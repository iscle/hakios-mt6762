diff --git a/tools/mt6762/physical/install_system_slice.py b/tools/mt6762/physical/install_system_slice.py
new file mode 100644
index 0000000000000000000000000000000000000000..9c40c78677259a5abc8f82ee2c049919adc30ee9
--- /dev/null
+++ b/tools/mt6762/physical/install_system_slice.py
@@ -0,0 +1,88 @@
+"""Bounded, backed-up iOS slice writer; hardware adapters must supply fresh guards.
+
+No device discovery, reset, format, retry or partition-table changes exist here.
+The caller must pin the active device, fresh GPT and preserved partition hashes
+in guard(). An exception leaves any partial write in place for inspection.
+"""
+import hashlib
+import os
+from pathlib import Path
+
+from desktop_ramdisk import SECTOR_SIZE, validate_slice
+
+
+def identity(stream):
+    s = os.fstat(stream.fileno())
+    return s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns
+
+
+def require(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+
+def read_exact(io, address, size):
+    data = io.read(address, size)
+    require(isinstance(data, (bytes, bytearray)) and len(data) == size,
+            'short or invalid media read; stop without reset')
+    return bytes(data)
+
+
+def install(io, source, backup, expected_sha256, start, count, guard, record,
+            chunk_bytes=4*1024*1024):
+    """Write one explicit extent after a complete backup; verify every byte.
+
+    io has read(address,size) and write(address,bytes). guard() must raise on
+    device/geometry/preserved-partition changes. record(event) persists progress.
+    This function never treats a failed write as permission to retry it.
+    """
+    extent = validate_slice(start, count)
+    require(512 <= chunk_bytes <= 4*1024*1024 and chunk_bytes % 512 == 0,
+            'invalid bounded transfer size')
+    require(len(expected_sha256) == 64 and
+            all(c in '0123456789abcdef' for c in expected_sha256), 'invalid source digest')
+    size, address = count*SECTOR_SIZE, start*SECTOR_SIZE
+    with Path(source).open('rb') as data:
+        before = identity(data)
+        require(before[2] == size, 'source length differs from slice')
+        digest = hashlib.sha256()
+        for block in iter(lambda: data.read(chunk_bytes), b''):
+            digest.update(block)
+        require(identity(data) == before and digest.hexdigest() == expected_sha256,
+                'source changed or digest mismatch before media access')
+        guard()
+        old_hash = hashlib.sha256()
+        fd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+        with os.fdopen(fd, 'wb') as saved:
+            for offset in range(0, size, chunk_bytes):
+                block = read_exact(io, address+offset, min(chunk_bytes,size-offset))
+                require(saved.write(block) == len(block), 'short backup write')
+                old_hash.update(block)
+            saved.flush()
+            os.fsync(saved.fileno())
+        record(dict(stage='backup_complete', address=address, bytes=size,
+                    sha256=old_hash.hexdigest()))
+        guard()
+        require(identity(data) == before, 'source changed while backing up; no write')
+        data.seek(0)
+        verified = hashlib.sha256()
+        for offset in range(0, size, chunk_bytes):
+            require(identity(data) == before, 'source changed during installation; stop')
+            block = data.read(min(chunk_bytes,size-offset))
+            require(len(block) == min(chunk_bytes,size-offset), 'short source read; stop')
+            record(dict(stage='write_begin', address=address+offset, bytes=len(block)))
+            require(io.write(address+offset, block) is True,
+                    'media write uncertain; stop without retry or reset')
+            actual = read_exact(io,address+offset,len(block))
+            require(actual == block, 'media readback mismatch; stop without reset')
+            verified.update(actual)
+            record(dict(stage='chunk_verified', address=address+offset, bytes=len(block)))
+        require(identity(data) == before and verified.hexdigest() == expected_sha256,
+                'source changed or complete readback digest mismatch; stop')
+        guard()
+        result = dict(extent, physical_contents_verified=True,
+                      source_sha256=expected_sha256, full_readback_sha256=verified.hexdigest(),
+                      backup_sha256=old_hash.hexdigest(), bytes_written=size,
+                      reset_requested=False, partition_table_written=False)
+        record(dict(stage='complete', **result))
+        return result
diff --git a/tools/mt6762/physical/lk-cache-bridge/README.rst b/tools/mt6762/physical/lk-cache-bridge/README.rst
new file mode 100644
index 0000000000000000000000000000000000000000..cc6e6c403e817d26cf163301541b8c7470d29fa3
--- /dev/null
+++ b/tools/mt6762/physical/lk-cache-bridge/README.rst
@@ -0,0 +1,93 @@
+Offline fastboot image-cache bridge
+==================================
+
+This is a concrete source fix for the observed exact-LK fastboot NULL-cache
+panic. It is **not a deployable LK image or a validated physical boot path**.
+No phone command, partition write, security-state change or LK image mutation
+is performed by these tools.
+
+The bridge changes only the behavior of the original call at0x4801dede in
+``cmd_boot``. The four-byte replacement BL is pinned to original bytes
+``19f02bf8`` and the complete dumped LK SHA256. Normal boot callsites remain
+unchanged. Its assembly wrapper captures the downloaded pointer from r7 and
+byte count from r9, validates the image before allocating, calls the exact
+existing cache allocator, and copies the complete image into that owned buffer.
+It then restores the caller's registers/stack and tail-calls the original
+decapsulator, whose cached lookup now succeeds. The allocator and its free
+callback retain the same ownership as the normal verified-image loading path.
+
+On admission/allocation failure, the wrapper sends fastboot FAIL and branches
+to the original handler cleanup at0x4801df82. That cleanup frees the handler's
+already allocated header and unwinds its frame. It does not return a false
+success into the remaining boot code. The bridge makes no storage, MMIO,
+authentication-policy, unlock or verity-status calls.
+
+Admission contract
+------------------
+
+The source must be the exact fixed fastboot transfer base0x48b00000 and its
+reported byte count must be1660..128MiB. The header must have Android magic,
+version2, size1660 and a supported power-of-two page size. The kernel and DTB
+must be nonempty; a second-stage executable is rejected. Every serialized
+component and its padding must fit the download without arithmetic wrap; a
+nonempty recovery DTBO must have its exact64-bit file offset. The last component
+must end exactly at download size. This deliberately accepts the diagnostic
+boot-v2 format and rejects unsupported layouts/trailing data.
+
+These checks precede cache allocation. Original LK continues to own its
+subsequent destination-address checks, DT handling and transfer. Passing this
+bridge is not proof those later stages or the physical XNU payload work.
+
+Build and tests
+---------------
+
+Requires an existing LLVM clang/lld capable of arm-none-eabi, Python pyelftools,
+Capstone (for the separate audit), and Unicorn. No dependency installation is
+performed::
+
+  python3 build.py --lk /path/to/lk.bin \
+    --llvm-bin /path/to/ndk/toolchains/llvm/prebuilt/linux-x86_64/bin \
+    --load-address 0x48200000 --out /tmp/lk-cache-bridge
+  python3 test_bridge.py --lk /path/to/lk.bin \
+    --boot /path/to/mt6762-xnu-diagnostic-boot.img \
+    --artifacts /tmp/lk-cache-bridge -v
+
+The example0x48200000 is only a model/linker coordinate; its physical ownership
+is **unverified and it may overlap the running LK heap**. Do not inject there
+based on these tests.
+
+The compiled Thumb blob was419bytes with the supplied NDK clang. Seven tests
+passed using the actual build4 diagnostic image. Unicorn executes the compiled
+shim, the patched original call, original cache name lookup/allocation logic,
+and the original decapsulator through its successful cached-header branch.
+Only external heap allocation, memcpy, fastboot response, verbosity query and
+final free are mocked. Tests verify:
+
+* Correct full-byte copy and cache pointer/size with no response failure.
+* Original cache replacement frees the prior buffer through its callback.
+* Null allocation, including replacement, produces FAIL and original cleanup.
+* Thirteen malformed header/bounds/source cases never allocate or copy.
+* Success preserves r4..r11, SP and caller LR; rejection executes the original
+  frame unwind. External call stacks remain8-byte aligned.
+* BL encoding reproduces the original exact call and rejects invalid ranges.
+
+No actual heap allocator, cache maintenance, peripheral, storage I/O, full LK
+boot or XNU execution is proved by this CPU model.
+
+Deployment boundary
+-------------------
+
+``build.py`` emits only an ELF, injectable original-code blob and guarded patch
+manifest. It intentionally emits no full patched LK partition. The input's
+partition header declares payload length0xac5bc; the embedded FDT begins later
+at file0xad850. Appending a stub requires changing the loaded extent and proving
+its relationship to data/BSS, embedded DT and live allocations. This proof is
+absent. A linker address inside unused-looking partition padding does not mean
+LK loads or safely executes it.
+
+Any future RAM-only integration must independently establish an owned executable
+range, install the blob there, compare the callsite preimage, apply only that
+four-byte BL, perform required data/instruction cache maintenance and establish
+a supported transfer into that running LK. Runtime placement and transport are
+not part of this bridge. Flashing or overwriting persistent LK is not a fallback
+implemented by this package.
diff --git a/tools/mt6762/physical/lk-cache-bridge/bridge.c b/tools/mt6762/physical/lk-cache-bridge/bridge.c
new file mode 100644
index 0000000000000000000000000000000000000000..35eefd384694ca04d19a982e00b6da122cbd72e3
--- /dev/null
+++ b/tools/mt6762/physical/lk-cache-bridge/bridge.c
@@ -0,0 +1,44 @@
+/* Exact-LK cache admission. No MMIO, security-state or storage writes. */
+typedef unsigned int u32;
+typedef unsigned char u8;
+#define SOURCE 0x48b00000u
+#define LIMIT 0x08000000u
+static u32 get32(const u8 *p) {
+    return (u32)p[0] | (u32)p[1]<<8 | (u32)p[2]<<16 | (u32)p[3]<<24;
+}
+static int component(u32 size, u32 page, u32 total, u32 *position) {
+    if (*position > total || size > total - *position) return 0;
+    u32 end = *position + size;
+    if (end > 0xffffffffu - (page - 1)) return 0;
+    end = (end + page - 1) & ~(page - 1);
+    if (end > total) return 0;
+    *position = end;
+    return 1;
+}
+__attribute__((used,noinline)) int bridge_prepare(const u8 *source, u32 size) {
+    /* This particular cmd_boot supplies its transfer base in r7 and size in r9. */
+    if ((u32)source != SOURCE || size < 1660 || size > LIMIT) return 0;
+    if (get32(source) != 0x52444e41 || get32(source+4) != 0x2144494f) return 0;
+    if (get32(source+40) != 2 || get32(source+1644) != 1660) return 0;
+    u32 page = get32(source+36);
+    if (page != 2048 && page != 4096 && page != 8192 && page != 16384) return 0;
+    u32 position=page;
+    u32 kernel=get32(source+8), ramdisk=get32(source+16), second=get32(source+24);
+    u32 recovery=get32(source+1632), dtb=get32(source+1648);
+    /* Diagnostic format supports a kernel plus DTB; no second-stage executable. */
+    if (!kernel || !dtb || second) return 0;
+    if (!component(kernel,page,size,&position) ||
+        !component(ramdisk,page,size,&position) ||
+        !component(second,page,size,&position)) return 0;
+    /* Nonempty recovery DTBO must point to its actual serialized position. */
+    if (recovery && (get32(source+1636)!=position || get32(source+1640))) return 0;
+    if (!component(recovery,page,size,&position) ||
+        !component(dtb,page,size,&position) || position!=size) return 0;
+    /* Exact cache allocator owns/free-callbacks this new image as in normal boot. */
+    void *(*allocate)(const char *,u32)=(void *)0x48037c51u;
+    void *(*copy)(void *,const void *,u32)=(void *)0x48028e24u;
+    void *image=allocate("boot",size);
+    if (!image) return 0;
+    copy(image,source,size);
+    return 1;
+}
diff --git a/tools/mt6762/physical/lk-cache-bridge/build.py b/tools/mt6762/physical/lk-cache-bridge/build.py
new file mode 100644
index 0000000000000000000000000000000000000000..350b4568e5fe7ca843b8b677ee4e2ae25d538b73
--- /dev/null
+++ b/tools/mt6762/physical/lk-cache-bridge/build.py
@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""Build injectable Thumb blob and guarded patch description, never full LK image.
+
+The requested address is a linker/test coordinate, NOT a verified physical cave.
+"""
+import argparse,hashlib,json,struct,subprocess
+from pathlib import Path
+from elftools.elf.elffile import ELFFile
+LK_SHA='5badc0dc942b0babdca3da13c7e07f3b5f1e57b66d503414b7f80effe8ce891a'
+CALL=0x4801dede
+ORIGINAL=bytes.fromhex('19f02bf8')
+def bl(source,target):
+    delta=target-(source+4)
+    if delta&1 or not -(1<<24)<=delta<(1<<24):raise ValueError('Thumb BL target out of range/alignment')
+    value=delta & 0x1ffffff;s=(value>>24)&1;i1=(value>>23)&1;i2=(value>>22)&1
+    return struct.pack('<HH',0xf000|(s<<10)|((value>>12)&1023),0xd000|((1^i1^s)<<13)|((1^i2^s)<<11)|((value>>1)&2047))
+def main():
+    p=argparse.ArgumentParser(description=__doc__);p.add_argument('--lk',required=True,type=Path)
+    p.add_argument('--llvm-bin',required=True,type=Path);p.add_argument('--load-address',required=True,type=lambda x:int(x,0))
+    p.add_argument('--out',required=True,type=Path);a=p.parse_args();raw=a.lk.read_bytes()
+    if hashlib.sha256(raw).hexdigest()!=LK_SHA or raw[CALL-0x47fffe00:CALL-0x47fffe00+4]!=ORIGINAL:raise ValueError('LK identity/callsite guard failed')
+    if a.load_address&3:raise ValueError('Load address must be4-byte aligned')
+    patch=bl(CALL,a.load_address);a.out.mkdir(parents=True,exist_ok=True);src=Path(__file__).resolve().parent
+    linker=a.out/'bridge.ld';linker.write_text(f'ENTRY(bridge_entry)\nSECTIONS {{ . = 0x{a.load_address:x}; .text : {{ *(.text.entry) *(.text*) *(.rodata*) }} /DISCARD/ : {{ *(.ARM.exidx*) *(.ARM.extab*) *(.comment*) }} }}\n')
+    elf=a.out/'bridge.elf'
+    cmd=[str(a.llvm_bin/'clang'),'--target=arm-none-eabi','-mcpu=cortex-a53','-mthumb','-Os','-ffreestanding','-fno-builtin','-fno-stack-protector','-fno-unwind-tables','-fno-asynchronous-unwind-tables','-nostdlib','-Wl,--build-id=none','-Wl,-T,'+str(linker),str(src/'entry.S'),str(src/'bridge.c'),'-o',str(elf)]
+    subprocess.run(cmd,check=True)
+    with elf.open('rb') as f:
+        e=ELFFile(f);section=e.get_section_by_name('.text');blob=section.data()
+        if section['sh_addr']!=a.load_address:raise ValueError('Unexpected code address')
+        if any(s['sh_type']=='SHT_REL' and s['sh_size'] for s in e.iter_sections()):raise ValueError('Unresolved relocation')
+    (a.out/'bridge.bin').write_bytes(blob)
+    manifest={'deployment_status':'INJECTABLE_BLOB_ONLY_NO_VERIFIED_RAM_PLACEMENT_NO_PHONE_EXECUTION',
+        'lk_sha256':LK_SHA,'lk_partition_size':len(raw),'lk_declared_payload_size':struct.unpack_from('<I',raw,4)[0],
+        'placement':{'address':hex(a.load_address),'size':len(blob),'physical_ownership_verified':False,'instruction_cache_maintenance_required':True},
+        'blob_sha256':hashlib.sha256(blob).hexdigest(),'patch':{'va':hex(CALL),'file_offset':hex(CALL-0x47fffe00),'expected_hex':ORIGINAL.hex(),'replacement_hex':patch.hex()},
+        'source_sha256':{n:hashlib.sha256((src/n).read_bytes()).hexdigest() for n in ('bridge.c','entry.S','build.py')},
+        'limits':['No flashable/patched LK file generated.','No append/cave load-extent proof.','Models do not prove physical execution or later XNU handoff.']}
+    (a.out/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n');print(f'{len(blob)} bytes; guarded BL patch; placement remains unverified')
+if __name__=='__main__':main()
diff --git a/tools/mt6762/physical/lk-cache-bridge/entry.S b/tools/mt6762/physical/lk-cache-bridge/entry.S
new file mode 100644
index 0000000000000000000000000000000000000000..277a19d23116d97a7f04514018ad608c26748be9
--- /dev/null
+++ b/tools/mt6762/physical/lk-cache-bridge/entry.S
@@ -0,0 +1,33 @@
+.syntax unified
+.arch armv7-a
+.thumb
+.section .text.entry,"ax",%progbits
+.global bridge_entry
+.type bridge_entry,%function
+.thumb_func
+bridge_entry:
+    /* 56 bytes preserve incoming8-byte alignment and all original registers. */
+    push.w {r0-r12,lr}
+    mov r0,r7
+    mov r1,r9
+    bl bridge_prepare
+    cmp r0,#0
+    beq rejected
+    pop.w {r0-r12,lr}
+    ldr r12,=0x48036f39
+    bx r12
+rejected:
+    adr r0,rejected_message
+    ldr r12,=0x4801cbb9
+    blx r12
+    pop.w {r0-r12,lr}
+    /* Original handler cleanup frees r4(header), then unwinds its own frame. */
+    ldr r12,=0x4801df83
+    bx r12
+.balign 4
+rejected_message:
+    .asciz "LK cache bridge rejected download"
+.balign 4
+.ltorg
+.size bridge_entry,.-bridge_entry
+.section .note.GNU-stack,"",%progbits
