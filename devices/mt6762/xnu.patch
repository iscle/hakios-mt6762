index 0000000000000000000000000000000000000000..98068b9dbfdf7ccd38bdbd61d3ea8b420755736d
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_charger_postsetup.c
@@ -0,0 +1,44 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../i2c/mtk_i2c_v2.h"
+#include "mt6762_charger_setup.h"
+int main(void)
+{
