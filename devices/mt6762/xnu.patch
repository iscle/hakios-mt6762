+#!/bin/sh
+set -eu
+cd "$(dirname "$0")"
+testdir=$(mktemp -d)
+trap 'rm -rf "$testdir"' EXIT HUP INT TERM
+cc -std=c11 -Wall -Wextra -Werror opp_policy.c test_opp_policy.c -o "$testdir/test-opp"
+"$testdir/test-opp"
+
+python3 - "$testdir/pvt_fixture.h" <<'PVT'
+import json,sys
+from pathlib import Path
+rows=json.loads(Path('evidence/stock-c62-pvt.json').read_text())['rows']
+words=[0]*144
+for d in range(3):
+ for i,(mhz,selector,post,clk) in enumerate(rows[d*16:(d+1)*16]):
+  words[d*36+i]=mhz|(selector<<16)
+  words[d*36+16+i]=post|(clk<<16)
+ words[d*36+32]=0xffffffff
+Path(sys.argv[1]).write_text('static const uint32_t pvt_fixture[144]={'+','.join(hex(x)+'u' for x in words)+'};\n')
+PVT
+cc -std=c11 -Wall -Wextra -Werror -g -I "$testdir" test_native_cpufreq.c -o "$testdir/test-native-cpufreq"
+"$testdir/test-native-cpufreq"
+PYTHONDONTWRITEBYTECODE=1 python3 test_clock_snapshot.py
+cc -std=c11 -Wall -Wextra -Werror -g test_native_sspm.c -o "$testdir/test-native-sspm"
+"$testdir/test-native-sspm"
+cc -std=c11 -Wall -Wextra -Werror -g -I "$testdir" test_sspm_observer.c -o "$testdir/test-sspm-observer"
+"$testdir/test-sspm-observer"
+PYTHONDONTWRITEBYTECODE=1 python3 test_sspm_observation.py
+python3 - "$testdir/thermal_slopes.h" <<'THERMAL'
+import json,sys
+from pathlib import Path
+cases=json.loads(Path('evidence/stock-thermal-slopes.json').read_text())['cases']
+lines=['static const int thermal_slopes[][8]={']
+for c in cases:
+ lines.append('{'+','.join(str(x) for x in [c['slope'],c['sign']]+c['denominators']+c['intercepts'])+'},')
+lines.append('};')
+Path(sys.argv[1]).write_text('\n'.join(lines)+'\n')
+THERMAL
+cc -std=c11 -Wall -Wextra -Werror -g -I "$testdir" test_native_thermal.c -o "$testdir/test-native-thermal"
+"$testdir/test-native-thermal"
+cc -std=c11 -Wall -Wextra -Werror -g test_thermal_observer.c -o "$testdir/test-thermal-observer"
+"$testdir/test-thermal-observer"
diff --git a/tools/mt6762/hardware/cpu-power/test_clock_snapshot.py b/tools/mt6762/hardware/cpu-power/test_clock_snapshot.py
new file mode 100644
index 0000000000000000000000000000000000000000..ed5885afae66135bf5e79b22dcc9a580f789f18e
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/test_clock_snapshot.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Retained-acquisition regressions for the physical CKDIV0 observation."""
+import copy
+import unittest
+
+from decode_clock_snapshot import DOMAINS, decode_snapshot
+
+
+def capture_fixture():
+    capture = {"state": 2, "pass_number": 2, "registers": []}
+    # Independent literal capture26 vectors, rather than calculated PCWs.
+    words = ((0x191, 0x811CD89D, 0x80000001, 0x10A00),
+             (0x191, 0x0111B13B, 0x80000001, 0x00AFF),
+             (0x191, 0x821713B1, 0x80000001, 0x10A00))
+    for addresses, values in zip(DOMAINS.values(), words):
+        for address, value in zip(addresses, values):
+            capture["registers"].append(dict(address=hex(address), width=4, valid=3,
+                                             first=value, second=value, stable=True))
+    return capture
+
+
+class PhysicalClockTests(unittest.TestCase):
+    def test_captured_code0_rates(self):
+        result = decode_snapshot(capture_fixture())
+        self.assertEqual([d["nominal_khz"] for d in result["domains"].values()],
+                         [1499999, 919999, 599999])
+        self.assertEqual([d["stock_getter_rounded_khz"] for d in result["domains"].values()],
+                         [1499500, 919500, 599750])
+        self.assertFalse(result["ownership_granted"])
+        self.assertFalse(result["dvfs_control_ready"])
+
+    def test_incomplete_or_changed_samples_remain_unknown(self):
+        for field, value in (("width", 2), ("valid", 1), ("stable", False),
+                             ("second", 0), ("first", -1), ("first", True)):
+            with self.subTest(field=field, value=value):
+                capture = capture_fixture()
+                capture["registers"][3][field] = value
+                result = decode_snapshot(capture)["domains"]
+                self.assertFalse(result["cpu0_3"]["valid"])
+                self.assertIsNone(result["cpu0_3"]["nominal_khz"])
+                self.assertTrue(result["cpu4_7"]["valid"])
+
+    def test_duplicate_or_missing_register_remains_unknown(self):
+        for duplicate in (False, True):
+            capture = capture_fixture()
+            if duplicate:
+                capture["registers"].append(copy.copy(capture["registers"][3]))
+            else:
+                capture["registers"].pop(3)
+            self.assertFalse(decode_snapshot(capture)["domains"]["cpu0_3"]["valid"])
+
+    def test_incomplete_capture_does_not_grant_validity(self):
+        for field, value in (("state", 1), ("pass_number", 1)):
+            capture = capture_fixture()
+            capture[field] = value
+            self.assertTrue(all(not d["valid"] for d in decode_snapshot(capture)["domains"].values()))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/mt6762/hardware/cpu-power/test_native_cpufreq.c b/tools/mt6762/hardware/cpu-power/test_native_cpufreq.c
new file mode 100644
index 0000000000000000000000000000000000000000..b24bc59f698311c3f23ed6d98b91a49b881b441e
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/test_native_cpufreq.c
@@ -0,0 +1,66 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../../../bsd/dev/mt6762_cpufreq_protocol.h"
+#include "pvt_fixture.h"
+static void table_tests(void)
+{
+    uint32_t words[144];struct mt6762_pvt_table t,before;
+    memcpy(words,pvt_fixture,sizeof(words));
+    assert(!mt6762_pvt_decode(words,&t));
+    assert(t.opp[0][0].khz==2001000 && t.opp[0][0].uv==1118750);
+    assert(t.opp[1][15].khz==400000 && t.opp[1][15].postdiv==4 && t.opp[1][15].clkdiv==2);
+    assert(t.opp[2][15].khz==300000 && t.opp[2][15].uv==600000);
+    words[0]=(80u<<16)|2001; /* independent runtime EEM selector, not nominal */
+    assert(!mt6762_pvt_decode(words,&t) && t.opp[0][0].uv==1018750);
+    before=t;
+    unsigned offsets[]={0,0,16,32};uint32_t bad[]={0x600000, (128u<<16)|2001,0x01010001,0};
+    for(unsigned i=0;i<4;i++) {
+        memcpy(words,pvt_fixture,sizeof(words));words[offsets[i]]=bad[i];
+        assert(mt6762_pvt_decode(words,&t));assert(!memcmp(&t,&before,sizeof(t)));
+    }
+    assert(mt6762_pvt_decode(NULL,&t));
+}
+static void clock_tests(void)
+{
+    uint32_t khz=999,ck=(1u<<9)|(8u<<17);
+    assert(!mt6762_pll_khz(1,0x100000,1,ck,&khz) && khz==1664000);
+    assert(!mt6762_pll_khz(1,0x1100000,1,ck,&khz) && khz==832000);
+    assert(!mt6762_pll_khz(1,0x1100000,1,(1u<<9)|(10u<<17),&khz) && khz==416000);
+    assert(!mt6762_pll_khz(1,0x100000,1,(1u<<9)|(9u<<17),&khz) && khz==1248000);
+    assert(!mt6762_pll_khz(1,0x100000,1,(1u<<9)|(17u<<17),&khz) && khz==1331200);
+    assert(!mt6762_pll_khz(1,0x100000,1,(1u<<9)|(29u<<17),&khz) && khz==277333);
+    assert(mt6762_pll_khz(0,0x100000,1,ck,&khz) && khz==277333);
+    assert(mt6762_pll_khz(1,0x100000,3,ck,&khz) && khz==277333);
+    assert(mt6762_pll_khz(1,0x100000,0,ck,&khz));
+    assert(mt6762_pll_khz(1,0x100000,1,8u<<17,&khz));
+    assert(mt6762_pll_khz(1,0x100000,1,(2u<<9)|(8u<<17),&khz));
+    assert(mt6762_pll_khz(1,0x5100000,1,ck,&khz));
+    assert(mt6762_pll_khz(1,0x100000,1,(1u<<9)|(12u<<17),&khz));
+    assert(mt6762_pll_khz(1,0,1,ck,&khz));
+
+    /* Actual two-pass inherited capture26; code 0 is undivided. PCWs are
+     * rounded down by the preloader, so nominal whole-kHz values end in 999. */
+    assert(!mt6762_pll_khz(0x191,0x811cd89d,0x80000001,0x10a00,&khz) && khz==1499999);
+    assert(!mt6762_pll_khz(0x191,0x0111b13b,0x80000001,0x00aff,&khz) && khz==919999);
+    assert(!mt6762_pll_khz(0x191,0x821713b1,0x80000001,0x10a00,&khz) && khz==599999);
+    /* Admitting code 0 must not weaken source/power checks, or admit the
+     * other encodings hidden by the stock getter's permissive default. */
+    assert(mt6762_pll_khz(0x190,0x811cd89d,0x80000001,0x10a00,&khz) && khz==599999);
+    assert(mt6762_pll_khz(0x191,0x811cd89d,0x80000003,0x10a00,&khz) && khz==599999);
+    assert(mt6762_pll_khz(0x191,0x811cd89d,0x80000001,0x10800,&khz) && khz==599999);
+    for(unsigned div=1;div<32;div++) {
+        if((div>=8 && div<=11) || (div>=16 && div<=20) || (div>=24 && div<=29))continue;
+        assert(mt6762_pll_khz(0x191,0x811cd89d,0x80000001,(div<<17)|0x10a00,&khz));
+        assert(khz==599999);
+    }
+}
+static void caps_tests(void)
+{
+    unsigned cap=999,floor=999;
+    assert(!mt6762_ppm_indices(15,&cap,&floor) && cap==0 && floor==15);
+    assert(!mt6762_ppm_indices((7u<<16)|12,&cap,&floor) && cap==7 && floor==12);
+    assert(mt6762_ppm_indices((13u<<16)|12,&cap,&floor) && cap==7 && floor==12);
+    assert(mt6762_ppm_indices(16,&cap,&floor));
+}
+int main(void) {table_tests();clock_tests();caps_tests();puts("native CPU PLL, runtime SSPM table, PPM validation: PASS");return 0;}
diff --git a/tools/mt6762/hardware/cpu-power/test_native_sspm.c b/tools/mt6762/hardware/cpu-power/test_native_sspm.c
new file mode 100644
index 0000000000000000000000000000000000000000..7855c4efe97ddd9e980c29edd86aaf02e2be7780
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/test_native_sspm.c
@@ -0,0 +1,100 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../../../bsd/dev/mt6762_sspm_protocol.h"
+struct fixture {
+    uint32_t words[64],in,out,response,doorbell,clear;
+    unsigned pin,reads,writes,polls,delays,barriers,ack_after,active;
+    unsigned fail_read,fail_write,stuck_clear,stuck_input,payload_read,clear_before_read;
+};
+static int read32(void *p,unsigned region,uint32_t offset,uint32_t *value)
+{
+    struct fixture *f=p;f->reads++;
+    if(f->fail_read==f->reads)return -1;
+    assert(!(offset&3));
+    if(region==MT6762_SSPM_DATA) {
+        assert(offset<256);*value=f->words[offset/4];f->payload_read++;return 0;
+    }
+    assert(region==MT6762_SSPM_CTRL && offset<=4);
+    if(offset==0) {*value=f->in;return 0;}
+    if(f->active && ++f->polls>=f->ack_after) {
+        f->out|=1u<<f->pin;
+        if(!f->stuck_input)f->in&=~(1u<<f->pin);
+        f->words[f->pin?3:0]=f->response;
+    }
+    *value=f->out;return 0;
+}
+static int write32(void *p,unsigned region,uint32_t offset,uint32_t value)
+{
+    struct fixture *f=p;f->writes++;
+    if(f->fail_write==f->writes)return -1;
+    if(region==MT6762_SSPM_DATA) {
+        unsigned start=f->pin?12:0,count=f->pin?16:12;
+        assert(offset>=start && offset<start+count && !(offset&3));
+        f->words[offset/4]=value;return 0;
+    }
+    assert(region==MT6762_SSPM_CTRL && offset<=4);
+    assert(value==(1u<<f->pin));
+    if(!offset) {f->in|=value;f->doorbell=value;f->active=1;}
+    else {
+        f->clear=value;
+        if(!f->payload_read)f->clear_before_read=1;
+        if(!f->stuck_clear)f->out&=~value;
+        f->active=0;
+    }
+    return 0;
+}
+static void barrier(void *p) {((struct fixture *)p)->barriers++;}
+static void delay_us(void *p,unsigned delay) {assert(delay==10);((struct fixture *)p)->delays+=delay;}
+static struct mt6762_sspm_transport make(struct fixture *f)
+{
+    struct mt6762_sspm_transport t={{f,read32,write32,barrier,delay_us},3,0};return t;
+}
+int main(void)
+{
+    const uint32_t platform[3]={0xdead,0,0},cpu[4]={0x11223344,1,2,3};
+    uint32_t ack=0xfeedbeef;
+    struct fixture f={.response=1,.ack_after=3,.out=0x80};
+    struct mt6762_sspm_transport t=make(&f);
+    assert(!mt6762_sspm_exchange(&t,0,platform,3,&ack,5));
+    assert(ack==1 && f.out==0x80 && f.clear==1 && !f.clear_before_read && !f.in);
+    assert(f.delays==20 && f.writes==5 && f.words[1]==0 && f.words[2]==0 && !t.fault);
+    f=(struct fixture){.pin=1,.response=0x87654321,.ack_after=1};t=make(&f);
+    assert(!mt6762_sspm_exchange(&t,1,cpu,4,&ack,5));
+    assert(ack==0x87654321 && f.doorbell==2 && f.clear==2 && f.writes==6);
+    assert(f.words[4]==1 && f.words[5]==2 && f.words[6]==3 && !f.words[0]);
+    f=(struct fixture){.in=1};t=make(&f);ack=99;
+    assert(mt6762_sspm_exchange(&t,0,platform,3,&ack,5)==MT6762_SSPM_BUSY);
+    assert(t.fault && !f.writes && ack==99);
+    f=(struct fixture){.out=1};t=make(&f);
+    assert(mt6762_sspm_exchange(&t,0,platform,3,&ack,5)==MT6762_SSPM_BUSY && !f.writes);
+    f=(struct fixture){.ack_after=99999,.out=0x80};t=make(&f);
+    assert(mt6762_sspm_exchange(&t,0,platform,3,&ack,5)==MT6762_SSPM_TIMEOUT);
+    assert(ack==99 && t.fault && f.delays==50 && f.writes==4 && f.out==0x80);
+    unsigned reads=f.reads,writes=f.writes;
+    f.out|=1; /* A late ACK cannot be consumed by a new transaction. */
+    assert(mt6762_sspm_exchange(&t,0,platform,3,&ack,5)==MT6762_SSPM_FAULT);
+    assert(f.reads==reads && f.writes==writes && f.out==0x81);
+    f=(struct fixture){.ack_after=1,.response=1,.stuck_clear=1};t=make(&f);
+    assert(mt6762_sspm_exchange(&t,0,platform,3,&ack,5)==MT6762_SSPM_IO && ack==99 && t.fault);
+    f=(struct fixture){.ack_after=1,.response=1,.stuck_input=1};t=make(&f);
+    assert(mt6762_sspm_exchange(&t,0,platform,3,&ack,5)==MT6762_SSPM_IO && ack==99 && t.fault);
+    assert(f.clear==0 && f.in==1 && f.out==1);
+    for(unsigned i=1;i<=6;i++) {
+        f=(struct fixture){.ack_after=1,.response=1,.fail_read=i};t=make(&f);
+        assert(mt6762_sspm_exchange(&t,0,platform,3,&ack,5)==MT6762_SSPM_IO && ack==99 && t.fault);
+    }
+    for(unsigned i=1;i<=5;i++) {
+        f=(struct fixture){.ack_after=1,.response=1,.fail_write=i};t=make(&f);
+        assert(mt6762_sspm_exchange(&t,0,platform,3,&ack,5)==MT6762_SSPM_IO && ack==99 && t.fault);
+    }
+    f=(struct fixture){0};t=make(&f);
+    assert(mt6762_sspm_exchange(&t,2,platform,3,&ack,5)==MT6762_SSPM_INVALID);
+    assert(mt6762_sspm_exchange(&t,0,platform,2,&ack,5)==MT6762_SSPM_INVALID);
+    assert(mt6762_sspm_exchange(&t,0,platform,3,&ack,0)==MT6762_SSPM_INVALID);
+    t.owned_pins=0;
+    assert(mt6762_sspm_exchange(&t,0,platform,3,&ack,5)==MT6762_SSPM_INVALID);
+    assert(!f.reads && !f.writes && ack==99);
+    puts("native SSPM ownership, slot layout, bounded ACK, W1C preservation, stale/error handling: PASS");
+    return 0;
+}
diff --git a/tools/mt6762/hardware/cpu-power/test_native_thermal.c b/tools/mt6762/hardware/cpu-power/test_native_thermal.c
new file mode 100644
index 0000000000000000000000000000000000000000..dfa880123e0308358c43156776638b1de80aada2
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/test_native_thermal.c
@@ -0,0 +1,85 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../../../bsd/dev/mt6762_thermal_protocol.h"
+#include "thermal_slopes.h"
+struct fixture {unsigned writes,reads,delays,sensor,fault;uint16_t raw;};
+static int read16(void *p,uint16_t reg,uint16_t *out)
+{
+    struct fixture *f=p;f->reads++;
+    if(f->fault==6)return -6;
+    if(reg==0x1216) {*out=f->fault==1?16:0;return 0;}
+    assert(reg==(f->sensor==0?0x1090:f->sensor==1?0x10d8:0x10da));
+    *out=f->raw;
+    if(f->fault==2 || (f->delays && f->fault!=3))*out|=0x8000;
+    return 0;
+}
+static int write16(void *p,uint16_t reg,uint16_t value)
+{
+    struct fixture *f=p;f->writes++;
+    assert(reg==(f->sensor?0x1114:0x110e));
+    assert(value==(1u<<(f->sensor?4+f->sensor:4)));
+    return f->fault==5?-5:0;
+}
+static void wait_us(void *p,unsigned us) {struct fixture *f=p;assert(us==80||us==200);f->delays++;}
+int main(void)
+{
+    /* Independent expected values from bounded original boot calibration logs. */
+    const uint32_t cpu_words[3]={0x0299546b,0x9d9d514c,0xa5d36940};
+    const uint16_t pmic_words[6]={0x137,1588,0,0,1526,1534};
+    struct mt6762_cpu_cal cpu,unchanged_cpu;
+    struct mt6762_pmic_cal pmic,unchanged_pmic;
+    int mc=123,previous=200000;
+    uint32_t bad_cpu[3];uint16_t bad_pmic[6];
+    assert(!mt6762_cpu_cal_decode(cpu_words,&cpu));
+    assert(cpu.gain==10288 && cpu.offset==-43 && cpu.half_degrees==53);
+    const int rooms[5]={8839,8857,8839,8836,8834};
+    for(unsigned i=0;i<5;i++)assert(cpu.room[i]==rooms[i]);
+    assert(!mt6762_cpu_temperature(&cpu,0,3682,&mc) && mc==26500);
+    for(unsigned raw=1;raw<4095;raw++)if(!mt6762_cpu_temperature(&cpu,0,raw,&mc)){assert(mc<=previous);previous=mc;}
+    assert(!mt6762_pmic_cal_decode(pmic_words,&pmic));
+    assert(pmic.intercept[0]==442134 && pmic.slope_den[0]==-1681);
+    assert(pmic.intercept[1]==387134 && pmic.intercept[2]==389282);
+    for(unsigned i=0;i<3;i++)assert(!mt6762_pmic_temperature(&pmic,i,pmic_words[i==0?1:i+3],&mc) && mc==27500);
+    unchanged_cpu=cpu;unchanged_pmic=pmic;
+    memcpy(bad_cpu,cpu_words,sizeof(bad_cpu));bad_cpu[0]&=~1u;
+    assert(mt6762_cpu_cal_decode(bad_cpu,&cpu) && !memcmp(&cpu,&unchanged_cpu,sizeof(cpu)));
+    memcpy(bad_cpu,cpu_words,sizeof(bad_cpu));bad_cpu[1]&=0x003fffff;
+    assert(mt6762_cpu_cal_decode(bad_cpu,&cpu));
+    memcpy(bad_pmic,pmic_words,sizeof(bad_pmic));bad_pmic[0]&=~256u;
+    assert(mt6762_pmic_cal_decode(bad_pmic,&pmic) && !memcmp(&pmic,&unchanged_pmic,sizeof(pmic)));
+    memcpy(bad_pmic,pmic_words,sizeof(bad_pmic));bad_pmic[0]=0x101;
+    assert(mt6762_pmic_cal_decode(bad_pmic,&pmic));
+    mc=123;assert(mt6762_cpu_temperature(&cpu,0,0,&mc) && mc==123);
+    assert(mt6762_pmic_temperature(&pmic,0,4095,&mc) && mc==123);
+    assert(mt6762_cpu_cal_decode(NULL,&cpu) && mt6762_pmic_cal_decode(NULL,&pmic));
+    /* Independently produced by executing original stock AArch64 function. */
+    for(unsigned i=0;i<sizeof(thermal_slopes)/sizeof(thermal_slopes[0]);i++) {
+        struct mt6762_pmic_cal slopes;
+        memcpy(bad_pmic,pmic_words,sizeof(bad_pmic));
+        bad_pmic[2]=(uint16_t)(thermal_slopes[i][0]|(thermal_slopes[i][1]<<8));
+        bad_pmic[3]=16; /* ID1 preserves slope. */
+        assert(!mt6762_pmic_cal_decode(bad_pmic,&slopes));
+        for(unsigned j=0;j<3;j++) {
+            assert(slopes.slope_den[j]==thermal_slopes[i][j+2]);
+            assert(slopes.intercept[j]==thermal_slopes[i][j+5]);
+        }
+        bad_pmic[3]=0; /* ID0 ignores even nonzero efuse slope. */
+        assert(!mt6762_pmic_cal_decode(bad_pmic,&slopes));
+        assert(!memcmp(&slopes,&unchanged_pmic,sizeof(slopes)));
+    }
+    const uint64_t deadlines[8]={10,11,12,13,14,15,16,17};
+    assert(mt6762_thermal_unexpired(255,deadlines,9)==255);
+    assert(mt6762_thermal_unexpired(255,deadlines,10)==254);
+    assert(mt6762_thermal_unexpired(255,deadlines,17)==0);
+    assert(mt6762_thermal_unexpired(1,deadlines,9)==1);
+    for(unsigned sensor=0;sensor<3;sensor++)for(unsigned fault=0;fault<=6;fault++) {
+        struct fixture f={.sensor=sensor,.fault=fault,.raw=fault==4?4095:1588};
+        struct mt6762_thermal_adc_io io={&f,read16,write16,wait_us};uint16_t raw=1234;
+        int e=mt6762_thermal_adc(&io,sensor,&raw);
+        if(!fault || (fault==1 && sensor))assert(!e && raw==1588 && f.writes==1);
+        else {assert(e && raw==1234);if(fault==1 || fault==6)assert(!f.writes);}
+        assert(f.delays<=161);
+    }
+    puts("native thermal calibration/freshness tests: PASS");
+}
