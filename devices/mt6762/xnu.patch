index 0000000000000000000000000000000000000000..687bbd2c7a2cf0899c3c2088fc4e765c51ac4cd4
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/test.sh
@@ -0,0 +1,11 @@
+#!/bin/sh
+set -eu
+source_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+test_dir=$(mktemp -d)
+trap 'rm -rf -- "$test_dir"' EXIT HUP INT TERM
+compiler=${CC:-cc}
+for test_name in test_axs_touch test_axs_touch_state test_display_core test_apple_backlight test_dsi_vm; do
+    "$compiler" -std=c11 -Wall -Wextra -Werror "$source_dir/$test_name.c" -o "$test_dir/$test_name"
+    "$test_dir/$test_name"
+done
+"$compiler" -std=c11 -Wall -Wextra -Werror -fsyntax-only "$source_dir/axs15260_panel.h"
diff --git a/tools/mt6762/hardware/display-touch/test_apple_backlight.c b/tools/mt6762/hardware/display-touch/test_apple_backlight.c
new file mode 100644
index 0000000000000000000000000000000000000000..6d082e05f95f8f6bbf938765f0afed37d154223b
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/test_apple_backlight.c
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: MIT */
+#include <assert.h>
+#include <stdio.h>
+#include "apple_backlight_core.h"
+int main(void)
+{
+    /* CFNumber SInt8/16/32/64 are valid integer encodings. Even exact integral
+     * floating values must be rejected by type, before an unsigned conversion
+     * could conceal fractions, NaN or a negative value. */
+    assert(mt6762_backlight_integer_type(8));
+    assert(mt6762_backlight_integer_type(16));
+    assert(mt6762_backlight_integer_type(32));
+    assert(mt6762_backlight_integer_type(64));
+    assert(!mt6762_backlight_integer_type(31));
+    assert(!mt6762_backlight_integer_type(63));
+    assert(!mt6762_backlight_integer_type(0));
+    assert(!mt6762_backlight_integer_type(65));
+    assert(!mt6762_backlight_integer_type(UINT32_MAX));
+    /* Off in mid-fade saves confirmed300, never the unconfirmed900 target.
+     * A later authenticated off-screen request supersedes that restore level;
+     * repeated off must preserve it. No target is an actual-duty sample. */
+    struct mt6762_backlight_lifecycle lifecycle = {MT6762_BACKLIGHT_ACTIVE, 512, 0};
+    assert(mt6762_backlight_desire(&lifecycle, 900, 1000000) == 0);
+    mt6762_backlight_blank_confirmed(&lifecycle, 300);
+    assert(lifecycle.mode == MT6762_BACKLIGHT_BLANKED && lifecycle.desired == 300 && !lifecycle.fade_us);
+    assert(mt6762_backlight_desire(&lifecycle, 256, 500000) == 1);
+    assert(mt6762_backlight_desire(&lifecycle, 768, 1000000) == 1);
+    mt6762_backlight_blank_confirmed(&lifecycle, 0);
+    assert(lifecycle.desired == 768 && lifecycle.fade_us == 1000000);
+    assert(mt6762_backlight_desire(&lifecycle, 1024, 0) == -1);
+    assert(lifecycle.desired == 768);
+    /* Wake uses the pending target/fade from actual zero, not stale300. */
+    assert(mt6762_backlight_step(0, lifecycle.desired, 500000, lifecycle.fade_us) == 384);
+    lifecycle.mode = MT6762_BACKLIGHT_ACTIVE;
+    mt6762_backlight_blank_confirmed(&lifecycle, 384);
+    assert(lifecycle.desired == 384 && !lifecycle.fade_us);
+    lifecycle.mode = MT6762_BACKLIGHT_STOPPED;
+    assert(mt6762_backlight_desire(&lifecycle, 1023, 0) == -1);
+    mt6762_backlight_blank_confirmed(&lifecycle, 0);
+    assert(lifecycle.mode == MT6762_BACKLIGHT_STOPPED && lifecycle.desired == 384);
+    uint64_t us = 123;
+    assert(!mt6762_backlight_request(0, 0, &us) && us == 0);
+    assert(!mt6762_backlight_request(1023, 65536, &us) && us == 1000000);
+    assert(!mt6762_backlight_request(512, 32768, &us) && us == 500000);
+    assert(!mt6762_backlight_request(1, 1, &us) && us == 15);
+    assert(!mt6762_backlight_request(1, INT32_MAX, &us) && us == 32767999984ULL);
+    assert(mt6762_backlight_request(1024, 0, &us) < 0);
+    assert(mt6762_backlight_request(UINT32_MAX, 0, &us) < 0);
+    assert(mt6762_backlight_request(UINT64_MAX, 0, &us) < 0);
+    assert(mt6762_backlight_request(0, UINT32_MAX, &us) < 0);
+    assert(mt6762_backlight_request(0, UINT64_MAX, &us) < 0);
+    assert(mt6762_backlight_request(0, 0, NULL) < 0);
+    assert(mt6762_backlight_step(0, 1023, 0, 1000000) == 0);
+    assert(mt6762_backlight_step(0, 1023, 500000, 1000000) == 511);
+    assert(mt6762_backlight_step(1023, 0, 500000, 1000000) == 512);
+    assert(mt6762_backlight_step(1023, 0, 1000000, 1000000) == 0);
+    assert(mt6762_backlight_step(0, 1023, UINT64_MAX, 1000000) == 1023);
+    assert(mt6762_backlight_step(512, 20, 0, 0) == 20);
+    /* Retarget from the last confirmed hardware level, not the old target. */
+    unsigned midway = mt6762_backlight_step(0, 1000, 250000, 1000000);
+    assert(midway == 250 && mt6762_backlight_step(midway, 0, 500000, 1000000) == 125);
+    unsigned previous = 0;
+    for (unsigned i = 0; i <= 1000000; i += 1000) {
+        unsigned now = mt6762_backlight_step(0, 1023, i, 1000000);
+        assert(now >= previous && now <= 1023); previous = now;
+    }
+    puts("Apple legacy integer brightness/fixed16.16 fade tests passed");
+    return 0;
+}
diff --git a/tools/mt6762/hardware/display-touch/test_axs_touch.c b/tools/mt6762/hardware/display-touch/test_axs_touch.c
new file mode 100644
index 0000000000000000000000000000000000000000..a0e11c077be2861947ae11ef30763fd20c34707f
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/test_axs_touch.c
@@ -0,0 +1,34 @@
+/* Synthetic protocol vectors, not captured physical touch packets. */
+#include "axs_touch.h"
+#include <assert.h>
+#include <string.h>
+#include <stdio.h>
+
+int main(void)
+{
+    uint8_t p[32] = {0, 2, 0x01, 0x7f, 0x03, 0x55, 0x20, 0x90,
+                          0x80, 0x01, 0x40, 0x02, 0x00, 0x00};
+    struct axs_frame f;
+    assert(axs_touch_decode(p, sizeof p, &f) == 1);
+    assert(f.count == 2 && f.active_mask == 0x11);
+    assert(f.contacts[0].x == 383 && f.contacts[0].y == 853);
+    assert(f.contacts[0].pressure == 32 && f.contacts[0].area == 9);
+    assert(f.contacts[1].id == 4 && f.contacts[1].event == 2);
+    assert(f.contacts[1].pressure == 63 && f.contacts[1].area == 9);
+    p[2] = 0x41; /* up: still decode position but no active contact bit */
+    assert(axs_touch_decode(p, sizeof p, &f) == 1 && f.active_mask == 0x10);
+    p[10] = 0x50; /* invalid contact id terminates records */
+    assert(axs_touch_decode(p, sizeof p, &f) == 1 && f.count == 1);
+    p[1] = 0;
+    assert(axs_touch_decode(p, sizeof p, &f) == 1 && f.count == 0 && !f.active_mask);
+    p[1] = 0x10;
+    f.count = 77;
+    assert(axs_touch_decode(p, sizeof p, &f) == -1 && f.count == 77);
+    p[0] = 0xff;
+    assert(axs_touch_decode(p, sizeof p, &f) == 0 && f.count == 77);
+    assert(axs_touch_decode(p, 31, &f) == -1);
+    assert(axs_touch_decode(NULL, 32, &f) == -1);
+    memset(p, 0, sizeof p); p[1] = 15;
+    assert(axs_touch_decode(p, sizeof p, &f) == 1 && f.count == 5);
+    puts("AXS synthetic parser vectors passed");
+}
diff --git a/tools/mt6762/hardware/display-touch/test_axs_touch_state.c b/tools/mt6762/hardware/display-touch/test_axs_touch_state.c
new file mode 100644
index 0000000000000000000000000000000000000000..e8f99015f9ef37227ffaba497d522adaf1956951
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/test_axs_touch_state.c
@@ -0,0 +1,63 @@
+/* Synthetic protocol/state-machine tests; no physical packet captures used. */
+#include "axs_touch_state.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+struct event { unsigned type,id,x,y; };
+struct output { struct event events[128]; unsigned n; };
+static void emit(void *p,unsigned t,unsigned id,unsigned x,unsigned y)
+{
+    struct output *o=p; assert(o->n<128);
+    o->events[o->n++]=(struct event){t,id,x,y};
+}
+static void contact(uint8_t *p,unsigned index,unsigned id,unsigned event,unsigned x,unsigned y)
+{
+    uint8_t *r=p+2+6*index;
+    r[0]=(uint8_t)((event<<6)|(x>>8));r[1]=(uint8_t)x;
+    r[2]=(uint8_t)((id<<4)|(y>>8));r[3]=(uint8_t)y;r[4]=63;r[5]=0x90;
+}
+int main(void)
+{
+    struct axs_state s; struct output o={0}; uint8_t p[32]={0,1};
+    assert(axs_state_init(&s,384,854,100,emit,&o)==0);
+    contact(p,0,0,0,0,0);
+    assert(axs_state_feed(&s,p,32,1)==1 && o.n==1 && o.events[0].type==AXS_DOWN);
+    assert(axs_state_feed(&s,p,32,2)==1 && o.n==1); /* repeated positions suppressed */
+    contact(p,0,0,2,384,854);
+    assert(axs_state_feed(&s,p,32,3)==1 && o.n==2);
+    assert(o.events[1].type==AXS_MOVE && o.events[1].x==65535 && o.events[1].y==65535);
+    contact(p,0,0,1,10,10);
+    assert(axs_state_feed(&s,p,32,4)==1 && o.n==3 && !s.active);
+    assert(o.events[2].type==AXS_UP && o.events[2].x==65535); /* last position */
+    p[1]=5;
+    for(unsigned i=0;i<5;i++)contact(p,i,i,2,192,427);
+    assert(axs_state_feed(&s,p,32,5)==1 && s.active==31 && o.n==8);
+    assert(o.events[7].x==32767 && o.events[7].y==32767);
+    p[1]=1;contact(p,0,4,2,192,427);
+    assert(axs_state_feed(&s,p,32,6)==1 && s.active==16 && o.n==12); /* four missing UPs */
+    p[1]=2;contact(p,1,4,0,1,1);
+    assert(axs_state_feed(&s,p,32,7)==-1 && !s.active && o.n==13); /* duplicate rejects atomically */
+    assert(o.events[12].type==AXS_UP);
+    p[1]=1;contact(p,0,0,0,1,1);assert(axs_state_feed(&s,p,32,8)==1);
+    p[1]=0x11;assert(axs_state_feed(&s,p,32,9)==-1 && !s.active);
+    p[1]=1;assert(axs_state_feed(&s,p,32,10)==1);
+    assert(axs_state_feed(&s,p,31,11)==-1 && !s.active);
+    assert(axs_state_feed(&s,p,32,12)==1);
+    p[0]=0xff;assert(axs_state_feed(&s,p,32,13)==0 && s.active);
+    assert(axs_state_expire(&s,111)==0 && s.active);
+    assert(axs_state_expire(&s,112)==1 && !s.active); /* no packets: must release */
+    unsigned before=o.n;assert(axs_state_expire(&s,113)==0 && o.n==before);
+    p[0]=0;assert(axs_state_feed(&s,p,32,114)==1);
+    assert(axs_state_feed(&s,p,32,113)==-1 && !s.active); /* clock regression */
+    contact(p,0,0,0,385,0);before=o.n;
+    assert(axs_state_feed(&s,p,32,115)==-1 && !s.active && o.n==before);
+    contact(p,0,0,3,0,0);assert(axs_state_feed(&s,p,32,116)==-1);
+    contact(p,0,0,0,0,0);assert(axs_state_feed(&s,p,32,117)==1);
+    p[1]=15;assert(axs_state_feed(&s,p,32,118)==-1 && !s.active);
+    p[1]=1;assert(axs_state_feed(&s,p,32,119)==1);
+    p[1]=0;assert(axs_state_feed(&s,p,32,120)==1 && !s.active);
+    p[1]=1;assert(axs_state_feed(&s,p,32,121)==1);
+    axs_state_release_all(&s);assert(!s.active);
+    assert(axs_state_feed(&s,NULL,32,122)==-1);
+    puts("AXS state tracker synthetic tests passed");
+}
