diff --git a/tools/mt6762/hardware/display-touch/display_power_probe.c b/tools/mt6762/hardware/display-touch/display_power_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..5731e56be8b75c692e0fa4ec1d73a95fe7ac6fbd
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/display_power_probe.c
@@ -0,0 +1,113 @@
+/* QEMU-only display lifecycle request diagnostic. No direct MMIO or IOKit writes. */
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOKit/IOKitLib.h>
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static bool flag(io_registry_entry_t entry, CFStringRef key)
+{
+    CFTypeRef value = IORegistryEntryCreateCFProperty(entry, key, NULL, 0);
+    bool valid = value && CFGetTypeID(value) == CFDataGetTypeID() &&
+        CFDataGetLength(value) == 4;
+    if (valid) {
+        const UInt8 *bytes = CFDataGetBytePtr(value);
+        valid = bytes[0] == 1 && !bytes[1] && !bytes[2] && !bytes[3];
+    }
+    if (value) CFRelease(value);
+    return valid;
+}
+static bool is_lab(void)
+{
+    io_registry_entry_t entry = IORegistryEntryFromPath(0,
+        "IODeviceTree:/chosen/mt6762-handoff");
+    if (!entry) return false;
+    bool valid = flag(entry, CFSTR("version")) && flag(entry, CFSTR("native-io")) &&
+        flag(entry, CFSTR("lab-fixture"));
+    IOObjectRelease(entry);
+    return valid;
+}
+static int native_level(void)
+{
+    io_service_t service = IOServiceGetMatchingService(0, IOServiceMatching("AppleARMBacklight"));
+    if (!service) return -1;
+    CFTypeRef parameters = IORegistryEntryCreateCFProperty(service,
+        CFSTR("IODisplayParameters"), NULL, 0);
+    int level = -1;
+    if (parameters && CFGetTypeID(parameters) == CFDictionaryGetTypeID()) {
+        CFTypeRef brightness = CFDictionaryGetValue(parameters, CFSTR("brightness"));
+        if (brightness && CFGetTypeID(brightness) == CFDictionaryGetTypeID()) {
+            CFTypeRef value = CFDictionaryGetValue(brightness, CFSTR("value"));
+            if (value && CFGetTypeID(value) == CFNumberGetTypeID())
+                CFNumberGetValue(value, kCFNumberIntType, &level);
+        }
+    }
+    if (parameters) CFRelease(parameters);
+    IOObjectRelease(service);
+    return level;
+}
+static int desired_level(void)
+{
+    io_service_t service = IOServiceGetMatchingService(0, IOServiceMatching("AppleARMBacklight"));
+    if (!service) return -1;
+    CFTypeRef value = IORegistryEntryCreateCFProperty(service, CFSTR("MT6762DesiredBrightness"), NULL, 0);
+    int level = -1;
+    if (value && CFGetTypeID(value) == CFNumberGetTypeID())
+        CFNumberGetValue(value, kCFNumberIntType, &level);
+    if (value) CFRelease(value);
+    IOObjectRelease(service);
+    return level;
+}
+/* Uses only original framework APIs; requests are restricted to a lab ADT. */
+int main(int argc, char **argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (argc < 2 || strcmp(argv[1], "--qemu-lab") || !is_lab()) return 2;
+    unsigned delay = argc > 2 ? (unsigned)strtoul(argv[2], NULL, 10) : 45;
+    if (delay > 600) return 2;
+    printf("MT6762_POWER_WAIT seconds=%u\n", delay);
+    sleep(delay);
+    void *bks = dlopen("/System/Library/PrivateFrameworks/BackBoardServices.framework/BackBoardServices", RTLD_NOW);
+    void *iomfb = dlopen("/System/Library/PrivateFrameworks/IOMobileFramebuffer.framework/IOMobileFramebuffer", RTLD_NOW);
+    if (!bks || !iomfb) return 3;
+    int32_t (*set)(float) = dlsym(bks, "BKSDisplayBrightnessSetWithImplicitTransaction");
+    float (*get)(void) = dlsym(bks, "BKSDisplayBrightnessGetCurrent");
+    bool (*available)(void) = dlsym(bks, "BKSDisplayBrightnessIsBrightnessLevelControlAvailable");
+    int32_t (*main_display)(void **) = dlsym(iomfb, "IOMobileFramebufferGetMainDisplay");
+    int32_t (*power)(void *, uint32_t) = dlsym(iomfb, "IOMobileFramebufferRequestPowerChange");
+    if (!set || !get || !available || !main_display || !power) return 4;
+    bool ready = false;
+    for (unsigned i = 0; i < 30; i++) { ready = available(); if (ready) break; sleep(2); }
+    if (!ready) return 5;
+    void *display = NULL;
+    int32_t status = main_display(&display);
+    printf("MT6762_POWER_OPEN status=%#x present=%u\n", status, display != NULL);
+    if (status || !display) return 6;
+    float original = get();
+    if (!(original >= 0 && original <= 1)) return 7;
+    status = set(0.25f);
+    sleep(4);
+    printf("MT6762_POWER_BEFORE status=%#x published=%d\n", status, native_level());
+    status = power(display, 0);
+    sleep(4);
+    printf("MT6762_POWER_OFF status=%#x published=%d desired=%d\n", status, native_level(), desired_level());
+    if (status) return 8;
+    status = set(0.75f);
+    sleep(4);
+    printf("MT6762_POWER_DEFERRED status=%#x published=%d desired=%d logical=%.6f\n", status, native_level(), desired_level(), get());
+    status = power(display, 0);
+    printf("MT6762_POWER_DUPLICATE_OFF status=%#x published=%d desired=%d\n", status, native_level(), desired_level());
+    status = power(display, 1);
+    sleep(4);
+    printf("MT6762_POWER_ON status=%#x published=%d desired=%d logical=%.6f\n", status, native_level(), desired_level(), get());
+    if (status) return 9;
+    status = set(original);
+    sleep(4);
+    printf("MT6762_POWER_RESTORE status=%#x published=%d desired=%d logical=%.6f\n", status, native_level(), desired_level(), get());
+    puts("MT6762_POWER_DONE require independent PWM and framebuffer evidence");
+    return status ? 10 : 0;
+}
diff --git a/tools/mt6762/hardware/display-touch/extract_display_touch.py b/tools/mt6762/hardware/display-touch/extract_display_touch.py
new file mode 100644
index 0000000000000000000000000000000000000000..8d2d8e2e66cb7ed265a472c1bb19a2a7e99df978
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/extract_display_touch.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""Extract board-specific display/touch facts from this stock symbolized ELF.
+
+Read-only input. Addresses are tied to the exact stock Image SHA256 below;
+this is deliberately not a heuristic extractor for other firmware revisions.
+The optional touch firmware blob stays local and is never installed/flashed.
+"""
+import argparse
+import hashlib
+import json
+import struct
+from pathlib import Path
+
+IMAGE_SHA256 = "82b1919185a49f268a0f8e145a6714d6264c1f66918a90df0d763266147ead4b"
+BASE = 0xffffff8008080000
+
+
+class ELF:
+    def __init__(self, path):
+        self.data = Path(path).read_bytes()
+        if self.data[:6] != b"\x7fELF\x02\x01":
+            raise ValueError("expected ELF64 little endian")
+        if struct.unpack_from("<H", self.data, 18)[0] != 183:
+            raise ValueError("expected AArch64")
+        off = struct.unpack_from("<Q", self.data, 32)[0]
+        size, count = struct.unpack_from("<HH", self.data, 54)
+        self.loads = []
+        for i in range(count):
+            typ, flags, poff, va, pa, filesz, memsz, align = struct.unpack_from(
+                "<IIQQQQQQ", self.data, off + i * size)
+            if typ == 1:
+                if poff + filesz > len(self.data) or filesz > memsz:
+                    raise ValueError("invalid load segment")
+                self.loads.append((va, poff, filesz))
+        image = next((self.data[o:o+n] for a, o, n in self.loads if a == BASE), None)
+        if image is None or hashlib.sha256(image).hexdigest() != IMAGE_SHA256:
+            raise ValueError("stock Image hash does not match fixed address map")
+
+    def read(self, address, size):
+        for base, offset, length in self.loads:
+            if base <= address and address + size <= base + length:
+                return self.data[offset + address-base:offset + address-base+size]
+        raise ValueError(f"unbacked address {address:#x}+{size:#x}")
+
+    def table(self, address, count):
+        result = []
+        for i in range(count):
+            a = address + i * 72
+            b = self.read(a, 72)
+            cmd, n = struct.unpack_from("<IB", b)
+            if cmd == 0xffe:
+                entry = {"delay_ms": n}
+            elif cmd == 0xfff:
+                entry = {"end": True}
+            elif cmd <= 255 and n <= 64:
+                entry = {"dcs_command": cmd, "parameters": b[5:5+n].hex(), "force_update": True}
+            else:
+                raise ValueError("unexpected LCM entry")
+            result.append({"stock_va": hex(a), **entry})
+        return result
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("elf", type=Path)
+    ap.add_argument("output", type=Path)
+    ap.add_argument("--extract-touch-firmware", action="store_true")
+    args = ap.parse_args()
+    elf = ELF(args.elf)
+    args.output.mkdir(parents=True, exist_ok=True)
+    fw = elf.read(0xffffff80090e0ce9, 50192)
+    display_clocks = []
+    for i in range(25):
+        _, name, refs, membership, module = struct.unpack_from("<QQIII", elf.read(0xffffff800983f658+32*i, 32))
+        display_clocks.append({"index":i, "name":elf.read(name,64).split(b"\0")[0].decode(),
+                               "initial_refs":refs,"display_membership":membership,"module_id":module})
+    facts = {
+        "source_image_sha256": IMAGE_SHA256,
+        "source_elf_sha256": hashlib.sha256(elf.data).hexdigest(),
+        "method": "bounded ELF extraction; instruction-level evidence in sibling .asm files; no native REA provider configured",
+        "panel": {
+            "driver": "axs15260_dsi_6580_hd", "width": 384, "height": 854,
+            "parameter_function_va": "0xffffff800874771c",
+            "mode": "SYNC_EVENT_VDO_MODE", "lanes": 3,
+            "data_format_raw": [0,3,0,0], "packet_stream_selector": 2,
+            "rgb_format_inference": "24-bit RGB888 from PS selector2; stock data_format enum3 differs from provided BSP enum and needs exact-stock DSI confirmation",
+            "pll_clock_mhz": 210,
+            "vertical": {"sync": 2, "back_porch": 20, "front_porch": 170, "active": 854},
+            "horizontal": {"sync": 20, "back_porch": 180, "front_porch": 180, "active": 384},
+            "reset_sequence": [{"level":1,"delay_ms":20},{"level":0,"delay_ms":20},{"level":1,"delay_ms":100}],
+            "init": elf.table(0xffffff800983e9f8, 8),
+            "suspend": elf.table(0xffffff800983ec38, 5),
+            "proximity_resume": elf.table(0xffffff800983eda0, 5),
+            "id": {"commands": [0xda, 0xdb, 0xdc], "expected_bytes": "005260", "stock_va": "0xffffff8008747928"},
+            "bias": {"slave_address": 0x3e, "register_writes": [[0,0x12],[1,0x12]], "stock_va": "0xffffff8008747ae8"},
+        },
+        "touch": {
+            "i2c_bus": 0, "i2c_mmio": "0x11007000", "slave_address": 0x3b,
+            "address_override_va": "0xffffff8008a25efc",
+            "packet_read": "single 32-byte I2C read; no register prefix",
+            "packet_length_va": "0xffffff8008a26610",
+            "packet_parse_va": "0xffffff8008a26db4",
+            "contacts_max": 5, "record_offset": 2, "record_stride": 6,
+            "header": "byte0=0; byte1 high nibble=0; byte1 low nibble count clamped to5; id>=5 ends records",
+            "record": {"x":"((b0&15)<<8)|b1", "y":"((b2&15)<<8)|b3", "event":"b0>>6", "id":"b2>>4", "pressure":"b4", "area":"b5>>4"},
+            "event": {"0":"down", "1":"up", "2":"contact", "3":"not reported active"},
+            "zero_contact_packet": "release all active contacts",
+            "version_read": {"write_hex":"0c", "read_bytes":2, "byte_order":"big", "stock_va":"0xffffff8008a25ac4"},
+            "reset_sequence": [{"level":1,"delay_us_min":1000,"delay_us_max":1100},{"level":0,"delay_us_min":10000,"delay_us_max":11000},{"level":1,"delay_ms":20}],
+            "irq_flags": "IRQF_ONESHOT | IRQF_TRIGGER_FALLING (0x2002)",
+            "firmware": {"stock_va":"0xffffff80090e0ce9", "length":len(fw), "sha256":hashlib.sha256(fw).hexdigest(), "version_bytes_at_0x7634":fw[0x7634:0x7636].hex(), "upgrade":"flash init/erase/write/read-check, not RAM-only; not performed by these tools"},
+        },
+        "dt_candidates_not_live_verified": {
+            "panel_reset_gpio":45, "panel_bias_enable_gpio":150,
+            "panel_bias_i2c_bus":5, "panel_bias_i2c_mmio":"0x11016000",
+            "touch_reset_gpio":174,"touch_interrupt_gpio":0,
+            "touch_supply":"MT6357 vldo28",
+            "caution":"stock DT overlay contains stale panel identity/resolution; pin mappings require LK final-DT or physical confirmation",
+        },
+        "brightness": {
+            "mode_evidence":"static DT overlay led@6 led_mode5; provided BSP maps5 to MT65XX_LED_MODE_CUST_BLS_PWM",
+            "pwm_mmio":"0x1100e000", "pwm_mmio_source":"stock boot DT disp_pwm@1100e000",
+            "stock_maximum":struct.unpack("<I",elf.read(0xffffff80098423f4,4))[0],
+            "stock_set_function":"0xffffff80087f9250",
+            "stock_direct_write_vas":["0xffffff80087f9550","0xffffff80087f9658","0xffffff80087f97d0"],
+            "register_offsets":{"enable":"0x00","commit":"0x0c","divider":"0x18","period_and_duty":"0x1c"},
+            "register_fields":{"enable":"bit0", "divider":"bits25:16", "period":"bits9:0=1023", "duty":"bits28:16"},
+            "zero_brightness":"write duty1, clear enable bit0; commit1 then0",
+            "nonzero_brightness":"clamp0..maximum, write duty, set enable bit0; commit1 then0",
+            "dt_pwm_config":{"clock_source_request":0,"divider":3},
+            "pwm_source_request_to_parent":{"0":"ULPOSC1_D8","1":"ULPOSC1_D2","2":"UNIVPLL2_D4","3":"26MHz"},
+            "pwm_hardware_mux_encoding_to_parent":{"0":"26MHz","1":"UNIVPLL2_D4","2":"ULPOSC1_D2","3":"ULPOSC1_D8"},
+            "clock_mapping_source":"provided BSP kernel-4.14 drivers/misc/mediatek/video/mt6765/dispsys/ddp_pwm_mux.c and drivers/clk/mediatek/clk-mt6765.c; not live verified",
+            "limits":["No physical brightness writes or register reads performed", "Exported Android brightness does not reveal PWM duty/clock state", "PWM output pin and external backlight IC identity remain unverified", "Clock/rail/pin ownership must precede native register access"],
+        },
+        "display_clock_table":{"stock_va":"0xffffff800983f658","entry_stride":32,"entries":display_clocks},
+        "historical_handoff_not_current": {
+            "framebuffer_base":"0x7ef90000", "reservation_size":"0x470000",
+            "advertised_vram_size":4653056, "fps_raw":6184,
+            "source":"retained expdb LK boot logs; no live register or scanout-format verification",
+        },
+        "unknown": ["live panel scanout physical address/stride/pixel format", "LK final DT pin and regulator overrides", "AXS current flash version and reason both old boots reflash", "physical I2C transfer and interrupt behavior"],
+    }
+    (args.output / "facts.json").write_text(json.dumps(facts, indent=2)+"\n")
+    if args.extract_touch_firmware:
+        (args.output / "axs-firmware.bin").write_bytes(fw)
+    print(json.dumps({"facts":str(args.output / "facts.json"),"touch_firmware_sha256":facts["touch"]["firmware"]["sha256"]}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/mt6762/hardware/display-touch/mt6762_display_core.h b/tools/mt6762/hardware/display-touch/mt6762_display_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..4a42ac43c102b0f55693bd9c37b99a4299f0f185
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/mt6762_display_core.h
@@ -0,0 +1,127 @@
+/* SPDX-License-Identifier: MIT
+ * Narrow inherited OVL0/BGRA8888 scanout validation and DISP_PWM duty update.
+ * Register definitions: supplied MT6765 BSP ddp_reg_ovl.h/ddp_reg_dma.h,
+ * ddp_info.h, ddp_reg_dsi.h, clk-mt6765-pg.c; stock PWM addresses in audit JSON.
+ * This does not initialize clocks, rails, DSI, M4U or a panel.
+ */
+#ifndef MT6762_DISPLAY_CORE_H
+#define MT6762_DISPLAY_CORE_H
+#include <stdint.h>
+#include <stddef.h>
+struct mt6762_fb_layout {
+    uint64_t physical, size, reserved_base, reserved_size;
+    uint32_t width, height, stride, format, layer;
+};
+static inline int mt6762_fb_bounds(const struct mt6762_fb_layout *f)
+{
+    if (!f || f->width != 384 || f->height != 854 || f->format != 1 || f->layer > 3 ||
+        f->stride < f->width * 4 || f->stride > 65535 || (f->stride & 3) ||
+        !f->physical || (f->physical & 0x3fff) || f->physical > UINT32_MAX ||
+        (f->reserved_base & 0x3fff) || (f->reserved_size & 0x3fff) ||
+        f->size > 16 * 1024 * 1024 ||
+        (((uint64_t)f->stride * f->height + 0x3fff) & ~UINT64_C(0x3fff)) > f->size ||
+        f->physical < f->reserved_base || f->size > f->reserved_size ||
+        f->physical - f->reserved_base > f->reserved_size - f->size ||
+        f->size > (uint64_t)UINT32_MAX + 1 - f->physical ||
+        f->reserved_size > UINT64_MAX - f->reserved_base) return 0;
+    return 1;
+}
+static inline int mt6762_display_power(uint32_t status, uint32_t status2, uint32_t con)
+{
+    /* Both status copies ON, reset released, power bits ON, isolation/clock
+     * disable/SRAM powerdown/SRAM acknowledgement all clear. */
+    return (status & 8) && (status2 & 8) && (con & 0x111f) == 0x0d;
+}
+struct mt6762_ovl_snapshot {
+    uint32_t en, sources, ext_sources, roi, con, address, pitch, size, offset, clip, rdma;
+    uint32_t downstream_rdma, dsi_start, dsi_mode, dsi_lanes, dsi_active;
+    uint32_t dsi_ps, dsi_vsa, dsi_vbp, dsi_vfp;
+};
+static inline int mt6762_ovl_matches_sources(const struct mt6762_fb_layout *f,
+    const struct mt6762_ovl_snapshot *s, uint32_t sources)
+{
+    uint32_t dimensions = f->width | (f->height << 16);
+    /* Reject rotation, colour keys, matrix conversion, local/constant source,
+     * extended layers, manual format and byte/RGB swaps. Alpha is opaque or
+     * disabled. Only the one known memory layer may contribute to scanout. */
+    return mt6762_fb_bounds(f) && (s->en & 1) && s->sources == sources &&
+        !(s->ext_sources & 7) && s->roi == dimensions &&
+        (s->con & 0xfffffe00u) == 0x2000 && (!(s->con & 0x100) || (s->con & 255) == 255) &&
+        s->address == f->physical && s->pitch == f->stride &&
+        s->size == dimensions && !s->offset && !s->clip && (s->rdma & 1) &&
+        (s->downstream_rdma & 0x13) == 1 && /* RDMA direct-link, no reset */
+        (s->dsi_start & 1) && (s->dsi_mode & 0x1f0303) == 2 &&
+        ((s->dsi_lanes >> 2) & 15) == 7 && (s->dsi_active & 0x3fff) == f->height &&
+        /* DSI_PS_Control remaps enum RGB888=2 to hardware selector5-2=3. */
+        (s->dsi_ps & 0x03077fffu) == ((3u << 16) | 1152) &&
+        s->dsi_vsa == 2 && s->dsi_vbp == 20 && s->dsi_vfp == 170;
+}
+static inline int mt6762_ovl_matches(const struct mt6762_fb_layout *f,
+    const struct mt6762_ovl_snapshot *s)
+{
+    return f->layer <= 3 && mt6762_ovl_matches_sources(f, s, 1u << f->layer);
+}
+/* Exact inherited LK menu profile measured in capture9. Both memory layers
+ * must be full-size BGRA within the independently reserved allocation. The
+ * caller additionally validates global datapath/cache controls and renders
+ * opaque pixels into layer1. This is not native display ownership. */
+static inline uint64_t mt6762_boot_menu_buffer(uint64_t base, uint64_t reserved_size,
+    const struct mt6762_ovl_snapshot *layers)
+{
+    struct mt6762_fb_layout f = {base, 0x144000, base, reserved_size, 384, 854, 1536, 1, 0};
+    if (reserved_size < 2 * UINT64_C(0x144000) ||
+        !mt6762_ovl_matches_sources(&f, &layers[0], 3) || layers[0].con != 0x21ff ||
+        layers[0].ext_sources != 0) return 0;
+    f.physical += 0x144000; f.layer = 1;
+    if (!mt6762_ovl_matches_sources(&f, &layers[1], 3) || layers[1].con != 0x21ff ||
+        layers[1].ext_sources != 0) return 0;
+    return f.physical;
+}
+struct mt6762_pwm_io {
+    void *context;
+    uint32_t (*read)(void *, unsigned offset);
+    void (*write)(void *, unsigned offset, uint32_t value);
+    void (*barrier)(void *);
+};
+static inline int mt6762_display_datapath(uint32_t datapath, uint32_t sbch)
+{
+    return !sbch && (!(datapath & ~UINT32_C(0x05000009)) ||
+        datapath == UINT32_C(0x81000001));
+}
+/* Exact LK profile measured twice in physical capture13. Preserve its 26MHz
+ * source, divider0 and pin43 mux1. Duty/enable may vary through the API; all
+ * configuration, shadow/commit and debug fields must retain this profile. */
+struct mt6762_pwm_snapshot {
+    uint32_t top, infra, gpio, enable, commit, con0, con1, debug;
+};
+static inline int mt6762_pwm_lk_configured(const struct mt6762_pwm_snapshot *s)
+{
+    return s && !(s->top & UINT32_C(0x83000000)) && !(s->infra & 4) &&
+        ((s->gpio >> 12) & 15) == 1 && !(s->enable & ~1u) &&
+        !s->commit && !s->con0 && !s->debug &&
+        !(s->con1 & ~UINT32_C(0x1fff03ff)) &&
+        (s->con1 & 1023) == 1023 && ((s->con1 >> 16) & 0x1fff) <= 1023;
+}
+static inline int mt6762_pwm_configured(uint32_t con0, uint32_t con1,
+    uint32_t top, uint32_t infra)
+{
+    return ((con0 >> 16) & 1023) == 3 && (con1 & 1023) == 1023 &&
+        !(top & 0x80000000u) && ((top >> 24) & 3) == 3 && !(infra & 4);
+}
+static inline int mt6762_pwm_program(const struct mt6762_pwm_io *io, unsigned level)
+{
+    if (!io || !io->read || !io->write || !io->barrier || level > 1023) return -1;
+    uint32_t con1 = io->read(io->context, 0x1c);
+    uint32_t en = io->read(io->context, 0);
+    /* Period remains1023. Reject a changed configuration before any write. */
+    if ((con1 & 1023) != 1023) return -1;
+    con1 = (con1 & ~0x1fff0000u) | ((level ? level : 1) << 16);
+    en = (en & ~1u) | (level != 0);
+    io->write(io->context, 0x1c, con1); io->barrier(io->context);
+    io->write(io->context, 0, en); io->barrier(io->context);
+    io->write(io->context, 0x0c, 1); io->barrier(io->context);
+    io->write(io->context, 0x0c, 0); io->barrier(io->context);
+    return ((io->read(io->context, 0x1c) & 0x1fff03ffu) == (con1 & 0x1fff03ffu) &&
+        (io->read(io->context, 0) & 1) == (en & 1)) ? 0 : -1;
+}
+#endif
diff --git a/tools/mt6762/hardware/display-touch/mt6762_dsi_vm_core.h b/tools/mt6762/hardware/display-touch/mt6762_dsi_vm_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..54fa32e0c897e5191c8d1aa77f77c6510c612367
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/mt6762_dsi_vm_core.h
@@ -0,0 +1,118 @@
+/* SPDX-License-Identifier: MIT
+ * Experimental, unwired MT6765 DSI video-mode short-command transport.
+ * Register/packet evidence: panel-lifecycle-audit.json. This is not an
+ * initialized native driver and does not establish a safe panel sleep cycle.
+ */
+#ifndef MT6762_DSI_VM_CORE_H
+#define MT6762_DSI_VM_CORE_H
+#include <stdint.h>
+#include <stddef.h>
+struct mt6762_dsi_vm_io {
+    void *context;
+    /* Must verify exclusive DSI/GCE/IRQ-ack ownership, initialized powered
+     * clocks/PHY/video timing, preserved rails/reset and usable MMIO. A bare
+     * DT boolean is insufficient. Return0 only for admitted hardware state. */
+    int (*verify_owned_inherited)(void *);
+    /* First-command admission must separately establish that no inherited VM
+     * request is in flight. Ownership, START low and stale DONE are each
+     * insufficient. No physical implementation of this proof exists here.
+     * Return0 only after an external, verified idle handoff/drain protocol. */
+    int (*admit_initial_idle)(void *);
+    uint32_t (*read32)(void *, unsigned);
+    void (*write32)(void *, unsigned, uint32_t);
+    void (*barrier)(void *);
+    void (*delay_us)(void *, unsigned);
+};
+/* Initialize to zero once per admitted ownership lifetime. Do not clear a
+ * fault/reseed this state to bypass a pending inherited request. */
+struct mt6762_dsi_vm_state {
+    unsigned faulted, own_completed;
+    uint32_t completed_packet;
+};
+enum { MT6762_DSI_ARGUMENT = -1, MT6762_DSI_UNAVAILABLE = -2,
+       MT6762_DSI_READBACK = -3, MT6762_DSI_TIMEOUT = -4 };
+#define MT6762_DSI_VM_DONE UINT32_C(0x20)
+#define MT6762_DSI_VM_START UINT32_C(0x10000)
+
+/* Only the exact stock short DCS command+one-zero-byte form. Long vendor
+ * initialization packets, reads/BTA, command mode and dual DSI are excluded.
+ * Caller serializes all invocations and supplies a validated timeout budget.
+ * MMIO that never returns cannot be recovered by this bounded poll loop. */
+static inline int mt6762_dsi_vm_short_zero(struct mt6762_dsi_vm_state *s,
+    const struct mt6762_dsi_vm_io *io, uint8_t command,
+    unsigned poll_us, unsigned polls)
+{
+    if (!s || !io || !io->verify_owned_inherited || !io->admit_initial_idle || !io->read32 || !io->write32 ||
+        !io->barrier || !io->delay_us || !poll_us || !polls ||
+        (uint64_t)poll_us * polls > UINT64_C(1000000) ||
+        (command != 0x10 && command != 0x11 && command != 0x28 && command != 0x29))
+        return MT6762_DSI_ARGUMENT;
+    if (s->faulted) return MT6762_DSI_UNAVAILABLE;
+    if (io->verify_owned_inherited(io->context)) goto unavailable;
+    uint32_t mode = io->read32(io->context, 0x14);
+    uint32_t control = io->read32(io->context, 0x130);
+    uint32_t start = io->read32(io->context, 0x00);
+    uint32_t initial_status = io->read32(io->context, 0x0c);
+    /* A high inherited trigger may still own the command slot even if stale
+     * DONE is high. Only retain our own fully completed/acknowledged trigger.
+     * Low START alone does not prove an idle command engine either. */
+    if (!s->own_completed) {
+        if ((start & MT6762_DSI_VM_START) || io->admit_initial_idle(io->context)) goto unavailable;
+    } else if (control != s->completed_packet || (initial_status & MT6762_DSI_VM_DONE)) {
+        goto unavailable;
+    }
+    /* SYNC_EVENT video mode, VM commands already enabled during VFP. The
+     * transport neither enables this facility nor changes video timing. */
+    if ((mode & 3) != 2 || (control & 0x3d) != 0x21 || (start & UINT32_C(0x14)) ||
+        (io->read32(io->context, 0x04) & 0xf2) ||
+        (initial_status & 0x7080)) goto unavailable;
+    /* Preserve low configuration bits except LONG_PKT. DCS short write with
+     * one parameter has data ID0x15, command in16..23 and zero in24..31. */
+    uint32_t packet = (control & UINT32_C(0xfd)) | UINT32_C(0x1500) |
+        ((uint32_t)command << 16);
+    s->own_completed = 0;
+    io->write32(io->context, 0x130, packet);
+    io->barrier(io->context);
+    if (io->read32(io->context, 0x130) != packet) goto readback;
+    /* INTSTA is write-zero-to-clear, unlike the thermal controller's W1C.
+     * Literal complement preserves all other status, including newly set bits. */
+    io->write32(io->context, 0x0c, ~MT6762_DSI_VM_DONE);
+    io->barrier(io->context);
+    if (io->read32(io->context, 0x0c) & MT6762_DSI_VM_DONE) goto readback;
+    /* Other one-shot requests were rejected before the first write. */
+    io->write32(io->context, 0x00, start & ~MT6762_DSI_VM_START);
+    io->barrier(io->context);
+    io->write32(io->context, 0x00, start | MT6762_DSI_VM_START);
+    io->barrier(io->context);
+    for (unsigned i = 0; i < polls; i++) {
+        if (io->verify_owned_inherited(io->context)) goto unavailable;
+        uint32_t status = io->read32(io->context, 0x0c);
+        if ((status & UINT32_C(0x7080)) ||
+            (io->read32(io->context, 0x04) & 0xf2)) goto unavailable;
+        if (status & MT6762_DSI_VM_DONE) {
+            io->barrier(io->context);
+            if (io->read32(io->context, 0x14) != mode ||
+                io->read32(io->context, 0x130) != packet) goto readback;
+            io->write32(io->context, 0x0c, ~MT6762_DSI_VM_DONE);
+            io->barrier(io->context);
+            uint32_t acknowledged = io->read32(io->context, 0x0c);
+            if (acknowledged & MT6762_DSI_VM_DONE) goto readback;
+            if (acknowledged & UINT32_C(0x7080)) goto unavailable;
+            s->completed_packet = packet;
+            s->own_completed = 1;
+            return 0;
+        }
+        io->delay_us(io->context, poll_us);
+    }
+    s->faulted = 1;
+    return MT6762_DSI_TIMEOUT;
+readback:
+    s->faulted = 1;
+    s->own_completed = 0;
+    return MT6762_DSI_READBACK;
+unavailable:
+    s->faulted = 1;
+    s->own_completed = 0;
+    return MT6762_DSI_UNAVAILABLE;
+}
+#endif
diff --git a/tools/mt6762/hardware/display-touch/mt6762_touch_entry.h b/tools/mt6762/hardware/display-touch/mt6762_touch_entry.h
new file mode 100644
index 0000000000000000000000000000000000000000..9f2c67ad79873b4b5e0e4d11abe88f6af41fe711
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/mt6762_touch_entry.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: MIT -- captured LK touch-bus admission only.
+ * No rail claim: successful version and DMA transactions are still required. */
+#ifndef MT6762_TOUCH_ENTRY_H
+#define MT6762_TOUCH_ENTRY_H
+#include <stdint.h>
+typedef uint32_t (*mt6762_entry_read)(void *,uint32_t,unsigned);
+#define MT6762_TOUCH_ENTRY_REGIONS 9
+static inline uint32_t mt6762_touch_entry_base(unsigned index)
+{
+    static const uint32_t bases[MT6762_TOUCH_ENTRY_REGIONS]={
+        0x10000000,0x10001000,0x10002000,0x10005000,0x1000b000,
+        0x1000c000,0x0c000000,0x11007000,0x11000000};
+    return index<MT6762_TOUCH_ENTRY_REGIONS?bases[index]:0;
+}
+struct mt6762_touch_entry_failure {uint32_t address,mask,expected,actual,pass,width;};
+static inline int mt6762_touch_entry_detail(mt6762_entry_read read,void *ctx,
+    struct mt6762_touch_entry_failure *failure)
+{
+    static const struct {uint32_t address,mask,value;unsigned width;} checks[]={
+        {0x100000a0,0x87,2,4}, {0x10001090,1u<<11,0,4}, {0x10001094,1u<<18,0,4},
+        {0x1000c26c,0xffffffff,0xff800081,4}, {0x1000c270,0xffffffff,0x00180000,4},
+        {0x1000c278,0xffffffff,0x80000001,4},
+        {0x100053a0,0xff00,0x1100,4}, {0x10005020,3u<<18,0,4},
+        {0x10005220,3u<<18,3u<<18,4},
+        {0x10002a30,(1u<<24)|(1u<<22),(1u<<24)|(1u<<22),4},
+        {0x10002a40,(1u<<24)|(1u<<22),0,4},
+        {0x10002a50,(1u<<24)|(1u<<22),(1u<<24)|(1u<<22),4},
+        {0x10002a80,(1u<<11)|(1u<<9),(1u<<11)|(1u<<9),4},
+        {0x10005450,0x0f000000,0,4}, {0x10005050,1u<<14,1u<<14,4},
+        {0x10005150,1u<<14,1u<<14,4}, {0x10005250,1u<<14,1u<<14,4},
+        {0x10005300,15,0,4}, {0x10005000,1,0,4}, {0x10005200,1,1,4},
+        {0x1000b000,1,0,4}, {0x1000b080,1,1,4}, {0x1000b200,1,0,4}, {0x1000b400,1,0,4},
+        {0x0c000000,0x80000000,0,4}, {0x0c00010c,1u<<20,0,4}, {0x0c00030c,1u<<20,0,4},
+        {0x11007024,1,0,2}, {0x1100700c,0x1ff,0,2},
+        {0x11000080,0xffffffff,0,4}, {0x11000088,0xffffffff,0,4},
+        {0x1100009c,0xffffffff,0,4}, {0x110000a0,0xffffffff,0,4},
+        {0x110000a4,0xffffffff,0,4}, {0x110000a8,0xffffffff,0,4},
+        {0x110000d4,0xffffffff,0,4}, {0x110000d8,0xffffffff,0,4},
+    };
+    /* Clock checks come first, before accessing controller and DMA registers.
+     * GIC pending116 is intentionally ignored; that line remains masked. */
+    for(unsigned pass=0;pass<2;pass++)
+        for(unsigned n=0;n<sizeof(checks)/sizeof(checks[0]);n++) {
+            uint32_t actual=read(ctx,checks[n].address,checks[n].width);
+            if((actual&checks[n].mask)!=checks[n].value) {
+                if(failure)*failure=(struct mt6762_touch_entry_failure){checks[n].address,
+                    checks[n].mask,checks[n].value,actual,pass,checks[n].width};
+                return 0;
+            }
+        }
+    return 1;
+}
+static inline int mt6762_touch_entry_ok(mt6762_entry_read read,void *ctx)
+{return mt6762_touch_entry_detail(read,ctx,0);}
+#endif
