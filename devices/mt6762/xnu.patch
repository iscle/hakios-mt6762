+/* SPDX-License-Identifier: MIT */
+#ifndef MT6762_PSCI_FDT_H
+#define MT6762_PSCI_FDT_H
+#include <stddef.h>
+#include <stdint.h>
+struct mtk_psci_topology {uint32_t count,mpidr[8],smc,observed_count;};
+/* Validate the complete live FDT through the existing bounded parser, then
+ * admit only this phone's observed 8-A53, 2x4 topology and PSCI 1.0/SMC binding.
+ * requested must be 2, 4 or 8; boot MPIDR Aff3..0 must be 0. Output is zero on error.
+ * Only RES1 bit 31/MT bit 24 may differ; U bit 30 is rejected.
+ * This establishes topology, NOT firmware CPU_ON support or coherent startup.
+ * Kernel 54 queries VERSION/FEATURES/AFFINITY_INFO again before every CPU_ON. */
+int mtk_psci_fdt_topology(const void *blob,size_t accessible,uint64_t boot_mpidr,
+    unsigned requested,struct mtk_psci_topology *out);
+#endif
diff --git a/tools/mt6762/physical/psci/test_psci_fdt.py b/tools/mt6762/physical/psci/test_psci_fdt.py
new file mode 100644
index 0000000000000000000000000000000000000000..68bfeb8d1ae76ef3580af7ff07d6d6ca5d31fa85
--- /dev/null
+++ b/tools/mt6762/physical/psci/test_psci_fdt.py
@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""Bounded live-topology admission; synthetic fixtures, no hardware operations."""
+import ctypes as C
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+HERE=Path(__file__).resolve().parent
+sys.path.insert(0,str(HERE.parent))
+from test_fdt_handoff import node,fdt,U32,U64
+
+class Topology(C.Structure):
+    _fields_=[('count',C.c_uint32),('mpidr',C.c_uint32*8),('smc',C.c_uint32),('observed_count',C.c_uint32)]
+def cpu(reg, extra=(), replace=None):
+    props={'compatible':b'arm,cortex-a53\0','device_type':b'cpu\0','reg':U32(reg),'enable-method':b'psci\0'}
+    props.update(replace or {})
+    return node('cpu@%03x'%reg,list(props.items())+list(extra))
+def tree(cpus=None,cpu_props=None,psci_props=None,extra=(),compatible=b'mediatek,MT6765\0'):
+    if cpus is None:cpus=[cpu(x) for x in (0,1,2,3,0x100,0x101,0x102,0x103)]
+    if cpu_props is None:cpu_props=[('#address-cells',U32(1)),('#size-cells',U32(0))]
+    if psci_props is None:psci_props=[('compatible',b'arm,psci-1.0\0'),('method',b'smc\0')]
+    return node('',[('#address-cells',U32(2)),('#size-cells',U32(2)),('compatible',compatible)],[
+        node('memory@40000000',[('device_type',b'memory\0'),('reg',U64(0x40000000)+U64(0xc0000000))]),
+        node('cpus',cpu_props,cpus),node('psci',psci_props)]+list(extra))
+class Tests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp=tempfile.TemporaryDirectory();cls.addClassCleanup(cls.tmp.cleanup)
+        so=Path(cls.tmp.name)/'psci.so'
+        subprocess.run(['cc','-std=c11','-O2','-Wall','-Wextra','-Werror','-ffreestanding','-shared','-fPIC',str(HERE/'psci_fdt.c'),str(HERE.parent/'fdt_handoff.c'),'-o',str(so)],check=True)
+        cls.lib=C.CDLL(str(so));cls.lib.mtk_psci_fdt_topology.argtypes=[C.c_void_p,C.c_size_t,C.c_uint64,C.c_uint,C.POINTER(Topology)]
+    def parse(self,blob=None,requested=2,mpidr=0x80000000):
+        if blob is None:blob=fdt(tree())
+        buf=C.create_string_buffer(blob);out=Topology();C.memset(C.byref(out),0xa5,C.sizeof(out))
+        rc=self.lib.mtk_psci_fdt_topology(buf,len(blob),mpidr,requested,C.byref(out))
+        if rc:self.assertEqual(bytes(out),bytes(C.sizeof(out)))
+        return rc,out
+    def reject(self,**kw):self.assertNotEqual(self.parse(**kw)[0],0)
+    def test_two_four_eight_and_node_order(self):
+        regs=[0,1,2,3,0x100,0x101,0x102,0x103]
+        for requested in (2,4,8):
+            for order in (regs,list(reversed(regs))):
+                rc,t=self.parse(fdt(tree(cpus=[cpu(x) for x in order])),requested)
+                self.assertEqual(rc,0);self.assertEqual(t.count,requested);self.assertEqual(t.observed_count,8);self.assertEqual(t.smc,1)
+                self.assertEqual(list(t.mpidr),regs[:requested]+[0]*(8-requested))
+    def test_architectural_mpidr_flags(self):
+        for value in (0,0x80000000,0x81000000,0x01000000):self.assertEqual(self.parse(mpidr=value)[0],0)
+        for value in (1,0x100,0x10000,0x100000000,0x40000000,1<<63):self.reject(mpidr=value)
+    def test_missing_duplicate_extra_cpu(self):
+        regs=[0,1,2,3,0x100,0x101,0x102,0x103]
+        for nodes in ([cpu(x) for x in regs[:-1]],[cpu(x) for x in regs]+[cpu(0)],
+            [cpu(x) for x in regs]+[node('mystery',[('device_type',b'cpu\0')])]):self.reject(blob=fdt(tree(cpus=nodes)))
+    def test_cpu_contract(self):
+        for change in ({'status':b'disabled\0'},{'compatible':b'arm,cortex-a55\0'},{'device_type':b'other\0'},
+            {'reg':U32(4)},{'reg':U64(0)},{'enable-method':b'spin-table\0'},{'enable-method':b'psci'}):
+            nodes=[cpu(0,replace=change)]+[cpu(x) for x in (1,2,3,0x100,0x101,0x102,0x103)]
+            self.reject(blob=fdt(tree(cpus=nodes)))
+        nodes=[cpu(0,extra=[('reg',U32(0))])]+[cpu(x) for x in (1,2,3,0x100,0x101,0x102,0x103)]
+        self.reject(blob=fdt(tree(cpus=nodes)))
+    def test_cells_and_psci(self):
+        for cells in ((2,0),(1,1)):
+            self.reject(blob=fdt(tree(cpu_props=[('#address-cells',U32(cells[0])),('#size-cells',U32(cells[1]))])))
+        for props in ([('compatible',b'arm,psci-1.0\0'),('method',b'hvc\0')],
+            [('compatible',b'arm,psci-1.0\0')],[('compatible',b'arm,psci-0.2\0'),('method',b'smc\0')],
+            [('compatible',b'arm,psci-1.0\0'),('method',b'smc\0'),('method',b'smc\0')]):
+            self.reject(blob=fdt(tree(psci_props=props)))
+        self.reject(blob=fdt(tree(extra=[node('psci')])));self.reject(blob=fdt(tree(extra=[node('cpus')])))
+    def test_board_and_count(self):
+        self.reject(blob=fdt(tree(compatible=b'mediatek,other\0')))
+        for requested in (0,1,3,5,7,9,0xffffffff):self.reject(requested=requested)
+        self.assertEqual(self.parse(fdt(tree(compatible=b'mediatek,MT6762\0')))[0],0)
+    def test_truncation_and_corrupt_header(self):
+        b=fdt(tree())
+        for n in (0,4,39,40,len(b)-1):self.reject(blob=b[:n])
+        self.reject(blob=b'BAD!'+b[4:])
+    @unittest.skipUnless(os.environ.get('MTK_PSCI_TEST_DTB'),'optional private captured DTB')
+    def test_actual_capture(self):
+        b=Path(os.environ['MTK_PSCI_TEST_DTB']).read_bytes()
+        for requested in (2,4,8):self.assertEqual(self.parse(b,requested)[0],0)
+if __name__=='__main__':unittest.main()
diff --git a/tools/mt6762/physical/psci/test_secondary.py b/tools/mt6762/physical/psci/test_secondary.py
new file mode 100644
index 0000000000000000000000000000000000000000..03540a0d877da66fd4c8e4ebc1cf5c497fbbc2c3
--- /dev/null
+++ b/tools/mt6762/physical/psci/test_secondary.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Compile actual MT6762 entry block; execute with modeled system registers.
+
+Ordinary instructions/branches are original assembled bytes. MRS/MSR/ERET and
+barriers are explicitly modeled: this does not prove physical EL2/GIC behavior.
+"""
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+from capstone import Cs, CS_ARCH_ARM64, CS_MODE_ARM
+from elftools.elf.elffile import ELFFile
+from unicorn import Uc, UC_ARCH_ARM64, UC_MODE_ARM, UC_HOOK_CODE, UC_HOOK_MEM_WRITE
+from unicorn import arm64_const as regs
+
+ROOT=Path(__file__).resolve().parents[4]
+text=(ROOT/'osfmk/arm64/start.s').read_text()
+block=text.split('/* MT6762_PSCI_EL2_BEGIN:',1)[1].split('/* MT6762_PSCI_EL2_END */',1)[0]
+block=block.split('*/',1)[1]
+block=block.replace('EXT(LowSecondaryExceptionVectorBase)@pageoff',':lo12:LowSecondaryExceptionVectorBase')
+block=block.replace('EXT(LowSecondaryExceptionVectorBase)@page','LowSecondaryExceptionVectorBase')
+source='.arch armv8-a\n.text\n.global _start\n_start:\n'+block+'\n.global test_end\ntest_end:\nnop\n.balign 2048\nLowSecondaryExceptionVectorBase:\nnop\n'
+clang=os.environ.get('IOS_CC','/home/iscle/mt6762-ios-port/toolchain/bin/clang')
+with tempfile.TemporaryDirectory(prefix='mt6762-secondary-') as directory:
+    path=Path(directory);(path/'test.s').write_text(source)
+    subprocess.run([clang,'--target=aarch64-none-elf','-nostdlib','-fuse-ld=lld',
+                    '-Wl,-Ttext=0x40000000','-Wl,--entry=_start',str(path/'test.s'),'-o',str(path/'test.elf')],check=True)
+    with (path/'test.elf').open('rb') as stream:
+        elf=ELFFile(stream)
+        section=elf.get_section_by_name('.text');data=section.data();base=section['sh_addr']
+        symbols={s.name:s['st_value'] for s in elf.get_section_by_name('.symtab').iter_symbols()}
+md=Cs(CS_ARCH_ARM64,CS_MODE_ARM)
+instructions={i.address:i for i in md.disasm(data,base)}
+
+def run(el=8,sctlr=0,gic=1,pmu=1,sre_failure=False):
+    u=Uc(UC_ARCH_ARM64,UC_MODE_ARM);u.mem_map(base,0x10000);u.mem_write(base,data)
+    context=0x1122334455667788;u.reg_write(regs.UC_ARM64_REG_X0,context)
+    system={'currentel':el,'sctlr_el2':sctlr,'cnthctl_el2':0x10,
+            'id_aa64pfr0_el1':gic<<24,'icc_sre_el2':0,
+            'midr_el1':0x410fd034,'mpidr_el1':0x80000103,
+            'id_aa64dfr0_el1':pmu<<8,'pmcr_el0':6<<11}
+    writes=[];reads=[];memory=[];eret=[];halt=[]
+    def register(name):return getattr(regs,'UC_ARM64_REG_'+name.upper())
+    def code(cpu,address,size,unused):
+        if address==symbols['test_end']:cpu.emu_stop();return
+        i=instructions[address];op=[x.strip() for x in i.op_str.split(',')]
+        if i.mnemonic=='mrs':
+            name=op[1].lower();reads.append(name)
+            value=system[name]
+            if name=='icc_sre_el2' and sre_failure:value=0
+            cpu.reg_write(register(op[0]),value);cpu.reg_write(regs.UC_ARM64_REG_PC,address+4)
+        elif i.mnemonic=='msr':
+            name=op[0].lower();value=0 if op[1]=='xzr' else cpu.reg_read(register(op[1]))
+            system[name]=value;writes.append((name,value));cpu.reg_write(regs.UC_ARM64_REG_PC,address+4)
+        elif i.mnemonic=='eret':
+            eret.append(system['spsr_el2']);system['currentel']=4
+            cpu.reg_write(regs.UC_ARM64_REG_PC,system['elr_el2'])
+        elif i.mnemonic in ('dsb','isb','ic'):
+            cpu.reg_write(regs.UC_ARM64_REG_PC,address+4)
+        elif i.mnemonic=='wfe':halt.append(True);cpu.emu_stop()
+    u.hook_add(UC_HOOK_CODE,code)
+    u.hook_add(UC_HOOK_MEM_WRITE,lambda cpu,access,address,size,value,unused:memory.append(address))
+    u.emu_start(base,base+len(data),count=500)
+    assert u.reg_read(regs.UC_ARM64_REG_X0)==context and not memory
+    good=el==4 or (el==8 and not(sctlr&((1<<0)|(1<<2)|(1<<25))) and not(gic and sre_failure))
+    assert bool(halt)!=good
+    if el==4:assert not writes and not eret
+    elif good:
+        assert eret==[0x3c5] and system['currentel']==4
+        for key,value in {'hcr_el2':1<<31,'cnthctl_el2':0x13,'cntvoff_el2':0,
+                          'sctlr_el1':0x30d00800,'cptr_el2':0x33ff,'hstr_el2':0,
+                          'vttbr_el2':0,'sp_el1':0,'vpidr_el2':0x410fd034,
+                          'vmpidr_el2':0x80000103,'mdcr_el2':6 if pmu else 0}.items():
+            assert system[key]==value,(key,system.get(key))
+        assert system['vbar_el2']==symbols['LowSecondaryExceptionVectorBase']
+    if el not in (4,8) or (el==8 and sctlr&((1<<0)|(1<<2)|(1<<25))):assert not writes
+    if not pmu:assert 'pmcr_el0' not in reads
+    return good
+
+for args in ({'el':4},{},{'gic':0},{'pmu':0},{'sctlr':1<<12},
+             {'el':0},{'el':12},{'sctlr':1},{'sctlr':4},{'sctlr':1<<25},{'sre_failure':True}):run(**args)
+print('PASS11 assembled secondary-entry cases: EL1 passthrough, EL2 descent, x0 preservation, unsafe-state rejection; system registers modeled')
diff --git a/tools/mt6762/physical/pwm_probe.h b/tools/mt6762/physical/pwm_probe.h
new file mode 100644
index 0000000000000000000000000000000000000000..cb45c4422c65b20bc7519d9c9afdba7169d80a8c
--- /dev/null
+++ b/tools/mt6762/physical/pwm_probe.h
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: MIT -- passive bootloader brightness snapshot. */
+#ifndef MTK_PWM_PROBE_H
+#define MTK_PWM_PROBE_H
+#include <stdint.h>
+#include <stddef.h>
+#include "display_probe.h"
+
+/* Groups are marked only after all their reads finish. A snapshot does not
+ * grant ownership, prove the external backlight wiring, or enable any clock. */
+enum pwm_probe_state { PWM_UNTOUCHED, PWM_READING, PWM_UNAVAILABLE, PWM_COMPLETE };
+enum pwm_probe_mask { PWM_POWER=1, PWM_CLOCKS=2, PWM_PIN=4, PWM_ULPOSC=8, PWM_BLOCK=16 };
+struct pwm_probe_snapshot {
+    uint32_t mask, power[3], top, infra, gpio, ulposc;
+    uint32_t enable, commit, con0, con1, debug, reserved[3];
+};
+struct pwm_probe_record {
+    uint8_t magic[8]; uint32_t version, size; uint8_t identity[32];
+    uint32_t state, state_inverse, pass, reserved0;
+    struct pwm_probe_snapshot snapshots[2];
+    uint32_t reserved[16];
+};
+_Static_assert(sizeof(struct pwm_probe_snapshot) == 64, "PWM snapshot size");
+_Static_assert(sizeof(struct pwm_probe_record) == 256, "PWM record size");
+_Static_assert(offsetof(struct pwm_probe_record, snapshots) == 64, "PWM snapshot offset");
+extern volatile struct pwm_probe_record physical_pwm;
+
+static inline void pwm_probe_commit(volatile struct pwm_probe_record *r,
+    const struct display_probe_io *io, uint32_t state)
+{
+    r->state_inverse = ~state;
+    io->barrier(io->context);
+    r->state = state;
+    io->barrier(io->context);
+}
+
+static inline void pwm_probe_capture(const struct display_probe_io *io,
+    volatile struct pwm_probe_record *r)
+{
+    pwm_probe_commit(r, io, PWM_READING);
+    for (unsigned pass = 0; pass < 2; ++pass) {
+        r->pass = pass + 1;
+        volatile struct pwm_probe_snapshot *s = &r->snapshots[pass];
+#define R(address) io->read(io->context, (address))
+        s->power[0] = R(0x10006180);
+        s->power[1] = R(0x10006184);
+        s->power[2] = R(0x1000630c);
+        s->mask |= PWM_POWER;
+        /* Always-on clock/pin registers precede any peripheral-block access. */
+        s->top = R(0x10000080);
+        s->infra = R(0x100010ac);
+        s->mask |= PWM_CLOCKS;
+        s->gpio = R(0x10005350); /* GPIO43: MODE bits15:12, DISP_PWM mux1. */
+        s->mask |= PWM_PIN;
+        if (!mt6762_display_power(s->power[0], s->power[1], s->power[2]) ||
+            (s->top & (1u << 31)) || (s->infra & (1u << 2))) goto unavailable;
+        if (((s->top >> 24) & 3) >= 2) {
+            s->ulposc = R(0x10006458);
+            s->mask |= PWM_ULPOSC;
+            if ((s->ulposc & 5) != 5) goto unavailable;
+        }
+        /* Only passive register reads. COMMIT and DEBUG are not written. */
+        s->enable = R(0x1100e000);
+        s->commit = R(0x1100e00c);
+        s->con0 = R(0x1100e018);
+        s->con1 = R(0x1100e01c);
+        s->debug = R(0x1100e080);
+        s->mask |= PWM_BLOCK;
+        io->barrier(io->context);
+#undef R
+    }
+    pwm_probe_commit(r, io, PWM_COMPLETE);
+    return;
+unavailable:
+    pwm_probe_commit(r, io, PWM_UNAVAILABLE);
+}
+#endif
diff --git a/tools/mt6762/physical/pwm_record.py b/tools/mt6762/physical/pwm_record.py
new file mode 100644
index 0000000000000000000000000000000000000000..a93a88f234b7fe87df8e2a7f0170eb528b1dc1ba
--- /dev/null
+++ b/tools/mt6762/physical/pwm_record.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""Decode passive brightness snapshots; no inferred native ownership."""
+import argparse
+import json
+from pathlib import Path
+import struct
+
+OFFSET, ADDRESS, SIZE = 0x4300, 0x40084300, 256
+MAGIC = b'MTKPWM01'
+STATES = ('untouched', 'reading-incomplete', 'unavailable', 'complete')
+FIELDS = ('mask','power0','power1','power_control','top','infra','gpio','ulposc',
+          'enable','commit','con0','con1','debug')
+
+
+def initialized(identity):
+    if len(identity) != 32:
+        raise ValueError('32-byte build identity required')
+    return (MAGIC + struct.pack('<II', 1, SIZE) + identity +
+            struct.pack('<4I', 0, 0xffffffff, 0, 0) + bytes(SIZE - 64))
+
+
+def decode(data, identity):
+    if len(data) != SIZE or len(identity) != 32:
+        raise ValueError('exact PWM record and identity sizes required')
+    if data[:16] != MAGIC + struct.pack('<II', 1, SIZE) or data[16:48] != identity:
+        raise ValueError('malformed or different-build PWM record')
+    state, inverse, passes, reserved = struct.unpack_from('<4I', data, 48)
+    if (state >= len(STATES) or state ^ inverse != 0xffffffff or reserved or
+        passes > 2 or any(data[192:]) or any(data[116:128]) or any(data[180:192])):
+        raise ValueError('malformed or torn PWM record')
+    if ((state == 0 and data != initialized(identity)) or
+        (state in (2,3) and passes == 0) or (state == 3 and passes != 2)):
+        raise ValueError('invalid PWM state/pass')
+    observations = []
+    for i in range(2):
+        raw = struct.unpack_from('<16I', data, 64 + i*64)
+        s = dict(zip(FIELDS, raw))
+        mask = s['mask']
+        if mask not in (0,1,3,7,15,23,31) or (i >= passes and any(raw)):
+            raise ValueError('invalid PWM snapshot mask')
+        if state == 3 and mask not in (23,31):
+            raise ValueError('missing completed PWM reads')
+        groups = ((1, ('power0','power1','power_control')),
+                  (2, ('top','infra')), (4, ('gpio',)), (8, ('ulposc',)),
+                  (16, ('enable','commit','con0','con1','debug')))
+        observed = {'read_mask':mask}
+        for bit, names in groups:
+            if mask & bit:
+                observed.update({k:s[k] for k in names})
+        if mask & 2:
+            observed['parent_selector'] = (s['top'] >> 24) & 3
+        if mask & 4:
+            observed['gpio43_mode'] = (s['gpio'] >> 12) & 15
+        if mask & 16:
+            observed.update(divider=(s['con0'] >> 16) & 0x3ff,
+                            period=s['con1'] & 0x3ff,
+                            duty=(s['con1'] >> 16) & 0x1fff)
+        if i < passes:
+            observations.append(observed)
+    return dict(state=state, state_name=STATES[state], pass_number=passes,
+                identity=identity.hex(), snapshots=observations,
+                stable_complete=state == 3 and observations[0] == observations[1],
+                native_ownership=False, register_writes=False)
+
+
+if __name__ == '__main__':
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('record',type=Path);p.add_argument('--manifest',type=Path,required=True)
+    a=p.parse_args();identity=bytes.fromhex(json.loads(a.manifest.read_text())['trace']['identity'])
+    print(json.dumps(decode(a.record.read_bytes(),identity),indent=2))
diff --git a/tools/mt6762/physical/recovery-autorestore.rst b/tools/mt6762/physical/recovery-autorestore.rst
new file mode 100644
index 0000000000000000000000000000000000000000..56db338033e73b13c164d7084d854649d80d24eb
--- /dev/null
+++ b/tools/mt6762/physical/recovery-autorestore.rst
@@ -0,0 +1,55 @@
+Stock Android recovery restoration attempt
+==========================================
+
+Read-only extraction of the exact supplied ``super.bin`` finds a restoration
+service in vendor. Both LP geometry/header/table checksums were validated before
+extracting only system and vendor into a private evidence directory. No Android
+file was changed and no device command was issued.
+
+Exact files and behavior
+------------------------
+
+Vendor ``/etc/init/vendor_flash_recovery.rc`` (89bytes, SHA256
+``d5ac2dc095118cb143443992bdffe2e9925f663efc85120ced1225d5c43218d7``)
+defines ``vendor_flash_recovery`` running ``/vendor/bin/install-recovery.sh``,
+class main, oneshot, without disabled. The system ``/system/etc/init/hw/init.rc``
+starts class main on nonencrypted startup and framework-start decrypt events.
+The shell script (685bytes, SHA256
+``cc62d106bfc0c2716e2c081e4f4df8670cf93193ffa4286fc199914f732d52dd``)
+checks the entire33554432-byte recovery partition and, on mismatch, invokes
+applypatch using the boot partition and ``/vendor/recovery-from-boot.p``.
+The patch exists (7345447bytes, SHA256
+``f4522e79d3f452979bb5b2353f4b1732c9ed994a9ed06474cfc136faac4da74f``).
+Partition paths append ``ro.boot.slot_suffix``; this is ordinary stock behavior.
+
+The script's required recovery SHA1 is
+``a78cf51d20a9fb0d405e41ef50211af07ff52bbd``; its source boot SHA1 is
+``eb7092b92f8921f9a4eb8d1d42907dd72f9d3f89``. Neither matches the saved exact
+stock partitions: stock recovery SHA1 is
+``dbdef42f85b53b3d810edd7ae1fbd2b3dd903bb0`` and stock boot SHA1 is
+``ea090eb65dd5f08fb5bbc213ad89932c75f9934a``. The diagnostic candidate also
+fails the expected recovery hash, so it triggers an attempt if this service runs.
+
+Consequently Android startup has an enabled automatic restoration **attempt**,
+but successful overwriting is not established. The source-hash mismatch can
+prevent patching; no successful current applypatch log or current partition
+readback was obtained in this offline task. The prior candidate readback before
+Android startup must not be presented as proof the candidate remains installed.
+Conversely, this service's existence alone must not be described as proof it
+was overwritten. A fresh recovery readback resolves the uncertainty.
+
+Private evidence and extraction provenance
+-----------------------------------------
+
+Local evidence is under ``hardware/recovery-restoration-audit``: extraction
+metadata, the four selected files, and findings.json. These firmware files and
+full partition images are not source-package artifacts. System occupies
+3790088sectors at super sector2551808; vendor occupies1596536sectors at sector
+6342656 (512-byte sectors). The extracted images have SHA256:
+
+* system: ``171ce3626a37eab8e66584cf2ba5c5bc132965b3d4eef93fa9b1169fb108c194``
+* vendor: ``a37a00f26f0db7256d5254893474fc80e7f3cceaf94beac390754b0ed008ae53``
+
+The files were read using ``debugfs`` without its write option. Product and
+userdata were not extracted or searched. The initial inference of likely
+restoration was explicitly narrowed after checking the mismatching SHA1 values.
