index 0000000000000000000000000000000000000000..94d541cbd832d4ce746c95f8cd2cfeeee5797cb9
--- /dev/null
+++ b/tools/mt6762/hardware/storage/test_msdc_poll_delay.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Compile the native delay wrapper with only ARM YIELD/timer operations mocked."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[4]
+
+
+class PollDelayTest(unittest.TestCase):
+    def test_actual_wrapper_uses_counter_without_scheduler_or_wfe(self):
+        source = (ROOT / "bsd/dev/mt6762_msdc.c").read_text()
+        wrapper = re.search(r"static void delay_us\(void \*unused,uint32_t us\)\n\{.*?\n\}", source, re.S).group()
+        # The replacement is intentionally limited to the one non-host opcode.
+        wrapper = wrapper.replace('__asm__ volatile("yield" ::: "memory");', 'yield_count++;')
+        self.assertNotIn("__asm__", wrapper)
+        prefix = r'''
+#include <stdint.h>
+#include <assert.h>
+static uint64_t now,tick_step;
+static unsigned yield_count,clock_reads;
+#define NSEC_PER_USEC 1000u
+static void clock_interval_to_absolutetime_interval(uint32_t us,uint32_t scale,uint64_t *out)
+{assert(scale==NSEC_PER_USEC);*out=(uint64_t)us*13;}
+static uint64_t mach_absolute_time(void)
+{uint64_t result=now;now+=tick_step;clock_reads++;return result;}
+'''
+        suffix = r'''
+int main(void) {
+    tick_step=1;delay_us(0,1);
+    assert(yield_count==12 && clock_reads==14 && now==14);
+    now=clock_reads=yield_count=0;delay_us(0,0);
+    assert(!yield_count && clock_reads==2);
+    now=clock_reads=yield_count=0;tick_step=10000;delay_us(0,1);
+    assert(!yield_count && clock_reads==2); /* preempted past deadline */
+    now=UINT64_MAX-5;clock_reads=yield_count=0;tick_step=1;delay_us(0,1);
+    assert(yield_count==12 && clock_reads==14); /* modular counter wrap */
+}
+'''
+        with tempfile.TemporaryDirectory() as tmp:
+            path = pathlib.Path(tmp)
+            (path / "wrapper.c").write_text(prefix + wrapper + suffix)
+            subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", str(path / "wrapper.c"), "-o", str(path / "test")], check=True)
+            subprocess.run([str(path / "test")], check=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/mt6762/hardware/watchdog/DECODER.rst b/tools/mt6762/hardware/watchdog/DECODER.rst
new file mode 100644
index 0000000000000000000000000000000000000000..b943d288738b088001bba70407403bbc2a2320d4
--- /dev/null
+++ b/tools/mt6762/hardware/watchdog/DECODER.rst
@@ -0,0 +1,83 @@
+Trial record retrieval and decoding
+===================================
+
+``decode_trial.py`` reads local files only. It requires exactly128bytes and
+validates magic/version, reserved fields, known flags, state-specific fields,
+deadline bounds and timestamp ordering. An expiry must have a nonzero attempt
+count, elapsed time at least the requested deadline and a last-feed gap within
+the producer's10second guard (plus1ns rounding tolerance). State3's out-of-range
+length flag must agree with the observed lengths. Such a flagged length is
+reported as corrupt diagnostic data, never used to read additional memory.
+State2 may contain partial flush metadata and is never called a completed clean.
+There is no CRC or inverse-state pair in this producer ABI: these checks reject
+detectable inconsistencies, but cannot establish that every plausible record
+was atomically captured.
+
+Raw observations
+----------------
+
+``decode_unbound(raw)`` returns validated raw observations with
+``identity_bound=false`` and both attribution fields false, even for state3.
+This is appropriate before provenance has been reviewed. CLI equivalent::
+
+  python3 decode_trial.py trial.bin --unbound
+
+Identity-bound observations
+---------------------------
+
+``decode_bound`` additionally requires the frozen stripped kernel, its unstripped
+symbol artifact, physical Image manifest, raw256-byte loader trace, explicit
+observed record PA and an externally SHA256-pinned binding document. The binding
+document's closed schema is::
+
+  {
+    "format": 1,
+    "kernel_sha256": "<64 lowercase hex>",
+    "symbol_sha256": "<64 lowercase hex>",
+    "image_sha256": "<64 lowercase hex>",
+    "trace_identity": "<64 lowercase hex>",
+    "symbol_va": 18446744005119186240,
+    "physical_address": 3551663424
+  }
+
+The numeric values above are illustrative; derive both for the selected frozen
+build. The independently pinned binding digest must come from the reviewed
+capture configuration, not be calculated from whichever document arrived with
+an unknown capture. The document is the external authority for the paired
+stripped/unstripped artifacts. The decoder verifies their bytes against its
+hashes; it DOES NOT reproduce stripping or prove that relationship on its own.
+Its output explicitly includes ``strip_equivalence_verified_here=false``.
+
+The decoder reads the actual defined ``_mt6762_trial_record`` symbol from the
+unstripped Mach-O, skipping legitimate STABS debug duplicates. It requires the
+record to fit its defining section and a writable segment. The stripped kernel
+segments must match the selected Image manifest. Record PA is derived from
+those segment offsets and the same-image loader trace's selected RAM base;
+both the explicitly supplied PA and reviewed binding must match. The trace
+must have the expected identity and a committed final branch marker. That
+marker alone does not prove XNU execution; record state is separate evidence.
+
+For frozen kernel53/Image38, the independently observed symbol VA is
+0xfffffff007b21540 and the expected PA for RAMbase0xd0000000 is0xd3b21540.
+Do not reuse these for a different kernel or relocation. CLI bound mode::
+
+  python3 decode_trial.py trial.bin \
+    --kernel /private/kernel.macho --symbols /private/kernel.unstripped \
+    --manifest /private/physical-manifest.json --trace /private/trace.bin \
+    --physical-address 0xd3b21540 --binding /private/trial-binding.json \
+    --binding-sha256 <independently-reviewed-digest>
+
+This attributes a plausible expiry/cache-clean observation to the selected
+Image, not uniquely to one boot of that Image. The trial record has no per-boot
+nonce; host capture ordering and independently checked loader linkage remain
+required. State3 means cache-clean instructions completed. Every result retains
+``reset_proven=false``, ``dram_retention_guaranteed=false`` and
+``coherent_log_snapshot=false``. Do not upgrade these based on a valid decoder
+result alone.
+
+Validation: ``python3 test_decode_trial.py`` covers all states, truncation,
+magic/version/reserved/flag errors, deadline and timestamp inconsistencies,
+length diagnostics, valid reviewed binding, stale trace identity, wrong
+kernel/symbol artifact, wrong PA and mismatched load segments. Actual frozen
+kernel53 symbol extraction and Image38 relocation were also checked locally
+with synthetic trace/disabled-record bytes; that was not a physical capture.
diff --git a/tools/mt6762/hardware/watchdog/TRIAL-DEADLINE.rst b/tools/mt6762/hardware/watchdog/TRIAL-DEADLINE.rst
new file mode 100644
index 0000000000000000000000000000000000000000..2d6ebc0d3c4a0a0fe84e776ba7dc9160186a977b
--- /dev/null
+++ b/tools/mt6762/hardware/watchdog/TRIAL-DEADLINE.rst
@@ -0,0 +1,80 @@
+Opt-in inherited-watchdog trial deadline
+=======================================
+
+The boot argument ``mt6762_trial_seconds=60`` (decimal60..1800) stops this
+kernel's AP watchdog refresh worker after the requested elapsed duration.
+Absent, zero, malformed or out-of-range arguments leave the deadline disabled.
+Large numbers are parsed as bounded decimal strings, not truncated integers.
+This option requires the existing ``watchdog-refresh-owned`` handoff and exact
+inherited admission: MODE0x7d, LENGTH field0xf000, REQ_MODE0x3f0036 and
+REQ_IRQ_EN0x3b0034. It cannot turn on or reconfigure a disabled watchdog.
+
+The implementation is in bsd/dev/mt6762_platform.c, not a separate watchdog.c.
+Its deadline starts with the timestamp sampled for the first admitted
+RESTART attempt. Later refreshes do not extend it. The existing configuration
+and maximum10second scheduling-gap checks run first and retain their existing
+failure behavior. A normal deadline expiry records its observations, performs
+bounded cache maintenance and terminates this native refresh worker.
+It does not perform a final extra kick, restart that worker, call loader_return,
+change interrupt routing, enable DDR reserve or issue a software reset.
+No physical trial of this new option is claimed here.
+
+The exact inherited mode enables IRQ and dual mode. The programmed interval
+is nominal30seconds from the last refresh, not a guaranteed reset deadline.
+Secure handlers, other refreshers, clock acceptance and second-stage timing
+remain uncharacterized. Arm the host capture before expiry, then measure actual
+USB reappearance. A second unobserved normal boot can overwrite evidence or
+restart the same bounded trial. There is no persistent boot-selector change.
+
+Evidence delivery and concurrency
+---------------------------------
+
+At expiry the global128-byte ``mt6762_trial_record`` contains magicMTKTRIAL,
+version1, requested seconds, attempt count, first/last/expiry timestamps in
+uptime nanoseconds, raw MODE/LENGTH/STATUS/NONRST/NONRST2/REQ_MODE/REQ_IRQ_EN,
+and before/after log lengths. Its layout is in trial_deadline.h. State0 means
+disabled,1 armed,2 expiry reached,3 cache-clean operations completed. State2
+is cleaned before the log flush; state3 is cleaned afterward. A state3 record
+does not prove reset, cache survival or log consistency. Retrieval must bind
+the symbol/address to the exact selected kernel and trial manifest, using the
+separately verified same-build loader trace for build identity. Pin the record's
+symbol VA from the frozen kernel's symbol table and derive its PA using that
+trial's verified relocation; never guess its placement from another build.
+This ordinary record has no unique per-boot nonce and is not an attestation.
+
+The MT6762-only helper in osfmk/arm64/loader_return.c cleans the complete
+``sizeof(loader_log)`` allocation, currently1536KiB, irrespective of the mutable
+length. It also cleans the actual length, ring position, wrapped/linear flags
+and loader_live descriptor, then executes DSB SY. The record is separately
+cleaned and ordered. It uses64-byte lines, appropriate to the admitted Cortex-A53.
+Range arithmetic rejects overflow; no mutable length can enlarge the range.
+
+Logging continues. The helper does not acquire loader_log_lock, disable local
+interrupts, copy/linearize the ring or modify its metadata. Existing log writers
+have a bounded-spin path which can bypass that lock during a panic; holding it
+over a full cache clean would delay writers without guaranteeing exclusion.
+The clean is therefore explicitly best-effort. Flag1 always records possible
+concurrent/post-clean writes. Flag2 additionally records an observed length
+larger than the allocation; such a value is never used for cache traversal.
+The two length observations can differ, and ring metadata need not describe
+one atomic instant. A valid deadline line/record is positive evidence; absent
+or partial evidence remains inconclusive.
+
+MODE0x7d leaves DDR-reserve bit7 clear. Capture30's preloader log says DDR reserve
+was not enabled, despite successful recovery of some XNU bytes. Cache cleaning
+does not preserve DRAM through resets, DRAM training, bootloader overwrites or
+subsequent DA allocations. Keep the existing separately verified DA heap
+reservation and read evidence promptly; never advertise guaranteed retention.
+
+Validation
+----------
+
+``bash tools/mt6762/hardware/watchdog/test.sh`` checks decimal admission,
+unterminated/overflow inputs, first-feed anchoring, exact expiry boundaries,
+irreversible expiry and bounded aligned cache traversal including pointer
+overflow. It also compiles the actual worker/init source into a host harness
+with deterministic time and MMIO:12 executions cover default/zero/invalid
+arguments,60/1800second expiry and unchanged profile/scheduling failures.
+Every modeled peripheral store must remain32-bit RESTART0x1971 at0x10007008.
+Only ARM cache/barrier instructions are elided in that host harness; it does
+not test real watchdog reload, interrupts, reset timing or retained memory.
diff --git a/tools/mt6762/hardware/watchdog/decode_trial.py b/tools/mt6762/hardware/watchdog/decode_trial.py
new file mode 100644
index 0000000000000000000000000000000000000000..09417128e26ef31fdc863e3bc424d972bbdb819c
--- /dev/null
+++ b/tools/mt6762/hardware/watchdog/decode_trial.py
@@ -0,0 +1,221 @@
+#!/usr/bin/env python3
+"""Strict local watchdog-trial decoder. No device access; no reset/retention proof."""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import re
+import struct
+
+SIZE = 128
+MAGIC = 0x4c414952544b544d
+LOG_CAPACITY = 1536 * 1024
+SYMBOL = b'_mt6762_trial_record'
+FIELDS = ('magic version state seconds attempts flags reserved0 first_feed_ns '
+          'last_feed_ns expired_ns log_length_before log_length_after mode length '
+          'status nonrst nonrst2 req_mode req_irq').split()
+STATES = ('disabled', 'armed', 'expiry-recorded', 'cache-clean-completed')
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def decode_unbound(data):
+    """Validate raw structure only. Never attributes an expiry to the current trial."""
+    if len(data) != SIZE:
+        raise ValueError('require exactly128 bytes')
+    words = struct.unpack('<Q6I3Q18I', data)
+    r = dict(zip(FIELDS, words))
+    if r['magic'] != MAGIC or r['version'] != 1:
+        raise ValueError('trial magic/version mismatch')
+    if r['state'] not in range(4) or r['reserved0'] or any(words[len(FIELDS):]):
+        raise ValueError('unknown state or nonzero reserved fields')
+    if r['flags'] & ~3:
+        raise ValueError('unknown flags')
+    if r['state'] == 0:
+        if any(words[3:]):
+            raise ValueError('changed disabled record')
+    else:
+        if not 60 <= r['seconds'] <= 1800:
+            raise ValueError('enabled deadline outside60..1800')
+        if r['state'] == 1:
+            if any(r[k] for k in FIELDS[4:] if k != 'first_feed_ns'):
+                raise ValueError('armed record contains expiry-only fields')
+        else:
+            if not r['attempts'] or not r['flags'] & 1:
+                raise ValueError('expiry lacks attempts/concurrency flag')
+            first, last, end = (r[k] for k in ('first_feed_ns', 'last_feed_ns', 'expired_ns'))
+            if not first <= last <= end or end-first < r['seconds'] * 10**9:
+                raise ValueError('inconsistent expiry timestamps')
+            if end-last > 10**10 + 1:
+                raise ValueError('expiry contradicts existing scheduling-gap guard')
+            invalid = any(r[k] > LOG_CAPACITY for k in ('log_length_before', 'log_length_after'))
+            if r['state'] == 3 and bool(r['flags'] & 2) != invalid:
+                raise ValueError('cache-clean result disagrees with log-length flag')
+            # State2 can be observed during the helper's partial metadata update.
+            # Its lengths/flag2 are not a completed flush result.
+    r.pop('magic');r.pop('reserved0')
+    r.update(record_sha256=sha(data), state_name=STATES[r['state']],
+             identity_bound=False, expiry_attributed_to_selected_image=False,
+             cache_clean_attributed_to_selected_image=False,
+             reset_proven=False, dram_retention_guaranteed=False,
+             coherent_log_snapshot=False)
+    return r
+
+
+def checked(data, offset, size):
+    if offset < 0 or size < 0 or offset + size > len(data):
+        raise ValueError('Mach-O range outside artifact')
+    return data[offset:offset+size]
+
+
+def macho(data, symbol=False):
+    magic, cpu, subtype, kind, count, length, _, _ = struct.unpack('<8I', checked(data, 0, 32))
+    if (magic, cpu, subtype & 255, kind) != (0xfeedfacf, 0x100000c, 0, 2):
+        raise ValueError('require thin arm64 executable')
+    commands = checked(data, 32, length)
+    pos, segments, sections, symtab = 0, [], [], None
+    for _ in range(count):
+        cmd, size = struct.unpack('<II', checked(commands, pos, 8))
+        if size < 8 or size % 8:
+            raise ValueError('invalid load command size')
+        c = checked(commands, pos, size)
+        if cmd == 0x19:
+            _, _, _, va, vs, off, fs, _, prot, ns, _ = struct.unpack('<II16s4Q4I', checked(c, 0, 72))
+            if size != 72 + ns * 80 or fs > vs or va + vs > 2**64:
+                raise ValueError('invalid segment layout')
+            checked(data, off, fs)
+            for index in range(ns):
+                section_va, section_size = struct.unpack_from('<QQ', c, 72+80*index+32)
+                if not va <= section_va <= section_va+section_size <= va+vs:
+                    raise ValueError('section outside segment')
+                sections.append((section_va, section_size))
+            if vs:
+                segments.append(dict(vmaddr=va, vmsize=vs, fileoff=off, filesize=fs, prot=prot))
+        elif cmd == 2:
+            if size != 24 or symtab is not None:
+                raise ValueError('invalid/duplicate symbol command')
+            symtab = struct.unpack_from('<4I', c, 8)
+        pos += size
+    if pos != length or not segments:
+        raise ValueError('incomplete Mach-O commands')
+    if not symbol:
+        return segments, None
+    if symtab is None:
+        raise ValueError('symbol artifact lacks LC_SYMTAB')
+    off, count, stroff, strsize = symtab
+    names = checked(data, stroff, strsize)
+    entries = checked(data, off, count * 16)
+    matches = []
+    for pos in range(0, len(entries), 16):
+        name, typ, section, _, va = struct.unpack_from('<IBBHQ', entries, pos)
+        if name >= len(names):
+            raise ValueError('invalid symbol string offset')
+        end = names.find(b'\0', name)
+        if end < 0:
+            raise ValueError('unterminated symbol')
+        if names[name:end] == SYMBOL:
+            if typ & 0xe0:  # Legitimate N_GSYM debug record accompanies the definition.
+                continue
+            if typ & 0x0e != 0x0e or not 1 <= section <= len(sections):
+                raise ValueError('trial symbol is not a defined section symbol')
+            start, size = sections[section-1]
+            if not start <= va or va+SIZE > start+size:
+                raise ValueError('trial record does not fit its defining section')
+            matches.append(va)
+    if len(matches) != 1:
+        raise ValueError('require one defined trial symbol')
+    return segments, matches[0]
+
+
+def decode_bound(data, *, physical_address, kernel_bytes, symbol_bytes,
+                 manifest, trace_bytes, binding_bytes, binding_sha256):
+    """Bind observations to externally reviewed provenance, not a self-approved flag.
+
+    The caller must pin binding_sha256 independently of the supplied document.
+    That reviewed document asserts the stripped/unstripped relationship; this
+    function checks both artifact hashes but does not reproduce stripping.
+    """
+    if not re.fullmatch('[0-9a-f]{64}', binding_sha256) or sha(binding_bytes) != binding_sha256:
+        raise ValueError('external binding digest mismatch')
+    b = json.loads(binding_bytes)
+    keys = {'format', 'kernel_sha256', 'symbol_sha256', 'image_sha256',
+            'trace_identity', 'symbol_va', 'physical_address'}
+    if not isinstance(b, dict) or set(b) != keys or type(b['format']) is not int or b['format'] != 1:
+        raise ValueError('unknown binding schema')
+    for k in ('kernel_sha256', 'symbol_sha256', 'image_sha256', 'trace_identity'):
+        if not isinstance(b[k], str) or not re.fullmatch('[0-9a-f]{64}', b[k]):
+            raise ValueError('malformed binding digest/identity')
+    if sha(kernel_bytes) != b['kernel_sha256'] or sha(symbol_bytes) != b['symbol_sha256']:
+        raise ValueError('frozen kernel/symbol artifact mismatch')
+    if manifest['kernel_sha256'] != b['kernel_sha256'] or manifest['image_sha256'] != b['image_sha256']:
+        raise ValueError('selected image differs from reviewed binding')
+    if manifest['trace']['identity'] != b['trace_identity']:
+        raise ValueError('selected trace identity differs from binding')
+    trace_path = Path(__file__).resolve().parents[2] / 'physical/trace_record.py'
+    spec = importlib.util.spec_from_file_location('mtk_trial_trace', trace_path)
+    module = importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+    trace = module.decode(trace_bytes, bytes.fromhex(b['trace_identity']))
+    if trace['phase'] != 10 or not trace['executed'] or not trace['ram']:
+        raise ValueError('require committed same-image final loader trace')
+    segments, _ = macho(kernel_bytes)
+    symbol_segments, va = macho(symbol_bytes, symbol=True)
+    if any(type(b[k]) is not int for k in ('symbol_va', 'physical_address')) or va != b['symbol_va']:
+        raise ValueError('binding symbol VA disagrees with actual symbol artifact')
+    if va % 64 or not any(s['prot'] & 2 and s['vmaddr'] <= va and va+SIZE <= s['vmaddr']+s['vmsize'] for s in symbol_segments):
+        raise ValueError('symbol outside aligned writable allocation')
+    loaded = manifest['segments']
+    if len(loaded) != len(segments):
+        raise ValueError('manifest load segments disagree with frozen kernel')
+    bases, target = set(), []
+    for s, m in zip(segments, loaded):
+        if any(type(m[k]) is not int or m[k] != s[k] for k in ('vmsize', 'fileoff', 'filesize')):
+            raise ValueError('manifest segment does not match frozen kernel')
+        offset = m['offset']
+        if type(offset) is not int or offset < 0 or offset+s['vmsize'] > 0x18000000:
+            raise ValueError('invalid physical loader segment offset')
+        bases.add(s['vmaddr']-offset)
+        if s['prot'] & 2 and s['vmaddr'] <= va and va+SIZE <= s['vmaddr']+s['vmsize']:
+            target.append(trace['ram'] + offset + va-s['vmaddr'])
+    if len(bases) != 1 or len(target) != 1 or type(physical_address) is not int or not 0 < physical_address <= 2**64-SIZE:
+        raise ValueError('ambiguous or invalid relocation/address')
+    if target[0] != physical_address or b['physical_address'] != physical_address:
+        raise ValueError('observed address differs from symbol-derived physical address')
+    r = decode_unbound(data)
+    r.update(identity_bound=True, binding_sha256=binding_sha256,
+             kernel_sha256=b['kernel_sha256'], symbol_sha256=b['symbol_sha256'],
+             image_sha256=b['image_sha256'], trace_identity=b['trace_identity'],
+             symbol_va=hex(va), physical_address=hex(physical_address),
+             expiry_attributed_to_selected_image=r['state'] >= 2,
+             cache_clean_attributed_to_selected_image=r['state'] == 3,
+             strip_equivalence_verified_here=False,
+             provenance_authority='externally SHA256-pinned reviewed binding document')
+    return r
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('record', type=Path)
+    p.add_argument('--unbound', action='store_true')
+    for name in ('kernel', 'symbols', 'manifest', 'trace', 'binding'):
+        p.add_argument('--'+name, type=Path)
+    p.add_argument('--binding-sha256')
+    p.add_argument('--physical-address', type=lambda v: int(v, 0))
+    a = p.parse_args()
+    fields = (a.kernel, a.symbols, a.manifest, a.trace, a.binding, a.binding_sha256, a.physical_address)
+    if a.unbound:
+        if any(v is not None for v in fields):p.error('--unbound cannot accept partial binding arguments')
+        result = decode_unbound(a.record.read_bytes())
+    else:
+        if any(v is None for v in fields):p.error('provide every binding argument or explicitly select --unbound')
+        result = decode_bound(a.record.read_bytes(), physical_address=a.physical_address,
+            kernel_bytes=a.kernel.read_bytes(), symbol_bytes=a.symbols.read_bytes(),
+            manifest=json.loads(a.manifest.read_text()), trace_bytes=a.trace.read_bytes(),
+            binding_bytes=a.binding.read_bytes(), binding_sha256=a.binding_sha256)
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__':
+    main()
