diff --git a/tools/mt6762/physical/verity-repair/mtk_adapter.py b/tools/mt6762/physical/verity-repair/mtk_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..99a79053559f923831cbfebe531fb42076035a2d
--- /dev/null
+++ b/tools/mt6762/physical/verity-repair/mtk_adapter.py
@@ -0,0 +1,122 @@
+"""Dry-run adapter for an already connected, explicitly selected mtkclient DA.
+
+There is intentionally no connect(), writeflash(), unlock(), or apply operation.
+SEJ authentication uses hardware register access through the existing DA API;
+this is not a claim that live preparation is hardware read-only.
+"""
+import importlib
+import json
+import os
+from pathlib import Path
+import subprocess
+
+from planner import PARTITION_SIZE, build_candidate, inspect, sha
+
+MTK_COMMIT = 'fa97df7df41140e60f215f24eea82cb46faf9ff0'
+
+
+def checked_seccfg_class(checkout):
+    checkout = Path(checkout).resolve(strict=True)
+    head = subprocess.check_output(['git', '-C', str(checkout), 'rev-parse', 'HEAD'], text=True).strip()
+    dirty = subprocess.check_output(['git', '-C', str(checkout), 'diff', 'HEAD', '--name-only'], text=True)
+    if head != MTK_COMMIT or dirty:
+        raise ValueError('Require reviewed, tracked-clean mtkclient commit')
+    module = importlib.import_module('mtkclient.Library.Hardware.seccfg')
+    expected = checkout / 'mtkclient/Library/Hardware/seccfg.py'
+    if Path(module.__file__).resolve() != expected:
+        raise ValueError('Imported seccfg module belongs to another checkout')
+    original = subprocess.check_output(['git', '-C', str(checkout), 'show',
+                                        MTK_COMMIT + ':mtkclient/Library/Hardware/seccfg.py'])
+    if sha(expected.read_bytes()) != sha(original):
+        raise ValueError('seccfg source differs from reviewed commit')
+    return module.SecCfgV4, {'mtkclient_commit': head, 'seccfg_source_sha256': sha(original)}
+
+
+def authenticated_candidate(data, hwc, mtk, seccfg_class):
+    inspect(data)  # Enforce size/version before imported parser seeks or decrypts.
+    parsed = seccfg_class(hwc, mtk)
+    if not parsed.parse(data) or parsed.hwtype != 'V4':
+        raise ValueError('Existing record must authenticate with observed HW V4 variant')
+
+    def authenticate(header):
+        import hashlib
+        # Same V4 branch as SecCfgV4.create(), without its lock/status edits.
+        output = hwc.sej.sej_sec_cfg_hw_V3(hashlib.sha256(header).digest(),
+                                         encrypt=True, legacy=True)
+        return bytes(output)
+
+    candidate, report = build_candidate(data, authenticate)
+    verified = seccfg_class(hwc, mtk)
+    if not verified.parse(candidate) or verified.hwtype != 'V4':
+        raise ValueError('Generated record failed independent imported-parser authentication')
+    if verified.lock_state != 3 or verified.critical_lock_state != 0:
+        raise ValueError('Imported parser reports wrong resulting state')
+    report.update(authenticated=True, authentication_variant='V4',
+                  status='dry-run-authenticated-not-written')
+    return candidate, report
+
+
+def save_private(path, data):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, 'wb') as stream:
+        stream.write(data)
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def prepare_from_connected_mtk(mtk, output_dir, checkout):
+    """Read fresh seccfg, authenticate, and save local review artifacts only.
+
+    Pass the configured `mtk` object used by Main/DaHandler, not Main itself.
+    Caller owns connection/session lifecycle. No flash-writing API is called.
+    """
+    seccfg_class, provenance = checked_seccfg_class(checkout)
+    if mtk.config.hwcode != 0x766:
+        raise ValueError('Require this observed hardware code0x766')
+    if mtk.daloader.xft is None:
+        raise ValueError('Require existing configured XFLASH extension')
+    pagesize = mtk.daloader.daconfig.pagesize
+    if pagesize != 512:
+        raise ValueError('Unexpected logical sector size')
+    entries = mtk.daloader.get_partition_data(parttype='user')
+    selected = [p for p in entries if p.name == 'seccfg']
+    if len(selected) != 1:
+        raise ValueError('Missing or ambiguous seccfg GPT entry')
+    part = selected[0]
+    start, length = part.sector * pagesize, part.sectors * pagesize
+    # Exact known board geometry; no generic or guessed partition fallback.
+    if start != 0xf000000 or length != PARTITION_SIZE:
+        raise ValueError('Unexpected live seccfg extent')
+    for other in entries:
+        if other is part:
+            continue
+        lo, hi = other.sector * pagesize, (other.sector + other.sectors) * pagesize
+        if lo < start + length and start < hi:
+            raise ValueError('Live GPT overlaps seccfg')
+    destination = Path(output_dir)
+    destination.mkdir(mode=0o700, parents=False, exist_ok=False)
+
+    def fresh_read():
+        raw = mtk.daloader.readflash(addr=start, length=length, filename='',
+                                     parttype='user', display=False)
+        if not isinstance(raw, (bytes, bytearray)) or len(raw) != length:
+            raise ValueError('Short/failed seccfg read')
+        return bytes(raw)
+
+    original = fresh_read()
+    save_private(destination / 'seccfg-fresh.bin', original)
+    hwc = mtk.daloader.xft.cryptosetup()
+    candidate, report = authenticated_candidate(original, hwc, mtk, seccfg_class)
+    if fresh_read() != original:
+        raise ValueError('Device snapshot changed during preparation; refuse candidate')
+    save_private(destination / 'seccfg-candidate.bin', candidate)
+    for sector in report['changed_sectors']:
+        offset = sector['offset']
+        name = f'candidate-sector-{offset:08x}.bin'
+        save_private(destination / name, candidate[offset:offset + 512])
+        sector.update(file=name, physical_byte_address=start + offset)
+    report.update(provenance, live_partition_start=start, live_partition_length=length,
+                  live_reads_equal=True, hardware_crypto_used=True,
+                  note='Review artifacts only. No persistent writes, lock changes, or hardware status clearing.')
+    save_private(destination / 'report.json', (json.dumps(report, indent=2) + '\n').encode())
+    return report
diff --git a/tools/mt6762/physical/verity-repair/planner.py b/tools/mt6762/physical/verity-repair/planner.py
new file mode 100644
index 0000000000000000000000000000000000000000..631ca8b8ff66e0d118afbbaf02acc102491736a0
--- /dev/null
+++ b/tools/mt6762/physical/verity-repair/planner.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Bounded, offline planning for the audited LK's seccfg warning state.
+
+No device API is imported. Authentication is supplied by the separate adapter;
+structural inspection alone never labels a candidate authenticated.
+"""
+import argparse
+import hashlib
+import json
+import struct
+from pathlib import Path
+
+PARTITION_SIZE = 8 * 1024 * 1024
+KEY = b'avb.managed_verity_mode'
+PERSIST_OFFSET = 0x200
+MAX_RECORDS = 8
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def inspect(data):
+    if len(data) != PARTITION_SIZE:
+        raise ValueError('Expected complete 8MiB seccfg capture')
+    words = struct.unpack_from('<7I', data)
+    if words[:3] != (0x4d4d4d4d, 4, 60) or words[6] != 0x45454545:
+        raise ValueError('Unsupported authenticated header layout')
+    if words[3] != 3:
+        raise ValueError('Require already unlocked state3; never lock/unlock here')
+    if words[4] not in (0, 1):
+        raise ValueError('Unknown exact-LK dm-verity status')
+    if struct.unpack_from('>3I', data, PERSIST_OFFSET) != (0x90790922, 1, 0):
+        raise ValueError('Unsupported persistent header')
+    if any(data[0x20c:0x240]):
+        raise ValueError('Nonzero unknown persistent header extension')
+    pos = 0x240
+    keys = set()
+    records = []
+    value_offset = None
+    while True:
+        if pos + 12 > len(data):
+            raise ValueError('Truncated descriptor')
+        magic, key_size, value_size = struct.unpack_from('>3I', data, pos)
+        if magic == 0:
+            if key_size or value_size:
+                raise ValueError('Malformed persistent terminator')
+            break
+        if magic != 0x90790804 or len(records) >= MAX_RECORDS:
+            raise ValueError('Unknown descriptor or excessive record count')
+        # Deliberately tighter than arbitrary partition size; no guessed allocation.
+        if not 1 <= key_size <= 1024 or not 1 <= value_size <= 65536:
+            raise ValueError('Unsupported descriptor size')
+        end = pos + 12 + key_size + value_size
+        if end + 12 > len(data):
+            raise ValueError('Descriptor exceeds partition')
+        key = bytes(data[pos + 12:pos + 12 + key_size])
+        if key in keys:
+            raise ValueError('Duplicate persistent key')
+        keys.add(key)
+        if key == KEY:
+            if key_size != 23 or value_size != 32:
+                raise ValueError('Managed-verity key/value must be23/32 bytes')
+            value_offset = pos + 12 + key_size
+        records.append({'descriptor_offset': pos, 'key_size': key_size,
+                        'value_size': value_size, 'is_managed_verity': key == KEY})
+        pos = end  # Packed descriptors: no alignment between records.
+    return {'input_sha256': sha(data), 'partition_size': len(data),
+            'lock_state': words[3], 'dm_verity_status': words[4],
+            'sboot_runtime': words[5], 'records': records,
+            'managed_value_offset': value_offset,
+            'authenticated': False}
+
+
+def build_candidate(data, authenticate_header):
+    """Callback returns the existing device's encrypted SHA256 for 28 bytes.
+
+    The callback is not trusted to change anything else, and this pure function
+    does not claim to verify the callback's cryptographic result.
+    """
+    info = inspect(data)
+    result = bytearray(data)
+    struct.pack_into('<I', result, 0x10, 0)
+    if info['dm_verity_status']:
+        encrypted_hash = authenticate_header(bytes(result[:28]))
+        if not isinstance(encrypted_hash, bytes) or len(encrypted_hash) != 32:
+            raise ValueError('Authentication callback must return exactly32 bytes')
+        result[28:60] = encrypted_hash
+    offset = info['managed_value_offset']
+    if offset is not None:
+        result[offset:offset + 32] = bytes(32)
+    result = bytes(result)
+    allowed = [(0x10, 0x14), (0x1c, 0x3c)]
+    if offset is not None:
+        allowed.append((offset, offset + 32))
+    changes = [n for n, (a, b) in enumerate(zip(data, result)) if a != b]
+    if any(not any(lo <= n < hi for lo, hi in allowed) for n in changes):
+        raise ValueError('Unexpected mutation outside allowlist')
+    after = inspect(result)
+    if after['lock_state'] != 3 or after['dm_verity_status'] != 0:
+        raise ValueError('Unexpected resulting state')
+    sectors = sorted({n // 512 * 512 for n in changes})
+    report = dict(info, candidate_sha256=sha(result), changed_bytes=len(changes),
+                  allowed_ranges=allowed, flash_writes_performed=False,
+                  status='dry-run-structural-candidate-not-authenticated',
+                  changed_sectors=[{'offset': n, 'length': 512,
+                                    'before_sha256': sha(data[n:n + 512]),
+                                    'candidate_sha256': sha(result[n:n + 512])}
+                                   for n in sectors])
+    return result, report
+
+
+def main():
+    parser = argparse.ArgumentParser(description='Offline inspection only; no candidate authentication or device access')
+    parser.add_argument('capture', type=Path)
+    args = parser.parse_args()
+    print(json.dumps(inspect(args.capture.read_bytes()), indent=2))
+
+
+if __name__ == '__main__':
+    main()
