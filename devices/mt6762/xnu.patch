+/* Executes the actual private probe, public PWRAP guard and unmodified gauge
+ * and WACS protocols. Only clock/lock/MMIO/handoff/log primitives are fakes. */
+#include <assert.h>
+#include <errno.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define NSEC_PER_MSEC 1000000u
+#define LCK_MTX_DECLARE(name,group) int name
+#include "../../../../bsd/dev/mt6762_power_protocol.h"
+static int pwrap_mutex;
+static int pwrap_ready,pwrap_fault,pwrap_read_only,adc_ready,charger_ready,charger_owned;
+static uint32_t pwrap_profile;
+static uint64_t now_us,lock_delay,interval_preemption,transaction_delay,separation_us;
+static unsigned lock_calls,lock_delay_at,late_at;
+static void lck_mtx_lock(int *m) {
+    assert(!*m);*m=1;
+    if(m==&pwrap_mutex && ++lock_calls==lock_delay_at)now_us+=lock_delay;
+}
+static void lck_mtx_unlock(int *m){assert(*m);*m=0;}
+static void clock_get_uptime(uint64_t *v){*v=now_us;}
+static void clock_interval_to_absolutetime_interval(unsigned n,unsigned scale,uint64_t *v)
+{assert(scale==NSEC_PER_MSEC);*v=(uint64_t)n*1000;now_us+=interval_preemption;}
+static void delay_for_interval(unsigned n,unsigned scale)
+{assert(n==1000 && scale==NSEC_PER_MSEC);now_us+=separation_us;}
+static void pwrap_wacs_delay(void *unused,unsigned us){(void)unused;assert(us==10);now_us+=us;}
+static char messages[65536];
+static void kprintf(const char *format,...) {
+    va_list ap;va_start(ap,format);
+    size_t used=strlen(messages);
+    int n=vsnprintf(messages+used,sizeof(messages)-used,format,ap);
+    va_end(ap);assert(n>=0 && (size_t)n<sizeof(messages)-used);
+}
+struct prop {const char *name;uint32_t value;};
+static struct prop properties[]={
+    {"fgauge-latch-probe",1},{"pwrap-inherited-probe",1},
+    {"fgauge-baseline-version",1},{"fgauge-rfg",100},{"fgauge-car-tune",1000},
+    {"fgauge-con0",0x129},{"fgauge-efuse-gain",0x416},{"fgauge-efuse-offset",1},
+    {"fgauge-adjust-offset",0},{"fgauge-gain",0x416},
+    {"fgauge-owned",0},{"fgauge-calibration-verified",0},{"adc-verified",0},
+    {"charger-verified",0},{"charger-control-owned",0},{"pwrap-write-owned",0},{"lab-fixture",0}
+};
+static int missing_property;
+static int mt6762_handoff_u32(const char *name,uint32_t *value) {
+    for(unsigned i=0;i<sizeof(properties)/sizeof(properties[0]);i++)
+        if((int)i!=missing_property && !strcmp(name,properties[i].name)) {*value=properties[i].value;return 0;}
+    return -1;
+}
+struct txn {uint16_t reg,value;unsigned write;uint64_t when;};
+static struct txn transactions[4096];
+static unsigned count,pmic_writes,requests,phase,command_write,fail_at,fail_stage,mutate_at;
+static unsigned blocked_public_writes,polls,no_ready,no_release,bad_control,bad_top,bad_final;
+static uint16_t control,response,mutate_mask,current_word,car_low,car_high;
+static uint64_t ticks,tick_delta;
+static int mt6762_pwrap_write16(uint16_t,uint16_t);
+static uint16_t pmic_read(uint16_t reg) {
+    switch(reg) {
+    case 8:return 0x5730;case 0xc0c:return 4;case 0xd08:return 0x129;
+    case 0xc8e:case 0xd96:return 0x416;case 0xc90:return 1;case 0xd94:return 0;
+    case 0xd0a:return control;case 0xd8a:return current_word;
+    case 0xd12:return car_low;case 0xd14:return car_high;
+    case 0xd20:return (uint16_t)ticks;case 0xd22:return (uint16_t)(ticks>>16);
+    case 0xd24:return bad_top?2:(uint16_t)(ticks>>32);
+    default:assert(0);return 0;
+    }
+}
+static void pmic_write(uint16_t reg,uint16_t value) {
+    static const uint16_t order[]={1,9,8,0};
+    assert(reg==0xd0a && pmic_writes<8 && value==order[pmic_writes%4]);
+    pmic_writes++;
+    if(value==1) {
+        if(requests++)ticks=(ticks+tick_delta)&((1ull<<33)-1);
+        control=no_ready?1:(bad_control?0x8003:0x8001);
+    }else if(value==9)control=0x8009;
+    else if(value==8)control=no_release?0x8008:8;
+    else control=bad_final?2:0;
+}
+static uint32_t mmio_read(void *unused,uint32_t offset) {
+    (void)unused;assert(offset==0xc24 && pwrap_mutex);polls++;
+    if(!phase) {
+        if(count+1==fail_at && fail_stage==0)return 0; /* No command issued. */
+        return 1u<<22;
+    }
+    if(count==fail_at) {
+        if((fail_stage==1 && phase==1) || (fail_stage==2 && phase==2))return 0;
+        if(fail_stage==3 && phase==1)return (1u<<22)|(7u<<16);
+    }
+    if(command_write || phase==2){phase=0;return 1u<<22;}
+    return (1u<<22)|(6u<<16)|response;
+}
+static void mmio_write(void *unused,uint32_t offset,uint32_t word) {
+    (void)unused;assert(pwrap_mutex);
+    if(offset==0xc28) {assert(phase==1 && !command_write && word==1);phase=2;return;}
+    assert(offset==0xc20 && !phase && count<4096);
+    command_write=word>>31;
+    uint16_t reg=(uint16_t)(((word>>16)&0x7fff)<<1),value=(uint16_t)word;
+    transactions[count++]=(struct txn){reg,value,command_write,now_us};
+    assert(mt6762_pwrap_write16(0xd0a,0)==-EPERM);blocked_public_writes++;
+    if(command_write)pmic_write(reg,value);
+    else {response=pmic_read(reg);if(count==mutate_at)response^=mutate_mask;}
+    phase=1;now_us+=transaction_delay;
+    if(count==late_at)now_us+=2000000;
+}
+static const struct mt6762_wacs_io pwrap_io={NULL,mmio_read,mmio_write,pwrap_wacs_delay};
+/* Generated verbatim from mt6762_power.c by the test runner. */
+#include "gauge_latch_power_functions.c"
+#include "../../../../bsd/dev/mt6762_gauge_latch_probe.c"
+static void reset(void) {
+    gauge_latch_started=0;pwrap_mutex=gauge_latch_mutex=0;
+    pwrap_ready=pwrap_read_only=1;pwrap_fault=adc_ready=charger_ready=charger_owned=0;
+    pwrap_profile=MT6762_WACS_LK22;now_us=1000;
+    lock_delay=interval_preemption=transaction_delay=0;separation_us=1000000;
+    lock_calls=lock_delay_at=late_at=0;
+    count=pmic_writes=requests=phase=command_write=fail_at=fail_stage=mutate_at=0;
+    blocked_public_writes=polls=no_ready=no_release=bad_control=bad_top=bad_final=0;
+    control=response=0;mutate_mask=1;current_word=100;car_low=0;car_high=1;ticks=10;tick_delta=1;
+    messages[0]=0;missing_property=-1;
+    const uint32_t defaults[]={1,1,1,100,1000,0x129,0x416,1,0,0x416,0,0,0,0,0,0,0};
+    for(unsigned i=0;i<sizeof(properties)/sizeof(properties[0]);i++)properties[i].value=defaults[i];
+}
+static const char *ending(void) {
+    const char *p=strstr(messages,"MT6762_GAUGE_LATCH_END ");
+    assert(p && !strstr(p+1,"MT6762_GAUGE_LATCH_END "));
+    assert(strstr(p,"cleanup_writes=0") && strstr(p,"measurement_published=0 ownership_grant=0"));
+    assert(!pwrap_mutex && !gauge_latch_mutex);
+    return p;
+}
+static void terminal(void) {
+    unsigned saved=count,saved_writes=pmic_writes;
+    gauge_latch_probe();assert(count==saved && pmic_writes==saved_writes);
+    assert(mt6762_pwrap_write16(0xd0a,1)==-EPERM && count==saved);
+}
+int main(void) {
+    char timeout[40];snprintf(timeout,sizeof(timeout),"last_error=%d",-ETIMEDOUT);
+    reset();gauge_latch_probe();
+    assert(strstr(ending(),"stage=complete error=0 samples=2 writes_attempted=8 writes_completed=8"));
+    assert(strstr(ending(),"latch_idle_observed=1 cleanup_writes=0 diagnostic_valid=1"));
+    assert(count==64 && pmic_writes==8 && blocked_public_writes==count && control==0);
+    assert(strstr(messages,"coefficient_current_ua=31400") && strstr(messages,"nter_progress=0 diagnostic_valid=0"));
+    struct txn baseline[64];memcpy(baseline,transactions,sizeof(baseline));terminal();
+    /* All real WACS transactions: loss before command, ambiguous completion,
+     * bounded response timeout; read VLDCLR completion failure is separate. */
+    unsigned transport_cases=0;
+    for(unsigned at=1;at<=64;at++)for(unsigned stage=0;stage<4;stage++) {
+        if(stage==2 && baseline[at-1].write)continue;
+        reset();fail_at=at;fail_stage=stage;gauge_latch_probe();
+        assert(pwrap_fault && count==at-(stage==0) && pmic_writes<=8);
+        assert(strstr(ending(),"diagnostic_valid=0") && !strstr(ending(),"stage=complete"));
+        assert(strstr(ending(),"latch_idle_observed=0"));
+        if(stage==3)assert(polls>=1000);
+        unsigned expected_writes=0;
+        for(unsigned i=0;i<count;i++)expected_writes+=baseline[i].write;
+        assert(pmic_writes==expected_writes); /* No cleanup command follows. */
+        terminal();transport_cases++;
+    }
+    /* Every exact configuration word, both before and after both snapshots. */
+    unsigned configuration_cases=0;
+    for(unsigned sample=0;sample<2;sample++)for(unsigned after=0;after<2;after++)for(unsigned i=0;i<8;i++) {
+        unsigned at=sample*32+(after?24:0)+i+1;
+        reset();mutate_at=at;gauge_latch_probe();
+        assert(count==at && !pwrap_fault && strstr(messages,"MT6762_GAUGE_LATCH_CONFIG_FAILED"));
+        assert(strstr(ending(),"diagnostic_valid=0"));terminal();configuration_cases++;
+    }
+    for(unsigned missing=0;missing<10;missing++) {
+        reset();missing_property=(int)missing;gauge_latch_probe();assert(!count && !pmic_writes);
+        if(missing) {assert(strstr(ending(),"stage=handoff"));terminal();}
+        else assert(!messages[0]);
+    }
+    for(unsigned wrong=0;wrong<17;wrong++) {
+        reset();properties[wrong].value^=wrong<10?2:1;gauge_latch_probe();assert(!count);
+        if(wrong) {assert(strstr(ending(),"stage=handoff"));terminal();}
+        else assert(!messages[0]);
+    }
+    for(unsigned gate=0;gate<7;gate++) {
+        reset();
+        switch(gate) {
+        case 0:pwrap_ready=0;break;case 1:pwrap_fault=1;break;case 2:pwrap_read_only=0;break;
+        case 3:pwrap_profile=MT6762_WACS_LEGACY21;break;case 4:adc_ready=1;break;
+        case 5:charger_ready=1;break;case 6:charger_owned=1;break;
+        }
+        gauge_latch_probe();assert(!count && strstr(ending(),"stage=wrapper"));
+        if(pwrap_read_only)terminal();
+    }
+    /* Known success has full release. Every failed handshake stops at its
+     * last issued command; no uncertain latch is silently called clean. */
+    reset();no_ready=1;gauge_latch_probe();assert(pmic_writes==1 && control==1);assert(strstr(ending(),"latch_idle_observed=0"));terminal();
+    reset();no_release=1;gauge_latch_probe();assert(pmic_writes==3 && control==0x8008);assert(strstr(ending(),"latch_idle_observed=0"));terminal();
+    reset();bad_control=1;gauge_latch_probe();assert(pmic_writes==1 && control==0x8003);terminal();
+    reset();bad_top=1;gauge_latch_probe();assert(pmic_writes==1 && control==0x8001);terminal();
+    reset();bad_final=1;gauge_latch_probe();assert(pmic_writes==4 && control==2);assert(strstr(ending(),"latch_idle_observed=0"));terminal();
+    for(unsigned kind=0;kind<3;kind++) {
+        reset();tick_delta=kind==0?0:kind==1?(1ull<<33)-1:1ull<<32;gauge_latch_probe();
+        assert(count==64 && !control && strstr(ending(),"stage=nter") && strstr(ending(),"diagnostic_valid=0"));terminal();
+    }
+    reset();ticks=(1ull<<33)-1;gauge_latch_probe();assert(strstr(ending(),"stage=complete error=0"));
+    reset();current_word=0xff9b;car_high=0xff9b;car_low=0xf800;gauge_latch_probe();
+    assert(strstr(messages,"coefficient_current_ua=-31400") && strstr(messages,"coefficient_charge_uah=-"));
+    /* Expiry during every transaction, including final data/config reads and
+     * every write completion. It never admits the next operation. */
+    for(unsigned at=1;at<=64;at++) {
+        reset();late_at=at;gauge_latch_probe();assert(count==at && !pwrap_fault);
+        assert(strstr(ending(),"diagnostic_valid=0") && strstr(ending(),timeout));terminal();
+    }
+    reset();lock_delay_at=2;lock_delay=2000000;gauge_latch_probe();assert(!count && strstr(ending(),timeout));
+    reset();interval_preemption=2000000;gauge_latch_probe();assert(!count && strstr(ending(),timeout));
+    reset();now_us=UINT64_MAX-1000;gauge_latch_probe();assert(!count && strstr(ending(),"stage=lease"));
+    reset();separation_us=999999;gauge_latch_probe();assert(count==32 && pmic_writes==4 && strstr(ending(),"stage=lease"));
+    /* A rogue private callback cannot bypass arming, address/value/phase,
+     * write budget, expired lease or terminal fault. */
+    for(unsigned misuse=0;misuse<7;misuse++) {
+        reset();struct gauge_latch_context c={.acquired=now_us,.deadline=now_us+2000000};
+        assert(mt6762_gauge_probe_begin(&c.budget,0));
+        if(misuse!=0)assert(mt6762_gauge_probe_arm(&c.budget));
+        uint16_t reg=0xd0a,val=1;
+        if(misuse==1)reg=0x110e;
+        if(misuse==2)val=9;
+        if(misuse==3)c.budget.attempted=c.budget.completed=8;
+        if(misuse==4)c.budget.fault=1;
+        if(misuse==5)now_us=c.deadline;
+        if(misuse==6)now_us=c.acquired-1;
+        assert(gauge_latch_write(&c,reg,val)<0 && !count && c.budget.fault);
+        assert(gauge_latch_write(&c,0xd0a,1)<0 && !count);
+    }
+    reset();struct gauge_latch_context c={.acquired=now_us,.deadline=now_us+2000000};uint16_t word=42;
+    assert(mt6762_gauge_probe_begin(&c.budget,0));
+    assert(gauge_latch_read(&c,0xd8a,&word)<0 && word==42 && !count);
+    printf("actual gauge latch/WACS integration: %u transport faults, %u config changes, 64 expiry positions, phase/lease/cleanup/public-write gates PASS\n",
+        transport_cases,configuration_cases);
+}
diff --git a/tools/mt6762/hardware/power/test_gauge_latch_integration.py b/tools/mt6762/hardware/power/test_gauge_latch_integration.py
new file mode 100644
index 0000000000000000000000000000000000000000..eb18afb2e2c616abaac78e7edb64a591225147e7
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_gauge_latch_integration.py
@@ -0,0 +1,39 @@
+"""Compile actual native probe + actual public PWRAP guard; no hardware I/O."""
+from pathlib import Path
+import argparse
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+SOURCE = (HERE.parents[3] / 'bsd/dev/mt6762_power.c').read_text()
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--sanitize', action='store_true', help='Enable host AddressSanitizer and UBSan')
+options = parser.parse_args()
+
+
+def function(name):
+    marker = SOURCE.index(name + '(')
+    begin = SOURCE.rfind('\n', 0, marker) + 1
+    opening = SOURCE.index('{', marker)
+    depth, end = 1, opening + 1
+    while depth:
+        depth += (SOURCE[end] == '{') - (SOURCE[end] == '}')
+        end += 1
+    text = SOURCE[begin:end] + '\n'
+    # The public API's type is on the same line; static functions have their
+    # return type on the preceding line in this driver.
+    if text.startswith(name + '('):
+        text = 'static int ' + text
+    return text
+
+
+with tempfile.TemporaryDirectory(prefix='mt6762-gauge-latch-') as directory:
+    temporary = Path(directory)
+    (temporary / 'gauge_latch_power_functions.c').write_text(
+        function('verified') + function('pwrap_transfer') + function('mt6762_pwrap_write16'))
+    binary = temporary / 'probe'
+    sanitize = ['-fsanitize=address,undefined', '-fno-omit-frame-pointer'] if options.sanitize else []
+    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror', '-Wno-unused-function',
+                    '-g', '-I', str(temporary), str(HERE / 'test_gauge_latch_integration.c'),
+                    '-o', str(binary)] + sanitize, check=True)
+    subprocess.run([str(binary)], check=True)
diff --git a/tools/mt6762/hardware/power/test_gauge_observer.c b/tools/mt6762/hardware/power/test_gauge_observer.c
new file mode 100644
index 0000000000000000000000000000000000000000..5355103963ae75b09f596399000f49b431ff35cf
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_gauge_observer.c
@@ -0,0 +1,110 @@
+/* Exercise the real native observer and getters with controlled PMIC/time I/O. */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#define MT6762_GAUGE_HOST_TEST 1
+#define NSEC_PER_MSEC 1000000
+#define LCK_GRP_DECLARE(name,text) int name __attribute__((unused))
+#define LCK_MTX_DECLARE(name,group) int name
+static uint64_t test_now,lock_wait,read_delay,interval_preemption;
+static unsigned reads,writes,fail_at;
+static uint16_t control,fixture_current,fixture_low,fixture_high;
+static uint64_t fixture_ticks;
+static int changed_calibration;
+static void lck_mtx_lock(int *m){assert(!*m);*m=1;test_now+=lock_wait;lock_wait=0;}
+static void lck_mtx_unlock(int *m){assert(*m);*m=0;}
+static void clock_get_uptime(uint64_t *v){*v=test_now;}
+static void clock_interval_to_absolutetime_interval(unsigned ms,unsigned scale,uint64_t *v)
+{assert(scale==NSEC_PER_MSEC);test_now+=interval_preemption;*v=ms;}
+static int mt6762_pwrap_read16(uint16_t reg,uint16_t *v)
+{
+ reads++;test_now+=read_delay;
+ if(reads==fail_at)return -1;
+ switch(reg) {
+ case 8:*v=0x5730;break;
+ case 0xd08:*v=0x29;break;
+ case 0xc8e:*v=4096;break;
+ case 0xc90:case 0xd94:case 0xc0c:*v=0;break;
+ case 0xd96:*v=changed_calibration?4095:4096;break;
+ case 0xd0a:*v=control;break;
+ case 0xd8a:*v=fixture_current;break;
+ case 0xd12:*v=fixture_low;break;
+ case 0xd14:*v=fixture_high;break;
+ case 0xd20:*v=fixture_ticks;break;
+ case 0xd22:*v=fixture_ticks>>16;break;
+ case 0xd24:*v=fixture_ticks>>32;break;
+ default:assert(0);
+ }return 0;
+}
+#include "../../../../bsd/dev/mt6762_gauge.c"
+static int fake_read(void *p,uint16_t reg,uint16_t *v)
+{(void)p;return mt6762_pwrap_read16(reg,v);}
+static int fake_write(void *p,uint16_t reg,uint16_t v)
+{
+ (void)p;assert(reg==0xd0a);writes++;
+ assert(v==1 || v==9 || v==8 || v==0);
+ control=v|(v&1?0x8000:0);return 0;
+}
+static void fake_delay(void *p,unsigned us){(void)p;assert(us==10);}
+static void reset(void)
+{
+ test_now=100;lock_wait=read_delay=interval_preemption=0;reads=writes=fail_at=0;control=0;
+ fixture_current=100;fixture_low=0;fixture_high=100;fixture_ticks=10;
+ changed_calibration=0;valid=errors=samples=transport_fault=freshness_rejections=0;
+ raw_current=-1;have_ticks=0;last_ticks=0;memset(&observation,0,sizeof(observation));
+ transport=(struct mt6762_gauge_transport){.io={NULL,fake_read,fake_write,fake_delay}};
+ rfg=100;tune=1000;
+ uint16_t calibration[]={0x29,4096,0,0,4096};memcpy(expected,calibration,sizeof(expected));
+}
+static void fresh_pair(void)
+{observe();assert(!valid);fixture_ticks++;test_now+=10;observe();assert(valid);}
+int main(void)
+{
+ struct gauge_observation out,untouched;
+ reset();memset(&out,0xa5,sizeof(out));untouched=out;
+ observe();assert(!valid && observation_read(&out)==-ENXIO && !memcmp(&out,&untouched,sizeof(out)));
+ fixture_ticks++;test_now+=10;observe();assert(!observation_read(&out));
+ int64_t independent;assert(!mt6762_gauge_charge(0,100,100,1000,&independent));
+ assert(out.current_ua==31400 && out.charge_uah==independent && out.charge_uah>0);
+ assert(out.acquired_abs==110 && out.expires_abs==2110);
+ /* Both signs come from one completed latch, never mixed with the prior pair. */
+ fixture_ticks++;fixture_current=0xff9b;fixture_high=0xff9b;fixture_low=0xf800;
+ observe();assert(!observation_read(&out));assert(out.current_ua==-31400 && out.charge_uah<0);
+ /* Legitimate zero is valid and distinguishable from an unavailable counter. */
+ fixture_ticks++;fixture_current=0xffff;fixture_low=fixture_high=0;
+ observe();assert(!observation_read(&out) && !out.current_ua && !out.charge_uah);
+ /* A partial CAR read must invalidate the whole old pair, then stay faulted. */
+ fixture_ticks++;fail_at=reads+12;observe();assert(!valid && transport.fault);
+ unsigned old_reads=reads,old_writes=writes;observe();assert(reads==old_reads && writes==old_writes);
+ assert(observation_read(&out)==-ENXIO);
+ reset();fresh_pair();fixture_ticks++;changed_calibration=1;observe();assert(!valid && transport_fault);
+ reset();fresh_pair();observe();assert(!valid && freshness_rejections==1 && !transport_fault);
+ fixture_ticks++;observe();assert(valid); /* Fresh progression can recover from a stationary counter. */
+ reset();fresh_pair();fixture_ticks--;observe();assert(!valid && transport_fault);
+ reset();fixture_ticks=(1ull<<33)-1;observe();fixture_ticks=0;observe();assert(valid);
+ /* Slow acquisition keeps the start deadline; it cannot gain a new lease. */
+ reset();observe();fixture_ticks++;read_delay=100;observe();assert(!valid && freshness_rejections==1);
+ assert(!transport_fault);read_delay=0;fixture_ticks++;observe();assert(valid);
+ reset();observe();fixture_ticks++;read_delay=10;uint64_t start=test_now;observe();
+ assert(!observation_read(&out) && out.acquired_abs==start && out.expires_abs==start+2000);
+ test_now=out.expires_abs-1;assert(!observation_read(&out));
+ test_now=out.expires_abs;assert(observation_read(&out)==-ENXIO);
+ /* Preemption after acquired_abs must not move the deadline's origin. */
+ reset();observe();fixture_ticks++;interval_preemption=3000;observe();
+ assert(!valid && freshness_rejections==1 && !transport_fault);
+ interval_preemption=0;fixture_ticks++;observe();assert(valid);
+ reset();observe();fixture_ticks++;interval_preemption=100;start=test_now;observe();
+ assert(!observation_read(&out) && out.acquired_abs==start && out.expires_abs==start+2000);
+ /* Checked absolute deadline overflow rejects before issuing PMIC requests. */
+ reset();test_now=UINT64_MAX-1000;observe();assert(!valid && !reads && !writes);
+ assert(freshness_rejections==1 && !transport_fault);
+ /* A blocked reader checks time after acquiring its lock. */
+ reset();fresh_pair();test_now=observation.expires_abs-1;lock_wait=2;
+ assert(observation_read(&out)==-ENXIO);
+ int ua=123;uint64_t expires=456;
+ assert(mt6762_gauge_current_snapshot(&ua,&expires)==-ENXIO && ua==123 && expires==456);
+ assert(observation_read(NULL)==-EINVAL);
+ puts("native coherent gauge observer: signs/zero/latch/calibration/NTER/acquisition expiry/lock wait PASS");
+}
diff --git a/tools/mt6762/hardware/power/test_gauge_probe.c b/tools/mt6762/hardware/power/test_gauge_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..147d0e8952f1cdf5687f9c212d2d7ad55ddb08da
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_gauge_probe.c
@@ -0,0 +1,86 @@
+/* Portable finite capability tests; no device or kernel execution. */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "mt6762_gauge_probe.h"
+static struct mt6762_gauge_probe_budget armed(unsigned phase)
+{
+    struct mt6762_gauge_probe_budget b={0};
+    static const uint16_t values[]={1,9,8,0};
+    assert(mt6762_gauge_probe_begin(&b,0));
+    assert(mt6762_gauge_probe_arm(&b));
+    for(unsigned i=0;i<phase;i++) {
+        assert(mt6762_gauge_probe_write_begin(&b,0xd0a,values[i]));
+        assert(mt6762_gauge_probe_write_end(&b,0));
+    }
+    return b;
+}
+int main(void)
+{
+    struct mt6762_gauge_probe_profile p={1,100,1000,{0x129,0x416,1,0,0x416}},q;
+    assert(mt6762_gauge_probe_profile_ok(&p) && !mt6762_gauge_probe_profile_ok(NULL));
+    for(unsigned i=0;i<8;i++) {
+        uint32_t words[8];assert(sizeof(words)==sizeof(q));
+        memcpy(words,&p,sizeof(words));words[i]^=1;memcpy(&q,words,sizeof(q));
+        assert(!mt6762_gauge_probe_profile_ok(&q));
+    }
+    uint64_t deadline=42;
+    assert(!mt6762_gauge_probe_deadline(UINT64_MAX-1,2,&deadline) && deadline==42);
+    assert(!mt6762_gauge_probe_deadline(1,0,&deadline));
+    assert(!mt6762_gauge_probe_deadline(1,1,NULL));
+    assert(mt6762_gauge_probe_deadline(10,20,&deadline) && deadline==30);
+    assert(!mt6762_gauge_probe_in_lease(10,30,9));
+    assert(mt6762_gauge_probe_in_lease(10,30,10));
+    assert(mt6762_gauge_probe_in_lease(10,30,29));
+    assert(!mt6762_gauge_probe_in_lease(10,30,30));
+    assert(!mt6762_gauge_probe_in_lease(10,10,10));
+    static const uint16_t sequence[]={1,9,8,0};
+    for(unsigned phase=0;phase<4;phase++)for(unsigned value=0;value<65536;value++) {
+        struct mt6762_gauge_probe_budget b=armed(phase);
+        int ok=mt6762_gauge_probe_write_begin(&b,0xd0a,(uint16_t)value);
+        assert(ok==(value==sequence[phase]));
+        assert(b.attempted==phase+(unsigned)ok);
+        if(!ok)assert(b.fault && !mt6762_gauge_probe_write_begin(&b,0xd0a,sequence[phase]));
+    }
+    for(unsigned reg=0;reg<65536;reg++) {
+        struct mt6762_gauge_probe_budget b=armed(0);
+        assert(mt6762_gauge_probe_write_begin(&b,(uint16_t)reg,1)==(reg==0xd0a));
+    }
+    for(unsigned phase=0;phase<4;phase++) {
+        struct mt6762_gauge_probe_budget b=armed(phase);
+        assert(mt6762_gauge_probe_write_begin(&b,0xd0a,sequence[phase]));
+        assert(!mt6762_gauge_probe_read_allowed(&b,0xd0a));
+        assert(!mt6762_gauge_probe_write_end(&b,-1));
+        assert(b.fault && !b.pending && b.attempted==phase+1 && b.completed==phase);
+        assert(!mt6762_gauge_probe_write_begin(&b,0xd0a,sequence[phase]));
+        assert(!mt6762_gauge_probe_begin(&b,0));
+    }
+    struct mt6762_gauge_probe_budget b={0};
+    assert(!mt6762_gauge_probe_read_allowed(&b,8));
+    assert(mt6762_gauge_probe_begin(&b,0));
+    assert(mt6762_gauge_probe_read_allowed(&b,8));
+    assert(!mt6762_gauge_probe_read_allowed(&b,0xd8a));
+    assert(!mt6762_gauge_probe_write_begin(&b,0xd0a,1)); /* Not armed. */
+    b=armed(0);assert(!mt6762_gauge_probe_read_allowed(&b,0xd8a));
+    b=armed(1);assert(mt6762_gauge_probe_read_allowed(&b,0xd8a));
+    b=armed(2);assert(!mt6762_gauge_probe_read_allowed(&b,0xd8a));
+    b=armed(0);assert(!mt6762_gauge_probe_finish(&b));
+    b=armed(4);assert(mt6762_gauge_probe_finish(&b));
+    assert(!mt6762_gauge_probe_read_allowed(&b,8));
+    assert(mt6762_gauge_probe_begin(&b,1) && mt6762_gauge_probe_arm(&b));
+    for(unsigned i=0;i<4;i++) {
+        assert(mt6762_gauge_probe_write_begin(&b,0xd0a,sequence[i]));
+        assert(mt6762_gauge_probe_write_end(&b,0));
+    }
+    assert(mt6762_gauge_probe_finish(&b) && b.completed==8 && b.attempted==8);
+    assert(!mt6762_gauge_probe_begin(&b,2));
+    assert(!mt6762_gauge_probe_write_begin(&b,0xd0a,1));
+    b=armed(0);b.attempted=8;assert(!mt6762_gauge_probe_write_begin(&b,0xd0a,1));
+    b=armed(0);b.pending=1;assert(!mt6762_gauge_probe_write_begin(&b,0xd0a,1));
+    b=armed(0);assert(!mt6762_gauge_probe_arm(&b));
+    b=armed(0);assert(!mt6762_gauge_probe_begin(&b,0));
+    b=armed(0);assert(!mt6762_gauge_probe_write_end(&b,0));
+    assert(!mt6762_gauge_probe_write_begin(NULL,0xd0a,1));
+    puts("gauge finite policy: exact profile, exhaustive address/value rejection, phase/budget/sticky failure, leases PASS");
+}
diff --git a/tools/mt6762/hardware/power/test_native_charger.c b/tools/mt6762/hardware/power/test_native_charger.c
new file mode 100644
index 0000000000000000000000000000000000000000..591c32e71945957e5e0e0098e37d8eec6eb0ee1e
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_native_charger.c
@@ -0,0 +1,114 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../../../../bsd/dev/mt6762_charger_protocol.h"
+struct model { uint8_t id,control; unsigned reads,writes; int fail_read,fail_write,no_latch,other_change; };
+struct observation_model { uint8_t id,control,status; unsigned reads,writes; int fail; };
+static int observation_read(void *p,uint8_t reg,uint8_t *v)
+{
+    static const uint8_t order[]={3,1,0};
+    struct observation_model *m=p;
+    assert(m->reads<3 && reg==order[m->reads]);
+    if(++m->reads==(unsigned)m->fail)return -8;
+    *v=reg==3?m->id:reg==1?m->control:m->status;
+    return 0;
+}
+static int observation_write(void *p,uint8_t reg,uint8_t v)
+{(void)reg;(void)v;((struct observation_model *)p)->writes++;return -9;}
+static void observation_tests(void)
+{
+    struct observation_model m={0};
+    struct mt6762_psc_io io={&m,observation_read,observation_write};
+    struct mt6762_psc_observation out;
+    for(unsigned control=0;control<256;control++)for(unsigned status=0;status<256;status++) {
+        m=(struct observation_model){.id=0xf0,.control=control,.status=status};
+        assert(!mt6762_psc_observe(&io,&out));
+        assert(out.id==0xf0 && out.control==control && out.status==status);
+        assert(m.reads==3 && !m.writes);
+    }
+    for(unsigned id=0;id<256;id++)if(id!=0xf0) {
+        m=(struct observation_model){.id=id};out=(struct mt6762_psc_observation){0xaa,0xbb,0xcc};
+        assert(mt6762_psc_observe(&io,&out)==-2 && m.reads==1 && !m.writes);
+        assert(out.id==0xaa && out.control==0xbb && out.status==0xcc);
+    }
+    for(int failure=1;failure<=3;failure++) {
+        m=(struct observation_model){.id=0xf0,.fail=failure};
+        out=(struct mt6762_psc_observation){0xaa,0xbb,0xcc};
+        assert(mt6762_psc_observe(&io,&out)==-8 && m.reads==(unsigned)failure && !m.writes);
+        assert(out.id==0xaa && out.control==0xbb && out.status==0xcc);
+    }
+    m=(struct observation_model){.id=0xf0};io.write=NULL;
+    assert(!mt6762_psc_observe(&io,&out) && m.reads==3);
+    m.reads=0;
+    assert(mt6762_psc_observe(NULL,&out)==-1 && mt6762_psc_observe(&io,NULL)==-1 && !m.reads);
+    io.read=NULL;assert(mt6762_psc_observe(&io,&out)==-1 && !m.reads);
+}
+static int rd(void *p,uint8_t reg,uint8_t *v)
+{
+    struct model *m=p;m->reads++;
+    if(m->fail_read==(int)m->reads)return -8;
+    assert(reg==3 || reg==1);*v=reg==3?m->id:m->control;
+    if(m->other_change && m->writes)*v^=0x40;
+    return 0;
+}
+static int wr(void *p,uint8_t reg,uint8_t v)
+{
+    struct model *m=p;assert(reg==1);m->writes++;
+    assert(v==(uint8_t)(m->control|4)); /* no other field changes */
+    if(m->fail_write)return -9;
+    if(!m->no_latch)m->control=v;
+    return 0;
+}
+static void disable_tests(void)
+{
+    struct model m={.id=0xf0,.control=0xf8};
+    struct mt6762_psc_io io={&m,rd,wr};uint8_t output=0xaa;
+    assert(!mt6762_psc_disable_owned(&io,1,&output));
+    assert(m.control==0xfc && output==0xfc && m.writes==1 && m.reads==3);
+    m=(struct model){.id=0xf0,.control=0xfc};
+    assert(!mt6762_psc_disable_owned(&io,1,&output) && !m.writes && m.reads==3);
+    m=(struct model){.id=0xf0};output=0xaa;
+    assert(mt6762_psc_disable_owned(&io,0,&output)==-1 && !m.reads && !m.writes);
+    m=(struct model){.id=0xee};
+    assert(mt6762_psc_disable_owned(&io,1,&output)==-2 && !m.writes && output==0xaa);
+    m=(struct model){.id=0xf0,.control=1};
+    assert(mt6762_psc_disable_owned(&io,1,&output)==-3 && !m.writes && output==0xaa);
+    for(int n=1;n<=3;n++) {
+        m=(struct model){.id=0xf0,.fail_read=n};
+        assert(mt6762_psc_disable_owned(&io,1,&output)==-8 && output==0xaa);
+        assert(m.writes==(unsigned)(n==3));
+    }
+    m=(struct model){.id=0xf0,.fail_write=1};
+    assert(mt6762_psc_disable_owned(&io,1,&output)==-9 && output==0xaa);
+    m=(struct model){.id=0xf0,.no_latch=1};
+    assert(mt6762_psc_disable_owned(&io,1,&output)==-4 && output==0xaa);
+    m=(struct model){.id=0xf0,.other_change=1};
+    assert(mt6762_psc_disable_owned(&io,1,&output)==-4 && output==0xaa);
+}
+static void decoder_tests(void)
+{
+    uint32_t v=999;
+    assert(!mt6762_psc_voltage_uv(0,0,&v) && v==4100000);
+    assert(!mt6762_psc_voltage_uv(4,0,&v) && v==4100000);
+    assert(!mt6762_psc_voltage_uv(8,0,&v) && v==4200000);
+    assert(!mt6762_psc_voltage_uv(35*4,0,&v) && v==4200000);
+    assert(!mt6762_psc_voltage_uv(36*4,0,&v) && v==4350000);
+    assert(!mt6762_psc_voltage_uv(44*4,0x80,&v) && v==4370000);
+    assert(!mt6762_psc_voltage_uv(45*4,0,&v) && v==4400000);
+    assert(!mt6762_psc_voltage_uv(62*4,0x80,&v) && v==4420000);
+    assert(mt6762_psc_voltage_uv(63*4,0,&v) && v==4420000);
+    assert(!mt6762_psc_input_ua(0,&v) && v==150000);
+    assert(!mt6762_psc_input_ua(0x40,&v) && v==500000);
+    assert(!mt6762_psc_input_ua(0x80,&v) && v==800000);
+    assert(mt6762_psc_input_ua(0xc0,&v) && v==800000);
+    assert(!mt6762_psc_current_ua(0,0,50000,&v) && v==656000);
+    assert(!mt6762_psc_current_ua(0x70,0,50000,&v) && v==1966000);
+    assert(!mt6762_psc_current_ua(0x70,1,50000,&v) && v==1734000);
+    assert(!mt6762_psc_current_ua(0x20,1,50000,&v) && v==800000);
+    assert(!mt6762_psc_current_ua(0,0,56000,&v) && v==585714);
+    assert(mt6762_psc_current_ua(0,0,0,&v) && v==585714);
+    assert(mt6762_psc_current_ua(0x70,0,1,&v) && v==585714);
+    assert(!mt6762_psc_termination_ua(0,50000,&v) && v==50000);
+    assert(!mt6762_psc_termination_ua(7,50000,&v) && v==226000);
+    assert(mt6762_psc_termination_ua(7,0,&v) && v==226000);
+}
+int main(void) {observation_tests();disable_tests();decoder_tests();puts("native charger observation, ownership, disable/readback, nominal datasheet decoders: PASS");return 0;}
diff --git a/tools/mt6762/hardware/power/test_native_gauge.c b/tools/mt6762/hardware/power/test_native_gauge.c
new file mode 100644
index 0000000000000000000000000000000000000000..432a7b81f48dd4da1f43e6958c6908b30d7d6911
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_native_gauge.c
@@ -0,0 +1,57 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../../../bsd/dev/mt6762_gauge_protocol.h"
+#include "gauge_vectors.h"
+struct fake {unsigned reads,writes,delays,fault;uint16_t control;};
+static int rd(void *p,uint16_t r,uint16_t *v)
+{
+ struct fake *f=p;f->reads++;
+ if(f->fault==5)return -1;
+ if(r==0xc0c)*v=f->fault==1?0x18:0;
+ else if(r==0xd08)*v=1;
+ else if(r==0xd0a)*v=f->control;
+ else if(r==0xd8a)*v=100;
+ else if(r==0xd12)*v=0;
+ else if(r==0xd14)*v=1;
+ else if(r==0xd20)*v=10;
+ else if(r==0xd22||r==0xd24)*v=0;
+ else assert(0);
+ return 0;
+}
+static int wr(void *p,uint16_t r,uint16_t v)
+{
+ struct fake *f=p;f->writes++;assert(r==0xd0a);assert(!(v&0x1f06));
+ if(f->fault==6)return -1;
+ f->control=v;
+ if((v&1) && f->fault!=3)f->control|=0x8000;
+ if((v&8) && f->fault==4)f->control|=0x8000;
+ return 0;
+}
+static void wait(void *p,unsigned us) {struct fake *f=p;assert(us==10);f->delays++;}
+int main(void)
+{
+ for(unsigned i=0;i<sizeof(gauge_vectors)/sizeof(gauge_vectors[0]);i++) {
+  const long long *v=gauge_vectors[i];int ua;int64_t uah;
+  assert(!mt6762_gauge_current((uint16_t)v[0],(unsigned)v[3],(unsigned)v[4],&ua) && ua==v[5]);
+  assert(!mt6762_gauge_charge((uint16_t)v[1],(uint16_t)v[2],(unsigned)v[3],(unsigned)v[4],&uah) && uah==v[6]);
+ }
+ for(unsigned fault=0;fault<7;fault++) {
+  struct fake f={.fault=fault,.control=fault==2?0x8000:0};
+  struct mt6762_gauge_transport t={.io={&f,rd,wr,wait}};
+  struct mt6762_gauge_snapshot s={.current=1234},old=s;
+  int e=mt6762_gauge_capture(&t,&s);
+  if(!fault)assert(!e && s.current==100 && s.ticks==10 && f.writes==4 && !f.control);
+  else {
+   assert(e && t.fault && !memcmp(&s,&old,sizeof(s)));
+   if(fault==1||fault==2||fault==5)assert(!f.writes);
+   unsigned reads=f.reads,writes=f.writes;
+   assert(mt6762_gauge_capture(&t,&s) && f.reads==reads && f.writes==writes);
+  }
+  assert(f.delays<=1000);
+ }
+ assert(!mt6762_gauge_progress(1,1));assert(mt6762_gauge_progress(1,2));
+ assert(!mt6762_gauge_progress(1000,1));assert(mt6762_gauge_progress((1ull<<33)-1,0));
+ int ua=123;assert(mt6762_gauge_current(100,0,1000,&ua) && ua==123);
+ puts("native gauge original-code arithmetic/latch/freshness tests: PASS");
+}
diff --git a/tools/mt6762/hardware/power/test_native_power.c b/tools/mt6762/hardware/power/test_native_power.c
new file mode 100644
index 0000000000000000000000000000000000000000..1e3ee41062aafdb19e1a44c6a948d6f0e2505fec
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_native_power.c
@@ -0,0 +1,129 @@
+/* Exercises the exact header used by bsd/dev/mt6762_power.c. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../../../bsd/dev/mt6762_power_protocol.h"
+#include "mt6762_pwrap_entry.h"
+#define INIT (1u << 21)
+struct mock { uint32_t states[8],offset[8],value[8]; unsigned n,index,reads,writes,delay; };
+static uint32_t rd(void *p,uint32_t off)
+{
+    struct mock *m=p;assert(off==0xc24);m->reads++;
+    unsigned i=m->index<m->n ? m->index++ : m->n-1;
+    return m->states[i];
+}
+static void wr(void *p,uint32_t off,uint32_t v)
+{struct mock *m=p;assert(m->writes<8);m->offset[m->writes]=off;m->value[m->writes++]=v;}
+static void wait_us(void *p,unsigned us) {((struct mock *)p)->delay+=us;}
+static void wacs_tests(void)
+{
+    struct mock m={.states={INIT,INIT|(2u<<16),INIT|(6u<<16)|0xbeef,INIT},.n=4};
+    struct mt6762_wacs_io io={&m,rd,wr,wait_us};uint16_t v=0x1234;
+    assert(!mt6762_wacs_transfer(&io,0,0x24,&v));assert(v==0xbeef);
+    assert(m.writes==2 && m.offset[0]==0xc20 && m.value[0]==0x00120000);
+    assert(m.offset[1]==0xc28 && m.value[1]==1 && m.delay==10);
+    m=(struct mock){.states={INIT,INIT|(2u<<16),INIT},.n=3};v=0xabcd;
+    assert(!mt6762_wacs_transfer(&io,1,0x110e,&v));
+    assert(m.writes==1 && m.value[0]==0x8887abcd && v==0xabcd);
+    m=(struct mock){.states={0},.n=1};v=0x1234;
+    assert(mt6762_wacs_transfer(&io,0,8,&v)==-2 && !m.writes && v==0x1234);
+    m=(struct mock){.states={INIT|(2u<<16)},.n=1};
+    assert(mt6762_wacs_transfer(&io,0,8,&v)==-3 && !m.writes);
+    assert(m.reads==1000 && m.delay==10000 && v==0x1234);
+    m=(struct mock){.states={INIT,INIT|(2u<<16)},.n=2};
+    assert(mt6762_wacs_transfer(&io,0,8,&v)==-3 && m.writes==1 && v==0x1234);
+    m=(struct mock){.states={INIT,INIT|(6u<<16)|0x5730,INIT|(2u<<16)},.n=3};
+    assert(mt6762_wacs_transfer(&io,0,8,&v)==-3 && m.writes==2 && v==0x1234);
+    m=(struct mock){.states={INIT},.n=1};
+    assert(mt6762_wacs_transfer(&io,0,7,&v)==-1 && !m.reads && !m.writes);
+    assert(mt6762_wacs_transfer(NULL,0,8,&v)==-1);
+    for(unsigned profile=1;profile<=2;profile++)for(unsigned bits=0;bits<4;bits++) {
+        uint32_t init=bits<<21;v=0x1234;
+        m=(struct mock){.states={init,init|(6u<<16)|0x5730,init},.n=3};
+        int error=mt6762_wacs_transfer_profile(&io,profile,0,8,&v);
+        if(bits&(1u<<(profile-1))) {
+            assert(!error && v==0x5730 && m.writes==2);
+            assert(m.offset[0]==0xc20 && m.value[0]==0x40000);
+            assert(m.offset[1]==0xc28 && m.value[1]==1);
+        } else assert(error==-2 && v==0x1234 && !m.writes && m.reads==1);
+    }
+    m=(struct mock){.states={3u<<21},.n=1};v=0x1234;
+    assert(mt6762_wacs_transfer_profile(&io,0,0,8,&v)==-1 && !m.reads && !m.writes);
+    assert(mt6762_wacs_transfer_profile(&io,3,0,8,&v)==-1 && !m.reads && !m.writes);
+    for(unsigned phase=0;phase<3;phase++) {
+        uint32_t init=1u<<22;
+        m=(struct mock){.states={init,init|(6u<<16)|0x5730,init|(2u<<16)},.n=3};
+        if(!phase)m=(struct mock){.states={init|(6u<<16)},.n=1};
+        if(phase==1)m=(struct mock){.states={init,init|(2u<<16)},.n=2};
+        assert(mt6762_wacs_transfer_profile(&io,2,0,8,&v)==-3);
+        assert(v==0x1234 && m.writes==phase);
+    }
+}
+struct entry_mock {uint32_t bad_address,bad_value;unsigned reads;};
+static uint32_t entry_rd(void *ctx,uint32_t a)
+{
+    struct entry_mock *m=ctx;m->reads++;
+    if(a==m->bad_address)return m->bad_value;
+    switch(a) {
+    case 0x10001090:case 0x1000d000:case 0x1000d07c:return 0;
+    case 0x1000d004:case 0x1000d09c:case 0x1000d0a0:return 1;
+    case 0x1000dc24:return 0x80f00800; /* actual capture17 */
+    default:assert(0);return 0;
+    }
+}
+static void entry_tests(void)
+{
+    struct entry_mock m={0};assert(mt6762_pwrap_entry_ok(entry_rd,&m));assert(m.reads==14);
+    const uint32_t bad[][2]={{0x10001090,2},{0x1000d000,1},{0x1000d004,0},
+        {0x1000d07c,1},{0x1000d09c,0},{0x1000d0a0,0},
+        {0x1000dc24,1u<<21},{0x1000dc24,0x460000},{0x1000dc24,0x420000}};
+    for(unsigned n=0;n<sizeof(bad)/sizeof(bad[0]);n++) {
+        m=(struct entry_mock){bad[n][0],bad[n][1],0};
+        assert(!mt6762_pwrap_entry_ok(entry_rd,&m));
+        if(!n)assert(m.reads==1);
+    }
+}
+struct adc { uint16_t out,request,address; unsigned reads,writes,delay,pending; int re,we; };
+static int adc_rd(void *p,uint16_t address,uint16_t *v)
+{struct adc *a=p;assert(address==a->address);a->reads++;if(a->re)return a->re;*v=a->reads<=a->pending?0:a->out;return 0;}
+static int adc_wr(void *p,uint16_t address,uint16_t v)
+{struct adc *a=p;assert(address==0x110e);a->request=v;a->writes++;return a->we;}
+static void adc_delay(void *p,unsigned us) {((struct adc *)p)->delay+=us;}
+static void adc_tests(void)
+{
+    struct adc a={.out=0x8000|26700,.address=0x108a,.pending=2};
+    struct mt6762_adc_io io={&a,adc_rd,adc_wr,adc_delay};int mv=-1;
+    assert(!mt6762_adc_sample(&io,1,&mv));
+    assert(mv==4400 && a.request==2 && a.reads==3 && a.delay==1480);
+    a=(struct adc){.out=0x8000|1400,.address=0x108e,.pending=1};
+    assert(!mt6762_adc_sample(&io,3,&mv));assert(mv==615 && a.request==8 && a.delay==80);
+    a=(struct adc){.out=0,.address=0x108e};mv=777;
+    assert(mt6762_adc_sample(&io,3,&mv)==-3 && mv==777 && a.reads==161);
+    a=(struct adc){.out=0x8000,.address=0x108e,.pending=1};
+    assert(mt6762_adc_sample(&io,3,&mv)==-4 && mv==777);
+    a=(struct adc){.out=0x8fff,.address=0x108e,.pending=1};
+    assert(mt6762_adc_sample(&io,3,&mv)==-4 && mv==777);
+    a=(struct adc){.address=0x108e,.we=-9};
+    assert(mt6762_adc_sample(&io,3,&mv)==-2 && !a.reads && mv==777);
+    a=(struct adc){.address=0x108e,.re=-8};
+    assert(mt6762_adc_sample(&io,3,&mv)==-2 && mv==777);
+    a=(struct adc){.out=0x8000|1400,.address=0x108e};
+    assert(mt6762_adc_sample(&io,3,&mv)==-5 && mv==777);
+    a=(struct adc){0};assert(mt6762_adc_sample(&io,11,&mv)==-1 && !a.writes);
+}
+static void keys_tests(void)
+{
+    struct mt6762_key_filter k={0};
+    for(unsigned i=0;i<10;i++)assert(!mt6762_key_update(&k,1,1)); /* held across handoff */
+    assert(!mt6762_key_update(&k,1,0));
+    assert(!mt6762_key_update(&k,1,1));assert(!mt6762_key_update(&k,1,0));
+    assert(!mt6762_key_update(&k,1,1));assert(mt6762_key_update(&k,1,1)==1);
+    assert(!mt6762_key_update(&k,1,1));
+    assert(!mt6762_key_update(&k,1,0));assert(mt6762_key_update(&k,1,0)==-1);
+    assert(!mt6762_key_update(&k,1,1));assert(mt6762_key_update(&k,1,1)==1);
+    assert(mt6762_key_update(&k,0,0)==-1);assert(!mt6762_key_update(&k,0,0));
+    assert(!mt6762_key_update(&k,1,1));assert(!mt6762_key_update(&k,1,1));
+    assert(!mt6762_key_update(&k,1,0));assert(!mt6762_key_update(&k,1,1));
+    assert(mt6762_key_update(&k,1,1)==1);
+}
+int main(void) {wacs_tests();entry_tests();adc_tests();keys_tests();puts("native PWRAP profiles/admission, ADC and button tests: PASS");return 0;}
diff --git a/tools/mt6762/hardware/power/test_ntc_compensation.c b/tools/mt6762/hardware/power/test_ntc_compensation.c
