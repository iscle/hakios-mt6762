diff --git a/tools/mt6762/hardware/power/test_vbat_observer_integration.c b/tools/mt6762/hardware/power/test_vbat_observer_integration.c
new file mode 100644
index 0000000000000000000000000000000000000000..dd60611220edc72ac98ae52fa107c8f70b9b516c
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_vbat_observer_integration.c
@@ -0,0 +1,97 @@
+/* Reuse the exact observer/WACS fixture; this entry exercises only VBAT. */
+#define MT6762_VBAT_TEST
+#include "test_battery_observer_integration.c"
+#include "vbat_vectors.h"
+static void vbat_start(unsigned gauge) {properties[21].value=1;start(gauge);}
+int main(void)
+{
+    reset();vbat_start(0);battery_inherited_poll();
+    assert(count==54 && adc_requests==1 && adc_voltage_requests==1 && adc_voltage_samples==1);
+    assert(!battery_observer.fault && !battery_observer.vbat_fault && !adc_mutex);
+    assert(published.valid==0x47 && published.voltage_uv==4119000 && pmic_writes==1);
+    assert(battery_adc_mv==4119 && adc_voltage_min==4119 && adc_voltage_max==4119);
+    struct txn baseline[54];memcpy(baseline,transactions,sizeof(baseline));
+    assert(baseline[27].write && baseline[27].reg==0x110e && baseline[27].value==2);
+    battery_inherited_poll();assert(count==54 && adc_requests==1);
+    next();assert(count==108 && adc_requests==2 && published.valid==0x47);
+    reset();vbat_start(1);battery_inherited_poll();assert(count==86 && pmic_writes==5 && published.valid==0x47);
+    next();assert(count==172 && pmic_writes==10 && published.valid==0x4f && snapshot()==0);
+    assert(published.current_ua==31400 && published.voltage_uv==4119000);
+    unsigned faults=0;
+    for(unsigned at=1;at<=54;at++)for(unsigned stage=0;stage<4;stage++) {
+        if(stage==2 && baseline[at-1].write)continue;
+        reset();vbat_start(0);fail_at=at;fail_stage=stage;battery_inherited_poll();
+        assert(pwrap_fault && battery_observer.fault && !published.valid && count==at-(stage==0));
+        unsigned writes=0;
+        for(unsigned i=0;i<count;i++)writes+=baseline[i].write;
+        assert(pmic_writes==writes && adc_requests==writes && adc_requests<=1);
+        assert(!adc_mutex && !pwrap_mutex && !battery_observer.vbat_context);
+        terminal();faults++;
+    }
+    for(unsigned at=1;at<=54;at++) {
+        reset();vbat_start(0);late_at=at;battery_inherited_poll();
+        assert(count==at && !pwrap_fault && battery_observer.fault && !published.valid);
+        assert(adc_requests<=1 && !adc_mutex);terminal();
+    }
+    unsigned mutations=0;
+    for(unsigned after=0;after<2;after++)for(unsigned i=0;i<24;i++) {
+        reset();vbat_start(0);mutate_at=(after?30:3)+i+1;battery_inherited_poll();
+        assert(count==mutate_at && !pwrap_fault && !battery_observer.fault && battery_observer.vbat_fault);
+        assert(adc_requests==after && published.valid==0x43 && battery_adc_mv==-1 && !adc_voltage_samples);
+        unsigned requests=adc_requests;next();assert(adc_requests==requests && published.valid==0x43);
+        mutations++;
+    }
+    for(unsigned missing=22;missing<=27;missing++) {
+        reset();properties[21].value=1;missing_property=(int)missing;
+        assert(!battery_inherited_admit() && !count);
+        reset();properties[21].value=1;properties[missing].value=0x10000;
+        assert(!battery_inherited_admit() && !count);
+    }
+    for(unsigned bad=0;bad<4;bad++) {
+        reset();vbat_start(0);
+        switch(bad) {case 0:adc_stale=1;break;case 1:adc_timeout=1;break;case 2:adc_raw=0;break;case 3:adc_raw=0x7fff;break;}
+        battery_inherited_poll();
+        assert(battery_observer.vbat_fault && !battery_observer.fault && published.valid==0x43);
+        assert(adc_requests==1 && adc_voltage_requests==1 && !adc_voltage_samples && battery_adc_mv==-1);
+        next();assert(adc_requests==1 && published.valid==0x43);
+        assert(strstr(messages,"cleanup_writes=0"));
+    }
+    reset();vbat_start(0);adc_delay_late=1;battery_inherited_poll();
+    assert(battery_observer.fault && adc_requests==1 && !published.valid);terminal();
+    reset();vbat_start(0);adc_lock_delay=2000000;battery_inherited_poll();
+    assert(battery_observer.fault && count==3 && !adc_requests && !published.valid);terminal();
+    for(unsigned i=0;i<sizeof(vbat_vectors)/sizeof(vbat_vectors[0]);i++) {
+        reset();vbat_start(0);adc_raw=(uint16_t)vbat_vectors[i][0];battery_inherited_poll();
+        if(adc_raw==0 || adc_raw==32767)assert(published.valid==0x43 && battery_observer.vbat_fault);
+        else assert(published.valid==0x47 && published.voltage_uv==vbat_vectors[i][1]*1000);
+    }
+    /* Failure after a previously published voltage replaces its validity. */
+    reset();vbat_start(1);battery_inherited_poll();next();assert(published.valid==0x4f);
+    adc_stale=1;next();assert(published.valid==0x4b && battery_observer.vbat_fault && snapshot()==0);
+    assert(battery_adc_mv==-1 && adc_requests==3);next();assert(adc_requests==3 && published.valid==0x4b);
+    /* Callback shapes, one-shot budget, phase, identity and lease cannot be
+     * expanded by a caller; general PWRAP writes stay refused throughout. */
+    for(unsigned misuse=0;misuse<12;misuse++) {
+        reset();vbat_start(0);
+        struct vbat_observer_context ctx={.lease={now_us,now_us+2000000},.phase=2};
+        battery_observer.vbat_context=&ctx;uint16_t reg=0x110e,value=2;
+        switch(misuse) {
+        case 0:reg=0x1110;break;case 1:reg=0x1236;break;case 2:value=8;break;
+        case 3:ctx.attempted=1;break;case 4:ctx.phase=1;break;case 5:ctx.phase=3;break;
+        case 6:battery_observer.vbat_context=NULL;break;case 7:battery_observer.vbat_fault=1;break;
+        case 8:battery_observer.active=0;break;case 9:now_us=ctx.lease.end;break;
+        case 10:now_us=ctx.lease.start-1;break;case 11:ctx.fault=1;break;
+        }
+        assert(vbat_observer_write(&ctx,reg,value)<0 && !count && ctx.fault);
+        assert(vbat_observer_write(&ctx,0x110e,2)<0 && !count);
+        assert(mt6762_pwrap_write16(0x110e,2)==-EPERM && !count);
+    }
+    reset();vbat_start(0);struct vbat_observer_context ctx={.lease={now_us,now_us+2000000},.phase=2};
+    battery_observer.vbat_context=&ctx;uint16_t raw=42;
+    assert(vbat_observer_read(&ctx,0x108a,&raw)<0 && raw==42 && !count); /* no request */
+    reset();vbat_start(0);ctx=(struct vbat_observer_context){.lease={now_us,now_us+2000000},.phase=2};
+    battery_observer.vbat_context=&ctx;
+    assert(!vbat_observer_write(&ctx,0x110e,2) && adc_requests==1);
+    assert(vbat_observer_write(&ctx,0x110e,2)<0 && adc_requests==1);
+    printf("actual native VBAT observer: %u WACS faults, %u shadow changes, 54 expiry positions, generation/lease/publication/private one-shot gates PASS\n",faults,mutations);
+}
diff --git a/tools/mt6762/hardware/power/test_vbat_observer_integration.py b/tools/mt6762/hardware/power/test_vbat_observer_integration.py
new file mode 100644
index 0000000000000000000000000000000000000000..dee8ed9d857b73b59781bff3af346aad04216703
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_vbat_observer_integration.py
@@ -0,0 +1,51 @@
+"""Compile actual inherited VBAT observer + actual public PWRAP guard; no hardware I/O."""
+from pathlib import Path
+import argparse
+import json
+import re
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+SOURCE = (HERE.parents[3] / 'bsd/dev/mt6762_power.c').read_text()
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--sanitize', action='store_true', help='Enable host AddressSanitizer and UBSan')
+options = parser.parse_args()
+
+
+def function(name, source=SOURCE):
+    marker = source.index(name + '(')
+    begin = source.rfind('\n', 0, marker) + 1
+    opening = source.index('{', marker)
+    depth, end = 1, opening + 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    text = source[begin:end] + '\n'
+    # The public API's type is on the same line; static functions have their
+    # return type on the preceding line in this driver.
+    if text.startswith(name + '('):
+        text = 'static int ' + text
+    return text
+
+
+with tempfile.TemporaryDirectory(prefix='mt6762-vbat-observer-') as directory:
+    temporary = Path(directory)
+    vectors = json.loads((HERE / 'evidence/stock-vbat-vectors.json').read_text())
+    assert vectors['image_sha256'] == '82b1919185a49f268a0f8e145a6714d6264c1f66918a90df0d763266147ead4b'
+    (temporary / 'vbat_vectors.h').write_text('static const int vbat_vectors[][2]={' +
+        ','.join('{%d,%d}' % (row['raw'], row['millivolts']) for row in vectors['cases']) + '};\n')
+    (temporary / 'battery_observer_power_functions.c').write_text(
+        function('verified') + function('pwrap_transfer') + function('mt6762_pwrap_read16') + function('mt6762_pwrap_write16') + function('adc_observed'))
+    gauge = (HERE.parents[3] / 'bsd/dev/mt6762_gauge.c').read_text()
+    observation = re.search(r'struct gauge_observation \{.*?\n\};', gauge, re.S).group()
+    (temporary / 'battery_observer_gauge_getters.c').write_text(observation + '\n' +
+        'static int gauge_mutex,valid;\nstatic struct gauge_observation observation;\n' +
+        function('observation_read', gauge) + function('mt6762_gauge_current_snapshot', gauge) +
+        function('mt6762_gauge_current_read', gauge))
+    binary = temporary / 'probe'
+    sanitize = ['-fsanitize=address,undefined', '-fno-omit-frame-pointer'] if options.sanitize else []
+    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror', '-Wno-unused-function',
+                    '-g', '-I', str(temporary), str(HERE / 'test_vbat_observer_integration.c'),
+                    '-o', str(binary)] + sanitize, check=True)
+    subprocess.run([str(binary)], check=True)
diff --git a/tools/mt6762/hardware/power/test_vbat_profile.py b/tools/mt6762/hardware/power/test_vbat_profile.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c6d50c6286165881a80d94e896f44c3baca8050
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_vbat_profile.py
@@ -0,0 +1,96 @@
+"""Exact live ADC routing/configuration admission; host only."""
+import ctypes as C
+import random
+import struct
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+from test_gauge_baseline import node, fdt, U32, COMPATIBLES
+
+HERE=Path(__file__).resolve().parent
+NAMES=b'pmic_battery_temp\0pmic_battery_voltage\0pmic_bif_voltage\0pmic_ptim_voltage\0pmic_ptim_r\0'
+class Profile(C.Structure):
+    _fields_=[(x,C.c_uint32) for x in ['version','fdt_size','phandle','channel','ratio_num','ratio_den','avg_num']]
+def tree(phandle=39):
+    nodes=[node(n,[('compatible',c)]) for n,c in zip(['','pwrap@1000d000','main_pmic','mtk_gauge'],COMPATIBLES)]
+    for parent,child in zip(nodes[:2],nodes[1:3]):parent[2].append(child)
+    nodes[2][2].append(nodes[3])
+    nodes[3][1].extend([('io-channels',b''.join(U32(phandle)+U32(ch) for ch in [3,1,14,15,16])),('io-channel-names',NAMES)])
+    adc=node('pmic_auxadc',[('compatible',b'mediatek,pmic-auxadc\0mediatek,mt6357-auxadc\0'),('phandle',U32(phandle)),('#io-channel-cells',U32(1))])
+    channel=node('isense',[('channel',U32(1)),('resistance-ratio',U32(3)+U32(1)),('avg-num',U32(128))])
+    adc[2].append(channel);nodes[2][2].append(adc)
+    return nodes+[adc,channel]
+class Tests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp=tempfile.TemporaryDirectory();cls.addClassCleanup(cls.tmp.cleanup)
+        path=Path(cls.tmp.name)
+        (path/'entry.c').write_text('#include "mt6762_vbat_profile.h"\nint entry(const uint16_t *p){return mt6762_vbat_entry_ok(p);}\n')
+        subprocess.run(['cc','-std=c11','-Wall','-Wextra','-Werror','-shared','-fPIC','-I',str(HERE),str(HERE/'mt6762_vbat_fdt.c'),str(path/'entry.c'),'-o',str(path/'profile.so')],check=True)
+        cls.lib=C.CDLL(str(path/'profile.so'));cls.query=cls.lib.mt6762_vbat_profile_from_fdt
+        cls.query.argtypes=[C.c_void_p,C.c_size_t,C.POINTER(Profile)];cls.query.restype=C.c_int
+        cls.lib.entry.argtypes=[C.POINTER(C.c_uint16)];cls.lib.entry.restype=C.c_int
+    def parse(self,b,accessible=None):
+        b=bytes(b);buf=C.create_string_buffer(b);out=Profile();C.memset(C.byref(out),0xa5,C.sizeof(out))
+        error=self.query(buf,len(b) if accessible is None else accessible,C.byref(out))
+        if error:self.assertEqual(bytes(out),bytes(C.sizeof(out)))
+        else:self.assertEqual((out.version,out.channel,out.ratio_num,out.ratio_den,out.avg_num),(1,1,3,1,128))
+        return error,out
+    def rejects(self,nodes):self.assertNotEqual(self.parse(fdt(nodes[0]))[0],0)
+    def test_valid_actual_route_and_order(self):
+        for phandle in [1,39,0x10002]:
+            nodes=tree(phandle);self.assertEqual(self.parse(fdt(nodes[0]))[1].phandle,phandle)
+            nodes[2][2].reverse();nodes[4][1].reverse();nodes[5][1].reverse()
+            self.assertEqual(self.parse(fdt(nodes[0]))[0],0)
+    def test_required_fields(self):
+        for depth in range(6):
+            for index in range(len(tree()[depth][1])):
+                nodes=tree();nodes[depth][1].pop(index);self.rejects(nodes)
+                nodes=tree();nodes[depth][1].append(nodes[depth][1][index]);self.rejects(nodes)
+                nodes=tree();key,value=nodes[depth][1][index];nodes[depth][1][index]=(key,value[:-1]);self.rejects(nodes)
+    def test_disabled_or_ambiguous(self):
+        for depth in range(6):
+            for value in [b'disabled\0',b'ok',b'fail\0',b'OK\0',b'']:
+                nodes=tree();nodes[depth][1].append(('status',value));self.rejects(nodes)
+            nodes=tree();nodes[depth][1].append(('status',b'okay\0'));self.assertEqual(self.parse(fdt(nodes[0]))[0],0)
+        nodes=tree();nodes[4][2].append(node('other',[('channel',U32(1))]));self.rejects(nodes)
+        nodes=tree();nodes[0][2].append(node('other',[('phandle',U32(39))]));self.rejects(nodes)
+        nodes=tree();nodes[0][2].append(node('other',[('linux,phandle',U32(39))]));self.rejects(nodes)
+        nodes=tree();nodes[4][2].append(node('isense'));self.rejects(nodes)
+        nodes=tree();nodes[0][2].append(node('other',[('compatible',b'mediatek,mt6357-auxadc\0')]));self.rejects(nodes)
+    def test_wrong_mapping_and_cells(self):
+        for index in range(10):
+            nodes=tree();data=bytearray(nodes[3][1][1][1]);struct.pack_into('>I',data,4*index,99)
+            nodes[3][1][1]=('io-channels',bytes(data));self.rejects(nodes)
+        for depth,key,values in [(5,'channel',[0,2]),(5,'avg-num',[0,8,127,129]),(4,'#io-channel-cells',[0,2]),(4,'phandle',[0,40,0xffffffff])]:
+            for value in values:
+                nodes=tree();nodes[depth][1][:]=[(k,U32(value) if k==key else v) for k,v in nodes[depth][1]];self.rejects(nodes)
+        nodes=tree();nodes[3][1][2]=('io-channel-names',NAMES.replace(b'pmic_battery_voltage',b'pmic_battery_unknown'));self.rejects(nodes)
+    def test_bounds_and_mutations(self):
+        b=fdt(tree()[0])
+        for end in range(len(b)):self.assertNotEqual(self.parse(b,end)[0],0)
+        for offset in [0,4,8,12,16,20,24,32,36]:
+            q=bytearray(b);struct.pack_into('>I',q,offset,0xffffffff);self.assertNotEqual(self.parse(q)[0],0)
+        rng=random.Random(6357)
+        for _ in range(1000):
+            q=bytearray(b)
+            for _ in range(rng.randrange(1,4)):
+                idx=rng.randrange(len(q));q[idx]^=1<<rng.randrange(8)
+            self.parse(q)
+    def test_live_capture44(self):
+        port=HERE.parents[3].parents[2]
+        for name in ['firmware/boot.bin.dtb','hardware/trace-boot-20261025/capture44/runtime.dtb']:
+            data=(port/name).read_bytes();error,result=self.parse(data)
+            self.assertEqual(error,0);self.assertEqual(result.phandle,39)
+    def test_fixed_shadows_and_masks(self):
+        expected=[0x5730,0x5730,0x7fca,0xf,0x14,0x372,0x8083,0x4000,0x30,0x6262,0x95d0,0x4055,1,0xfc0,0x38,0x1ac,0x4c,0xfdb,0xd,0xaa,0,0,0,0]
+        def ok(values):return self.lib.entry((C.c_uint16*24)(*values))
+        self.assertTrue(ok(expected));self.assertFalse(self.lib.entry(None))
+        for i in range(19):
+            for bit in range(16):
+                v=expected.copy();v[i]^=1<<bit;self.assertFalse(ok(v))
+        for i,mask in [(19,0x3ff),(20,7),(21,0xff),(22,0x3449),(23,0x500)]:
+            for bit in range(16):
+                v=expected.copy();v[i]^=1<<bit;self.assertEqual(bool(ok(v)),not bool(mask&(1<<bit)))
+if __name__=='__main__':unittest.main()
