+/* SPDX-License-Identifier: MIT */
+#include <assert.h>
+#include <stdio.h>
+#include "mt6762_display_core.h"
+struct mock_pwm {
+    uint32_t registers[8];
+    unsigned count, barriers, offsets[4], drop_writes;
+    uint32_t values[4];
+};
+static uint32_t mock_read(void *context, unsigned offset)
+{ return ((struct mock_pwm *)context)->registers[offset / 4]; }
+static void mock_write(void *context, unsigned offset, uint32_t value)
+{
+    struct mock_pwm *p = context;
+    assert(p->count < 4 && p->barriers == p->count);
+    p->offsets[p->count] = offset; p->values[p->count++] = value;
+    if (!p->drop_writes) p->registers[offset / 4] = value;
+}
+static void mock_barrier(void *context) { ++((struct mock_pwm *)context)->barriers; }
+int main(void)
+{
+    struct mt6762_fb_layout f = {0x7ef90000, 0x470000, 0x7ef90000, 0x470000, 384, 854, 1536, 1, 0};
+    assert(mt6762_fb_bounds(&f));
+    struct mt6762_fb_layout bad = f;
+    bad.size = 1024; assert(!mt6762_fb_bounds(&bad));
+    bad = f; bad.physical++; assert(!mt6762_fb_bounds(&bad));
+    bad = f; bad.reserved_base++; assert(!mt6762_fb_bounds(&bad));
+    bad = f; bad.reserved_size--; assert(!mt6762_fb_bounds(&bad));
+    bad = f; bad.physical = 0xffff0000; bad.reserved_base = bad.physical;
+    assert(!mt6762_fb_bounds(&bad));
+    bad = f; bad.format = 2; assert(!mt6762_fb_bounds(&bad));
+    bad = f; bad.stride = UINT32_MAX; assert(!mt6762_fb_bounds(&bad));
+    assert(mt6762_display_power(8, 8, 13));
+    assert(!mt6762_display_power(8, 0, 13));
+    assert(!mt6762_display_power(8, 8, 13 | 0x1000));
+    assert(!mt6762_display_power(8, 8, 13 | 0x10));
+    struct mt6762_ovl_snapshot s = {
+        .en=1, .sources=1, .roi=384 | 854u<<16, .con=0x20ff,
+        .address=0x7ef90000, .pitch=1536, .size=384 | 854u<<16,
+        .rdma=1, .downstream_rdma=1, .dsi_start=1, .dsi_mode=2,
+        .dsi_lanes=7u<<2, .dsi_active=854, .dsi_ps=(3u<<16)|1152,
+        .dsi_vsa=2, .dsi_vbp=20, .dsi_vfp=170
+    };
+    assert(mt6762_ovl_matches(&f, &s));
+    s.con |= 0x100; assert(mt6762_ovl_matches(&f, &s));
+    s.con--; assert(!mt6762_ovl_matches(&f, &s)); s.con=0x20ff;
+    s.con |= 1u<<24; assert(!mt6762_ovl_matches(&f, &s)); s.con=0x20ff;
+    s.sources=3; assert(!mt6762_ovl_matches(&f, &s)); s.sources=1;
+    s.ext_sources=1; assert(!mt6762_ovl_matches(&f, &s)); s.ext_sources=0;
+    s.address+=4096; assert(!mt6762_ovl_matches(&f, &s)); s.address-=4096;
+    s.downstream_rdma=3; assert(!mt6762_ovl_matches(&f, &s)); s.downstream_rdma=1;
+    s.dsi_ps=(2u<<16)|1152; assert(!mt6762_ovl_matches(&f,&s));
+    s.dsi_ps=(3u<<16)|1152;
+    s.pitch|=1u<<16; assert(!mt6762_ovl_matches(&f,&s)); s.pitch=1536;
+    struct mt6762_ovl_snapshot menu[2]={s,s};
+    menu[0].sources=menu[1].sources=3; menu[0].con=menu[1].con=0x21ff;
+    menu[1].address+=0x144000;
+    assert(mt6762_boot_menu_buffer(f.physical,f.reserved_size,menu)==0x7f0d4000);
+    assert(!mt6762_boot_menu_buffer(f.physical,0x144000,menu));
+    menu[1].address+=0x4000; assert(!mt6762_boot_menu_buffer(f.physical,f.reserved_size,menu));
+    menu[1].address-=0x4000;
+    menu[0].sources=7; assert(!mt6762_boot_menu_buffer(f.physical,f.reserved_size,menu));
+    s.dsi_lanes=3u<<2; assert(!mt6762_ovl_matches(&f, &s));
+    assert(mt6762_pwm_configured(3u<<16, 1023, 3u<<24, 0));
+    assert(!mt6762_pwm_configured(3u<<16, 1023, 0, 0));
+    assert(!mt6762_pwm_configured(3u<<16, 1023, 3u<<24, 4));
+    assert(!mt6762_pwm_configured(3u<<16, 1023, 0x83000000, 0));
+    struct mt6762_pwm_snapshot lk = {0x30101,0,0x11111441,1,0,0,0x03ff03ff,0};
+    assert(mt6762_pwm_lk_configured(&lk));
+    lk.con1=0x010003ff; assert(mt6762_pwm_lk_configured(&lk));
+    lk.con1=0x000103ff;lk.enable=0;assert(mt6762_pwm_lk_configured(&lk));
+    lk.enable=1;lk.con1=0x03ff03ff;
+    struct mt6762_pwm_snapshot invalid;
+    invalid=lk;invalid.top|=1u<<24;assert(!mt6762_pwm_lk_configured(&invalid));
+    invalid=lk;invalid.top|=1u<<31;assert(!mt6762_pwm_lk_configured(&invalid));
+    invalid=lk;invalid.infra=4;assert(!mt6762_pwm_lk_configured(&invalid));
+    invalid=lk;invalid.gpio&=~0xf000u;assert(!mt6762_pwm_lk_configured(&invalid));
+    invalid=lk;invalid.enable=3;assert(!mt6762_pwm_lk_configured(&invalid));
+    invalid=lk;invalid.commit=1;assert(!mt6762_pwm_lk_configured(&invalid));
+    invalid=lk;invalid.con0=1;assert(!mt6762_pwm_lk_configured(&invalid));
+    invalid=lk;invalid.con0=3u<<16;assert(!mt6762_pwm_lk_configured(&invalid));
+    invalid=lk;invalid.con1=0x040003ff;assert(!mt6762_pwm_lk_configured(&invalid));
+    invalid=lk;invalid.con1|=1u<<15;assert(!mt6762_pwm_lk_configured(&invalid));
+    invalid=lk;invalid.debug=1;assert(!mt6762_pwm_lk_configured(&invalid));
+    assert(mt6762_display_datapath(0,0));
+    assert(mt6762_display_datapath(0x81000001,0));
+    assert(!mt6762_display_datapath(0x81000003,0));
+    assert(!mt6762_display_datapath(0x81000001,1));
+    struct mock_pwm p = {.registers = {0x80,0,0,0,0,0,3u<<16,0xa00003ff}};
+    const struct mt6762_pwm_io io = {&p, mock_read, mock_write, mock_barrier};
+    assert(mt6762_pwm_program(&io, 1024) < 0 && !p.count);
+    assert(!mt6762_pwm_program(&io, 700) && p.count == 4 && p.barriers == 4);
+    assert(p.offsets[0]==0x1c && p.values[0]==(0xa00003ffu | 700u<<16));
+    assert(p.offsets[1]==0 && p.values[1]==0x81);
+    assert(p.offsets[2]==0x0c && p.values[2]==1 && p.offsets[3]==0x0c && p.values[3]==0);
+    p.count=p.barriers=0;
+    assert(!mt6762_pwm_program(&io, 0));
+    assert(p.values[0]==0xa00103ff && p.values[1]==0x80);
+    p.count=p.barriers=0; p.registers[7]=1022;
+    assert(mt6762_pwm_program(&io, 1)<0 && !p.count && !p.barriers);
+    p.registers[7]=1023; p.drop_writes=1;
+    assert(mt6762_pwm_program(&io, 50)<0 && p.count==4 && p.barriers==4);
+    puts("display bounds/readback and PWM ordering tests passed");
+    return 0;
+}
diff --git a/tools/mt6762/hardware/display-touch/test_dsi_vm.c b/tools/mt6762/hardware/display-touch/test_dsi_vm.c
new file mode 100644
index 0000000000000000000000000000000000000000..fa87424380358855b4b1d8328d04ceae3e9b84a4
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/test_dsi_vm.c
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: MIT
+ * Synthetic W0C/packet/fresh-completion contract, not a physical DSI test. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "mt6762_dsi_vm_core.h"
+struct fake {
+    uint32_t regs[0x134 / 4];
+    unsigned writes, triggers, delays, denied, stale, timeout, badread, modechange;
+    unsigned idle_unproven, admissions, acknowledgements, drop_final_ack;
+    unsigned offsets[16];
+    uint32_t values[16];
+};
+static int verify(void *p) { return ((struct fake *)p)->denied ? -1 : 0; }
+static int admit_idle(void *p)
+{
+    struct fake *f = p;
+    f->admissions++;
+    return f->idle_unproven ? -1 : 0;
+}
+static uint32_t read32(void *p, unsigned off)
+{
+    struct fake *f = p;
+    if (f->badread && off == 0x130 && f->writes) return 0;
+    return f->regs[off / 4];
+}
+static void write32(void *p, unsigned off, uint32_t value)
+{
+    struct fake *f = p;
+    assert(f->writes < 16 && (off == 0 || off == 0xc || off == 0x130));
+    f->offsets[f->writes] = off; f->values[f->writes++] = value;
+    if (off == 0xc) {
+        assert(value == ~MT6762_DSI_VM_DONE);
+        f->acknowledgements++;
+        if (!f->stale && !(f->drop_final_ack && f->acknowledgements == 2))
+            f->regs[off / 4] &= value;
+    } else {
+        if (off == 0 && !(f->regs[0] & MT6762_DSI_VM_START) && (value & MT6762_DSI_VM_START)) f->triggers++;
+        f->regs[off / 4] = value;
+    }
+}
+static void barrier(void *p) { (void)p; }
+static void delay(void *p, unsigned us)
+{
+    struct fake *f = p;
+    assert(us == 10);
+    f->delays++;
+    /* A different event can arrive after the first acknowledgement. The
+     * completion acknowledgement must preserve it, not replay an old mask. */
+    if (f->triggers && !f->timeout) f->regs[0xc / 4] |= MT6762_DSI_VM_DONE | 0x10;
+    if (f->modechange) f->regs[0x14 / 4] = 0;
+}
+static void reset(struct fake *f)
+{
+    memset(f, 0, sizeof(*f));
+    f->regs[0] = 1;
+    f->regs[0xc / 4] = MT6762_DSI_VM_DONE | 8; /* old completion plus unrelated frame event */
+    f->regs[0x14 / 4] = 2;
+    f->regs[0x130 / 4] = 0xaabb3923; /* prior long packet, configured VFP */
+}
+int main(void)
+{
+    struct fake f;
+    struct mt6762_dsi_vm_state state = {0};
+    const struct mt6762_dsi_vm_io io = {&f, verify, admit_idle, read32, write32, barrier, delay};
+    reset(&f);
+    assert(!mt6762_dsi_vm_short_zero(&state, &io, 0x28, 10, 4));
+    assert(f.regs[0x130 / 4] == 0x281521 && f.triggers == 1 && f.delays == 1);
+    assert(f.regs[0] == 0x10001 && f.regs[0xc / 4] == 0x18);
+    assert(f.writes == 5 && f.offsets[0] == 0x130 && f.offsets[1] == 0xc);
+    assert(f.offsets[2] == 0 && f.values[2] == 1 && f.values[3] == 0x10001);
+    assert(!mt6762_dsi_vm_short_zero(&state, &io, 0x10, 10, 4));
+    assert(f.triggers == 2 && f.admissions == 1 && state.own_completed); /* only our completed trigger */
+    /* A high inherited trigger is not our prior completion. Neither stale
+     * DONE high nor DONE low admits overwriting its command packet. */
+    for (unsigned done = 0; done < 2; done++) {
+        reset(&f); state = (struct mt6762_dsi_vm_state){0};
+        f.regs[0] |= MT6762_DSI_VM_START;
+        if (!done) f.regs[0xc / 4] &= ~MT6762_DSI_VM_DONE;
+        assert(mt6762_dsi_vm_short_zero(&state, &io, 0x28, 10, 4) == MT6762_DSI_UNAVAILABLE);
+        assert(!f.writes && !f.triggers && !f.admissions);
+    }
+    /* Even low START requires independent initial idle admission. */
+    reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.idle_unproven = 1;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x28, 10, 4) == MT6762_DSI_UNAVAILABLE);
+    assert(!f.writes && f.admissions == 1);
+    /* A dropped final W0C write must not create an own-completion token. */
+    reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.drop_final_ack = 1;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x28, 10, 4) == MT6762_DSI_READBACK);
+    assert(state.faulted && !state.own_completed && f.triggers == 1);
+    unsigned failed_writes = f.writes;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x29, 10, 4) < 0 && f.writes == failed_writes);
+    /* Loss of the previous packet/cleared status invalidates retained proof. */
+    reset(&f); state = (struct mt6762_dsi_vm_state){0};
+    assert(!mt6762_dsi_vm_short_zero(&state, &io, 0x28, 10, 4));
+    f.regs[0x130 / 4] ^= 0x10000; failed_writes = f.writes;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x29, 10, 4) < 0 && f.writes == failed_writes);
+    reset(&f); state = (struct mt6762_dsi_vm_state){0};
+    assert(!mt6762_dsi_vm_short_zero(&state, &io, 0x28, 10, 4));
+    f.regs[0xc / 4] |= MT6762_DSI_VM_DONE; failed_writes = f.writes;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x29, 10, 4) < 0 && f.writes == failed_writes);
+    const uint8_t commands[] = {0x10, 0x11, 0x28, 0x29};
+    for (unsigned i = 0; i < sizeof(commands); i++) {
+        reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.regs[0] |= 0x100;
+        assert(!mt6762_dsi_vm_short_zero(&state, &io, commands[i], 10, 4));
+        assert(f.regs[0x130 / 4] == ((uint32_t)commands[i] << 16 | 0x1521));
+        assert(f.values[2] == 0x101 && f.values[3] == 0x10101 && f.regs[0] == 0x10101);
+    }
+    const unsigned invalid_modes[] = {0, 1, 3};
+    for (unsigned i = 0; i < 3; i++) {
+        reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.regs[0x14 / 4] = invalid_modes[i];
+        assert(mt6762_dsi_vm_short_zero(&state, &io, 0x11, 10, 4) < 0 && !f.writes);
+    }
+    reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.denied = 1;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x11, 10, 4) < 0 && !f.writes);
+    reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.regs[0] |= 4;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x11, 10, 4) < 0 && !f.writes);
+    reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.regs[0] |= 16;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x11, 10, 4) < 0 && !f.writes);
+    reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.stale = 1;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x11, 10, 4) == MT6762_DSI_READBACK && !f.triggers);
+    reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.timeout = 1;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x11, 10, 4) == MT6762_DSI_TIMEOUT && f.delays == 4);
+    unsigned writes = f.writes;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x29, 10, 4) < 0 && f.writes == writes);
+    reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.badread = 1;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x29, 10, 4) == MT6762_DSI_READBACK && !f.triggers);
+    reset(&f); state = (struct mt6762_dsi_vm_state){0}; f.modechange = 1;
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x29, 10, 4) == MT6762_DSI_READBACK);
+    reset(&f); state = (struct mt6762_dsi_vm_state){0};
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0xbb, 10, 4) == MT6762_DSI_ARGUMENT && !f.writes);
+    assert(mt6762_dsi_vm_short_zero(&state, &io, 0x29, 0, 4) == MT6762_DSI_ARGUMENT && !f.writes);
+    puts("Synthetic DSI VM short packet/W0C/fresh-completion tests passed");
+    return 0;
+}
diff --git a/tools/mt6762/hardware/i2c/README.rst b/tools/mt6762/hardware/i2c/README.rst
new file mode 100644
index 0000000000000000000000000000000000000000..235062db6c72e1e29305044fd3745f8b6063bf8c
--- /dev/null
+++ b/tools/mt6762/hardware/i2c/README.rst
@@ -0,0 +1,134 @@
+MT6765-family I2C transaction core
+================================
+
+This portable core is connected to XNU's native platform worker. Emulated
+FIFO/DMA transactions and input events have run. Physical capture21/kernel42
+now passes inherited I2C0 setup, reads touch version0007, receives32-byte DMA
+packets and reports a complete down/drag/up gesture. Touch operation within
+the physical iOS desktop remains untested.
+
+Evidence: the supplied stock DT's mediatek,i2c_common node selects version2,
+DMA support2 (33-bit), clock divider5, LTIMING and MT6765 counter constraints.
+Register definitions and transfer ordering are from the supplied BSP
+kernel-4.14/drivers/i2c/busses/i2c-mtk.{c,h}. The stock kernel is4.19 and
+its timing/clock implementation must be reconciled before native activation.
+
+I2C0 is0x11007000, APDMA0x11000080, SPI84; I2C5 is0x11016000,
+APDMA0x11000580, SPI130. SPI numbers require +32 for architectural INTIDs.
+Actual AXS touch is bus0/address0x3b; panel bias and PSC5425E are bus5 at
+0x3e and0x6a. No bus scanning or device writes were used to establish these.
+
+The core handles one write, one read, or write followed by repeated-START
+read to the same7-bit address. Up to8bytes uses FIFO; longer transfers use
+APDMA with a dedicated33-bit-addressable coherent buffer. This permits the
+AXS controller's single32-byte read without inventing a register prefix.
+V2 AUX_LENGTH is0x44, MCU_INTR is0x40. Controller accesses are16bits and
+APDMA accesses32bits. A controller error overrides a simultaneous completion.
+Every wait is bounded; failed transactions fault the context and do not
+publish partial receive data or automatically reset/retry a charger write.
+
+Required native integration
+---------------------------
+
+* Claim exclusive controller/APDMA ownership, enable the correct parents and
+  gates, establish IO rail/pinmux and configure verified standard/fast-mode
+  timing. The core accepts at most400kHz and preserves those timing registers.
+  The observed DT divider alone does not identify the input clock frequency.
+* Map device registers with Device memory attributes. Supply ordered16/32-bit
+  MMIO and a real full-system barrier, plus a functioning microsecond timer.
+* Allocate physically contiguous coherent DMA memory, pin it, use its bus
+  address (never a kernel virtual address), and validate the entire allocation
+  below8GiB. If memory is cacheable/noncoherent, this interface is insufficient:
+  add direction-aware cache clean/invalidate and ownership transitions first.
+  Establish whether this APDMA path bypasses or needs the platform IOMMU.
+* Serialize the entire transaction, including power register read/modify/write.
+  Verify START and APDMA idle before ownership transfer. After a failure keep
+  the DMA buffer pinned and inaccessible to reuse until DMA has been stopped
+  and the reset/clock/power state has been re-established by a proven sequence.
+* Hook polling into a worker, not a long interrupt-disabled section. Add
+  the controller's GIC source to the ownership contract: it must stay masked
+  in the GIC while this polling core is used. Peripheral event enable matches
+  the BSP's0x12f mask and is cleared on completion/failure; raw status
+  visibility with all peripheral events disabled is not assumed. Add
+  interrupt operation only after the GIC routing and interrupt acknowledgments
+  have been tested. Verify normal reads before any charger or bias writes.
+
+Neither successful host tests nor setting ``initialized`` supplies these
+prerequisites. The native integration checks inherited clock/IRQ/pad state,
+allocates a private coherent DMA buffer and polls from a worker. Physical
+reset recovery remains unaccepted. Physical touch DMA has now run without
+resetting the controller. Run ``bash test.sh`` for host tests.
+
+Measured setup readback
+-----------------------
+
+Capture20/kernel38 programmed the stock-style DIV0x0404 and HS0 values, then
+read DIV0x0004 and HS0x8000. TIMING0x0419, LTIMING0x0118, IO3 and the inherited
+clock checks matched. ``native_setup.h`` gives the admitted physical I2C0
+profile these exact readback expectations; programming is unchanged. The
+emulated profile retains its original expectations. Unknown profiles,
+unmeasured dividers and other mismatches fail. This observation does not
+establish the undocumented bits' meaning. Kernel42 includes this correction;
+capture21 confirms successful physical transactions and gestures. See
+../display-touch/physical-build38-evidence.json and physical-build42-evidence.json
+in that directory. Event logging stops after32 events; the incomplete second
+gesture in that log is not evidence of a missing release.
+
+The setup check also requires exact EXT_CONF, DELAY_LEN and timeout readback.
+These three words were previously logged without affecting acceptance. The
+physical capture records0x8001,0x000a and0x0190 respectively, matching the
+programmed100kHz setup. Host tests reject every differing bit in all three
+words for both laboratory and measured profiles. This does not extend the
+measured I2C0 DIV/HS behavior to the untested physical I2C5 controller.
+
+An explicit physical ``--native-charger-setup-probe`` now admits only the
+capture26 inherited I2C5 entry profile and records the programmed setup.
+Bus5 retains the strict synthetic post-write comparison; its entry DIV4 and
+HS0x8000 are not accepted as post-write proof. A separate setup-only latch
+always blocks transfer readiness, even after matching readbacks. No PSC or
+display-bias transaction is granted. The inherited bus5 path also checks the
+captured INFRA0xc8 bits18/19/20 before/after setup and before transfers, without
+changing those dedicated gates. See ../power/CHARGER-ENTRY.rst for the exact
+entry record, producer/consumer checks and trial limits.
+
+Clock dependency evidence
+-------------------------
+
+Both actual DT controller nodes reference infracfg_ao (phandle0x25) clock
+ID11 as ``main`` and ID38 as ``dma``. The supplied MT6765 binding header maps
+these to CLK_IFR_I2C_AP and CLK_IFR_AP_DMA. In clk-mt6765.c they resolve to:
+
+* I2C AP gate: infracfg_ao base0x10001000, bank0 bit11, gate-set0x80,
+  gate-clear0x84, status0x90; parent ``i2c_ck``.
+* APDMA gate: same base, bank1 bit18, gate-set0x88, gate-clear0x8c,
+  status0x94; parent ``axi_ck``. These gates use active-high disable bits,
+  so enabling uses the clear register, not an RMW of the status register.
+* I2C parent selector: topckgen base0x10000000, CLK_CFG_6 offset0xa0,
+  selector bits2:0, gate bit7, set/clear0xa4/0xa8, update bit24 in
+  CLK_CFG_UPDATE. Encodings0..4 select clk26m, univpll3_d4, univpll3_d2,
+  syspll1_d8, syspll2_d8 respectively. Remaining encodings are not defined.
+
+The divider property5 is then part of the I2C controller timing computation.
+It must not be multiplied by an assumed PLL rate. Parent changes affect other
+I2C consumers, including firmware/SSPM-owned channels. Preserve and decode the
+current parent initially; any reparenting needs explicit ownership, inactive
+transactions, the update handshake and new timing values for every consumer.
+The clock source's actual rate must come from its verified PLL configuration.
+
+The BSP also defines I2C5/arbiter/immediate gates (IDs58..60, bank2 bits18..20),
+but the actual DT references only the shared AP and APDMA clocks. Their presence
+in the clock table is not evidence they must all be enabled. Reconcile this
+against the exact stock controller and boot state before native initialization.
+
+These tables are source/DT observations; the native handoff additionally
+checks the captured clock and controller state. No physical clock reparenting
+has been attempted. APDMA channel addressing alone does not prove cache
+coherency or IOMMU routing in general. The measured inherited path has now
+completed native touch DMA; other APDMA devices remain separate work.
+
+The exact stock Image independently corroborates these tables: ``ifr_clks``
+records at VAs0xffffff80090523e8 (ID11) and0xffffff8009052a28 (ID38) carry
+the same gate shifts and register banks. The I2C top mux record at
+0xffffff8009051b68 has offset0xa0, set0xa4, clear0xa8, update0x4,
+shift0, width3, gate7 and update bit24; its five parent strings are at
+0xffffff80090521f8. Bounded raw records are in the CPU/power evidence package.
