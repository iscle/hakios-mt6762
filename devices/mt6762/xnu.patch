--- /dev/null
+++ b/tools/mt6762/hardware/connectivity-power/test_conn_power.sh
@@ -0,0 +1,27 @@
+#!/bin/sh
+set -eu
+cd "$(dirname "$0")"
+testdir=$(mktemp -d)
+trap 'rm -rf "$testdir"' EXIT HUP INT TERM
+cc -std=c11 -Wall -Wextra -Werror -O2 conn_power.c test_conn_power.c -o "$testdir/test"
+"$testdir/test"
+if [ -n "${CLANG:-}" ]; then
+    connectivity_clang=$CLANG
+elif command -v clang >/dev/null 2>&1; then
+    connectivity_clang=$(command -v clang)
+else
+    connectivity_clang="$(pwd)/../../../../../../../toolchain/theos/toolchain/linux/iphone/bin/clang-11"
+fi
+"$connectivity_clang" --target=aarch64-none-elf -std=c11 -ffreestanding -fno-builtin \
+    -Wall -Wextra -Werror -O2 -c conn_power.c -o "$testdir/core.o"
+python3 - "$testdir/core.o" <<'PY'
+import sys
+from elftools.elf.elffile import ELFFile
+with open(sys.argv[1], 'rb') as f:
+    elf = ELFFile(f)
+    assert elf['e_machine'] == 'EM_AARCH64'
+    undefined = [s.name for s in elf.get_section_by_name('.symtab').iter_symbols()
+                 if s['st_shndx'] == 'SHN_UNDEF' and s.name]
+    assert not undefined, undefined
+print('CONN core freestanding AArch64 strict compile, no undefined runtime dependencies PASS')
+PY
diff --git a/tools/mt6762/hardware/connectivity-power/test_probe.c b/tools/mt6762/hardware/connectivity-power/test_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..f2cee57b495f448d74f516ae504382056a026e5f
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity-power/test_probe.c
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: MIT -- executes the actual passive collector. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../physical/connectivity_probe.h"
+struct mock {
+    uint64_t now,step,jump;
+    unsigned reads,barriers,times;
+    int fail_at,gated_pass,wrong_family_pass,tamper;
+    struct mt6762_connectivity_record *record;
+};
+static int sample(struct mock *m,unsigned bus,uint32_t address,uint32_t *value)
+{
+    unsigned index=m->reads%40,pass=m->reads/40;
+    assert(bus==(index>=21));
+    assert(address==(bus?mt6762_connectivity_pmic_regs[index-21]:mt6762_connectivity_ap_regs[index]));
+    assert(!(address>=0x18000000 && address<0x19000000));
+    *value=bus?(address^0x1234):(address^0x12345678);
+    if(address==0x0008)*value=(int)pass==m->wrong_family_pass?0x5801:0x5700+pass;
+    if(address==0x10001090)*value=(int)pass==m->gated_pass?2:0;
+    if(m->tamper && index+1<40)m->record->entries[index+1].address=0x18000000;
+    m->now+=m->jump;
+    return (int)m->reads++==m->fail_at?-77:0;
+}
+static int ap(void *p,uint32_t address,uint32_t *value)
+{return sample(p,0,address,value);}
+static int pmic(void *p,uint16_t address,uint16_t *value)
+{uint32_t v;int e=sample(p,1,address,&v);*value=(uint16_t)v;return e;}
+static uint64_t ticks(void *p)
+{struct mock *m=p;uint64_t v=m->now;m->now+=m->step;m->times++;return v;}
+static void barrier(void *p){((struct mock *)p)->barriers++;}
+static const uint8_t identity[32]={1,2,3,4};
+static struct mt6762_connectivity_record record;
+static struct mt6762_connectivity_io setup(struct mock *m)
+{
+    *m=(struct mock){.step=1,.fail_at=-1,.gated_pass=-1,.wrong_family_pass=-1,.record=&record};
+    memset(&record,0xa5,sizeof(record));
+    return (struct mt6762_connectivity_io){m,ap,pmic,ticks,barrier,13000000,250000};
+}
+int main(int argc,char **argv)
+{
+    struct mock m;struct mt6762_connectivity_io io=setup(&m);
+    assert(mt6762_connectivity_capture(&io,&record,identity,0)==1);
+    assert(!m.reads && !m.times && !m.barriers && record.state==1);
+    assert(mt6762_connectivity_capture(NULL,&record,identity,0)==1);
+    for(unsigned invalid=0;invalid<9;invalid++) {
+        io=setup(&m);const uint8_t *id=identity;int enabled=1;
+        switch(invalid) {
+        case 0:io.read_ap32=NULL;break;case 1:io.read_pmic16=NULL;break;
+        case 2:io.ticks=NULL;break;case 3:io.barrier=NULL;break;
+        case 4:io.budget_us=0;break;case 5:io.budget_us=1000001;break;
+        case 6:id=NULL;break;case 7:enabled=-1;break;case 8:enabled=2;break;
+        }
+        assert(mt6762_connectivity_capture(&io,&record,id,enabled)==-1);
+        assert(!m.reads && !m.times && !m.barriers);
+    }
+    io=setup(&m);io.counter_hz=0;
+    assert(mt6762_connectivity_capture(&io,&record,identity,1)==-4 && !m.reads && !m.times);
+    for(int failed=0;failed<80;failed++) {
+        io=setup(&m);m.fail_at=failed;
+        assert(mt6762_connectivity_capture(&io,&record,identity,1)==-2);
+        assert(m.reads==(unsigned)failed+1 && record.state==4 && record.state_inverse==~4u);
+        assert(record.pass==(unsigned)failed/40+1 && record.index==(unsigned)failed%40);
+        assert(record.transport_error==-77 && record.entries[failed%40].error[failed/40]==-77);
+        assert(!(record.entries[failed%40].valid&(1u<<(failed/40))));
+        assert(record.entries[failed%40].value[failed/40]==0);
+        for(unsigned p=0;p<2;p++)for(unsigned i=0;i<40;i++) {
+            unsigned n=p*40+i;
+            if(n<(unsigned)failed)assert(record.entries[i].valid&(1u<<p));
+            if(n>(unsigned)failed)assert(record.entries[i].error[p]==INT32_MIN && !(record.entries[i].valid&(1u<<p)));
+        }
+    }
+    for(int pass=0;pass<2;pass++) {
+        io=setup(&m);m.gated_pass=pass;
+        assert(mt6762_connectivity_capture(&io,&record,identity,1)==-5);
+        assert(m.reads==(unsigned)pass*40+16 && record.index==16 && record.transport_error==0);
+    }
+    for(int pass=0;pass<2;pass++) {
+        io=setup(&m);m.wrong_family_pass=pass;
+        assert(mt6762_connectivity_capture(&io,&record,identity,1)==-6);
+        assert(m.reads==(unsigned)pass*40+22 && record.index==21 && record.transport_error==0);
+        assert(record.entries[21].value[pass]==0x5801 && (record.entries[21].valid&(1u<<pass)));
+        assert(!record.entries[21].error[pass] && record.entries[22].error[pass]==INT32_MIN);
+    }
+    io=setup(&m);io.budget_us=1;m.step=14;
+    assert(mt6762_connectivity_capture(&io,&record,identity,1)==-3 && !m.reads);
+    io=setup(&m);io.budget_us=1;m.jump=13;
+    assert(mt6762_connectivity_capture(&io,&record,identity,1)==-3 && m.reads==1);
+    assert(record.entries[0].valid==1 && record.entries[0].error[0]==0);
+    io=setup(&m);m.now=UINT64_MAX-50;
+    assert(!mt6762_connectivity_capture(&io,&record,identity,1) && m.reads==80);
+    io=setup(&m);m.step=0;
+    assert(!mt6762_connectivity_capture(&io,&record,identity,1) && m.reads==80);
+    io=setup(&m);m.tamper=1;
+    assert(!mt6762_connectivity_capture(&io,&record,identity,1) && m.reads==80);
+    /* Even malicious alteration of retained addresses never alters requests. */
+    io=setup(&m);assert(!mt6762_connectivity_capture(&io,&record,identity,1));
+    for(unsigned i=0;i<40;i++)assert(record.entries[i].valid==3 && !record.entries[i].error[0] && !record.entries[i].error[1]);
+    for(unsigned i=0;i<sizeof(record.reserved);i++)assert(!record.reserved[i]);
+    assert(!memcmp(record.identity,identity,32) && record.size==4096 && record.version==1);
+    if(argc>=2) {FILE *f=fopen(argv[1],"wb");assert(f);assert(fwrite(&record,1,sizeof(record),f)==sizeof(record));assert(!fclose(f));}
+    if(argc>=3) {
+        io=setup(&m);m.fail_at=62;assert(mt6762_connectivity_capture(&io,&record,identity,1)==-2);
+        FILE *f=fopen(argv[2],"wb");assert(f);assert(fwrite(&record,1,sizeof(record),f)==sizeof(record));assert(!fclose(f));
+    }
+    if(argc>=4) {
+        io=setup(&m);m.wrong_family_pass=0;assert(mt6762_connectivity_capture(&io,&record,identity,1)==-6);
+        FILE *f=fopen(argv[3],"wb");assert(f);assert(fwrite(&record,1,sizeof(record),f)==sizeof(record));assert(!fclose(f));
+    }
+    if(argc>=5) {
+        io=setup(&m);m.now=UINT64_MAX-50;assert(!mt6762_connectivity_capture(&io,&record,identity,1));
+        FILE *f=fopen(argv[4],"wb");assert(f);assert(fwrite(&record,1,sizeof(record),f)==sizeof(record));assert(!fclose(f));
+    }
+    if(argc>=6) {
+        io=setup(&m);assert(mt6762_connectivity_capture(&io,&record,identity,0)==1);
+        FILE *f=fopen(argv[5],"wb");assert(f);assert(fwrite(&record,1,sizeof(record),f)==sizeof(record));assert(!fclose(f));
+    }
+    puts("connectivity collector: disabled,80 fault sites, clock gates, deadlines/wrap/frozen timer, fixed addresses and complete record PASS");
+    return 0;
+}
diff --git a/tools/mt6762/hardware/connectivity-power/test_pwrap.c b/tools/mt6762/hardware/connectivity-power/test_pwrap.c
new file mode 100644
index 0000000000000000000000000000000000000000..798e6adc78229c02b99f015e4babe626fbab22ef
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity-power/test_pwrap.c
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: MIT -- executes the unchanged native WACS engine. */
+#include <assert.h>
+#include <stdio.h>
+#include "pwrap_readonly.h"
+struct mock {unsigned held,locks,unlocks,admissions,reads,writes,delay,phase;int acquire_error,admit_error,fail_phase;uint16_t reg;};
+static int acquire(void *v){struct mock *m=v;m->locks++;assert(!m->held);if(m->acquire_error)return m->acquire_error;m->held=1;return 0;}
+static void release(void *v){struct mock *m=v;assert(m->held);m->held=0;m->unlocks++;}
+static int admit(void *v){struct mock *m=v;assert(m->held);m->admissions++;return m->admit_error;}
+static uint32_t rd(void *v,uint32_t off)
+{
+    struct mock *m=v;assert(m->held && off==0xc24);m->reads++;
+    if((int)m->phase==m->fail_phase)return (1u<<22)|(2u<<16);
+    return (1u<<22)|(m->phase==1?((6u<<16)|0x4321):0);
+}
+static void wr(void *v,uint32_t off,uint32_t value)
+{
+    struct mock *m=v;assert(m->held);m->writes++;
+    if(m->phase==0) {
+        assert(off==0xc20 && !(value&0x80000000u));
+        assert(value==((uint32_t)(m->reg>>1)<<16));m->phase=1;
+    } else {assert(m->phase==1 && off==0xc28 && value==1);m->phase=2;}
+}
+static void delay(void *v,unsigned us){struct mock *m=v;assert(m->held && us==10);m->delay+=us;}
+int main(void)
+{
+    struct mock m={.fail_phase=-1};struct mt6762_wacs_io io={&m,rd,wr,delay};
+    struct mt6762_connectivity_pwrap p={&m,&io,acquire,release,admit,0};uint16_t value;
+    for(unsigned i=0;i<19;i++) {
+        m=(struct mock){.fail_phase=-1,.reg=mt6762_connectivity_pmic_regs[i]};value=0xeeee;p.fault=0;
+        assert(!mt6762_connectivity_pwrap_read(&p,m.reg,&value));
+        assert(value==0x4321 && m.locks==1 && m.unlocks==1 && m.admissions==1 && m.reads==3 && m.writes==2);
+    }
+    const uint16_t forbidden[]={0,6,0x1a5c,0x1a5e,0x1b8c,0x1b8e,0x1b92,0x1b94,0x110e,0xffff};
+    for(unsigned i=0;i<sizeof(forbidden)/sizeof(*forbidden);i++) {
+        m=(struct mock){0};assert(mt6762_connectivity_pwrap_read(&p,forbidden[i],&value)==-1001);
+        assert(!m.locks && !m.reads && !m.writes);
+    }
+    for(int phase=0;phase<3;phase++) {
+        m=(struct mock){.fail_phase=phase,.reg=0x1a58};p.fault=0;value=0xeeee;
+        assert(mt6762_connectivity_pwrap_read(&p,m.reg,&value)==-3);
+        assert(p.fault && !m.held && m.unlocks==1 && m.writes==(unsigned)phase && value==0xeeee);
+        assert(m.delay==10000 && m.reads==1000u+(unsigned)phase);
+        unsigned reads=m.reads,writes=m.writes,admits=m.admissions;
+        assert(mt6762_connectivity_pwrap_read(&p,m.reg,&value)==-1002);
+        assert(m.reads==reads && m.writes==writes && m.admissions==admits && !m.held);
+    }
+    m=(struct mock){.admit_error=-88,.reg=0x1a58};p.fault=0;
+    assert(mt6762_connectivity_pwrap_read(&p,m.reg,&value)==-88 && p.fault && m.unlocks==1 && !m.reads && !m.writes);
+    m=(struct mock){.acquire_error=-99,.reg=0x1a58};p.fault=0;
+    assert(mt6762_connectivity_pwrap_read(&p,m.reg,&value)==-99 && !p.fault && !m.unlocks && !m.admissions && !m.reads);
+    p.acquire=NULL;assert(mt6762_connectivity_pwrap_read(&p,0x1a58,&value)==-1001);
+    puts("connectivity WACS: exact19 read commands, lock/admission, no PMIC write bit, timeout phases, fault latch PASS");
+    return 0;
+}
diff --git a/tools/mt6762/hardware/connectivity-power/test_record.py b/tools/mt6762/hardware/connectivity-power/test_record.py
new file mode 100644
index 0000000000000000000000000000000000000000..d6f60710a17dee2e7177e4127c4a017953e06d57
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity-power/test_record.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Cross-check decoder/initializer against records emitted by actual C code."""
+from pathlib import Path
+import struct
+import sys
+import record
+
+
+def rejects(data, expected=None):
+    try:
+        record.decode(data, expected)
+    except ValueError:
+        return
+    raise AssertionError('corrupt record admitted')
+
+
+def main():
+    success, failed, family, wrapped, disabled = (Path(x).read_bytes() for x in sys.argv[1:])
+    identity = bytes((1, 2, 3, 4)) + bytes(28)
+    initial = record.initialize(identity)
+    assert record.decode(initial)['state_name'] == 'not-started'
+    good = record.decode(success, identity)
+    assert good['state_name'] == 'complete' and len(good['registers']) == 40
+    assert all(r['valid'] == 3 for r in good['registers'])
+    assert all(r['stable'] for i, r in enumerate(good['registers']) if i != 21)
+    assert good['registers'][21]['value'] == [0x5700, 0x5701]
+    assert not good['ownership_granted'] and not good['physical_retention_proven']
+    # Both inactive states require pristine samples, not merely clear valid
+    # bits. Exercise every value slot against Python's initializer and the
+    # actual C-emitted DISABLED packet.
+    assert record.decode(disabled, identity)['state_name'] == 'disabled'
+    for inactive in (initial, disabled):
+        for index in range(len(record.REGISTERS)):
+            for sample in range(2):
+                corrupt = bytearray(inactive)
+                struct.pack_into('<I', corrupt, 112 + index*24 + 8 + sample*4, 1)
+                rejects(corrupt)
+    # Actual C code crosses UINT64_MAX during the first pass. A raw numeric
+    # b0<=e0 rule would wrongly reject this valid packet.
+    wrap = record.decode(wrapped, identity)
+    assert wrap['began_ticks'][0] > wrap['ended_ticks'][0]
+    assert wrap['state_name'] == 'complete'
+    for actual in (success, wrapped):
+        b0, b1, e0, e1 = struct.unpack_from('<QQQQ', actual, 64)
+        mask = (1 << 64) - 1
+        # Break each ordering boundary while retaining the original final
+        # duration where possible. Both ordinary and wrapped clocks must fail.
+        for offset, value in [(80, b0-1), (80, b1+1), (72, e0-1),
+                              (72, e1+1), (88, b1-1), (64, e0+1)]:
+            corrupt = bytearray(actual)
+            struct.pack_into('<Q', corrupt, offset, value & mask)
+            rejects(corrupt)
+    # Equal timestamps are allowed: finite request counts also bound a frozen
+    # counter, so timestamp ordering is non-strict inside the global budget.
+    frozen = bytearray(success)
+    struct.pack_into('<QQQQ', frozen, 64, 42, 42, 42, 42)
+    assert record.decode(frozen)['state_name'] == 'complete'
+    bad = record.decode(failed, identity)
+    assert bad['state_name'] == 'failed' and bad['result'] == -2 and bad['transport_error'] == -77
+    assert bad['pass_number'] == 2 and bad['index'] == 22
+    assert bad['registers'][22]['valid'] == 1 and bad['registers'][22]['value'][1] is None
+    assert bad['registers'][22]['error'][1] == -77
+    assert bad['registers'][23]['error'][1] == record.NOT_READ
+    mismatch = record.decode(family, identity)
+    assert mismatch['result'] == -6 and mismatch['registers'][21]['value'][0] == 0x5801
+    assert mismatch['registers'][22]['value'] == [None, None]
+    corrupt = bytearray(family); struct.pack_into('<I', corrupt, 112 + 21*24 + 8, 0x5701); rejects(corrupt)
+    rejects(success[:-1]); rejects(success + b'\0'); rejects(success, bytes(32))
+    # Header, identity binding, commit pair, table shape, values, errors, padding.
+    for offset, fmt, value in [(0, 'B', 0), (8, 'I', 2), (12, 'I', 1024),
+        (48, 'I', 5), (52, 'I', 0), (56, 'I', 3), (60, 'I', 40),
+        (96, 'I', 1), (100, 'I', 0), (104, 'i', -2),
+        (112, 'I', 0x18000000), (116, 'B', 1), (117, 'B', 2),
+        (118, 'H', 4), (128, 'i', -1), (112 + 21*24 + 8, 'I', 0x10000),
+        (1072, 'B', 1)]:
+        data = bytearray(success); struct.pack_into('<' + fmt, data, offset, value); rejects(data)
+    for r in good['registers']:
+        address = int(r['address'], 16)
+        assert not 0x18000000 <= address < 0x19000000
+        assert r['width'] == (4 if r['bus'] == 'ap' else 2)
+    assert initial[112:120] == success[112:120][:6] + b'\0\0'
+    print('connectivity record: C/Python ABI, inactive zeros, ordered/wrapped timestamps, partial failure, payload binding, corruption and domain exclusions PASS')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/mt6762/hardware/connectivity-rom/README.rst b/tools/mt6762/hardware/connectivity-rom/README.rst
new file mode 100644
index 0000000000000000000000000000000000000000..2190f6d9ea212cb6fca372e62d8cf2c863c6771d
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity-rom/README.rst
@@ -0,0 +1,165 @@
+Reset-held CONSYS EMI firmware staging
+=====================================
+
+This original freestanding core stages the three exact shipped RAM images into
+an already owned CONSYS reservation and verifies every transferred byte. It is
+default off and has no loader/kernel integration. It does not map or reserve
+memory, access MMIO, configure a clock/PMIC/MPU, release MCU reset, issue PDA/WMT
+commands, start DMA or enable a radio. No physical staging has been tested.
+
+Exact input profile
+-------------------
+
+``cr_stage(request, io, workspace, report)`` accepts an immutable array in this
+order. ``cr_profile_at`` exposes the fixed metadata and SHA-256 digests; callers
+cannot supply replacement hashes, targets, types or header lengths.
+
+============================ ==== ========== ========== ========== ===========
+Filename (prefix soc1_0_)     Type File bytes Body bytes EMI offset Debug offset
+============================ ==== ========== ========== ========== ===========
+ram_bt_1_1_hdr.bin            0    571085     571037     0x080000   0x68300
+ram_wifi_1_1_hdr.bin          3    196208     196160     0x140000   0x68310
+ram_mcu_1_1_hdr.bin           4    105940     105892     0x000000   0x68320
+============================ ==== ========== ========== ========== ===========
+
+All three images share one 4 MiB CONSYS reservation. The separate WLAN DMA pool
+and ``WIFI_RAM_CODE_soc1_0_1_1.bin`` are not used. The original 48-byte headers
+are removed. The launcher clears address byte0 (raw0x11); the normalized low24
+bits give the table's offsets. Raw type is stored big endian. The date is not
+required to contain16 digits: the actual BT image terminates its date with NULs.
+This is why the current general ``conn_decode`` parser cannot handle all three
+images; it remains unmodified. Exact header fields plus full-file SHA-256 are
+checked here, without importing firmware data or using a permissive parser.
+
+All three full-file digests are checked before the first destination write.
+Each body is then copied in at most1024-byte chunks, published to the peripheral
+view, prepared for uncached/fresh readback and compared bytewise. The exact short
+tail is retained. The core also hashes the bytes actually staged and compares
+the pinned body digest. After each verified body it stages16 debug bytes: the
+first15 original date bytes followed by NUL. Success therefore verifies873137
+bytes through857 transfers. Gaps and all other reservation bytes are untouched.
+
+The hash pins bind the artifacts used in this project, not Apple/MediaTek
+authentication or physical compatibility. Header CRC fields remain opaque;
+SHA-256 here does not claim to implement their algorithm. The source hash
+boundary depends on a real immutable-source lease. A violated lease can permit
+partial wrong data before the final staged-body hash detects it; the core then
+fails with reset still under the caller's control. This is not an atomic copy.
+
+Caller admission and actual observations
+---------------------------------------
+
+Before calling, the integration must:
+
+* Commit the current boot's CONSYS range in the common allocation ledger,
+  exclude it from every live loader/kernel/DMA allocation, and hold exclusive
+  ownership until a later lifetime/recovery owner takes over. A successful
+  ``cm_plan`` proposal or a saved capture is insufficient. Stock allocations
+  require16 MiB alignment,4 MiB size, and the live FDT allocation intervals;
+  the core checks the alignment/size and below4GiB bounds, while the caller
+  must enforce the actual FDT/ledger interval and exclusions.
+* Preserve the immutable, fully mapped source buffers and the physical-address
+  correspondence supplied in each ``cr_source``. The core rejects overlap of
+  these source ranges with each other or CONSYS and detects virtual aliases
+  with request, IO, workspace and report. All other source/executable/stack/
+  framebuffer/allocator exclusions belong to the committed ledger.
+* Establish reset-held power/IP admission, stable PMIC/oscillator/clocks,
+  bus-master quiescence, external-LDO policy and the exact AP/CONN EMI remap.
+  Establish AP write/read and CONN access permissions, including ownership of
+  the stock Wi-Fi staging path's MPU protection transition. This core never
+  performs or implicitly authorizes that transition.
+* Establish nonconflicting mapping/shareability/cache attributes and cache-line
+  ownership. The publish callback must make writes visible to CONN with the
+  required ordering. Prepare-read must prevent a stale cached alias from making
+  readback falsely pass; it cannot merely reread the just-written CPU cache.
+
+``observe`` is called before each source hash/copy step and before every
+destination write, cache operation and read. A successful exact run makes5141
+observations; this is deliberately conservative and must fit the real deadline.
+The callback must perform actual fresh checks under the owner lock and return
+current ordinary-read data. The core independently validates these values:
+
+================= ============ =============================================
+Observation       Ordinary PA  Predicate
+================= ============ =============================================
+RGU reset         0x10007018   bit12 set
+SPM CONN control  0x1000632c   low5 bits =0x0d
+Power ACK pair    0x10006180/4 bit1 set in both
+CONN IP           0x180b1010   0x10020300
+CONN HW/FW        0x18002000/4 stable full values; FW low8=0
+CONSYS remap      0x10001380   low12 = committed base >>24
+================= ============ =============================================
+
+The powered0x180 accesses require the earlier digital/power admission. The
+hardware version is retained and required stable; it is not compared to header
+0x8a00 because the shipped selection does not make that comparison. Firmware
+low8=0 reproduces the exact launcher's compatibility predicate for these files.
+``observe`` must also revalidate the real protection/rail/clock/access/source
+lease invariants that are not represented by these fields. It reports the
+owned base, size and nonzero epoch, which must remain equal to the request.
+Those software values detect a changed owner; they are not independent proof
+of reservation, security permission, source immutability or freshness. Returning
+constant snapshots or success booleans cannot satisfy the integration contract.
+
+Callbacks, limits and errors
+---------------------------
+
+The IO adapter must implement synchronous bounded ``write``, ``synchronize`` and
+``read`` callbacks over exactly the passed physical range. They have no right
+to program unrelated hardware. Each data callback returns an explicit completed
+length; a short or oversized result is terminal. ``synchronize`` distinguishes
+publish from prepare-read. The stateful host consumer enforces that sequence
+using separate CPU-cache and DRAM arrays; it is a real callback consumer of the
+core, not a mock replacement of the transfer algorithm.
+
+``enabled=0`` returns DISABLED without any callback. Enabled must equal1, the
+timer must be the established13 MHz counter, timeout1..5000000 microseconds,
+and operation limit1..20000. The unsigned elapsed-time check handles one counter
+wrap; backward/unreasonably large movement fails. Time is checked before and
+after callbacks. The operation cap and fixed-size loops remain finite with a
+frozen timer. A stalled bus or a callback that never returns is not contained by
+this C core; adapters must establish their own access and execution bounds.
+
+Inputs and IO descriptors are snapshotted into the caller-owned workspace. On
+invalid argument/layout, the output is untouched so a rejected alias cannot
+corrupt an input. Otherwise the report is initialized and tracks the failure
+phase, raw observations, callback result, attempted/completed counts and last
+range/length. A failed write may have reached memory even if it reports zero
+completion. The core stops without further IO (a final timer read is allowed),
+does no retry/rollback/automatic poweroff, and never changes reset. Caller must
+retain reset and ownership on both success and failure. Loss of access/ownership
+means the last snapshot cannot establish the current physical reset state.
+
+The workspace/report are ordinary C diagnostics, not an on-device wire ABI.
+Do not place the workspace on a small kernel stack. No new kernel header or IIG
+generation is needed until an integration deliberately includes this core.
+
+Source evidence and validation
+-----------------------------
+
+``evidence.json`` pins the primary shipped artifacts and exact relevant code
+ranges from the private ``wifi-native/rompatch`` audit. The shipped module
+``mtk_wcn_soc_rom_patch_dwn`` at .text+0x25d0c supplies the type loop,48-byte
+header skip, low24-bit destination, memcpy_toio and debug-time copy. Launcher
+VA0x62b8/0x6358..0x638c supplies the normalized address/type. Exact helper
+instructions were exercised in Unicorn during that audit. No binary/source
+equivalence is assumed for the BSP's misleading32-byte comment or its inactive
+branches. Stock silently succeeds on some mapping errors; this core reports
+those errors and verifies readback instead.
+
+Portable primitive tests and strict freestanding AArch64 compile::
+
+  bash test.sh
+
+Full stateful tests with locally held originals, in fixed order::
+
+  bash test.sh /private/soc1_0_ram_bt_1_1_hdr.bin \
+      /private/soc1_0_ram_wifi_1_1_hdr.bin /private/soc1_0_ram_mcu_1_1_hdr.bin
+
+Repeat the latter with ``SANITIZE=1`` for AddressSanitizer/UndefinedBehaviorSanitizer.
+Without private files the test explicitly skips exact-image staging; it does
+not substitute synthetic trusted digests. Tests cover all-image prevalidation,
+source/header tampering, stage order/exact tails/timestamps, untouched gaps,
+short/error writes and reads, cache faults, changed live state/owner, source
+mutation after validation, timer wrap/backwards/freeze, deadlines, bounds and
+overlap. There is no phone access or firmware distribution in these tests.
