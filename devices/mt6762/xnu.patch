index 0000000000000000000000000000000000000000..e4fb0999d6c3434d1e623b2c850c6f2b41b67385
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/panel-lifecycle-audit.json
@@ -0,0 +1,131 @@
+{
+  "scope": "Source-only panel lifecycle audit and unwired host-testable transport. No physical writes, native registration, QEMU model changes or kernel integration.",
+  "image_sha256": "82b1919185a49f268a0f8e145a6714d6264c1f66918a90df0d763266147ead4b",
+  "panel": "axs15260_dsi_6580_hd",
+  "normal_suspend": {
+    "entry": "0xffffff8008747860",
+    "predicate": "psensor_enable_for_lcm at0xffffff8009c03f40 equals0",
+    "state": "is_in_sleepmode at0xffffff8009a1db50 becomes1",
+    "sequence": [
+      "DCS0x28 parameter00",
+      "delay120ms",
+      "DCS0x10 parameter00",
+      "delay30ms",
+      "additional delay120ms after push_table",
+      "disp_dts_gpio_select_state(9): lcd_bias_enp0_gpio",
+      "delay20ms"
+    ],
+    "table": "0xffffff800983ec38"
+  },
+  "normal_resume": {
+    "entry": "0xffffff80087478e0 ->lcm_init0xffffff80087477d8",
+    "predicate": "proximity flag0 OR is_in_sleepmode==1",
+    "sequence": [
+      "lcm_init_power: state10 lcd_bias_enp1_gpio",
+      "delay20ms",
+      "I2C bus5/address0x3e register0=0x12 then register1=0x12",
+      "axs_reset_proc(20) resets touch as part of panel initialization",
+      "panel reset1 delay20ms,0 delay20ms,1 delay100ms",
+      "full init table: BB0000000000005aa5,B201000006000a04219c001e,B241,1100,delay120ms,2900,delay10ms"
+    ],
+    "warning": "Bias programming/reset/panel wake are not independent from touch lifecycle. No native implementation or rollback is admitted."
+  },
+  "proximity_branch": {
+    "suspend": "If proximity flag nonzero, sets is_in_sleepmode0 and returns without DCS sleep or bias-off.",
+    "resume": "Only if proximity flag nonzero and is_in_sleepmode!=1, sends1100 delay150ms then2900 delay20ms.",
+    "warning": "This branch does NOT prove the same table is a safe resume after sleep commands with retained bias. Stock had skipped sleep in the corresponding suspend branch."
+  },
+  "gpio_mapping": {
+    "table_va": "0xffffff800909a970",
+    "stock_state_count": 13,
+    "state9": "lcd_bias_enp0_gpio",
+    "state10": "lcd_bias_enp1_gpio",
+    "dt_reset_pin": 45,
+    "dt_bias_enable_pin": 150,
+    "dt_enn_and_enp": "Both overlay ENP and ENN low/high names map GPIO150; do not infer two independent rail enable pins.",
+    "limit": "Static overlay routing; live pin state and electrical rail topology unverified. BSP enum differs (11entries), so stock indices were decoded from stock pointer table."
+  },
+  "host_suspend_order": {
+    "primary_display_suspend": "0xffffff80087be6b8",
+    "path_stop_call": "0xffffff80087beab4 ->0xffffff8008796c14",
+    "panel_suspend_call": "0xffffff80087bec14 ->0xffffff80087d23c4",
+    "ddp_dsi_stop": "0xffffff800877b4f4",
+    "actions": [
+      "clear DSI_START bit0",
+      "DSI_SetMode(...,0) at0xffffff800877b774",
+      "wait BUSY bit31 clear",
+      "DSI_clk_HS_mode(...,false) at0xffffff800877b86c",
+      "clear INTEN0x08 and INTSTA0x0c"
+    ],
+    "conclusion": "Normal stock panel suspend occurs after host path stop in command mode. Sending sleep commands while inherited video scanout stays active is not corroborated by this normal path."
+  },
+  "video_command_transport": {
+    "source": "mt6762_dsi_vm_core.h",
+    "registration": "None; no native caller",
+    "packet": "DSI_set_cmdq_V2 short branch0xffffff80087758b8 encodes DCS one-parameter ID0x15, command bits16..23, parameter bits24..31, LONG_PKT0; VM_CMD_CON offset0x130.",
+    "setup": "DSI_Set_VM_CMD0xffffff8008771cfc sets VM_CMD_EN0 and TS_VFP_EN5. Prototype requires these already configured, VFP-only timing, sync-event video mode2.",
+    "trigger": "DSI_EnableVM_CMD0xffffff8008772108, direct path0xffffff8008772274..22d0 toggles START bit16 low then high preserving other bits.",
+    "completion": "INTSTA0x0c bit5 VM_CMD_DONE; BSP GCE path clears/polls/clears that bit. Host prototype requires observed low then high and bounded timeout.",
+    "acknowledgement": "Exact stock disp_irq_handler0xffffff8008799b24 complements selected status then stores to DSI+0xc at0xffffff8008799b3c; W0C. Prototype writes literal~0x20 to preserve unrelated status.",
+    "exclusions": [
+      "No enabling VM facility, mode transitions, clock/PLL/lane programming or interrupt-mask writes.",
+      "No command-mode, BTA/read, long vendor commands, arbitrary payloads or dual DSI.",
+      "No automatic retry or reset after unknown completion; failure latches terminal state.",
+      "Completion proves controller command completion, not panel acknowledgement or physical sleep."
+    ],
+    "initial_idle_admission": "Exclusive ownership alone is insufficient. The required admit_initial_idle callback must establish a previously verified idle handoff/drain independently; no physical proof implementation is supplied. Initial START16 high is always rejected before writes, irrespective of stale DONE. START16 low alone never proves idle.",
+    "retained_trigger": "A high START16 is accepted only for this transport own command after observed fresh DONE, unchanged packet/mode and final W0C acknowledgement readback low. Subsequent calls reject changed packet content or unexpectedly reasserted DONE; faults invalidate the completion token.",
+    "final_ack": "Read back INTSTA after final W0C. DONE still high or errors fail and latch fault; no success or subsequent command is allowed."
+  },
+  "integration_plan": [
+    "Keep committed PWM/copy blanking as current working lifecycle until a separate panel ownership contract is admitted.",
+    "Transfer exclusive DSI/GCE command queue and IRQ-acknowledgement ownership; prove no bootloader/SSPM/ESD worker can reset or submit commands concurrently. Read back clocks/domain/PLL/lane/timing/reset/bias state before each operation.",
+    "Use the unwired video short-command core only for separately admitted VM command operation. It is not an automatic panel-sleep policy.",
+    "For exact normal stock sleep, implement and validate host quiesce: stop producers/GCE at frame boundary, drain fences, stop display path, transition DSI to command mode and verify idle before panel commands. Retain clocks needed for command transport; do not power gate by guessed writes.",
