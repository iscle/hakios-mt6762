+#define SEEN_STATUS 2u
+#define SEEN_RFG 4u
+#define SEEN_TUNE 8u
+struct baseline_node {unsigned path,seen,children;};
+static uint32_t be32(const unsigned char *p)
+{return ((uint32_t)p[0]<<24)|((uint32_t)p[1]<<16)|((uint32_t)p[2]<<8)|p[3];}
+static uint64_t be64(const unsigned char *p)
+{return ((uint64_t)be32(p)<<32)|be32(p+4);}
+static int bounded(uint32_t at,uint32_t size,uint32_t end)
+{return at<=end && size<=end-at;}
+static int overlap(uint32_t a,uint32_t n,uint32_t b,uint32_t m)
+{return n && m && a<b+m && b<a+n;}
+static int length(const unsigned char *p,uint32_t maximum,uint32_t *out)
+{for(uint32_t n=0;n<maximum;n++)if(!p[n]){*out=n;return 1;}return 0;}
+static int same(const unsigned char *p,const char *s)
+{while(*p && *s && *p==(unsigned char)*s){p++;s++;}return !*p && !*s;}
+static int bytes_equal(const unsigned char *a,uint32_t n,const char *b,uint32_t m)
+{if(n!=m)return 0;for(uint32_t i=0;i<n;i++)if(a[i]!=(unsigned char)b[i])return 0;return 1;}
+static int compatible(unsigned path,const unsigned char *value,uint32_t size)
+{
+    static const char root[]="mediatek,MT6765";
+    static const char pwrap[]="mediatek,mt6765-pwrap\0syscon";
+    static const char pmic[]="mediatek,mt6357";
+    static const char gauge[]="mediatek,mt6357-gauge";
+    switch(path) {
+    case 1:return bytes_equal(value,size,root,sizeof(root));
+    case 2:return bytes_equal(value,size,pwrap,sizeof(pwrap));
+    case 3:return bytes_equal(value,size,pmic,sizeof(pmic));
+    case 4:return bytes_equal(value,size,gauge,sizeof(gauge));
+    default:return 1;
+    }
+}
+static int parse(const unsigned char *b,size_t accessible,
+    struct mt6762_gauge_baseline *next)
+{
+    static const char *const names[]={"","pwrap@1000d000","main_pmic","mtk_gauge"};
+    struct baseline_node stack[MAX_DEPTH];
+    unsigned depth=0,root_seen=0,seen_path[4]={0},gauge_compatible=0,done=0;
+    uint32_t total,structure,structure_size,strings,strings_size,reserve,at,stop;
+    if(!b || accessible<40 || be32(b)!=0xd00dfeed)return E_HEADER;
+    total=be32(b+4);structure=be32(b+8);strings=be32(b+12);reserve=be32(b+16);
+    strings_size=be32(b+32);structure_size=be32(b+36);
+    if(total<40 || total>accessible || total>MT6762_GAUGE_BASELINE_MAX_FDT ||
+       be32(b+20)!=17 || be32(b+24)<16 || be32(b+24)>17)return E_HEADER;
+    if(structure<40 || strings<40 || reserve<40 || (structure&3) || (reserve&7) ||
+       !structure_size || (structure_size&3) || !strings_size ||
+       !bounded(structure,structure_size,total) || !bounded(strings,strings_size,total) ||
+       overlap(structure,structure_size,strings,strings_size))return E_BOUNDS;
+    /* Validate the reserve-map terminator and separation from other blocks;
+     * do not interpret reservations as permission for this read-only query. */
+    at=reserve;
+    for(unsigned count=0;;count++) {
+        uint64_t address,size;
+        if(count>=256)return E_LIMIT;
+        if(!bounded(at,16,total) || overlap(at,16,structure,structure_size) ||
+           overlap(at,16,strings,strings_size))return E_BOUNDS;
+        address=be64(b+at);size=be64(b+at+8);at+=16;
+        if(!address && !size)break;
+        if(!size || address>UINT64_MAX-size)return E_BOUNDS;
+    }
+    at=structure;stop=structure+structure_size;
+    while(at<stop) {
+        uint32_t token;
+        if(!bounded(at,4,stop))return E_BOUNDS;
+        token=be32(b+at);at+=4;
+        if(token==1) {
+            uint32_t size,advance;unsigned path=0;
+            if(depth>=MAX_DEPTH)return E_LIMIT;
+            if(!length(b+at,stop-at,&size))return E_STRUCTURE;
+            advance=(size+4u)&~3u;
+            if(!bounded(at,advance,stop))return E_BOUNDS;
+            if(!depth) {
+                if(root_seen++ || size)return E_STRUCTURE;
+                path=1;
+            }else {
+                if(!size)return E_STRUCTURE;
+                for(uint32_t i=0;i<size;i++)if(b[at+i]=='/')return E_STRUCTURE;
+                stack[depth-1].children=1;
+                if(depth<4 && stack[depth-1].path==depth && same(b+at,names[depth]))path=depth+1;
+            }
+            if(path && seen_path[path-1]++)return E_AMBIGUOUS;
+            stack[depth++]=(struct baseline_node){path,0,0};at+=advance;
+        }else if(token==2) {
+            struct baseline_node *node;
+            if(!depth)return E_STRUCTURE;
+            node=&stack[--depth];
+            if(node->path && !(node->seen&SEEN_COMPATIBLE))return E_PROFILE;
+            if(node->path==4 && (node->seen&(SEEN_RFG|SEEN_TUNE))!=(SEEN_RFG|SEEN_TUNE))return E_PROFILE;
+        }else if(token==3) {
+            struct baseline_node *node;
+            uint32_t size,nameoff,n,padded,bit=0;const unsigned char *name;
+            if(!depth || !bounded(at,8,stop))return E_STRUCTURE;
+            node=&stack[depth-1];if(node->children)return E_STRUCTURE;
+            size=be32(b+at);nameoff=be32(b+at+4);at+=8;
+            if(size>stop-at || nameoff>=strings_size ||
+               !length(b+strings+nameoff,strings_size-nameoff,&n) || !n)return E_BOUNDS;
+            padded=(size+3u)&~3u;
+            if(padded<size || !bounded(at,padded,stop))return E_BOUNDS;
+            name=b+strings+nameoff;
+            if(same(name,"compatible"))bit=SEEN_COMPATIBLE;
+            else if(same(name,"status"))bit=SEEN_STATUS;
+            else if(node->path==4 && same(name,"R_FG_VALUE"))bit=SEEN_RFG;
+            else if(node->path==4 && same(name,"CAR_TUNE_VALUE"))bit=SEEN_TUNE;
+            if(bit && (node->seen&bit))return E_AMBIGUOUS;
+            node->seen|=bit;
+            if(bit==SEEN_COMPATIBLE) {
+                uint32_t pos=0;
+                if(!size)return E_STRUCTURE;
+                while(pos<size) {
+                    if(!length(b+at+pos,size-pos,&n) || !n)return E_STRUCTURE;
+                    if(same(b+at+pos,"mediatek,mt6357-gauge") && ++gauge_compatible>1)return E_AMBIGUOUS;
+                    pos+=n+1;
+                }
+                if(!compatible(node->path,b+at,size))return E_PROFILE;
+            }else if(bit==SEEN_STATUS) {
+                if(!size || !length(b+at,size,&n) || n+1!=size)return E_STRUCTURE;
+                if(node->path && !same(b+at,"okay") && !same(b+at,"ok"))return E_DISABLED;
+            }else if(bit==SEEN_RFG || bit==SEEN_TUNE) {
+                if(size!=4)return E_PROFILE;
+                if(bit==SEEN_RFG)next->dt_r_fg=be32(b+at);
+                else next->dt_car_tune=be32(b+at);
+            }
+            at+=padded;
+        }else if(token==4)continue;
+        else if(token==9) {
+            if(depth || root_seen!=1)return E_STRUCTURE;
+            done=1;break;
+        }else return E_STRUCTURE;
+    }
+    if(!done)return E_STRUCTURE;
+    while(at<stop)if(b[at++])return E_STRUCTURE;
+    if(seen_path[3]!=1 || gauge_compatible!=1 ||
+       next->dt_r_fg!=10 || next->dt_car_tune!=100)return E_PROFILE;
+    next->version=MT6762_GAUGE_BASELINE_V1;next->fdt_size=total;
+    next->r_fg=next->dt_r_fg*10;next->car_tune=next->dt_car_tune*10;
+    return 0;
+}
+int mt6762_gauge_baseline_from_fdt(const void *blob,size_t accessible,
+    struct mt6762_gauge_baseline *out)
+{
+    struct mt6762_gauge_baseline next={0};int error;
+    if(!out)return E_HEADER;
+    *out=next;
+    error=parse(blob,accessible,&next);
+    if(!error)*out=next;
+    return error;
+}
diff --git a/tools/mt6762/hardware/power/mt6762_gauge_baseline.h b/tools/mt6762/hardware/power/mt6762_gauge_baseline.h
new file mode 100644
index 0000000000000000000000000000000000000000..aad546ddb318110fc3b8a9fba599250ef0e720da
--- /dev/null
+++ b/tools/mt6762/hardware/power/mt6762_gauge_baseline.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: MIT -- exact-stock fresh-boot coefficient profile.
+ * Pure validation of caller-owned immutable FDT bytes; no hardware access.
+ * This is not the last Android runtime value, a hardware calibration check,
+ * or an ownership grant. See GAUGE-BASELINE.rst for source and replay evidence.
+ */
+#ifndef MT6762_GAUGE_BASELINE_H
+#define MT6762_GAUGE_BASELINE_H
+#include <stddef.h>
+#include <stdint.h>
+#define MT6762_GAUGE_BASELINE_V1 1u
+#define MT6762_GAUGE_BASELINE_MAX_FDT 0x80000u
+struct mt6762_gauge_baseline {
+    uint32_t version,fdt_size;
+    uint32_t dt_r_fg,dt_car_tune;
+    uint32_t r_fg,car_tune;
+};
+enum mt6762_gauge_baseline_error {
+    MT6762_GAUGE_BASELINE_E_HEADER=-1,
+    MT6762_GAUGE_BASELINE_E_BOUNDS=-2,
+    MT6762_GAUGE_BASELINE_E_STRUCTURE=-3,
+    MT6762_GAUGE_BASELINE_E_AMBIGUOUS=-4,
+    MT6762_GAUGE_BASELINE_E_PROFILE=-5,
+    MT6762_GAUGE_BASELINE_E_DISABLED=-6,
+    MT6762_GAUGE_BASELINE_E_LIMIT=-7
+};
+/* On any error *out is zeroed. A successful result is only a reproducible
+ * fresh initialization coefficient pair (100,1000), derived from present
+ * DT cells (10,100) by the exact stock multiplier10. No default fallback.
+ * Does not change existing mtk_fdt_info or depend on its layout. The caller
+ * must separately validate hardware calibration shadows, clocks/latch state,
+ * exclusive ownership, and fresh coherent acquisition before measurement. */
+int mt6762_gauge_baseline_from_fdt(const void *blob,size_t accessible,
+    struct mt6762_gauge_baseline *out);
+#endif
diff --git a/tools/mt6762/hardware/power/mt6762_gauge_probe.h b/tools/mt6762/hardware/power/mt6762_gauge_probe.h
new file mode 100644
index 0000000000000000000000000000000000000000..36e601e934757fdbb9dd94caf529f2e3310a16e4
--- /dev/null
+++ b/tools/mt6762/hardware/power/mt6762_gauge_probe.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: MIT -- finite capture33 gauge diagnostic policy.
+ * No hardware callback, clock programming, general ownership or publication.
+ * The unchanged native gauge protocol supplies the actual latch handshake. */
+#ifndef MT6762_GAUGE_PROBE_H
+#define MT6762_GAUGE_PROBE_H
+#include <stdint.h>
+
+struct mt6762_gauge_probe_profile {
+    uint32_t version,rfg,tune,config[5];
+};
+static inline int mt6762_gauge_probe_profile_ok(const struct mt6762_gauge_probe_profile *p)
+{
+    static const uint32_t expected[5]={0x129,0x416,1,0,0x416};
+    if(!p || p->version!=1 || p->rfg!=100 || p->tune!=1000)return 0;
+    for(unsigned i=0;i<5;i++)if(p->config[i]!=expected[i])return 0;
+    return 1;
+}
+static const uint16_t mt6762_gauge_probe_entry_regs[8]={
+    8,0xc0c,0xd08,0xc8e,0xc90,0xd94,0xd96,0xd0a};
+static const uint16_t mt6762_gauge_probe_entry_values[8]={
+    0x5730,4,0x129,0x416,1,0,0x416,0};
+struct mt6762_gauge_probe_budget {
+    unsigned next_sample,active,armed,pending,attempted,completed,fault;
+};
+static inline int mt6762_gauge_probe_read_allowed(const struct mt6762_gauge_probe_budget *b,
+    uint16_t reg)
+{
+    if(!b || b->fault || !b->active || b->pending || b->next_sample>=2 ||
+       b->attempted!=b->completed)return 0;
+    for(unsigned i=0;i<8;i++)if(reg==mt6762_gauge_probe_entry_regs[i])return 1;
+    /* Data are observable only after this sample's READ_PRE write, before
+     * its release sequence. A callback cannot read an inherited old latch. */
+    return b->armed && b->completed==4*b->next_sample+1 &&
+        (reg==0xd8a || reg==0xd12 || reg==0xd14 || reg==0xd20 || reg==0xd22 || reg==0xd24);
+}
+static inline int mt6762_gauge_probe_reject(struct mt6762_gauge_probe_budget *b)
+{if(b)b->fault=1;return 0;}
+static inline int mt6762_gauge_probe_begin(struct mt6762_gauge_probe_budget *b,unsigned sample)
+{
+    if(!b || b->fault || b->active || b->armed || b->pending || sample>=2 ||
+       sample!=b->next_sample || b->attempted!=sample*4 || b->completed!=sample*4)
+        return mt6762_gauge_probe_reject(b);
+    b->active=1;return 1;
+}
+static inline int mt6762_gauge_probe_arm(struct mt6762_gauge_probe_budget *b)
+{
+    if(!b || b->fault || !b->active || b->armed || b->pending || b->next_sample>=2 ||
+       b->attempted!=b->next_sample*4 || b->completed!=b->attempted)
+        return mt6762_gauge_probe_reject(b);
+    b->armed=1;return 1;
+}
+/* Admission consumes an attempted-write slot BEFORE the transport call. An
+ * ambiguous/failed transaction can never be repeated through this budget. */
+static inline int mt6762_gauge_probe_write_begin(struct mt6762_gauge_probe_budget *b,
+    uint16_t reg,uint16_t value)
+{
+    static const uint16_t sequence[4]={1,9,8,0};
+    if(!b || b->fault || !b->active || !b->armed || b->pending || b->next_sample>=2 ||
+       b->attempted>=8 || b->attempted>=4*(b->next_sample+1) ||
+       b->attempted!=b->completed || reg!=0xd0a || value!=sequence[b->attempted%4])
+        return mt6762_gauge_probe_reject(b);
+    b->pending=1;b->attempted++;return 1;
+}
+static inline int mt6762_gauge_probe_write_end(struct mt6762_gauge_probe_budget *b,int error)
+{
+    if(!b || b->fault || !b->pending || !b->active || !b->armed ||
+       b->attempted!=b->completed+1 || b->attempted>8)
+        return mt6762_gauge_probe_reject(b);
+    b->pending=0;
+    if(error)return mt6762_gauge_probe_reject(b);
+    b->completed++;return 1;
+}
+static inline int mt6762_gauge_probe_finish(struct mt6762_gauge_probe_budget *b)
+{
+    if(!b || b->fault || !b->active || !b->armed || b->pending || b->next_sample>=2 ||
+       b->attempted!=4*(b->next_sample+1) || b->completed!=b->attempted)
+        return mt6762_gauge_probe_reject(b);
+    b->active=0;b->armed=0;b->next_sample++;return 1;
+}
+static inline int mt6762_gauge_probe_deadline(uint64_t start,uint64_t interval,uint64_t *out)
+{
+    if(!out || !interval || UINT64_MAX-start<interval)return 0;
+    *out=start+interval;return 1;
+}
+static inline int mt6762_gauge_probe_in_lease(uint64_t start,uint64_t deadline,uint64_t now)
+{return deadline>start && now>=start && now<deadline;}
+#endif
diff --git a/tools/mt6762/hardware/power/mt6762_keys_entry.h b/tools/mt6762/hardware/power/mt6762_keys_entry.h
new file mode 100644
index 0000000000000000000000000000000000000000..9896d72b643e382f81d446a73436df60260ea47e
--- /dev/null
+++ b/tools/mt6762/hardware/power/mt6762_keys_entry.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: MIT -- captured inherited keypad, read-only polling.
+ * Stock DT: fixed26MHz clock, matrix indices0/1, GIC INTID212.
+ * MT6765 pin mapping: GPIO92 row0, GPIO93/94 columns0/1; capture20 matches.
+ * Captures19/20: enabled, debounce0x400, selection0x1c70, masked/inactive IRQ.
+ * Pending IRQ is allowed: polling never acknowledges or unmasks it.
+ */
+#ifndef MT6762_KEYS_ENTRY_H
+#define MT6762_KEYS_ENTRY_H
+#include <stdint.h>
+static inline int mt6762_keys_entry_ok(
+    uint32_t (*read)(void *,uint32_t,unsigned),void *context)
+{
+    if(!read)return 0;
+    for(unsigned pass=0;pass<2;pass++) {
+        if(read(context,0x0c000118,4)&(1u<<20))return 0;
+        if(read(context,0x0c000318,4)&(1u<<20))return 0;
+        if((read(context,0x100053b0,4)&0x07770000)!=0x01110000)return 0;
+        if(read(context,0x10010024,2)!=1 ||
+           read(context,0x10010018,2)!=0x400 ||
+           read(context,0x10010020,2)!=0x1c70)return 0;
+    }
+    return 1;
+}
+#endif
diff --git a/tools/mt6762/hardware/power/mt6762_pmic_entry.h b/tools/mt6762/hardware/power/mt6762_pmic_entry.h
new file mode 100644
index 0000000000000000000000000000000000000000..7a6443d6e52d2ee4fec1968f490d6d2b7a5ef16b
--- /dev/null
+++ b/tools/mt6762/hardware/power/mt6762_pmic_entry.h
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: MIT
+ * MT6357 inherited gauge/ADC observation, not measurement or admission.
+ * Ordinary 16-bit reads only; no latch/request/reset/SET/CLR writes. Output
+ * words are sequential observations, not a coherent measurement snapshot.
+ * ADC ready bits may belong to old conversions and confer no freshness.
+ * Sources and remaining ownership/calibration gaps: PMIC-ENTRY.rst.
+ */
+#ifndef MT6762_PMIC_ENTRY_H
+#define MT6762_PMIC_ENTRY_H
+#include <stdint.h>
+
+#define MT6762_PMIC_ENTRY_COUNT 13u
+static const uint16_t mt6762_pmic_entry_regs[MT6762_PMIC_ENTRY_COUNT]={
+    0x0008, /* HWCID: stop on an unexpected family before further reads. */
+    0x0c0c, /* BM_TOP_CKPDN_CON0: gauge digital/analog clock gates. */
+    0x0d08, /* FGADC_CON0: FG_ON and inherited configuration. */
+    0x0d0a, /* FGADC_CON1: existing command/latch state; never clear it. */
+    0x0c8e, /* FGADC_ANA_ELR0: hardware efuse gain shadow. */
+    0x0c90, /* FGADC_ANA_ELR1: hardware efuse offset shadow. */
+    0x0d94, /* FGADC_OFFSET_CON1: manual offset adjustment. */
+    0x0d96, /* FGADC_GAIN_CON0: hardware gain configuration. */
+    0x0e08, /* BATON_ANA_CON0: detector enable and absence state. */
+    0x108a, /* AUXADC_ADC1: previous battery voltage result/ready. */
+    0x108e, /* AUXADC_ADC3: previous thermistor result/ready. */
+    0x109e, /* AUXADC_ADC11: previous BIF result/ready. */
+    0x1236  /* AUXADC_CHR_TOP_CON2: inherited BATON_TDET_EN. */
+};
+typedef int (*mt6762_pmic_entry_read)(void *,uint16_t,uint16_t *);
+struct mt6762_pmic_entry_observation {
+    uint16_t value[MT6762_PMIC_ENTRY_COUNT];
+};
+struct mt6762_pmic_entry_failure {
+    unsigned index;
+    uint16_t address,value;
+    int error;
+};
+/* Return -1 for invalid arguments, -2 for transport failure, -3 for a wrong
+ * PMIC family. On failure leave *out untouched; never retry a failed read.
+ * Busy/disabled gauge fields and zero/stale ADC words are valid raw evidence,
+ * not grounds to clear a latch, start a conversion, or grant ownership. */
+static inline int mt6762_pmic_entry_observe(mt6762_pmic_entry_read read,
+    void *context,struct mt6762_pmic_entry_observation *out,
+    struct mt6762_pmic_entry_failure *failure)
+{
+    struct mt6762_pmic_entry_observation next;
+    if(!read || !out) {
+        if(failure)*failure=(struct mt6762_pmic_entry_failure){0,0,0,-1};
+        return -1;
+    }
+    for(unsigned i=0;i<MT6762_PMIC_ENTRY_COUNT;i++) {
+        uint16_t value=0;
+        int error=read(context,mt6762_pmic_entry_regs[i],&value);
+        if(error || (!i && (value>>8)!=0x57)) {
+            if(failure)*failure=(struct mt6762_pmic_entry_failure){
+                i,mt6762_pmic_entry_regs[i],error?0:value,error};
+            return error?-2:-3;
+        }
+        next.value[i]=value;
+    }
+    *out=next;
+    return 0;
+}
+
+/* Independent version1 ADC configuration record. Keep the preceding13-word
+ * record and API unchanged for existing physical capture decoders. HWCID is
+ * reread first; the remaining18 ordinary words fill the missing SWCID and
+ * native BIF configuration inventory. This does not request conversions or
+ * infer calibration from equality, zero/nonzero values or chip revision. */
+#define MT6762_PMIC_ADC_ENTRY_COUNT 19u
+static const uint16_t mt6762_pmic_adc_entry_regs[MT6762_PMIC_ADC_ENTRY_COUNT]={
+    0x0008, /* HWCID: independent identity guard for this pass. */
+    0x000a, /* SWCID. */
+    0x10de, /* AUXADC_DIG_1_ELR0: inherited software gain trim. */
+    0x10e0, /* AUXADC_DIG_1_ELR1: inherited software offset trim. */
+    0x1120, /* AUXADC_CON0; not SET/CLR aliases. */
+    0x1126, /* AUXADC_CON1. */
+    0x1128, /* AUXADC_CON2. */
+    0x112e, /* AUXADC_CON5. */
+    0x1132, /* AUXADC_CON7. */
+    0x1136, /* AUXADC_CON9. */
+    0x113a, /* AUXADC_CON11. */
+    0x113c, /* AUXADC_CON12. */
+    0x1008, /* AUXADC_ANA_CON0. */
+    0x11a2, /* AUXADC_DIG_3_ELR0. */
+    0x11a4, /* AUXADC_DIG_3_ELR1. */
+    0x11a6, /* AUXADC_DIG_3_ELR2. */
+    0x11a8, /* AUXADC_DIG_3_ELR3. */
+    0x11aa, /* AUXADC_DIG_3_ELR4. */
+    0x11ac  /* AUXADC_DIG_3_ELR5. */
+};
+struct mt6762_pmic_adc_entry_observation {
+    uint16_t value[MT6762_PMIC_ADC_ENTRY_COUNT];
+};
+static inline int mt6762_pmic_adc_entry_observe(mt6762_pmic_entry_read read,
+    void *context,struct mt6762_pmic_adc_entry_observation *out,
+    struct mt6762_pmic_entry_failure *failure)
+{
+    struct mt6762_pmic_adc_entry_observation next;
+    if(!read || !out) {
+        if(failure)*failure=(struct mt6762_pmic_entry_failure){0,0,0,-1};
+        return -1;
+    }
+    for(unsigned i=0;i<MT6762_PMIC_ADC_ENTRY_COUNT;i++) {
+        uint16_t value=0;
+        int error=read(context,mt6762_pmic_adc_entry_regs[i],&value);
+        if(error || (!i && (value>>8)!=0x57)) {
+            if(failure)*failure=(struct mt6762_pmic_entry_failure){
+                i,mt6762_pmic_adc_entry_regs[i],error?0:value,error};
+            return error?-2:-3;
+        }
+        next.value[i]=value;
+    }
+    *out=next;
+    return 0;
+}
+#endif
diff --git a/tools/mt6762/hardware/power/mt6762_pwrap_entry.h b/tools/mt6762/hardware/power/mt6762_pwrap_entry.h
new file mode 100644
index 0000000000000000000000000000000000000000..eff0584ff7ffb54d6b8265779bfb960dd4478913
--- /dev/null
+++ b/tools/mt6762/hardware/power/mt6762_pwrap_entry.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: MIT -- narrow inherited LK WACS2 read admission.
+ * Other masters, cipher, DIO, arbitration, clocks and PMIC state are preserved.
+ * Exact LK tests RDATA.INIT_DONE at bit22; the legacy lab uses bit21. */
+#ifndef MT6762_PWRAP_ENTRY_H
+#define MT6762_PWRAP_ENTRY_H
+#include <stdint.h>
+typedef uint32_t (*mt6762_pwrap_entry_read)(void *,uint32_t);
+static inline int mt6762_pwrap_entry_ok(mt6762_pwrap_entry_read read,void *ctx)
+{
+    static const struct {uint32_t address,mask,value;} checks[]={
+        {0x10001090,2,0}, /* Clock gate first, before PWRAP access. */
+        {0x1000d000,0xffffffff,0},{0x1000d004,0xffffffff,1},
+        {0x1000d07c,0xffffffff,0},{0x1000d09c,0xffffffff,1},
+        {0x1000d0a0,0xffffffff,1},{0x1000dc24,0x470000,0x400000},
+    };
+    for(unsigned pass=0;pass<2;pass++)
+        for(unsigned n=0;n<sizeof(checks)/sizeof(checks[0]);n++)
+            if((read(ctx,checks[n].address)&checks[n].mask)!=checks[n].value)return 0;
+    return 1;
+}
+#endif
diff --git a/tools/mt6762/hardware/power/mt6762_vbat_fdt.c b/tools/mt6762/hardware/power/mt6762_vbat_fdt.c
new file mode 100644
index 0000000000000000000000000000000000000000..1553704e8a13f8e4056e3459fb5565570e29d906
--- /dev/null
+++ b/tools/mt6762/hardware/power/mt6762_vbat_fdt.c
@@ -0,0 +1,201 @@
+#include "mt6762_vbat_profile.h"
+#include "mt6762_gauge_baseline.h"
+#define E_HEADER MT6762_GAUGE_BASELINE_E_HEADER
+#define E_BOUNDS MT6762_GAUGE_BASELINE_E_BOUNDS
+#define E_STRUCTURE MT6762_GAUGE_BASELINE_E_STRUCTURE
+#define E_AMBIGUOUS MT6762_GAUGE_BASELINE_E_AMBIGUOUS
+#define E_PROFILE MT6762_GAUGE_BASELINE_E_PROFILE
+#define E_DISABLED MT6762_GAUGE_BASELINE_E_DISABLED
+#define E_LIMIT MT6762_GAUGE_BASELINE_E_LIMIT
+#define MAX_DEPTH 64u
+#define SEEN_COMPATIBLE 1u
+#define SEEN_STATUS 2u
+#define SEEN_PHANDLE 4u
+#define SEEN_CHANNEL 8u
+#define SEEN_RATIO 16u
+#define SEEN_AVG 32u
+#define SEEN_CHANNELS 64u
+#define SEEN_NAMES 128u
+#define SEEN_CELLS 256u
+struct vbat_node {unsigned path,seen,children;};
+static uint32_t be32(const unsigned char *p)
+{return ((uint32_t)p[0]<<24)|((uint32_t)p[1]<<16)|((uint32_t)p[2]<<8)|p[3];}
+static uint64_t be64(const unsigned char *p)
+{return ((uint64_t)be32(p)<<32)|be32(p+4);}
+static int bounded(uint32_t at,uint32_t size,uint32_t end)
+{return at<=end && size<=end-at;}
+static int overlap(uint32_t a,uint32_t n,uint32_t b,uint32_t m)
+{return n && m && a<b+m && b<a+n;}
+static int length(const unsigned char *p,uint32_t maximum,uint32_t *out)
+{for(uint32_t n=0;n<maximum;n++)if(!p[n]){*out=n;return 1;}return 0;}
+static int same(const unsigned char *p,const char *s)
+{while(*p && *s && *p==(unsigned char)*s){p++;s++;}return !*p && !*s;}
+static int bytes_equal(const unsigned char *a,uint32_t n,const char *b,uint32_t m)
+{if(n!=m)return 0;for(uint32_t i=0;i<n;i++)if(a[i]!=(unsigned char)b[i])return 0;return 1;}
+static int compatible(unsigned path,const unsigned char *value,uint32_t size)
+{
+    static const char root[]="mediatek,MT6765";
+    static const char pwrap[]="mediatek,mt6765-pwrap\0syscon";
+    static const char pmic[]="mediatek,mt6357";
+    static const char gauge[]="mediatek,mt6357-gauge";
+    static const char adc[]="mediatek,pmic-auxadc\0mediatek,mt6357-auxadc";
+    switch(path) {
+    case 1:return bytes_equal(value,size,root,sizeof(root));
+    case 2:return bytes_equal(value,size,pwrap,sizeof(pwrap));
+    case 3:return bytes_equal(value,size,pmic,sizeof(pmic));
+    case 4:return bytes_equal(value,size,gauge,sizeof(gauge));
+    case 5:return bytes_equal(value,size,adc,sizeof(adc));
+    default:return 1;
+    }
+}
+static int parse(const unsigned char *b,size_t accessible,
+    struct mt6762_vbat_fdt_profile *next)
+{
+    static const char *const names[]={"","pwrap@1000d000","main_pmic"};
+    struct vbat_node stack[MAX_DEPTH];
+    unsigned depth=0,root_seen=0,seen_path[6]={0},gauge_compatible=0,adc_compatible=0,done=0;
+    uint32_t phandles[512],phandle_count=0,consumer_phandle=0;
+    uint32_t total,structure,structure_size,strings,strings_size,reserve,at,stop;
+    if(!b || accessible<40 || be32(b)!=0xd00dfeed)return E_HEADER;
+    total=be32(b+4);structure=be32(b+8);strings=be32(b+12);reserve=be32(b+16);
+    strings_size=be32(b+32);structure_size=be32(b+36);
+    if(total<40 || total>accessible || total>MT6762_GAUGE_BASELINE_MAX_FDT ||
+       be32(b+20)!=17 || be32(b+24)<16 || be32(b+24)>17)return E_HEADER;
+    if(structure<40 || strings<40 || reserve<40 || (structure&3) || (reserve&7) ||
+       !structure_size || (structure_size&3) || !strings_size ||
+       !bounded(structure,structure_size,total) || !bounded(strings,strings_size,total) ||
+       overlap(structure,structure_size,strings,strings_size))return E_BOUNDS;
+    /* Validate the reserve-map terminator and separation from other blocks;
+     * do not interpret reservations as permission for this read-only query. */
+    at=reserve;
+    for(unsigned count=0;;count++) {
+        uint64_t address,size;
+        if(count>=256)return E_LIMIT;
+        if(!bounded(at,16,total) || overlap(at,16,structure,structure_size) ||
+           overlap(at,16,strings,strings_size))return E_BOUNDS;
+        address=be64(b+at);size=be64(b+at+8);at+=16;
+        if(!address && !size)break;
+        if(!size || address>UINT64_MAX-size)return E_BOUNDS;
+    }
+    at=structure;stop=structure+structure_size;
+    while(at<stop) {
+        uint32_t token;
+        if(!bounded(at,4,stop))return E_BOUNDS;
+        token=be32(b+at);at+=4;
+        if(token==1) {
+            uint32_t size,advance;unsigned path=0;
+            if(depth>=MAX_DEPTH)return E_LIMIT;
+            if(!length(b+at,stop-at,&size))return E_STRUCTURE;
+            advance=(size+4u)&~3u;
+            if(!bounded(at,advance,stop))return E_BOUNDS;
+            if(!depth) {
+                if(root_seen++ || size)return E_STRUCTURE;
+                path=1;
+            }else {
+                if(!size)return E_STRUCTURE;
+                for(uint32_t i=0;i<size;i++)if(b[at+i]=='/')return E_STRUCTURE;
+                stack[depth-1].children=1;
+                if(depth<3 && stack[depth-1].path==depth && same(b+at,names[depth]))path=depth+1;
+                else if(depth==3 && stack[depth-1].path==3) {
+                    if(same(b+at,"mtk_gauge"))path=4;
+                    if(same(b+at,"pmic_auxadc"))path=5;
+                }else if(depth==4 && stack[depth-1].path==5 && same(b+at,"isense"))path=6;
+            }
+            if(path && seen_path[path-1]++)return E_AMBIGUOUS;
+            stack[depth++]=(struct vbat_node){path,0,0};at+=advance;
+        }else if(token==2) {
+            struct vbat_node *node;
+            if(!depth)return E_STRUCTURE;
+            node=&stack[--depth];
+            if(node->path && node->path<6 && !(node->seen&SEEN_COMPATIBLE))return E_PROFILE;
+            unsigned required=node->path==4?(SEEN_CHANNELS|SEEN_NAMES):node->path==5?(SEEN_PHANDLE|SEEN_CELLS):
+                node->path==6?(SEEN_CHANNEL|SEEN_RATIO|SEEN_AVG):0;
+            if((node->seen&required)!=required)return E_PROFILE;
+        }else if(token==3) {
+            struct vbat_node *node;
+            uint32_t size,nameoff,n,padded,bit=0;const unsigned char *name;
+            if(!depth || !bounded(at,8,stop))return E_STRUCTURE;
+            node=&stack[depth-1];if(node->children)return E_STRUCTURE;
+            size=be32(b+at);nameoff=be32(b+at+4);at+=8;
+            if(size>stop-at || nameoff>=strings_size ||
+               !length(b+strings+nameoff,strings_size-nameoff,&n) || !n)return E_BOUNDS;
+            padded=(size+3u)&~3u;
+            if(padded<size || !bounded(at,padded,stop))return E_BOUNDS;
+            name=b+strings+nameoff;
+            if(same(name,"compatible"))bit=SEEN_COMPATIBLE;
+            else if(same(name,"status"))bit=SEEN_STATUS;
+            else if(same(name,"phandle") || same(name,"linux,phandle"))bit=SEEN_PHANDLE;
+            else if(node->path==4 && same(name,"io-channels"))bit=SEEN_CHANNELS;
+            else if(node->path==4 && same(name,"io-channel-names"))bit=SEEN_NAMES;
+            else if(node->path==5 && same(name,"#io-channel-cells"))bit=SEEN_CELLS;
+            else if(depth>=2 && stack[depth-2].path==5 && same(name,"channel"))bit=SEEN_CHANNEL;
+            else if(node->path==6 && same(name,"resistance-ratio"))bit=SEEN_RATIO;
+            else if(node->path==6 && same(name,"avg-num"))bit=SEEN_AVG;
+            if(bit && (node->seen&bit))return E_AMBIGUOUS;
+            node->seen|=bit;
+            if(bit==SEEN_COMPATIBLE) {
+                uint32_t pos=0;
+                if(!size)return E_STRUCTURE;
+                while(pos<size) {
+                    if(!length(b+at+pos,size-pos,&n) || !n)return E_STRUCTURE;
+                    if(same(b+at+pos,"mediatek,mt6357-gauge") && ++gauge_compatible>1)return E_AMBIGUOUS;
+                    if(same(b+at+pos,"mediatek,mt6357-auxadc") && ++adc_compatible>1)return E_AMBIGUOUS;
+                    pos+=n+1;
+                }
+                if(!compatible(node->path,b+at,size))return E_PROFILE;
+            }else if(bit==SEEN_STATUS) {
+                if(!size || !length(b+at,size,&n) || n+1!=size)return E_STRUCTURE;
+                if(node->path && !same(b+at,"okay") && !same(b+at,"ok"))return E_DISABLED;
+            }else if(bit==SEEN_PHANDLE) {
+                if(size!=4 || !be32(b+at) || be32(b+at)==0xffffffffu)return E_PROFILE;
+                uint32_t value=be32(b+at);
+                for(unsigned i=0;i<phandle_count;i++)if(phandles[i]==value)return E_AMBIGUOUS;
+                if(phandle_count==512)return E_LIMIT;
+                phandles[phandle_count++]=value;
+                if(node->path==5)next->phandle=value;
+            }else if(bit==SEEN_CHANNELS) {
+                static const uint32_t channels[]={3,1,14,15,16};
+                if(size!=40)return E_PROFILE;
+                consumer_phandle=be32(b+at);
+                for(unsigned i=0;i<5;i++)if(be32(b+at+8*i)!=consumer_phandle ||
+                    be32(b+at+8*i+4)!=channels[i])return E_PROFILE;
+            }else if(bit==SEEN_NAMES) {
+                static const char expected[]="pmic_battery_temp\0pmic_battery_voltage\0pmic_bif_voltage\0pmic_ptim_voltage\0pmic_ptim_r";
+                if(!bytes_equal(b+at,size,expected,sizeof(expected)))return E_PROFILE;
+            }else if(bit==SEEN_RATIO) {
+                if(size!=8 || be32(b+at)!=3 || be32(b+at+4)!=1)return E_PROFILE;
+                next->ratio_num=3;next->ratio_den=1;
+            }else if(bit==SEEN_CHANNEL || bit==SEEN_AVG || bit==SEEN_CELLS) {
+                if(size!=4)return E_PROFILE;
+                uint32_t value=be32(b+at);
+                if(bit==SEEN_CHANNEL) {
+                    if(node->path==6) {if(value!=1)return E_PROFILE;next->channel=value;}
+                    else if(value==1)return E_AMBIGUOUS;
+                }
+                else if(bit==SEEN_AVG) {if(value!=128)return E_PROFILE;next->avg_num=value;}
+                else if(value!=1)return E_PROFILE;
+            }
+            at+=padded;
+        }else if(token==4)continue;
+        else if(token==9) {
+            if(depth || root_seen!=1)return E_STRUCTURE;
+            done=1;break;
+        }else return E_STRUCTURE;
+    }
+    if(!done)return E_STRUCTURE;
+    while(at<stop)if(b[at++])return E_STRUCTURE;
+    if(seen_path[3]!=1 || seen_path[4]!=1 || seen_path[5]!=1 || gauge_compatible!=1 ||
+       adc_compatible!=1 || !next->phandle || consumer_phandle!=next->phandle)return E_PROFILE;
+    next->version=MT6762_VBAT_PROFILE_V1;next->fdt_size=total;
+    return 0;
+}
+int mt6762_vbat_profile_from_fdt(const void *blob,size_t accessible,
+    struct mt6762_vbat_fdt_profile *out)
+{
+    struct mt6762_vbat_fdt_profile next={0};int error;
+    if(!out)return E_HEADER;
+    *out=next;
+    error=parse(blob,accessible,&next);
+    if(!error)*out=next;
+    return error;
+}
diff --git a/tools/mt6762/hardware/power/mt6762_vbat_profile.h b/tools/mt6762/hardware/power/mt6762_vbat_profile.h
new file mode 100644
index 0000000000000000000000000000000000000000..c61364b164ff2e2ce4f8f8af3ef17b4484a0db86
--- /dev/null
+++ b/tools/mt6762/hardware/power/mt6762_vbat_profile.h
@@ -0,0 +1,33 @@
+/* Exact inherited MT6357 channel1 profile. No hardware operations or grants. */
+#ifndef MT6762_VBAT_PROFILE_H
+#define MT6762_VBAT_PROFILE_H
+#include <stddef.h>
+#include <stdint.h>
+#define MT6762_VBAT_PROFILE_V1 1u
+#define MT6762_VBAT_FIXED_COUNT 19u
+#define MT6762_VBAT_ENTRY_COUNT 24u
+static const uint16_t mt6762_vbat_entry_regs[MT6762_VBAT_ENTRY_COUNT]={
+    0x0008,0x000a,0x10de,0x10e0,0x1120,0x1126,0x1128,0x112e,0x1132,0x1136,
+    0x113a,0x113c,0x1008,0x11a2,0x11a4,0x11a6,0x11a8,0x11aa,0x11ac,
+    0x0f8c,0x0f8e,0x0f90,0x113e,0x114c};
+/* Capture44, both complete passes, checked again by producer and consumer. */
+static const uint16_t mt6762_vbat_fixed_values[MT6762_VBAT_FIXED_COUNT]={
+    0x5730,0x5730,0x7fca,0x000f,0x0014,0x0372,0x8083,0x4000,0x0030,0x6262,
+    0x95d0,0x4055,0x0001,0x0fc0,0x0038,0x01ac,0x004c,0x0fdb,0x000d};
+static inline int mt6762_vbat_entry_ok(const uint16_t *words)
+{
+    if(!words)return 0;
+    for(unsigned i=0;i<MT6762_VBAT_FIXED_COUNT;i++)if(words[i]!=mt6762_vbat_fixed_values[i])return 0;
+    /* Original preloader table @0x37fd8: F8C=AA mask3FF, F8E=0 mask1.
+     * Also refuse test/interpolation-clock disable, any HK/ADC reset, RNG,
+     * test/start/mux/buffer overrides and alternate output selection. These
+     * are readiness predicates, not assumed uncaptured register values. */
+    return (words[19]&0x3ff)==0xaa && !(words[20]&7) && !(words[21]&0xff) &&
+        !(words[22]&0x3449) && !(words[23]&0x500);
+}
+struct mt6762_vbat_fdt_profile {uint32_t version,fdt_size,phandle,channel,ratio_num,ratio_den,avg_num;};
+/* Immutable caller-owned FDT, <=512KiB. Exact paths, compatible/status,
+ * provider phandle, named consumer mapping, channel/ratio/averaging required.
+ * Output zero on all failures; no defaults, fixed phandle assumption or I/O. */
+int mt6762_vbat_profile_from_fdt(const void *,size_t,struct mt6762_vbat_fdt_profile *);
+#endif
