index 0000000000000000000000000000000000000000..ac6f457fd03dc1ea082198da42e6d2387575ddc2
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/decode_clock_snapshot.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""Decode CPU/CCI configured rates from retained peripheral-result JSON only.
+
+No device access, MMIO writes, firmware commands, or readiness grants. A
+matching pair of samples is not an atomic snapshot or a frequency measurement.
+See PHYSICAL-CLOCKS.rst for exact stock/BSP provenance and missing handoff proof.
+"""
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+
+DOMAINS = {
+    "cpu0_3": (0x1000C21C, 0x1000C220, 0x1000C228, 0x102007A0),
+    "cpu4_7": (0x1000C20C, 0x1000C210, 0x1000C218, 0x102007A4),
+    "cci": (0x1000C22C, 0x1000C230, 0x1000C238, 0x102007C0),
+}
+FIELDS = ("con0", "con1", "power", "ckdiv")
+
+
+def u32(value):
+    return type(value) is int and 0 <= value <= 0xFFFFFFFF
+
+
+def decode_rate(con0, con1, power, ckdiv):
+    """Same admission/arithmetic as mt6762_pll_khz; unknown never means zero."""
+    if not all(u32(word) for word in (con0, con1, power, ckdiv)):
+        return {"valid": False, "nominal_khz": None, "reasons": ["invalid u32"]}
+    post = (con1 >> 24) & 7
+    div = (ckdiv >> 17) & 31
+    pcw = con1 & 0x3FFFFF
+    mux = (ckdiv >> 9) & 3
+    reasons = []
+    if not con0 & 1:
+        reasons.append("PLL disabled")
+    if power & 3 != 1:
+        reasons.append("PLL not powered without isolation")
+    if mux != 1:
+        reasons.append("source mux does not select this PLL")
+    if not pcw:
+        reasons.append("zero PCW")
+    if post > 4:
+        reasons.append("reserved postdivider")
+    # Exact inherited preloader encoding; see CKDIV0.rst. Do not copy stock's
+    # permissive default for the other unsupported divider codes.
+    if div == 0:
+        numerator, denominator = 1, 1
+    elif 8 <= div <= 11:
+        numerator, denominator = 12 - div, 4
+    elif 16 <= div <= 20:
+        numerator, denominator = 21 - div, 5
+    elif 24 <= div <= 29:
+        numerator, denominator = 30 - div, 6
+    else:
+        numerator, denominator = None, None
+        reasons.append("unsupported/reserved CKDIV")
+    rate = stock_rate = None
+    if not reasons:
+        rate = pcw * 26000 * numerator // (16384 * (1 << post) * denominator)
+        # The exact stock getter truncates to integer MHz before dividing.
+        stock_rate = (((pcw * 26) >> 14) * 1000 // (1 << post)) * numerator // denominator
+        if not 0 < rate <= 0xFFFFFFFF:
+            rate = stock_rate = None
+            reasons.append("rate outside nonzero u32")
+    return {
+        "valid": not reasons,
+        "nominal_khz": rate,
+        "stock_getter_rounded_khz": stock_rate,
+        "reasons": reasons,
+        "fields": {"pcw": pcw, "postdivider_code": post, "ckdiv_code": div,
+                   "source_mux": mux, "ratio_numerator": numerator,
+                   "ratio_denominator": denominator},
+    }
+
+
+def decode_snapshot(capture):
+    if not isinstance(capture, dict) or not isinstance(capture.get("registers"), list):
+        raise ValueError("expected peripheral-result JSON object with register list")
+    capture_reasons = []
+    if type(capture.get("state")) is not int or capture["state"] != 2:
+        capture_reasons.append("capture not complete")
+    if type(capture.get("pass_number")) is not int or capture["pass_number"] != 2:
+        capture_reasons.append("capture does not contain two passes")
+    entries = {}
+    for record in capture["registers"]:
+        if not isinstance(record, dict):
+            raise ValueError("invalid register record")
+        address = record.get("address")
+        try:
+            address = int(address, 0) if isinstance(address, str) else address
+        except ValueError as error:
+            raise ValueError("invalid register address") from error
+        if not u32(address):
+            raise ValueError("invalid register address")
+        entries.setdefault(address, []).append(record)
+    domains = {}
+    for domain, addresses in DOMAINS.items():
+        reasons = list(capture_reasons)
+        raw, registers = {}, {}
+        for name, address in zip(FIELDS, addresses):
+            matches = entries.get(address, [])
+            registers[name] = {"address": f"0x{address:08x}", "value": None}
+            if not matches:
+                reasons.append(f"{name}: not captured")
+                continue
+            if len(matches) != 1:
+                reasons.append(f"{name}: duplicate address")
+                continue
+            item = matches[0]
+            if (type(item.get("width")) is not int or item["width"] != 4 or
+                    type(item.get("valid")) is not int or item["valid"] != 3 or
+                    item.get("stable") is not True or
+                    not u32(item.get("first")) or not u32(item.get("second")) or
+                    item["first"] != item["second"]):
+                reasons.append(f"{name}: incomplete/unstable/non-u32 double read")
+                continue
+            raw[name] = item["first"]
+            registers[name]["value"] = f"0x{item['first']:08x}"
+        decoded = {"valid": False, "nominal_khz": None,
+                   "stock_getter_rounded_khz": None, "reasons": reasons}
+        if not reasons:
+            decoded = decode_rate(**raw)
+        domains[domain] = dict(decoded, registers=registers)
+    return {
+        "schema": "mt6762-configured-cpu-clocks-v1",
+        "reference_khz": 26000,
+        "domains": domains,
+        "ownership_granted": False,
+        "dvfs_control_ready": False,
+        "device_access_performed": False,
+        "limitations": [
+            "Configured nominal rates; no hardware frequency-counter measurement.",
+            "Two equal read passes do not prove atomicity or exclude an intervening change.",
+            "This parser does not authenticate capture acquisition or verify the claimed peripheral-record digest.",
+            "No PMIC electrical measurement, calibrated OPP, SSPM liveness, or thermal/current budget proof.",
+        ],
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("capture", type=Path)
+    args = parser.parse_args()
+    blob = args.capture.read_bytes()
+    try:
+        capture = json.loads(blob)
+        report = decode_snapshot(capture)
+    except (ValueError, TypeError) as error:
+        parser.error(str(error))
+    report["input"] = {"path": str(args.capture.resolve()),
+                       "file_sha256": hashlib.sha256(blob).hexdigest(),
+                       "claimed_peripheral_record_sha256": capture.get("sha256")}
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/mt6762/hardware/cpu-power/decode_sspm_observation.py b/tools/mt6762/hardware/cpu-power/decode_sspm_observation.py
new file mode 100644
index 0000000000000000000000000000000000000000..318658c33c4bca165316cc1974ee0d6474da0244
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/decode_sspm_observation.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""Decode the bounded passive SSPM log record; no device access or DVFS grant."""
+import argparse
+import hashlib
+import json
+import re
+from pathlib import Path
+
+GROUPS = {'guards': (5, 1), 'pvt': (144, 2), 'eem': (3, 4), 'ppm': (2, 8),
+          'voltage': (3, 16), 'index': (3, 32), 'vote': (3, 64),
+          'mailbox': (9, 128), 'irq': (2, 256)}
+HEADER = re.compile(r'MT6762_SSPM_OBSERVE version=1 passes=2 words=174 '
+                    r'stable_groups=([0-9a-f]{3}) guards=([01]) '
+                    r'c62_representation=([01]) ownership=0 liveness=unknown')
+RAW = re.compile(r'MT6762_SSPM_RAW pass=([01]) group=([a-z]+) word=(\d+) '
+                 r'count=([1-4]) ((?:[0-9a-f]{8} ){3}[0-9a-f]{8})')
+GUARDS = [0x55aa55aa, 0xaa55aa55, 0x55aa55aa, 0xaa55aa55, 0x55aa55aa]
+
+
+def c62_match(words):
+    rows = json.loads((Path(__file__).parent / 'evidence/stock-c62-pvt.json').read_text())['rows']
+    for domain in range(3):
+        if words[domain*36+32] != 0xffffffff:
+            return False
+        for i in range(16):
+            fv, method = words[domain*36+i], words[domain*36+16+i]
+            mhz, _, post, clk = rows[domain*16+i]
+            if (fv & 0xf0000000 or ((fv >> 16) & 0xfff) > 127 or
+                    method & 0xff00ff00 or fv & 0xffff != mhz or
+                    method & 0xff != post or (method >> 16) & 0xff != clk):
+                return False
+    return True
+
+
+def decode(blob):
+    text = blob.decode('ascii', errors='replace')
+    headers = list(HEADER.finditer(text))
+    if len(headers) != 1:
+        raise ValueError('Expected exactly one version1 complete SSPM observation')
+    header = headers[0]
+    tail = text[header.end():]
+    end = tail.find('MT6762_SSPM_OBSERVE end=1 writes=0')
+    if end < 0:
+        raise ValueError('Truncated SSPM observation')
+    stable = int(header[1], 16)
+    if stable & ~511:
+        raise ValueError('Unknown stability bits')
+    samples = [{name: [None]*count for name, (count, _) in GROUPS.items()}
+               for _ in range(1 if stable == 511 else 2)]
+    for line in tail[:end].splitlines():
+        if 'MT6762_SSPM_RAW' not in line:
+            continue
+        match = RAW.fullmatch(line.strip())
+        if not match:
+            raise ValueError('Malformed SSPM raw line')
+        p, name, start, count, raw = match.groups()
+        p, start, count = int(p), int(start), int(count)
+        words = [int(word, 16) for word in raw.split()]
+        if p >= len(samples) or name not in GROUPS or start % 4:
+            raise ValueError('Unexpected pass/group/word')
+        group = samples[p][name]
+        if count != min(4, len(group)-start) or any(words[count:]):
+            raise ValueError('Unexpected count or nonzero padding')
+        if not 0 <= start < len(group) or any(v is not None for v in group[start:start+count]):
+            raise ValueError('Duplicate/out-of-range SSPM raw words')
+        group[start:start+count] = words[:count]
+    if any(v is None for sample in samples for group in sample.values() for v in group):
+        raise ValueError('Missing SSPM raw words')
+    if len(samples) == 2:
+        computed = sum(flag for name, (_, flag) in GROUPS.items() if samples[0][name] == samples[1][name])
+        if stable != computed:
+            raise ValueError('Raw samples disagree with stability report')
+    guards = bool(stable & 1) and samples[0]['guards'] == GUARDS
+    c62 = guards and bool(stable & 2) and c62_match(samples[0]['pvt'])
+    if guards != bool(int(header[2])) or c62 != bool(int(header[3])):
+        raise ValueError('Raw samples disagree with representation report')
+    interpretation = []
+    for s in samples:
+        interpretation.append({
+            'pending_platform_cpu_in': s['mailbox'][0] & 3,
+            'pending_platform_cpu_out': s['mailbox'][1] & 3,
+            'mailbox0_irq_enabled': bool(s['irq'][0] & (1 << 13)),
+            'mailbox0_irq_active': bool(s['irq'][1] & (1 << 13)),
+            'eem_flags_clear': not any(s['eem']),
+            'current_indices_in_range': all(v <= 15 for v in s['index']),
+            'ppm_indices_in_range': all((v >> 16) <= (v & 0xffff) <= 15 for v in s['ppm']),
+            'vote_fields': [{'index': v & 15, 'counter': (v >> 4) & 255,
+                             'upper_bits': v >> 12} for v in s['vote']],
+        })
+    return {'input_sha256': hashlib.sha256(blob).hexdigest(), 'version': 1,
+            'stable_groups': stable, 'matching_second_raw_pass_omitted': len(samples) == 1,
+            'guards_match': guards, 'c62_representation_match': c62,
+            'samples': samples, 'interpretation': interpretation,
+            'ownership_granted': False, 'controller_ready': False,
+            'limits': ['Guard/table matches do not prove CPU-DVFS initialization, bin, EEM, freshness or firmware liveness.',
+                       'Voltage words have no asserted physical measurement, units or request correlation.',
+                       'Votes are submissions, not sequence acknowledgements; snapshots are not atomic or ABA-proof.',
+                       'No mailbox status was acknowledged; this observer does not own firmware or IRQs.']}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('log', type=Path)
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    args.output.write_text(json.dumps(decode(args.log.read_bytes()), indent=2) + '\n')
+
+
+if __name__ == '__main__':
+    main()
