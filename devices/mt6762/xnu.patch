+"""Host tests of the original no-I/O management protocol core."""
+import ctypes as C
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parent
+DEFAULT = bytes.fromhex('02040600000411000000')
+SET = bytes.fromhex('020402000003')
+FULL = bytes.fromhex('020406000004db0e6801')
+
+def crc(data):
+    value = 0
+    for b in data:
+        value ^= b
+        for _ in range(8):
+            value = (value >> 1) ^ (0xA001 if value & 1 else 0)
+    return value
+
+def frame(data, full=False, seq=0, ack=0, channel=4):
+    h = bytes([0x80 | (seq << 3) | (ack if full else 0),
+               (channel << 4) | (len(data) >> 8), len(data) & 255])
+    return h + bytes([sum(h) & 255 if full else 0]) + data + (
+        crc(data) if full else 0).to_bytes(2, 'little')
+
+def ack_frame(ack=0):
+    return bytes([0x80 | ack, 0, 0, 0x80 | ack])
+
+class Protocol(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.temp = tempfile.TemporaryDirectory()
+        p = Path(cls.temp.name)
+        (p/'wrap.c').write_text('#include "wmt_protocol.h"\n'
+            'unsigned test_phase(struct cw_session*s){return s->phase;}\n'
+            'unsigned test_events(struct cw_session*s){return s->events;}\n'
+            'unsigned test_packets(struct cw_session*s){return s->packets;}\n'
+            'unsigned test_size(void){return sizeof(struct cw_session);}\n')
+        subprocess.run(['cc','-std=c99','-Wall','-Wextra','-Werror','-O2',
+            '-fPIC','-shared','-I',str(ROOT),str(ROOT/'wmt_protocol.c'),
+            str(p/'wrap.c'),'-o',str(p/'test.so')], check=True)
+        cls.lib = C.CDLL(str(p/'test.so'))
+        for name in ['test_phase','test_events','test_packets']:
+            getattr(cls.lib,name).argtypes=[C.c_void_p]
+        cls.lib.cw_init.argtypes=[C.c_void_p,C.c_uint]
+        cls.lib.cw_poll.argtypes=[C.c_void_p,C.c_uint64]
+        cls.lib.cw_command.argtypes=[C.c_void_p,C.c_int,C.c_uint64,C.c_uint64,
+                                    C.c_void_p,C.c_size_t,C.c_void_p]
+        cls.lib.cw_enter_full.argtypes=[C.c_void_p,C.c_uint64]
+        cls.lib.cw_attest_pda_patch_reset.argtypes=[C.c_void_p,C.c_uint64]
+        cls.lib.cw_feed.argtypes=[C.c_void_p,C.c_void_p,C.c_size_t,C.c_uint64]
+        cls.lib.cw_take_ack.argtypes=[C.c_void_p,C.c_void_p]
+        cls.lib.cw_crc16.argtypes=[C.c_void_p,C.c_size_t]
+        cls.lib.cw_crc16.restype=C.c_uint16
+    @classmethod
+    def tearDownClass(cls):
+        cls.temp.cleanup()
+    def setUp(self):
+        self.s=(C.c_uint64*((self.lib.test_size()+7)//8))()
+        self.lib.cw_init(self.s,1)
+    def command(self, cmd, now=100, timeout=100000):
+        out=C.create_string_buffer(80);n=C.c_size_t()
+        self.assertEqual(self.lib.cw_command(self.s,cmd,now,timeout,out,80,C.byref(n)),0)
+        return out.raw[:n.value]
+    def feed(self, data, now=200):
+        return self.lib.cw_feed(self.s,data,len(data),now)
+    def full_start(self):
+        self.assertEqual(self.command(1),bytes.fromhex('8040050001040100040000'))
+        self.assertEqual(self.feed(frame(DEFAULT)),0)
+        self.assertEqual(self.lib.cw_attest_pda_patch_reset(self.s,250),0)
+        self.assertEqual(self.command(2,300),bytes.fromhex('804009000104050003db0e68010000'))
+        self.assertEqual(self.feed(frame(SET),400),0)
+        self.assertEqual(self.lib.cw_enter_full(self.s,10400),0)
+        self.assertEqual(self.command(3,10500),bytes.fromhex('874005cc01040100046cf3'))
+    def test_crc_known_vector(self):
+        self.assertEqual(self.lib.cw_crc16(b'123456789',9),0xbb3d)
+    def test_default_off_and_invalid_enable(self):
+        for enabled in [0,2,0xffffffff]:
+            self.lib.cw_init(self.s,enabled)
+            self.assertEqual(self.feed(b''),-1)
+    def test_exact_three_command_handshake(self):
+        self.full_start()
+        self.assertEqual(self.feed(frame(FULL,True),10600),0)
+        self.assertEqual(self.lib.test_phase(self.s),8)
+        out=C.create_string_buffer(4)
+        self.assertEqual(self.lib.cw_take_ack(self.s,out),0)
+        self.assertEqual(out.raw,ack_frame())
+        self.assertEqual(self.lib.test_events(self.s),3)
+    def test_every_transport_split(self):
+        data=frame(DEFAULT)
+        for split in range(len(data)+1):
+            self.lib.cw_init(self.s,1);self.command(1)
+            self.assertEqual(self.feed(data[:split]),0)
+            self.assertEqual(self.feed(data[split:]),0)
+            self.assertEqual(self.lib.test_phase(self.s),3)
+    def test_full_bytewise_split_and_delimiter(self):
+        self.full_start()
+        for byte in b'\x55\x55'+frame(FULL,True):
+            self.assertEqual(self.feed(bytes([byte]),10600),0)
+        self.assertEqual(self.lib.test_phase(self.s),8)
+    def test_wmt_split_across_stp_packets(self):
+        self.full_start()
+        self.assertEqual(self.feed(frame(FULL[:3],True)+frame(FULL[3:],True,seq=1),10600),0)
+        self.assertEqual(self.lib.test_phase(self.s),8)
+    def test_ack_and_event_coalesced(self):
+        self.full_start()
+        self.assertEqual(self.feed(ack_frame()+frame(FULL,True),10600),0)
+        self.assertEqual(self.lib.test_phase(self.s),8)
+    def test_event_waits_for_command_ack(self):
+        self.full_start()
+        self.assertEqual(self.feed(frame(FULL,True,ack=7),10600),0)
+        self.assertEqual(self.lib.test_phase(self.s),7)
+        self.assertEqual(self.feed(ack_frame(),10700),0)
+        self.assertEqual(self.lib.test_phase(self.s),8)
+    def test_crc_error_sticky(self):
+        self.full_start();p=bytearray(frame(FULL,True));p[-1]^=1
+        self.assertEqual(self.feed(bytes(p),10600),-6)
+        self.assertEqual(self.feed(frame(FULL,True),10700),-6)
+        self.assertEqual(self.lib.test_events(self.s),2)
+    def test_checksum_error(self):
+        self.full_start();p=bytearray(frame(FULL,True));p[3]^=1
+        self.assertEqual(self.feed(bytes(p),10600),-5)
+    def test_wrong_opcode_status_and_options(self):
+        for at, value, err in [(1,7,-11),(4,1,-12),(6,0x12,-11)]:
+            self.lib.cw_init(self.s,1);self.command(1);p=bytearray(DEFAULT);p[at]=value
+            self.assertEqual(self.feed(frame(p)),err)
+            self.assertEqual(self.lib.test_events(self.s),0)
+    def test_wrong_channel_sequence_ack_nak(self):
+        for data,err in [(frame(FULL,True,channel=3),-8),
+                         (frame(FULL,True,seq=1),-9),
+                         (frame(FULL,True,ack=2),-10),
+                         (bytes.fromhex('80c00a4a'),-4)]:
+            self.lib.cw_init(self.s,1);self.full_start()
+            self.assertEqual(self.feed(data,10600),err)
+    def test_oversize_outer_and_inner(self):
+        self.command(1)
+        self.assertEqual(self.feed(bytes.fromhex('80480000')),-7)
+        self.lib.cw_init(self.s,1);self.command(1)
+        self.assertEqual(self.feed(frame(bytes.fromhex('0204ffff'))),-7)
+    def test_mandatory_zero_tail_and_checksum(self):
+        for offset,err in [(3,-5),(-1,-6)]:
+            self.lib.cw_init(self.s,1);self.command(1);p=bytearray(frame(DEFAULT));p[offset]=1
+            self.assertEqual(self.feed(bytes(p)),err)
+    def test_timeout_partial_and_backward_clock(self):
+        self.command(1,100,1000)
+        self.assertEqual(self.feed(b'\x80',1099),0)
+        self.assertEqual(self.feed(frame(DEFAULT)[1:],1100),-13)
+        self.lib.cw_init(self.s,1);self.command(1)
+        self.assertEqual(self.feed(b'',99),-14)
+    def test_frozen_clock_budget(self):
+        self.command(1)
+        for _ in range(1000000):
+            self.assertEqual(self.lib.cw_poll(self.s,100),0)
+        self.assertEqual(self.lib.cw_poll(self.s,100),-15)
+    def test_explicit_switch_and_wait(self):
+        self.command(1);self.feed(frame(DEFAULT));self.lib.cw_attest_pda_patch_reset(self.s,250);self.command(2,300);self.feed(frame(SET),400)
+        self.assertEqual(self.lib.cw_enter_full(self.s,10399),-3)
+        self.assertEqual(self.lib.cw_enter_full(self.s,10400),0)
+    def test_mode_switch_deadline(self):
+        self.command(1);self.feed(frame(DEFAULT));self.lib.cw_attest_pda_patch_reset(self.s,250);self.command(2,300,1000);self.feed(frame(SET),400)
+        self.assertEqual(self.lib.cw_enter_full(self.s,10400),-13)
+    def test_unsolicited_extra_event_rejected(self):
+        self.command(1)
+        self.assertEqual(self.feed(frame(DEFAULT)+frame(DEFAULT)),-3)
+        self.assertEqual(self.lib.test_phase(self.s),9)
+    def test_capacity_bounds_no_output(self):
+        out=C.create_string_buffer(b'Z'*32);n=C.c_size_t(123)
+        self.assertEqual(self.lib.cw_command(self.s,1,100,100000,out,10,C.byref(n)),-2)
+        self.assertEqual(n.value,123);self.assertEqual(out.raw[:32],b'Z'*32)
+        self.assertEqual(self.lib.test_phase(self.s),1)
+    def test_unknown_transport_and_resync_rejected(self):
+        self.full_start()
+        self.assertEqual(self.feed(b'\x7f'*4,10600),-4)
+    def test_pda_attestation_required(self):
+        self.assertEqual(self.lib.cw_attest_pda_patch_reset(self.s,90),-3)
+        self.command(1);self.feed(frame(DEFAULT))
+        out=C.create_string_buffer(32);n=C.c_size_t()
+        self.assertEqual(self.lib.cw_command(self.s,2,300,100000,out,32,C.byref(n)),-3)
+        self.assertEqual(self.lib.test_phase(self.s),3)
+        self.assertEqual(self.lib.cw_attest_pda_patch_reset(self.s,400),0)
+        self.command(2,500)
+    def test_duplicate_sequence_rejected(self):
+        self.full_start()
+        self.assertEqual(self.feed(frame(FULL[:3],True),10600),0)
+        self.assertEqual(self.feed(frame(FULL[3:],True),10700),-9)
+    def test_ack_regression_rejected(self):
+        self.full_start()
+        self.assertEqual(self.feed(ack_frame(),10600),0)
+        self.assertEqual(self.feed(frame(FULL,True,ack=7),10700),-10)
+    def test_deadline_overflow_rejected(self):
+        out=C.create_string_buffer(32);n=C.c_size_t()
+        self.assertEqual(self.lib.cw_command(self.s,1,2**64-100,1000,out,32,C.byref(n)),-2)
+    def test_zero_payload_mandatory_rejected(self):
+        self.command(1);self.assertEqual(self.feed(bytes.fromhex('80000000')),-8)
+
+if __name__=='__main__': unittest.main()
diff --git a/tools/mt6762/hardware/connectivity/validate.py b/tools/mt6762/hardware/connectivity/validate.py
new file mode 100644
index 0000000000000000000000000000000000000000..134ec27ab011b5a429e407766ab6fd11524af168
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity/validate.py
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+"""Offline artifact checks and project passive-record decoder; no device IO.
+
+Structural C parser success is separate from exact stock SHA-256 identity.
+No path can grant CONN MMIO, power, firmware, DMA or radio operation permission.
+"""
+import argparse
+import ctypes as C
+import hashlib
+import json
+import importlib.util
+import os
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+ERRORS = ['ok', 'size', 'format', 'range', 'duplicate']
+POWERS = ['unknown', 'off', 'transition', 'isolated', 'power-bits-ready-only']
+
+class Region(C.Structure):
+    _fields_ = [(x, C.c_uint32) for x in ['offset', 'length', 'device_address', 'feature']]
+class Image(C.Structure):
+    _fields_ = [(x, C.c_uint32) for x in ['kind', 'payload_bytes', 'region_count', 'chip', 'eco', 'format', 'flags', 'hw_version', 'sw_version', 'target', 'image_type', 'own_version', 'peer_version']] + [('regions', Region * 16)]
+class State(C.Structure):
+    _fields_ = [(x, C.c_uint32) for x in ['seen', 'stable', 'missing', 'power', 'survey_enabled']] + [(x, C.c_uint64) for x in ['begin', 'end', 'hz']]
+
+def compile_core(directory):
+    output = Path(directory) / 'conn_decode.so'
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=c99', '-Wall', '-Wextra', '-Werror', '-O2', '-fPIC', '-shared', str(HERE / 'conn_decode.c'), '-o', str(output)], check=True, capture_output=True)
+    lib = C.CDLL(str(output))
+    lib.conn_image_parse.argtypes = [C.c_void_p, C.c_size_t, C.c_uint, C.POINTER(Image)]
+    lib.conn_state_parse.argtypes = [C.c_void_p, C.c_size_t, C.c_uint, C.POINTER(State)]
+    lib.conn_register_address.argtypes = [C.c_size_t]
+    lib.conn_register_address.restype = C.c_uint64
+    lib.conn_register_count.restype = C.c_size_t
+    return lib
+
+def structural(lib, data, kind):
+    result = Image()
+    error = lib.conn_image_parse(data, len(data), kind, C.byref(result))
+    if error:
+        raise ValueError('structural-' + ERRORS[error])
+    return {key: getattr(result, key) for key, _ in Image._fields_ if key != 'regions'} | {
+        'regions': [{k: getattr(r, k) for k, _ in Region._fields_} for r in result.regions[:result.region_count]],
+        'addresses_are_firmware_device_addresses_not_host_write_targets': True,
+        'crc_validation': 'not-implemented; exact full-file SHA-256 required separately'}
+
+def checked_file(lib, path, expected):
+    # Bound read even if a caller substitutes a huge/nonregular file.
+    if not path.is_file() or path.stat().st_size != expected['bytes']:
+        raise ValueError('artifact-size')
+    with path.open('rb') as stream:
+        data = stream.read(expected['bytes'] + 1)
+    if len(data) != expected['bytes']:
+        raise ValueError('artifact-size')
+    digest = hashlib.sha256(data).hexdigest()
+    if digest != expected['sha256']:
+        raise ValueError('artifact-sha256')
+    details = structural(lib, data, expected['kind']) if expected['kind'] else {}
+    return {'bytes': len(data), 'sha256': digest, 'exact_stock_identity': True, 'structure': details}
+
+def make_record(entries, begin=0, end=0, hz=1):
+    # Entries: (PA, first, second, width, valid); unknowns are rejected by C.
+    header = struct.pack('<8sHHHHIIQQQ', b'MTKCONN1', 1, 48, len(entries), 24,
+                         48 + 24 * len(entries), 0, begin, end, hz)
+    return header + b''.join(struct.pack('<QIIBBHI', a, x, y, w, v, 0, 0)
+                             for a, x, y, w, v in entries)
+
+def decode_record(lib, data, enabled=False):
+    result = State()
+    error = lib.conn_state_parse(data, len(data), int(enabled), C.byref(result))
+    if error:
+        raise ValueError('record-' + ERRORS[error])
+    d = {k: getattr(result, k) for k, _ in State._fields_}
+    d['power_interpretation'] = POWERS[result.power]
+    d['missing_addresses'] = [hex(lib.conn_register_address(i)) for i in range(lib.conn_register_count()) if result.missing & (1 << i)]
+    d.update(identity_binding='unbound-observations-only', conn_mmio_authorized=False,
+             dma_authorized=False, radio_operation_authorized=False,
+             unresolved=['live clocks and rails', 'ADIE/ECO', 'cold-start/reset ownership',
+                         'EMI/MPU and buffers', 'DMA routing/coherency', 'firmware/calibration compatibility'])
+    return d
+
+def capture_observations(lib, path, enabled=False):
+    data = path.read_bytes()
+    source = json.loads(data)
+    allowed = {lib.conn_register_address(i) for i in range(lib.conn_register_count())}
+    entries = []
+    for entry in source['registers']:
+        address = int(entry['address'], 0)
+        if address not in allowed:
+            continue
+        entries.append((address, entry['first'], entry['second'], entry['width'], entry['valid']))
+    begins, ends = source['began_ticks'], source['ended_ticks']
+    # Both passes are enclosed. No cross-snapshot combining or fabricated zero value.
+    record = make_record(entries, min(begins), max(ends), source['counter_hz'])
+    return decode_record(lib, record, enabled) | {'source_sha256': hashlib.sha256(data).hexdigest(), 'selected_entries': len(entries)}
+
+def display_observations(path, identity):
+    # Reuse the canonical display ABI validator, with external expected identity.
+    # Do NOT turn one retained last-pass sample into two stable observations.
+    module_path = HERE.parent.parent / 'physical' / 'display_record.py'
+    spec = importlib.util.spec_from_file_location('mtk_conn_display_record', module_path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    raw = path.read_bytes()
+    observed = module.decode(raw, identity)
+    if not observed['accepted'] or 'power' not in observed:
+        raise ValueError('display-record-incomplete')
+    first, second = observed['power'][:2]
+    a, b = bool(first & 2), bool(second & 2)
+    return {'source_sha256': hashlib.sha256(raw).hexdigest(),
+            'external_identity_matched': True,
+            'identity_binding': 'caller-supplied expected loader identity; verify against frozen manifest separately',
+            'values': {'0x10006180': first, '0x10006184': second},
+            'conn_ack_pair': [a, b],
+            'power_interpretation': 'off-at-recorded-sample' if not a and not b else 'on-acks-only' if a and b else 'inconsistent-acks',
+            'stability': 'single final pass; no claim of repeated CONN observation',
+            'display_control_0x1000630c_is_not_conn_control_0x1000632c': True,
+            'conn_mmio_authorized': False, 'dma_authorized': False,
+            'radio_operation_authorized': False}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--artifacts', type=Path)
+    parser.add_argument('--calibration', type=Path)
+    parser.add_argument('--record', type=Path)
+    parser.add_argument('--peripherals', type=Path)
+    parser.add_argument('--display', type=Path)
+    parser.add_argument('--display-identity', help='externally verified expected loader identity, 64 hex characters')
+    parser.add_argument('--survey', action='store_true', help='explicitly interpret passive power bits (does not authorize hardware)')
+    args = parser.parse_args()
+    if bool(args.artifacts) != bool(args.calibration):
+        parser.error('--artifacts and --calibration must be provided together')
+    if bool(args.display) != bool(args.display_identity):
+        parser.error('--display and --display-identity must be supplied together')
+    if not (args.artifacts or args.record or args.peripherals or args.display):
+        parser.error('provide artifacts or a retained record')
+    profile_bytes = (HERE / 'stock-profile.json').read_bytes()
+    profile = json.loads(profile_bytes)
+    report = {'profile': profile['id'], 'profile_sha256': hashlib.sha256(profile_bytes).hexdigest(), 'phone_access': False, 'hardware_authorized': False}
+    try:
+        with tempfile.TemporaryDirectory(prefix='mtk-connectivity-') as temp:
+            lib = compile_core(temp)
+            if args.artifacts:
+                report['artifacts'] = {name: checked_file(lib, args.artifacts / name, spec) for name, spec in profile['files'].items()}
+                report['calibration'] = checked_file(lib, args.calibration, profile['calibration'])
+            if args.record:
+                raw = args.record.read_bytes()
+                if len(raw) > 48 + 9 * 24:
+                    raise ValueError('record-size')
+                report['record'] = decode_record(lib, raw, args.survey)
+            if args.display:
+                report['display'] = display_observations(args.display, bytes.fromhex(args.display_identity))
+            if args.peripherals:
+                report['peripherals'] = capture_observations(lib, args.peripherals, args.survey)
+        report['result'] = 'PASS-offline-validation-only'
+    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as error:
+        report['result'] = 'FAIL'
+        # Exception must never include source bytes/calibration contents.
+        report['error'] = type(error).__name__ if not isinstance(error, ValueError) else str(error)
+    print(json.dumps(report, indent=2))
+    return 0 if report['result'].startswith('PASS') else 1
+
+if __name__ == '__main__':
+    raise SystemExit(main())
