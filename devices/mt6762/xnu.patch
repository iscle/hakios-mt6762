+        elif address==0x4000e930:
+            calls.append({'callback':'usb_disconnect','r0':cpu.reg_read(UC_ARM_REG_R0),'r1':cpu.reg_read(UC_ARM_REG_R1)});ret(cpu,0)
+        elif address==0x40017544:
