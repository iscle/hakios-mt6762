diff --git a/tools/mt6762/physical/loader.ld b/tools/mt6762/physical/loader.ld
new file mode 100644
index 0000000000000000000000000000000000000000..fc6f178d2e9f5515f0a6ab6c5275fb1a5376e06d
--- /dev/null
+++ b/tools/mt6762/physical/loader.ld
@@ -0,0 +1,79 @@
+/* Fixed LK destination. All output storage is present in the raw Image. */
+OUTPUT_FORMAT("elf64-littleaarch64")
+OUTPUT_ARCH(aarch64)
+ENTRY(_start)
+PHDRS { image PT_LOAD FLAGS(7); }
+SECTIONS
+{
+    . = 0x40080000;
+    .entry : ALIGN(8) {
+        KEEP(*(.text.entry))
+    } :image
+    . = 0x40084000;
+    .trace : ALIGN(64) {
+        KEEP(*(.trace))
+    } :image
+    .display_trace : ALIGN(64) {
+        KEEP(*(.display_trace))
+    } :image
+    .pwm_trace : ALIGN(64) {
+        KEEP(*(.pwm_trace))
+    } :image
+    .peripheral_trace : ALIGN(64) {
+        KEEP(*(.peripheral_trace))
+    } :image
+    .connectivity_trace : ALIGN(64) {
+        KEEP(*(.connectivity_trace))
+    } :image
+    .text : ALIGN(8) {
+        *(.text .text.*)
+    } :image
+    .rodata : ALIGN(16) {
+        *(.rodata .rodata.*)
+    } :image
+    .data : ALIGN(16) {
+        *(.data .data.*)
+        *(.sdata .sdata.*)
+    } :image
+    .payload : ALIGN(16) {
+        __payload_start = .;
+        KEEP(*(.payload .payload.*))
+        __payload_end = .;
+    } :image
+    /* lld rejects casting NOBITS inputs to PROGBITS. The following PROGBITS
+     * stack forces these bytes into the single segment's file extent and
+     * raw Image as a zero-filled gap; entry explicitly zeroes them as well. */
+    .bss (NOLOAD) : ALIGN(16) {
+        __bss_start = .;
+        *(.bss .bss.* .sbss .sbss.* COMMON)
+        . = ALIGN(16);
+        __bss_end = .;
+    } :image
+    .stack : ALIGN(16) {
+        __stack_start = .;
+        KEEP(*(.stack))
+        . = ALIGN(16);
+        __stack_end = .;
+    } :image
+    . = ALIGN(16);
+    image_end = .;
+    __image_size = image_end - image_start;
+    /DISCARD/ : { *(.comment .note* .eh_frame .eh_frame_hdr .ARM.attributes) }
+}
+ASSERT(_start == 0x40080000, "physical entry load address changed")
+ASSERT(image_start == _start, "Linux Image header is not first")
+ASSERT(SIZEOF(.entry) <= 0x4000, "entry overlaps fixed trace record")
+ASSERT(physical_trace == 0x40084000 && SIZEOF(.trace) == 256, "fixed trace layout")
+ASSERT(physical_display == 0x40084100 && SIZEOF(.display_trace) == 512, "fixed display record layout")
+ASSERT(physical_pwm == 0x40084300 && SIZEOF(.pwm_trace) == 256, "fixed PWM record layout")
+ASSERT(physical_peripherals == 0x40084400 && SIZEOF(.peripheral_trace) == 4096, "fixed peripheral record layout")
+ASSERT(physical_connectivity == 0x40085400 && SIZEOF(.connectivity_trace) == 4096, "fixed connectivity survey layout")
+ASSERT(physical_connectivity + SIZEOF(.connectivity_trace) <= 0x40090000, "connectivity survey outside reserved DA prefix")
+ASSERT(physical_peripherals + SIZEOF(.peripheral_trace) <= 0x40090000, "peripheral record outside reserved DA prefix")
+ASSERT(physical_pwm + SIZEOF(.pwm_trace) <= 0x40090000, "PWM record outside reserved DA prefix")
+ASSERT(physical_display + SIZEOF(.display_trace) <= 0x40090000, "display record outside reserved DA prefix")
+ASSERT(physical_trace + SIZEOF(.trace) <= 0x40200000, "trace outside bounded source-image read range")
+ASSERT((physical_vectors & 0x7ff) == 0, "VBAR alignment")
+ASSERT((__bss_start & 15) == 0 && (__bss_end & 15) == 0, "BSS zero alignment")
+ASSERT(__stack_end - __stack_start == 65536, "private stack must be64KiB")
+ASSERT(image_end <= 0x47880000, "Image overlaps stock tags/FDT or exceeds120MiB")
diff --git a/tools/mt6762/physical/loader_trace.h b/tools/mt6762/physical/loader_trace.h
new file mode 100644
index 0000000000000000000000000000000000000000..e2f1a7c911f19f574b2070a8840695fe520d4089
--- /dev/null
+++ b/tools/mt6762/physical/loader_trace.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: MIT -- RAM-only diagnostic record, never ownership. */
+#ifndef MTK_LOADER_TRACE_H
+#define MTK_LOADER_TRACE_H
+#include <stdint.h>
+#include <stddef.h>
+enum loader_phase {
+    TRACE_INITIALIZED = 0, TRACE_SAFE_ENTRY = 1, TRACE_EL1 = 2,
+    TRACE_C_ENTRY = 3, TRACE_IDENTITY = 4, TRACE_FDT = 5,
+    TRACE_CONSOLE = 6, TRACE_WINDOW = 7, TRACE_KERNEL_COPIED = 8,
+    TRACE_ARGUMENTS = 9, TRACE_JUMP_READY = 10,
+    TRACE_REFUSED = 254, TRACE_EXCEPTION = 255
+};
+enum loader_failure {
+    TRACE_BAD_CPU = 1, TRACE_BAD_FDT_POINTER = 2, TRACE_BAD_COMPATIBLE = 3,
+    TRACE_BAD_MPIDR = 4, TRACE_BAD_FDT_ALIGNMENT = 5, TRACE_BAD_GIC = 6,
+    TRACE_BAD_RESULT = 7, TRACE_BAD_NATIVE_DISPLAY = 8,
+    TRACE_FDT_ERROR = 0x100, TRACE_WINDOW_ERROR = 0x200
+};
+struct loader_trace {
+    uint8_t magic[8]; uint32_t version, size; uint8_t identity[32];
+    uint64_t phase, phase_inverse, sequence, sequence_inverse;
+    uint64_t previous_phase, detail, original_el, fdt, midr, frequency;
+    uint64_t ram, args, entry, esr, far, elr, spsr, exception_el;
+    uint64_t entry_sctlr, mpidr, reserved[6];
+};
+_Static_assert(sizeof(struct loader_trace) == 256, "trace size");
+_Static_assert(offsetof(struct loader_trace, phase) == 48, "assembly phase offset");
+_Static_assert(offsetof(struct loader_trace, original_el) == 96, "assembly original EL");
+_Static_assert(offsetof(struct loader_trace, esr) == 152, "assembly exception offset");
+_Static_assert(offsetof(struct loader_trace, entry_sctlr) == 192, "assembly entry offset");
+extern volatile struct loader_trace physical_trace;
+void loader_trace_commit(uint64_t phase, uint64_t detail);
+#endif
