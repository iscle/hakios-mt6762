@@ -0,0 +1,90 @@
+MT6765 BTIF PIO and first WMT query
+=================================
+
+This original, freestanding implementation supplies the management transport
+needed before the separate CONNAC WLAN DMA interface. It is not yet wired to
+physical MMIO or kernel startup. It does not start Wi-Fi, scan, associate, or
+load firmware. No Apple userspace executable is changed.
+
+``btif_pio.c`` owns bounded byte transfers through an explicitly supplied
+register adapter. ``btif_wmt.c`` composes it with the actual mandatory-mode
+WMT query parser. Its final state is ``BTIF_WMT_DEFAULT_OPTIONS`` only after
+the entire query drains from TX and its exact complete response is accepted.
+It does not assert that the common MCU patch is loaded, attest PDA completion,
+switch to full STP framing, or publish a network interface.
+
+Register evidence
+-----------------
+
+The private audit is retained at
+``hardware/hakios-migration-20261026/wifi-native/btif`` in the workspace.
+``evidence.json`` here records original Image and function hashes. The recovered
+stock ELF's selected bytes were compared with the original Image before
+disassembly. The supplied 4.14 BSP is corroborating documentation; the shipped
+kernel is 4.19.191, and source equivalence is not assumed.
+
+* Stock ``hal_btif_hw_init`` at Image+0x7b0fb4 sets normal FAKELCR, enables
+  handshake, sets thresholds, disables loopback and RX/TX DMA, sets timeout
+  auto-reset, disables TX interrupt generation and enables RX generation.
+* ``hal_btif_irq_handler`` at Image+0x7b1318 reads 32-bit IIR &0x44, then uses
+  byte RBR reads. Its TX half uses LSR bit6 for16 free bytes or bit5 for8,
+  then byte THR writes. It does not transfer FIFO data with32-bit accesses.
+* The actual ``mtk_btif_info`` descriptor has TX capacity16, RX capacity8,
+  TX threshold8 and RX threshold1. DT maps BTIF at0x1100c000 and its GIC
+  source atSPI112 (ID144), with APDMA TX/RX at0x11000880/0x11000900.
+
+The new PIO adaptation polls IIR with RX generation enabled but its GIC source
+masked. It refuses live DMA, queued bytes or busy TX at initial admission.
+Unlike stock init, it never flushes an inherited FIFO. A new command refuses
+unsolicited RX both at begin and before its bytes are sent; stale events cannot
+satisfy a newly generated query. Receive-only windows remain available.
+
+Ownership and failure contract
+------------------------------
+
+The real adapter must first establish exclusive transport ownership, powered
+and accessible connectivity, held BTIF/AXI clocks, idle APDMA channels and a
+masked GIC source. No boolean in this library proves these facts. ``ready``
+must revalidate those conditions from safe always-on state before every batch;
+it must not read powered CONSYS registers merely to decide whether they are
+accessible. No concurrent owner may change clocks/power or reset the device.
+
+Register callbacks supply the required device-memory ordering. Calls are
+serialized and must not run concurrently. No operation changes PLLs, gates,
+rails, APDMA, GIC, sleep, wake or reset. Initial setup touches only IER,
+FAKELCR, HANDSHAKE, TRI_LVL and DMA_EN, preserving unrelated bits. Writes to
+DMA_EN set timeout auto-reset only after both DMA bits were observed clear.
+
+Each step drains at most32 received bytes and writes at most16 bytes. A
+monotonic microsecond deadline and one-million-call budget bound every
+exchange, including a frozen-clock scenario. ``finish(now_us)`` checks the
+deadline again. Failure is sticky; no implicit retry, FIFO flush or recovery
+is attempted. The owner must stop the transaction and retain the first error.
+Software bounds cannot prevent an inaccessible hardware bus from stalling.
+
+The eight-byte receive FIFO requires working hardware backpressure and prompt
+service. Enabling HANDSHAKE is supported by the stock init, but actual peer
+flow control and sustained physical receive behavior have not been measured.
+The fixture models a peer that pauses at eight bytes; this is an explicit
+model assumption, not hardware evidence. An interrupt/DMA receive path may
+be needed for later high-throughput firmware/data traffic.
+
+Validation
+----------
+
+Run ``python3 tools/mt6762/hardware/btif/test.py`` from the kernel tree.
+Tests use a host C compiler with warnings as errors. They exercise byte access
+widths, the16/8 TX capacity rules, full FIFOs, partial progress, zero/limited
+RX buffers, maximum-frame streaming, ownership/configuration loss, stale RX,
+late completion, backwards/frozen clocks and sticky failure. The integrated
+query test uses an eight-byte FIFO, delayed polls and a backpressured peer;
+corrupt/late replies and undrained TX never establish success.
+
+Both implementation files also compiled freestanding for Cortex-A53. Host
+ASan/UBSan linking was unavailable because this environment lacks the GCC
+runtime libraries; no sanitizer success is claimed.
+
+Next hardware step is the separately admitted cold-start/patch sequence and a
+single default-options query. Complete Wi-Fi still requires calibrated WMT
+setup, common firmware loading, CONNAC command/event/data rings, cache/DMA
+ownership, scan/join/security handling, and HakiOS station/network integration.
diff --git a/tools/mt6762/hardware/btif/btif_pio.c b/tools/mt6762/hardware/btif/btif_pio.c
new file mode 100644
index 0000000000000000000000000000000000000000..ba7cb7cee91bf75cc309b77aabac01d907735d99
--- /dev/null
+++ b/tools/mt6762/hardware/btif/btif_pio.c
@@ -0,0 +1,117 @@
+#include "btif_pio.h"
+
+enum { DATA=0, IER=4, IIR=8, FAKELCR=12, LSR=20,
+       DMA_EN=0x4c, TRI_LVL=0x60, HANDSHAKE=0x6c };
+enum { MAX_TX=2054, MAX_RX_STEP=32, MAX_POLLS=1000000 };
+
+static int fail(struct btif_pio *s,int e)
+{
+    if(s) { s->error=e; s->active=0; s->tx_complete=0; }
+    return e;
+}
+static uint32_t rd(struct btif_pio *s,unsigned r)
+{ return s->io.read32(s->io.context,r); }
+static void wr(struct btif_pio *s,unsigned r,uint32_t v)
+{ s->io.write32(s->io.context,r,v); }
+static int accessible(struct btif_pio *s)
+{ return s->io.ready(s->io.context)==1; }
+static int config(struct btif_pio *s)
+{
+    /* No access after a failed always-on accessibility check. */
+    if(!accessible(s)) return fail(s,BTIF_OWNERSHIP);
+    if((rd(s,DMA_EN)&7)!=4 || (rd(s,IER)&3)!=1 ||
+       (rd(s,TRI_LVL)&255)!=0x18 || !(rd(s,HANDSHAKE)&1) ||
+       rd(s,FAKELCR)!=0) return fail(s,BTIF_CONFIG);
+    return BTIF_OK;
+}
+int btif_pio_init(struct btif_pio *s,const struct btif_pio_io *io,
+                  const struct btif_pio_grant *g)
+{
+    if(!s || !io || !g) return BTIF_ARGUMENT;
+    /* A failed or already initialized instance requires explicit teardown by
+     * its owner; this function is not an implicit peripheral reset. */
+    if(s->initialized || s->active || s->error) return BTIF_STATE;
+    if(g->enabled!=1) return fail(s,BTIF_DISABLED);
+    if(g->exclusive!=1 || g->irq_masked!=1 || g->apdma_idle!=1)
+        return fail(s,BTIF_OWNERSHIP);
+    if(!io->ready || !io->read32 || !io->write32 || !io->read8 || !io->write8)
+        return fail(s,BTIF_ARGUMENT);
+    s->io=*io;
+    if(!accessible(s)) return fail(s,BTIF_OWNERSHIP);
+    uint32_t dma=rd(s,DMA_EN),status=rd(s,LSR),ier=rd(s,IER);
+    if((dma&3) || (status&0x41)!=0x40 || (ier&2))
+        return fail(s,BTIF_BUSY);
+    /* The cold owner has already made both APDMA channels idle. Preserve
+     * undocumented bits; do not clear a live DMA-enable bit to seize it. */
+    wr(s,IER,ier&~3u);
+    wr(s,FAKELCR,0);
+    wr(s,HANDSHAKE,rd(s,HANDSHAKE)|1);
+    wr(s,TRI_LVL,(rd(s,TRI_LVL)&~255u)|0x18);
+    wr(s,DMA_EN,dma|4);
+    wr(s,IER,(ier&~3u)|1);
+    if(config(s)) return s->error;
+    if((rd(s,LSR)&0x41)!=0x40) return fail(s,BTIF_BUSY);
+    s->initialized=1;
+    return BTIF_OK;
+}
+int btif_pio_begin(struct btif_pio *s,const uint8_t *tx,size_t length,
+                   uint64_t now,uint64_t timeout)
+{
+    if(!s) return BTIF_ARGUMENT;
+    if(s->error) return s->error;
+    if(!s->initialized || s->active) return BTIF_STATE;
+    if((length && !tx) || length>MAX_TX || timeout<1000 || timeout>10000000 ||
+       now>UINT64_MAX-timeout) return BTIF_ARGUMENT;
+    if(now<s->last_us) return fail(s,BTIF_CLOCK);
+    if(config(s)) return s->error;
+    /* Reject unsolicited bytes before a new command; otherwise a queued
+     * old reply could satisfy a query that has not reached the device. */
+    uint32_t status=rd(s,LSR);
+    if(!(status&0x40) || (length && (status&1))) return fail(s,BTIF_BUSY);
+    s->tx=tx; s->tx_length=length; s->tx_written=0;
+    s->last_us=now; s->deadline_us=now+timeout; s->polls=0; s->rx_total=0;
+    s->tx_complete=0; s->active=1;
+    return BTIF_OK;
+}
+int btif_pio_step(struct btif_pio *s,uint8_t *rx,size_t capacity,
+                  size_t *received,uint64_t now)
+{
+    if(received) *received=0;
+    if(!s || !rx || !capacity || !received) return BTIF_ARGUMENT;
+    if(s->error) return s->error;
+    if(!s->initialized || !s->active) return BTIF_STATE;
+    if(now<s->last_us) return fail(s,BTIF_CLOCK);
+    s->last_us=now;
+    if(now>=s->deadline_us) return fail(s,BTIF_TIMEOUT);
+    if(++s->polls>MAX_POLLS) return fail(s,BTIF_BUDGET);
+    if(config(s)) return s->error;
+    if(s->tx_written<s->tx_length && (rd(s,IIR)&0x44))
+        return fail(s,BTIF_BUSY); /* Unsolicited or premature response. */
+    size_t n=0,limit=capacity<MAX_RX_STEP?capacity:MAX_RX_STEP;
+    /* Exact shipped IRQ handler uses IIR0x44 for RX/timeout and byte RBR. */
+    while(n<limit && (rd(s,IIR)&0x44)) rx[n++]=s->io.read8(s->io.context,DATA);
+    uint32_t status=rd(s,LSR);
+    size_t room=(status&0x40)?16:(status&0x20)?8:0;
+    size_t left=s->tx_length-s->tx_written;
+    if(room>left) room=left;
+    for(size_t i=0;i<room;i++)
+        s->io.write8(s->io.context,DATA,s->tx[s->tx_written++]);
+    /* Re-read after the last write; prior TEMT cannot prove completion. */
+    s->tx_complete=s->tx_written==s->tx_length && (rd(s,LSR)&0x40)!=0;
+    s->rx_total+=(uint32_t)n;
+    *received=n;
+    return BTIF_OK;
+}
+int btif_pio_finish(struct btif_pio *s,uint64_t now)
+{
+    if(!s) return BTIF_ARGUMENT;
+    if(s->error) return s->error;
+    if(!s->active || !s->tx_complete) return BTIF_STATE;
+    if(now<s->last_us) return fail(s,BTIF_CLOCK);
+    if(now>=s->deadline_us) return fail(s,BTIF_TIMEOUT);
+    s->last_us=now;
+    if(config(s)) return s->error;
+    if(!(rd(s,LSR)&0x40)) return fail(s,BTIF_BUSY);
+    s->active=0; s->tx=NULL; s->tx_length=0;
+    return BTIF_OK;
+}
diff --git a/tools/mt6762/hardware/btif/btif_pio.h b/tools/mt6762/hardware/btif/btif_pio.h
new file mode 100644
index 0000000000000000000000000000000000000000..228bf64458043ef957f93d86b0e90036ad7b9351
--- /dev/null
+++ b/tools/mt6762/hardware/btif/btif_pio.h
@@ -0,0 +1,54 @@
+/* Original bounded MT6765 BTIF PIO transport. See README.rst for provenance.
+ * No power, clock, DMA, interrupt-controller or allocation operations here. */
+#ifndef MT6762_BTIF_PIO_H
+#define MT6762_BTIF_PIO_H
+#include <stddef.h>
+#include <stdint.h>
+
+enum btif_pio_error {
+    BTIF_OK=0, BTIF_DISABLED=-1, BTIF_ARGUMENT=-2, BTIF_OWNERSHIP=-3,
+    BTIF_BUSY=-4, BTIF_CONFIG=-5, BTIF_STATE=-6, BTIF_TIMEOUT=-7,
+    BTIF_CLOCK=-8, BTIF_BUDGET=-9
+};
+/* ready must recheck accessibility/clock/ownership using always-on registers,
+ * before accessing BTIF. It must not probe the CONSYS aperture to decide this.
+ * Every register callback performs its required device-memory barriers.
+ * An admitted caller serializes this entire transport, including RX/ACK TX. */
+struct btif_pio_io {
+    void *context;
+    int (*ready)(void *);
+    uint32_t (*read32)(void *, unsigned);
+    void (*write32)(void *, unsigned, uint32_t);
+    uint8_t (*read8)(void *, unsigned);
+    void (*write8)(void *, unsigned, uint8_t);
+};
+struct btif_pio_grant {
+    unsigned enabled, exclusive, irq_masked, apdma_idle;
+};
+struct btif_pio {
+    struct btif_pio_io io;
+    const uint8_t *tx;
+    size_t tx_length, tx_written;
+    uint64_t last_us, deadline_us;
+    uint32_t polls, rx_total;
+    int error;
+    unsigned initialized, active, tx_complete;
+};
+/* Zero-initialize state before first use. Refuses live DMA, queued RX or TX.
+ * No FIFO flush: inherited bytes are never discarded. RX IRQ generation is
+ * enabled for IIR polling, but the caller must keep its GIC source masked. */
+int btif_pio_init(struct btif_pio *, const struct btif_pio_io *,
+                  const struct btif_pio_grant *);
+/* Buffer remains owned by caller until finish/failure. No retries, no copying.
+ * Receive-only windows (tx=NULL,length=0) are supported. Timeout1ms..10s. */
+int btif_pio_begin(struct btif_pio *, const uint8_t *, size_t,
+                   uint64_t now_us, uint64_t timeout_us);
+/* At most32 RX and16 TX bytes per call. All TX writes/RX reads are8-bit.
+ * received is zero on error; discard the entire protocol exchange on failure.
+ * Caller calls its protocol parser, then polls again until a matched reply.
+ * No wait/delay in this core; monotonic time and a poll budget bound progress. */
+int btif_pio_step(struct btif_pio *, uint8_t *, size_t capacity,
+                  size_t *received, uint64_t now_us);
+/* Success means local TX FIFO drained before deadline, NOT a firmware ACK. */
+int btif_pio_finish(struct btif_pio *, uint64_t now_us);
+#endif
diff --git a/tools/mt6762/hardware/btif/btif_wmt.c b/tools/mt6762/hardware/btif/btif_wmt.c
new file mode 100644
index 0000000000000000000000000000000000000000..6e90b7ec62afaf34ead075f102e13e3895706c6b
--- /dev/null
+++ b/tools/mt6762/hardware/btif/btif_wmt.c
@@ -0,0 +1,42 @@
+#include "btif_wmt.h"
+static int failed(struct btif_wmt_query *s,int transport,int protocol)
+{
+    s->phase=BTIF_WMT_FAILED;
+    s->transport_error=transport;s->protocol_error=protocol;
+    return -1;
+}
+int btif_wmt_start(struct btif_wmt_query *s,const struct btif_pio_io *io,
+                   const struct btif_pio_grant *grant,uint64_t now,uint64_t timeout)
+{
+    int r;size_t written=0;
+    if(!s || !io || !grant || s->phase!=BTIF_WMT_NEW) return -1;
+    /* Validate the whole command before changing the peripheral. */
+    cw_init(&s->protocol,grant->enabled);
+    r=cw_command(&s->protocol,CW_QUERY_DEFAULT,now,timeout,s->tx,sizeof(s->tx),&written);
+    if(r) return failed(s,0,r);
+    r=btif_pio_init(&s->transport,io,grant);
+    if(r) return failed(s,r,0);
+    r=btif_pio_begin(&s->transport,s->tx,written,now,timeout);
+    if(r) return failed(s,r,0);
+    s->phase=BTIF_WMT_QUERY;
+    return 0;
+}
+int btif_wmt_step(struct btif_wmt_query *s,uint64_t now)
+{
+    int r;size_t n=0;
+    if(!s || s->phase!=BTIF_WMT_QUERY) return -1;
+    r=cw_poll(&s->protocol,now);
+    if(r) return failed(s,0,r);
+    r=btif_pio_step(&s->transport,s->rx,sizeof(s->rx),&n,now);
+    if(r) return failed(s,r,0);
+    if(n) {
+        r=cw_feed(&s->protocol,s->rx,n,now);
+        if(r) return failed(s,0,r);
+    }
+    if(s->protocol.phase==CW_DEFAULT_VERIFIED && s->transport.tx_complete) {
+        r=btif_pio_finish(&s->transport,now);
+        if(r) return failed(s,r,0);
+        s->phase=BTIF_WMT_DEFAULT_OPTIONS;
+    }
+    return 0;
+}
diff --git a/tools/mt6762/hardware/btif/btif_wmt.h b/tools/mt6762/hardware/btif/btif_wmt.h
new file mode 100644
