diff --git a/tools/mt6762/hardware/power/test_pmic_entry.c b/tools/mt6762/hardware/power/test_pmic_entry.c
new file mode 100644
index 0000000000000000000000000000000000000000..77a10cfa4a6848b1c5e895ad2be7d655903a8fc9
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_pmic_entry.c
@@ -0,0 +1,115 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "mt6762_pmic_entry.h"
+
+/* Independent literal allowlist: no request, SET/CLR alias or current/CAR
+ * latch data may silently enter this passive configuration observer. */
+static const uint16_t expected[]={0x8,0xc0c,0xd08,0xd0a,0xc8e,0xc90,
+    0xd94,0xd96,0xe08,0x108a,0x108e,0x109e,0x1236};
+static uint16_t words[13];
+static unsigned reads;
+static int fail_at=-1;
+static int read_word(void *context,uint16_t address,uint16_t *value)
+{
+    assert(context==words && reads<13 && address==expected[reads]);
+    unsigned index=reads++;
+    *value=words[index]; /* A failed transport may have modified its output. */
+    return (int)index==fail_at?-71:0;
+}
+static void reset(void)
+{
+    reads=0;fail_at=-1;
+    for(unsigned i=0;i<13;i++)words[i]=(uint16_t)(0x8000+i);
+    words[0]=0x5730;
+}
+static const uint16_t adc_expected[]={0x8,0xa,0x10de,0x10e0,0x1120,0x1126,
+    0x1128,0x112e,0x1132,0x1136,0x113a,0x113c,0x1008,
+    0x11a2,0x11a4,0x11a6,0x11a8,0x11aa,0x11ac};
+static uint16_t adc_words[19];
+static int adc_read_word(void *context,uint16_t address,uint16_t *value)
+{
+    assert(context==adc_words && reads<19 && address==adc_expected[reads]);
+    unsigned index=reads++;
+    *value=adc_words[index];
+    return (int)index==fail_at?-71:0;
+}
+static void adc_reset(void)
+{
+    reads=0;fail_at=-1;
+    for(unsigned i=0;i<19;i++)adc_words[i]=(uint16_t)(0x3100+i);
+    adc_words[0]=0x5730;
+}
+static void adc_cases(void)
+{
+    struct mt6762_pmic_adc_entry_observation out,before;
+    struct mt6762_pmic_entry_failure failure;
+    assert(MT6762_PMIC_ADC_ENTRY_COUNT==19);
+    assert(!memcmp(mt6762_pmic_adc_entry_regs,adc_expected,sizeof(adc_expected)));
+    adc_reset();
+    assert(!mt6762_pmic_adc_entry_observe(adc_read_word,adc_words,&out,&failure));
+    assert(reads==19 && !memcmp(out.value,adc_words,sizeof(adc_words)));
+    /* Configuration values are raw evidence: zero/all-ones and a revision
+     * different from previous samples must not invent a calibration grant. */
+    for(unsigned mode=0;mode<2;mode++) {
+        adc_reset();
+        for(unsigned i=1;i<19;i++)adc_words[i]=mode?0xffff:0;
+        assert(!mt6762_pmic_adc_entry_observe(adc_read_word,adc_words,&out,NULL));
+        assert(reads==19 && !memcmp(out.value,adc_words,sizeof(adc_words)));
+    }
+    memset(&before,0xa5,sizeof(before));
+    for(unsigned i=0;i<19;i++) {
+        adc_reset();fail_at=(int)i;out=before;
+        assert(mt6762_pmic_adc_entry_observe(adc_read_word,adc_words,&out,&failure)==-2);
+        assert(reads==i+1 && failure.index==i && failure.address==adc_expected[i]);
+        assert(failure.error==-71 && failure.value==0);
+        assert(!memcmp(&out,&before,sizeof(out)));
+    }
+    for(unsigned id=0;id<=0xffff;id++) {
+        if((id>>8)==0x57)continue;
+        adc_reset();adc_words[0]=(uint16_t)id;out=before;
+        assert(mt6762_pmic_adc_entry_observe(adc_read_word,adc_words,&out,&failure)==-3);
+        assert(reads==1 && failure.index==0 && failure.address==8);
+        assert(failure.value==id && failure.error==0);
+        assert(!memcmp(&out,&before,sizeof(out)));
+    }
+    adc_reset();out=before;
+    assert(mt6762_pmic_adc_entry_observe(NULL,adc_words,&out,&failure)==-1);
+    assert(mt6762_pmic_adc_entry_observe(adc_read_word,adc_words,NULL,NULL)==-1);
+    assert(!reads && !memcmp(&out,&before,sizeof(out)));
+}
+int main(void)
+{
+    struct mt6762_pmic_entry_observation out,before;
+    struct mt6762_pmic_entry_failure failure;
+    assert(MT6762_PMIC_ENTRY_COUNT==13);
+    reset();
+    assert(!mt6762_pmic_entry_observe(read_word,words,&out,&failure));
+    assert(reads==13 && !memcmp(out.value,words,sizeof(words)));
+    /* Gates shut, gauge off, another owner's latch set, detector disabled,
+     * ADC zero/not-ready and ADC maximum/ready remain raw observations. */
+    reset();words[1]=0x18;words[2]=0;words[3]=0x8009;words[8]=0;
+    words[9]=0;words[10]=0xffff;words[11]=0x8000;words[12]=2;
+    assert(!mt6762_pmic_entry_observe(read_word,words,&out,NULL));
+    assert(reads==13 && !memcmp(out.value,words,sizeof(words)));
+    memset(&before,0xa5,sizeof(before));
+    for(unsigned i=0;i<13;i++) {
+        reset();fail_at=(int)i;out=before;
+        assert(mt6762_pmic_entry_observe(read_word,words,&out,&failure)==-2);
+        assert(reads==i+1 && failure.index==i && failure.address==expected[i]);
+        assert(failure.error==-71 && failure.value==0);
+        assert(!memcmp(&out,&before,sizeof(out)));
+    }
+    reset();words[0]=0xffff;out=before;
+    assert(mt6762_pmic_entry_observe(read_word,words,&out,&failure)==-3);
+    assert(reads==1 && failure.index==0 && failure.address==8);
+    assert(failure.value==0xffff && failure.error==0);
+    assert(!memcmp(&out,&before,sizeof(out)));
+    reset();out=before;
+    assert(mt6762_pmic_entry_observe(NULL,words,&out,&failure)==-1);
+    assert(mt6762_pmic_entry_observe(read_word,words,NULL,NULL)==-1);
+    assert(!reads && !memcmp(&out,&before,sizeof(out)));
+    adc_cases();
+    puts("passive PMIC entry: fixed reads, raw busy/stale state, atomic failure, no retry PASS");
+    puts("passive ADC entry: independent fixed19-word record, raw config, wrong-ID/partial stop PASS");
+}
diff --git a/tools/mt6762/hardware/power/test_pmic_entry_integration.py b/tools/mt6762/hardware/power/test_pmic_entry_integration.py
new file mode 100644
index 0000000000000000000000000000000000000000..9b271045db2cfe725ada16246c973dde782031af
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_pmic_entry_integration.py
@@ -0,0 +1,137 @@
+"""Host-execute the actual kernel's passive PMIC probe; never access hardware."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+HERE=Path(__file__).resolve().parent
+SOURCE=(HERE.parents[3]/'bsd/dev/mt6762_power.c').read_text()
+
+def function(name):
+    marker=SOURCE.index(name+'(')
+    begin=SOURCE.rfind('\n',0,marker)+1
+    opening=SOURCE.index('{',marker)
+    depth=1;end=opening+1
+    while depth:
+        depth+=(SOURCE[end]=='{')-(SOURCE[end]=='}');end+=1
+    return SOURCE[begin:end]+'\n'
+
+HARNESS=r'''
+#include <assert.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include "mt6762_pmic_entry.h"
+static int pwrap_ready,pwrap_read_only,pwrap_fault;
+static unsigned reads,starts[2],entries[2],completions[2],failures[2];
+static int fail_at,bad_id_at,adc_only;
+static char messages[16384];
+static const uint16_t original[]={0x8,0xc0c,0xd08,0xd0a,0xc8e,0xc90,
+    0xd94,0xd96,0xe08,0x108a,0x108e,0x109e,0x1236};
+static const uint16_t adc[]={0x8,0xa,0x10de,0x10e0,0x1120,0x1126,
+    0x1128,0x112e,0x1132,0x1136,0x113a,0x113c,0x1008,
+    0x11a2,0x11a4,0x11a6,0x11a8,0x11aa,0x11ac};
+static uint16_t address_at(unsigned index) {
+    if(adc_only){assert(index<38);return adc[index%19];}
+    assert(index<64);return index<26?original[index%13]:adc[(index-26)%19];
+}
+static int mt6762_pwrap_read16(uint16_t address,uint16_t *value) {
+    unsigned index=reads++;
+    assert(address==address_at(index));
+    if((int)index==fail_at){pwrap_fault=1;return -71;}
+    *value=address==8?0x5730:(uint16_t)(index|0x8000);
+    if((int)index==bad_id_at)*value=0xffff;
+    return 0;
+}
+static void kprintf(const char *format,...) {
+    char text[512];va_list ap;va_start(ap,format);
+    vsnprintf(text,sizeof(text),format,ap);va_end(ap);
+    assert(strlen(messages)+strlen(text)<sizeof(messages));strcat(messages,text);
+    unsigned kind=!!strstr(text,"MT6762_ADC_ENTRY");
+    if(!kind)assert(strstr(text,"MT6762_PMIC_ENTRY"));
+    if(strstr(text,"_BEGIN ")) {
+        assert(strstr(text,kind?
+            "version=1 passes=2 registers=19 conversion_requested=0 gauge_commands=0":
+            "version=1 passes=2 registers=13 conversion_requested=0 gauge_commands=0"));
+        starts[kind]++;
+    }else if(strstr(text,"_FAILED "))failures[kind]++;
+    else if(strstr(text,"_COMPLETE ")) {
+        assert(strstr(text,"measurement_valid=0 ownership_grant=0"));
+        if(kind)assert(strstr(text,"calibration_grant=0"));
+        completions[kind]++;
+    }else {
+        assert(strstr(text,kind?"MT6762_ADC_ENTRY pass=":"MT6762_PMIC_ENTRY pass="));
+        entries[kind]++;
+    }
+}
+'''
+CASES=r'''
+static void reset(void) {
+    reads=0;memset(starts,0,sizeof(starts));memset(entries,0,sizeof(entries));
+    memset(completions,0,sizeof(completions));memset(failures,0,sizeof(failures));
+    messages[0]=0;adc_only=0;
+    fail_at=bad_id_at=-1;pwrap_ready=pwrap_read_only=1;pwrap_fault=0;
+}
+static void check_failure(unsigned at,int transport) {
+    unsigned kind=adc_only || at>=26;
+    unsigned index=kind?(adc_only?at:at-26):at;
+    unsigned count=kind?19:13;
+    char expected[256];
+    snprintf(expected,sizeof(expected),
+        "%s_FAILED pass=%u index=%u address=%04x error=%d transport=%d value=%04x\n",
+        kind?"MT6762_ADC_ENTRY":"MT6762_PMIC_ENTRY",index/count,index%count,
+        address_at(at),transport?-2:-3,transport?-71:0,transport?0:0xffff);
+    assert(strstr(messages,expected));
+    assert(reads==at+1 && failures[kind]==1 && !failures[!kind]);
+    unsigned old_done=adc_only?0:(at<26?at/13:2);
+    unsigned adc_done=kind?index/19:0;
+    assert(completions[0]==old_done && entries[0]==13*old_done);
+    assert(completions[1]==adc_done && entries[1]==19*adc_done);
+    assert(starts[0]==(unsigned)!adc_only && starts[1]==kind);
+}
+int main(void) {
+    reset();pmic_entry_probe();
+    assert(reads==64 && starts[0]==1 && entries[0]==26 && completions[0]==2 && !failures[0]);
+    assert(starts[1]==1 && entries[1]==38 && completions[1]==2 && !failures[1]);
+    /* Prefix remains exactly the original two13-word passes. The new prefix
+     * is appended only after the original completion, preserving decoders. */
+    const char *old_end=strstr(messages,"MT6762_PMIC_ENTRY_COMPLETE pass=1 measurement_valid=0 ownership_grant=0\n");
+    assert(old_end && strstr(messages,"MT6762_ADC_ENTRY_BEGIN ")>old_end);
+    for(int i=0;i<64;i++) {
+        reset();fail_at=i;pmic_entry_probe();
+        check_failure((unsigned)i,1);
+        assert(pwrap_fault);pmic_entry_probe();assert(reads==(unsigned)i+1);
+    }
+    static const int id_indices[]={0,13,26,45};
+    for(unsigned i=0;i<4;i++) {
+        reset();bad_id_at=id_indices[i];pmic_entry_probe();
+        check_failure((unsigned)bad_id_at,0);
+    }
+    reset();adc_only=1;pmic_adc_entry_probe();
+    assert(reads==38 && !starts[0] && starts[1]==1 && entries[1]==38 && completions[1]==2);
+    for(int i=0;i<38;i++) {
+        reset();adc_only=1;fail_at=i;pmic_adc_entry_probe();check_failure((unsigned)i,1);
+        pmic_adc_entry_probe();assert(reads==(unsigned)i+1);
+    }
+    for(int pass=0;pass<2;pass++) {
+        reset();adc_only=1;bad_id_at=19*pass;pmic_adc_entry_probe();
+        check_failure((unsigned)bad_id_at,0);
+    }
+    for(int direct=0;direct<2;direct++)for(int gate=0;gate<3;gate++) {
+        reset();adc_only=direct;
+        if(gate==0)pwrap_ready=0;
+        if(gate==1)pwrap_read_only=0;
+        if(gate==2)pwrap_fault=1;
+        if(direct)pmic_adc_entry_probe();else pmic_entry_probe();
+        assert(!reads && !starts[0] && !starts[1] && !messages[0]);
+    }
+    puts("native PMIC/ADC probes: old records preserved, readonly gates, all64 failures, identity stop, no measurement grants PASS");
+}
+'''
+
+with tempfile.TemporaryDirectory() as temporary:
+    source=Path(temporary)/'probe.c';binary=Path(temporary)/'probe'
+    source.write_text(HARNESS+function('pmic_entry_read')+function('pmic_adc_entry_probe')+
+                      function('pmic_entry_probe')+CASES)
+    subprocess.run(['cc','-std=c11','-Wall','-Wextra','-Werror','-I',str(HERE),
+                    str(source),'-o',str(binary)],check=True)
+    subprocess.run([str(binary)],check=True)
diff --git a/tools/mt6762/hardware/power/test_power_protocol.c b/tools/mt6762/hardware/power/test_power_protocol.c
new file mode 100644
index 0000000000000000000000000000000000000000..a0dcab9569a22e79e97df06b0d70aa5a9f2795f2
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_power_protocol.c
@@ -0,0 +1,71 @@
+#include "power_protocol.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+struct fake_i2c { uint8_t regs[7]; int calls,fail_call,short_call,writes; };
+static int transfer(void *arg,struct power_i2c_msg *m,size_t n)
+{
+    struct fake_i2c *f=arg;
+    f->calls++;
+    if(f->calls==f->fail_call) return -5;
+    if(f->calls==f->short_call) return (int)n-1;
+    assert(m[0].address==0x6a && !m[0].read);
+    if(n==2){
+        assert(m[0].length==1 && m[1].address==0x6a && m[1].read && m[1].length==1);
+        m[1].data[0]=f->regs[m[0].data[0]];
+    }else{
+        assert(n==1 && m[0].length==2 && m[0].data[0]==1);
+        f->regs[1]=m[0].data[1]; f->writes++;
+    }
+    return (int)n;
+}
+struct fake_mmio { uint32_t status[8]; unsigned n,i,writes; int fail; };
+static int rd(void *arg,uint32_t off,uint32_t *v)
+{
+    struct fake_mmio *f=arg; assert(off==0xc24);
+    if(f->fail)return -1;
+    *v=f->status[f->i<f->n?f->i++:f->n-1]; return 0;
+}
+static int wr(void *arg,uint32_t off,uint32_t v)
+{
+    struct fake_mmio *f=arg;
+    if(!f->writes) {assert(off==0xc20); assert(v==0x00120000);}
+    else {assert(off==0xc28);assert(v==1);}
+    f->writes++;return 0;
+}
+int main(void)
+{
+    /* Actual boot trace: ID f0, Reg1 f8 -> fc on disable, preserved fields. */
+    struct fake_i2c f={{0,0xf8,0x90,0xf0,0x76,0x24,0},0,0,0,0};
+    struct power_i2c b={&f,transfer};
+    struct psc5425e_snapshot s;
+    assert(!psc5425e_snapshot(&b,&s));
+    assert(s.identity==0xf0 && !s.done && !s.charge_disabled && s.current==0x76);
+    assert(!psc5425e_disable_charge(&b) && f.regs[1]==0xfc && f.writes==1);
+    assert(!psc5425e_disable_charge(&b) && f.writes==1);
+    f.regs[0]=0x20;assert(!psc5425e_snapshot(&b,&s)&&s.done);
+    f.regs[0]=0x30;assert(!psc5425e_snapshot(&b,&s)&&!s.done);
+    /* Read failure must not become valid status or cause a register write. */
+    memset(&s,0x55,sizeof(s));f.fail_call=f.calls+3;
+    assert(psc5425e_snapshot(&b,&s)==POWER_IO && s.identity==0x55);
+    f.fail_call=f.calls+2;
+    assert(psc5425e_disable_charge(&b)==POWER_IO && f.writes==1);
+    uint8_t value=0x77;f.short_call=f.calls+1;
+    assert(psc5425e_read(&b,0,&value)==POWER_IO && value==0x77);
+    f.regs[3]=0;assert(psc5425e_disable_charge(&b)==POWER_ID_MISMATCH && f.writes==1);
+    struct fake_mmio mm={{0x200000,0x220000,0x26000e},3,0,0,0};
+    struct power_mmio m={&mm,rd,wr};uint16_t v=0xbeef;
+    assert(!mt6765_pwrap_read16(&m,0x24,&v,4)&&v==14&&mm.writes==2);
+    mm=(struct fake_mmio){{0x220000},1,0,0,0};
+    assert(mt6765_pwrap_read16(&m,0x24,&v,3)==POWER_TIMEOUT&&mm.writes==0&&mm.i==1);
+    mm=(struct fake_mmio){{0},1,0,0,0};
+    assert(mt6765_pwrap_read16(&m,0x24,&v,3)==POWER_NOT_READY&&mm.writes==0);
+    assert(mt6765_pwrap_read16(&m,0x25,&v,3)==POWER_INVALID);
+    struct mt6357_keys k=mt6357_decode_topstatus(14);assert(!k.power&&!k.home&&k.charger_present);
+    k=mt6357_decode_topstatus(0);assert(k.power&&k.home&&!k.charger_present);
+    uint16_t keys[5]={0xffff,0xffff,0xffff,0xffff,0xffff};
+    assert(mt6765_key_pressed(keys,0)==0);keys[0]=0xfffe;
+    assert(mt6765_key_pressed(keys,0)==1&&mt6765_key_pressed(keys,1)==0);
+    assert(mt6765_key_pressed(keys,72)==POWER_INVALID);
+    puts("PASS: recovered I2C transactions, disable trace, errors, WACS2, and key decoding");
+}
diff --git a/tools/mt6762/hardware/power/test_report_expiry.c b/tools/mt6762/hardware/power/test_report_expiry.c
new file mode 100644
index 0000000000000000000000000000000000000000..d3eaaf6d4c0b712404b756bb836f46dfe3d11868
--- /dev/null
+++ b/tools/mt6762/hardware/power/test_report_expiry.c
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: MIT */
+#include <assert.h>
+#include <stdio.h>
+#include "report_expiry.h"
+/* Model only publication decisions; actual IOKit field-removal behavior is
+ * checked by the read-only guest probe, not reproduced in this host test. */
+int main(void)
+{
+    struct mt6762_report_expiry s = {0};
+    assert(mt6762_report_receive(&s, 0, 2000, 1, 0x4f, 2000) == MT6762_REPORT_CLEAR);
+    assert(!s.active);
+    assert(mt6762_report_receive(&s, 1000, 3000, 1000, 0x4f, 2000) == MT6762_REPORT_APPLY);
+    assert(mt6762_report_expire(&s, 2999) == MT6762_REPORT_IGNORE);
+    /* A queued timer for the old3000 deadline runs after a new sample. */
+    assert(mt6762_report_receive(&s, 2000, 4000, 2001, 0x4f, 2000) == MT6762_REPORT_APPLY);
+    assert(mt6762_report_expire(&s, 3000) == MT6762_REPORT_IGNORE && s.active);
+    /* Expired old arrivals and duplicate acquisition cannot erase it. */
+    assert(mt6762_report_receive(&s, 900, 2900, 3001, 0x4f, 2000) == MT6762_REPORT_IGNORE);
+    assert(mt6762_report_receive(&s, 2000, 2001, 3001, 0, 2000) == MT6762_REPORT_IGNORE);
+    assert(s.active && s.expires == 4000);
+    assert(mt6762_report_expire(&s, 4000) == MT6762_REPORT_CLEAR && !s.active);
+    assert(mt6762_report_expire(&s, 4001) == MT6762_REPORT_IGNORE);
+    /* The producer stopped: timer alone clears. A later fresh report recovers. */
+    assert(mt6762_report_receive(&s, 5000, 7000, 5000, 0x4f, 2000) == MT6762_REPORT_APPLY);
+    assert(mt6762_report_expire(&s, 7000) == MT6762_REPORT_CLEAR);
+    assert(mt6762_report_receive(&s, 8000, 10000, 8000, 0x4f, 2000) == MT6762_REPORT_APPLY);
+    /* Newer acquisition may carry a shorter earliest source deadline. */
+    assert(mt6762_report_receive(&s, 8500, 9000, 8500, 0x5f, 2000) == MT6762_REPORT_APPLY);
+    assert(s.last_acquired == 8500 && s.expires == 9000);
+    assert(mt6762_report_expire(&s, 9000) == MT6762_REPORT_CLEAR);
+    /* A slow acquisition cannot gain lifetime when finally published. */
+    assert(mt6762_report_receive(&s, 9500, 11500, 11500, 0x4f, 2000) == MT6762_REPORT_CLEAR);
+    assert(!s.active);
+    assert(mt6762_report_receive(&s, 12000, 14000, 12000, 0x4f, 2000) == MT6762_REPORT_APPLY);
+    assert(mt6762_report_receive(&s, 12500, 14500, 12500, 0, 2000) == MT6762_REPORT_CLEAR);
+    assert(!s.active); /* explicit invalid reading immediately removes prior data */
+    assert(mt6762_report_receive(&s, 13000, 0, 13000, 0x4f, 2000) == MT6762_REPORT_CLEAR);
+    assert(mt6762_report_receive(&s, 14001, 15000, 14000, 0x4f, 2000) == MT6762_REPORT_CLEAR);
+    assert(mt6762_report_receive(&s, 14000, 16001, 14000, 0x4f, 2000) == MT6762_REPORT_CLEAR);
+    /* A timer delayed past a rejected older report still clears expired data. */
+    assert(mt6762_report_receive(&s, 15000, 17000, 15000, 0x4f, 2000) == MT6762_REPORT_APPLY);
+    assert(mt6762_report_receive(&s, 14900, 16900, 17001, 0x4f, 2000) == MT6762_REPORT_CLEAR);
+    mt6762_report_stop(&s);
+    assert(!s.active && s.stopped);
+    assert(mt6762_report_receive(&s, 18000, 20000, 18000, 0x4f, 2000) == MT6762_REPORT_IGNORE);
+    assert(mt6762_report_expire(&s, UINT64_MAX) == MT6762_REPORT_IGNORE);
+    /* Subtraction-based checks do not wrap at the absolute-time limit. */
+    struct mt6762_report_expiry edge = {0};
+    assert(mt6762_report_receive(&edge, UINT64_MAX - 1000, UINT64_MAX,
+        UINT64_MAX - 500, 1, 2000) == MT6762_REPORT_APPLY);
+    assert(mt6762_report_expire(&edge, UINT64_MAX) == MT6762_REPORT_CLEAR);
+    puts("Native report acquisition-age/expiry/order/stop tests passed");
+    return 0;
+}
