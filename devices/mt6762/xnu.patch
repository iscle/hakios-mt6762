index 0000000000000000000000000000000000000000..e2d0d858fdfabc803d180ac4fe7051cc60e28c76
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity/wmt_protocol.c
@@ -0,0 +1,163 @@
+#include "wmt_protocol.h"
+static const uint8_t query[]={1,4,1,0,4};
+static const uint8_t set_full[]={1,4,5,0,3,0xdb,0x0e,0x68,1};
+static const uint8_t default_event[]={2,4,6,0,0,4,0x11,0,0,0};
+static const uint8_t set_event[]={2,4,2,0,0,3};
+static const uint8_t full_event[]={2,4,6,0,0,4,0xdb,0x0e,0x68,1};
+static int fail(struct cw_session *s,int e) { s->error=e;s->phase=CW_FAILED;return e; }
+uint16_t cw_crc16(const uint8_t *p,size_t n) {
+ uint16_t crc=0;size_t i;unsigned b;
+ for(i=0;i<n;i++){crc^=p[i];for(b=0;b<8;b++)crc=(crc>>1)^((crc&1)?0xa001:0);}
+ return crc;
+}
+void cw_init(struct cw_session *s,unsigned enabled) {
+ size_t i;uint8_t *p=(uint8_t *)s;if(!s)return;
+ for(i=0;i<sizeof(*s);i++)p[i]=0;
+ s->phase=enabled==1?CW_NEW:CW_OFF;s->mode=CW_BTIF_MANDATORY;s->txack=7;
+}
+int cw_poll(struct cw_session *s,uint64_t now) {
+ if(!s)return CW_ARGUMENT;
+ if(s->phase==CW_OFF)return CW_DISABLED;
+ if(s->error)return s->error;
+ if(now<s->last_us)return fail(s,CW_CLOCK);
+ s->last_us=now;
+ if(s->active){
+  if(now>=s->deadline_us)return fail(s,CW_TIMEOUT);
+  if(++s->polls>CW_POLL_MAX)return fail(s,CW_BUDGET);
+ }
+ return CW_OK;
+}
+int cw_command(struct cw_session *s,enum cw_command cmd,uint64_t now,
+ uint64_t timeout,uint8_t *out,size_t capacity,size_t *written) {
+ const uint8_t *p=query;size_t n=sizeof(query),i;uint16_t crc;int r;
+ if(!s||!out||!written)return CW_ARGUMENT;
+ if((r=cw_poll(s,now)))return r;
+ if(timeout<1000||timeout>10000000||now>UINT64_MAX-timeout)return CW_ARGUMENT;
+ if(s->used||s->wused||s->active||s->ack_pending)return CW_STATE;
+ if(cmd==CW_QUERY_DEFAULT&&s->phase==CW_NEW){}
+ else if(cmd==CW_SET_FULL&&s->phase==CW_DEFAULT_VERIFIED&&s->pda_ready){p=set_full;n=sizeof(set_full);}
+ else if(cmd==CW_QUERY_FULL&&s->phase==CW_FULL){}
+ else return CW_STATE;
+ if(capacity<n+6)return CW_ARGUMENT;
+ out[0]=s->mode==CW_BTIF_FULL?(uint8_t)(0x80|(s->txseq<<3)|s->txack):0x80;
+ out[1]=0x40;out[2]=(uint8_t)n;
+ out[3]=s->mode==CW_BTIF_FULL?(uint8_t)(out[0]+out[1]+out[2]):0;
+ for(i=0;i<n;i++)out[4+i]=p[i];
+ crc=s->mode==CW_BTIF_FULL?cw_crc16(p,n):0;
+ out[4+n]=(uint8_t)crc;out[5+n]=(uint8_t)(crc>>8);*written=n+6;
+ s->phase=cmd==CW_QUERY_DEFAULT?CW_WAIT_DEFAULT:cmd==CW_SET_FULL?CW_WAIT_SET:CW_WAIT_FULL;
+ s->active=1;s->deadline_us=now+timeout;s->polls=0;s->tx_acked=0;s->event_seen=0;
+ return CW_OK;
+}
+int cw_attest_pda_patch_reset(struct cw_session *s,uint64_t now) {
+ int r;if((r=cw_poll(s,now)))return r;
+ if(s->phase!=CW_DEFAULT_VERIFIED||s->active||s->used||s->wused)return CW_STATE;
+ s->pda_ready=1;return CW_OK;
+}
+int cw_enter_full(struct cw_session *s,uint64_t now) {
+ int r;if((r=cw_poll(s,now)))return r;
+ if(s->phase!=CW_SWITCH_WAIT||s->used||s->wused||now-s->switch_us<10000)return CW_STATE;
+ s->mode=CW_BTIF_FULL;s->phase=CW_FULL;s->active=0;
+ s->rxseq=0;s->txseq=0;s->txack=7;s->ack_pending=0;
+ return CW_OK;
+}
+static void complete_full(struct cw_session *s) {
+ if(s->phase==CW_WAIT_FULL&&s->event_seen&&s->tx_acked){
+  s->phase=CW_OPTIONS_VERIFIED;s->active=0;
+ }
+}
+static int event(struct cw_session *s) {
+ const uint8_t *expected;size_t n,i;
+ if(s->phase==CW_WAIT_DEFAULT){expected=default_event;n=sizeof(default_event);}
+ else if(s->phase==CW_WAIT_SET){expected=set_event;n=sizeof(set_event);}
+ else if(s->phase==CW_WAIT_FULL&&!s->event_seen){expected=full_event;n=sizeof(full_event);}
+ else return fail(s,CW_EVENT);
+ if(s->wused<5||s->wmt[0]!=2||s->wmt[1]!=4)return fail(s,CW_EVENT);
+ if(s->wmt[4])return fail(s,CW_STATUS);
+ if(s->wused!=n)return fail(s,CW_EVENT);
+ for(i=0;i<n;i++)if(s->wmt[i]!=expected[i])return fail(s,CW_EVENT);
+ s->events++;
+ if(s->phase==CW_WAIT_DEFAULT){s->phase=CW_DEFAULT_VERIFIED;s->active=0;}
+ else if(s->phase==CW_WAIT_SET){s->phase=CW_SWITCH_WAIT;s->switch_us=s->last_us;
+  /* Existing command deadline also bounds the host-mode transition. */
+ }else{s->event_seen=1;complete_full(s);}
+ return CW_OK;
+}
+static int wmt_bytes(struct cw_session *s,const uint8_t *p,size_t n) {
+ size_t i;int r;
+ for(i=0;i<n;i++){
+  if(s->wused>=CW_WMT_MAX)return fail(s,CW_LENGTH);
+  s->wmt[s->wused++]=p[i];
+  if(s->wused==4){
+   s->wneed=4u+s->wmt[2]+((uint32_t)s->wmt[3]<<8);
+   if(s->wneed<5||s->wneed>CW_WMT_MAX)return fail(s,CW_LENGTH);
+  }
+  if(s->wneed&&s->wused==s->wneed){
+   if((r=event(s)))return r;
+   s->wused=0;s->wneed=0;
+  }
+ }
+ return CW_OK;
+}
+static int packet(struct cw_session *s) {
+ uint8_t *p=s->packet,ack=p[0]&7,seq=(p[0]>>3)&7;
+ size_t n=((p[1]&15u)<<8)|p[2];uint16_t crc;int r;
+ if(n){
+  crc=(uint16_t)(p[4+n]|((uint16_t)p[5+n]<<8));
+  if(crc!=(s->mode==CW_BTIF_FULL?cw_crc16(p+4,n):0))return fail(s,CW_CRC);
+ }
+ if(s->mode==CW_BTIF_FULL){
+  /* One outstanding command, no retries or recovery from unknown history. */
+  if(ack==s->txseq)s->tx_acked=1;
+  else if(ack!=((s->txseq+7)&7)||s->tx_acked)return fail(s,CW_ACK);
+  if(n){
+   if(seq!=s->rxseq)return fail(s,CW_SEQUENCE);
+   s->txack=seq;s->rxseq=(uint8_t)((seq+1)&7);
+   s->ack_pending=1;s->ack_value=seq;
+  }else{s->acknowledgements++;complete_full(s);}
+ }
+ s->packets++;
+ if(n&&(r=wmt_bytes(s,p+4,n)))return r;
+ return CW_OK;
+}
+int cw_feed(struct cw_session *s,const uint8_t *p,size_t n,uint64_t now) {
+ size_t i;unsigned len,type;int r;
+ if(!s||(!p&&n))return CW_ARGUMENT;
+ if((r=cw_poll(s,now)))return r;
+ if(n>65536)return fail(s,CW_LENGTH); /* bounded work per call */
+ for(i=0;i<n;i++){
+  if(!s->active)return fail(s,CW_STATE);
+  if(!s->used&&s->mode==CW_BTIF_FULL&&p[i]==0x55){
+   if(++s->delimiters>2)return fail(s,CW_HEADER);
+   continue;
+  }
+  if(s->used>=sizeof(s->packet))return fail(s,CW_LENGTH);
+  s->packet[s->used++]=p[i];
+  if(s->used==1){
+   if((s->mode==CW_BTIF_MANDATORY&&p[i]!=0x80)||
+      (s->mode==CW_BTIF_FULL&&(p[i]&0xc0)!=0x80))return fail(s,CW_HEADER);
+   s->delimiters=0;
+  }
+  if(s->used==4){
+   len=((s->packet[1]&15u)<<8)|s->packet[2];type=(s->packet[1]>>4)&7;
+   if(s->packet[1]&0x80)return fail(s,CW_HEADER); /* NAK/recovery unsupported */
+   if(len>CW_STP_MAX||(s->mode==CW_BTIF_MANDATORY&&len>=2000))return fail(s,CW_LENGTH);
+   if((len&&type!=4)||(!len&&(type||s->mode!=CW_BTIF_FULL)))return fail(s,CW_CHANNEL);
+   if(s->packet[3]!=(s->mode==CW_BTIF_FULL?
+       (uint8_t)(s->packet[0]+s->packet[1]+s->packet[2]):0))return fail(s,CW_CHECKSUM);
+   s->need=len?len+6:4;
+  }
+  if(s->need&&s->used==s->need){
+   if((r=packet(s)))return r;
+   s->used=0;s->need=0;
+  }
+ }
+ return CW_OK;
+}
+int cw_take_ack(struct cw_session *s,uint8_t out[4]) {
+ if(!s||!out)return CW_ARGUMENT;
+ if(s->error)return s->error;
+ if(s->mode!=CW_BTIF_FULL||!s->ack_pending)return CW_STATE;
+ out[0]=(uint8_t)(0x80|s->ack_value);out[1]=0;out[2]=0;out[3]=out[0];
+ s->ack_pending=0;return CW_OK;
+}
diff --git a/tools/mt6762/hardware/connectivity/wmt_protocol.h b/tools/mt6762/hardware/connectivity/wmt_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..9b18616ed46151d92d433d12d5db61060e7488be
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity/wmt_protocol.h
@@ -0,0 +1,43 @@
+/* Original bounded management subset; no MMIO, allocation, transport or retries. */
+#ifndef MTK_WMT_PROTOCOL_H
+#define MTK_WMT_PROTOCOL_H
+#include <stddef.h>
+#include <stdint.h>
+#define CW_STP_MAX 2048u
+#define CW_WMT_MAX 64u
+#define CW_POLL_MAX 1000000u
+enum cw_error { CW_OK=0, CW_DISABLED=-1, CW_ARGUMENT=-2, CW_STATE=-3,
+ CW_HEADER=-4, CW_CHECKSUM=-5, CW_CRC=-6, CW_LENGTH=-7, CW_CHANNEL=-8,
+ CW_SEQUENCE=-9, CW_ACK=-10, CW_EVENT=-11, CW_STATUS=-12,
+ CW_TIMEOUT=-13, CW_CLOCK=-14, CW_BUDGET=-15 };
+enum cw_mode { CW_BTIF_MANDATORY=1, CW_BTIF_FULL=2 };
+enum cw_phase { CW_OFF=0, CW_NEW=1, CW_WAIT_DEFAULT=2, CW_DEFAULT_VERIFIED=3,
+ CW_WAIT_SET=4, CW_SWITCH_WAIT=5, CW_FULL=6, CW_WAIT_FULL=7,
+ CW_OPTIONS_VERIFIED=8, CW_FAILED=9 };
+enum cw_command { CW_QUERY_DEFAULT=1, CW_SET_FULL=2, CW_QUERY_FULL=3 };
+/* Caller-owned, single-threaded state. No member authorizes hardware access. */
+struct cw_session {
+ uint8_t packet[CW_STP_MAX+6], wmt[CW_WMT_MAX];
+ uint32_t used, need, wused, wneed, polls;
+ uint64_t last_us, deadline_us, switch_us;
+ int error;
+ uint8_t phase, mode, active, rxseq, txseq, txack, tx_acked, event_seen;
+ uint8_t ack_pending, ack_value, delimiters, pda_ready;
+ uint32_t packets, events, acknowledgements;
+};
+uint16_t cw_crc16(const uint8_t *, size_t);
+void cw_init(struct cw_session *, unsigned enabled);
+/* Times are monotonic microseconds; timeout 1ms..10s. No retransmission. */
+int cw_poll(struct cw_session *, uint64_t now_us);
+int cw_command(struct cw_session *, enum cw_command, uint64_t now_us,
+ uint64_t timeout_us, uint8_t *out, size_t capacity, size_t *written);
+/* Caller attestation: completed PDA patch transfer and matched firmware reset
+ * response. Artifact validation alone does not qualify. No download is done here. */
+int cw_attest_pda_patch_reset(struct cw_session *, uint64_t now_us);
+/* Explicit caller confirmation of host framing reconfiguration; >=10ms after SET event. */
+int cw_enter_full(struct cw_session *, uint64_t now_us);
+/* Split/coalesced BTIF bytes. Failure is sticky; no bytes accepted afterward. */
+int cw_feed(struct cw_session *, const uint8_t *, size_t, uint64_t now_us);
+/* Full-mode cumulative ACK bytes; caller must transmit, and check its own result. */
+int cw_take_ack(struct cw_session *, uint8_t out[4]);
+#endif
diff --git a/tools/mt6762/hardware/cpu-power/CKDIV0.rst b/tools/mt6762/hardware/cpu-power/CKDIV0.rst
new file mode 100644
index 0000000000000000000000000000000000000000..1188eaa0427b427c67bf885d97330008ef65de32
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/CKDIV0.rst
@@ -0,0 +1,86 @@
+Inherited CKDIV code zero
+========================
+
+Capture26's twelve stable raw words reveal an overly restrictive observer:
+``mt6762_pll_khz`` rejected CKDIV[21:17]=0. The correction admits this specific
+inherited undivided encoding. All other previously unsupported divider codes,
+PLL bypass muxes, disabled/isolated PLLs and malformed snapshots still fail.
+No divider, PLL, rail, firmware ownership or DVFS readiness is changed.
+
+Evidence for the narrow correction
+----------------------------------
+
+The conclusion combines three independent kinds of evidence, rather than
+copying the stock getter's default branch for every unsupported code:
+
+* Physical acquisition: capture26 contains matching complete observations of
+  CKDIV words 0x00010a00, 0x00000aff and 0x00010a00. Each selects its PLL with
+  divider code zero. The raw 4096-byte record is version2, complete, and every
+  JSON record is independently compared against the raw bytes by the audit.
+* Boot firmware: the supplied preloader source deliberately leaves
+  ``SET_ARMPLL_DIV_EN`` undefined at ``pll.c:48``, while enabling the PLL mux
+  selection. The optional writes of divider codes8/8/10 at lines740..750 do
+  not run in that source configuration. At lines621..627 it programs PLL
+  control words for the stated 920/1500/600 MHz boot frequencies.
+* Exact shipped instructions: the dumped preloader's routine at
+  0x2244d2..0x2244eb programs those same control words. Its mux sequence at
+  0x2245de..0x2245f7 changes only bits10:9 of 0x102007a0, 0x102007a4 and
+  0x102007c0, preserving the inherited divider. Original Thumb instructions
+  were replayed against all32 divider inputs; no divider field was changed.
+  The exact stock kernel getter at 0xffffff800867bcf0..0xffffff800867be5f
+  interprets the observed code0 as unity. Original AArch64 instructions were
+  executed using each domain's captured CON1/CKDIV pair.
+
+This establishes a corroborated stock-software interpretation of the actual
+boot configuration. It is not an independent electrical frequency measurement
+or a recovered hardware specification for every encoding. In particular,
+the stock getter also returns an undivided result for several unrecognized
+codes; those codes remain rejected in the native observer and offline parser.
+The preloader replay models register storage and does not simulate divider
+hardware, oscillators, power sequencing or firmware concurrency.
+
+Captured configured rates and rails
+-----------------------------------
+
+========== ========== ================ ====================
+Domain     CON1       Nominal kHz     Exact stock getter kHz
+========== ========== ================ ====================
+CPU0-3     811cd89d   1499999          1499500
+CPU4-7     0111b13b   919999           919500
+CCI        821713b1   599999           599750
+========== ========== ================ ====================
+
+CON1 is hexadecimal. The nominal results retain fractional-PCW precision;
+stock truncates before division. The preloader's nominal boot targets are
+approximately 1500/920/600 MHz. The ARMPLL update bit31 has cleared in the
+CPU4-7 observation; it is not part of PCW or either divider.
+
+The two retained PWRAP sample passes agree on VPROC DBG0/DBG1=0x3b2d/0x0043
+and VSRAM_PROC DBG0/DBG1=0x3d23/0x0003. Their enabled/stable bits are set.
+VPROC's binary selector45 gives 800000 microvolts; VSRAM's selector61 gives
+900000 microvolts. Both accompanying Gray-code fields agree with the binary
+selectors. These values describe programmed rail settings, not measured
+electrical voltages. They do not prove calibrated operating-point suitability
+or transfer SSPM control to XNU. The stock C62 maximums remain a separate
+policy question; this change does not request them.
+
+Reproduction and validation
+---------------------------
+
+``evidence/inherited-clkdiv0.json`` retains full artifact hashes, exact code
+range hashes, all32 preloader replay cases, three stock getter results and
+raw-derived rail interpretations. The bounded preloader disassembly is in
+``evidence/inherited-clkdiv-disassembly.txt``. The corrected physical rate
+report is ``evidence/capture26-clock-readback.json``.
+
+With the existing Capstone and Unicorn modules installed::
+
+  python3 audit_inherited_clkdiv.py --image /path/to/firmware/Image \
+    --preloader /path/to/preloader.bin --capture /path/to/capture26 \
+    --bsp /path/to/workspace --output /private/evidence
+
+The script rejects other stock Image/preloader hashes and mismatched raw
+capture data. ``test.sh`` includes three exact captured-regression vectors,
+code0 power/mux failures and rejection of all remaining unsupported dividers.
+No physical write or kernel build is part of these tests. The sole changed
+kernel header is ``bsd/dev/mt6762_cpufreq_protocol.h``.
diff --git a/tools/mt6762/hardware/cpu-power/FEEDBACK.rst b/tools/mt6762/hardware/cpu-power/FEEDBACK.rst
new file mode 100644
index 0000000000000000000000000000000000000000..760fc3c600a3a94df62fb9dedc012c2f04cdbf51
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/FEEDBACK.rst
@@ -0,0 +1,113 @@
+Exact stock SSPM DVFS feedback boundary
+======================================
+
+This is an offline AP-side audit of the retained phone Image and symbolized
+stock ELF, pinned by SHA-256 in ``evidence/feedback-evidence.json``. The BSP
+is reference source, not assumed byte-identical. REA's native provider was
+unavailable in this session; installed Capstone, pyelftools and Unicorn provide
+the bounded fallback. No device command, clock write, vote or new native
+readiness flag is introduced.
+
+Request is not completion
+-------------------------
+
+``cpuhvfs_set_cluster_load_freq`` at 0xffffff800867b4f8 increments a global
+counter, wraps 255 to 1, combines ``index | counter << 4``, writes the domain's
+CSRAM word at 0x3a4 + 4*domain, issues DSB SY and returns zero. It does not wait
+for the counter to be echoed, a current-index change, a mailbox reply or a
+voltage transition. Its return means the AP submitted a vote. Domain remapping
+and table selection remain subject to the existing platform audit.
+
+The exact ``cpuhvfs_get_cur_dvfs_freq_idx`` at 0xffffff800867b230 is a raw load
+from CSRAM+0x354+4*domain. ``cpuhvfs_get_volt`` at 0xffffff800867b304 reads
+CSRAM+0x32c+4*buck. Neither snapshot contains a checked vote sequence or age.
+The voltage getter does not establish units, a physical rail measurement or
+correlation to a particular log entry.
+
+Notification record
+-------------------
+
+The CPU receive descriptor 0x2081a selects mailbox2, slot3, four words. The
+exact ``Ripi_cpu_dvfs_thread`` copies only the first two words as ring start
+and exclusive end offsets. Its ring begins at CSRAM+0x3d0 and wraps at 0xf88:
+150 entries of five 32-bit words, not 150 entries containing a vote counter.
+
+Each entry contains a little-endian 64-bit timestamp and three domain words.
+The executed original decoder extracts only OPP index [15:12], limit [7:4]
+and base [11:8]. The reference header names the other fields turbo [1:0],
+cluster-enabled [3:2], scheduler index [20:16], WFI index [24:21] and padding
+[31:25]. Those names are BSP evidence; there is no producer-side proof that
+ignored bits echo a request sequence. No voltage is decoded from the ring.
+Timestamps are concatenated without unit conversion or AP-clock correlation.
+
+For multiple records the AP computes a time-weighted frequency from the
+previous record's OPP over each timestamp interval, chooses a table index,
+and clamps it using the last record's limits. Its Linux frequency transition
+notification therefore is not necessarily the last logged OPP. The callback's
+``transition_end(..., 0)`` is an AP policy notification, not a firmware ACK.
+
+Loss and bounds matter
+----------------------
+
+The exact receive wait at 0xffffff800880a40c drains repeated completions when
+an action lock exists. The exact ISR callback at 0xffffff800880a104 skips both
+copy and completion when that lock's trylock fails. Unicorn executes both
+branches with modeled OS locks/completions; this corroborates the BSP's drop
+and coalescing behavior. One callback cannot be counted as one completed vote.
+The hardware interrupt wrapper acknowledges the observed mailbox status before
+calling that callback; this is not a request-sequence acknowledgement either.
+
+Unlike the supplied BSP's MAX_LOG_FETCH condition, this Image's read loop at
+0xffffff800867a808..a884 loops until the end offset, then clamps the count to
+40. The decoders guard out-of-range indices by warning and using entry zero;
+this does not bound the ring traversal or make malformed end offsets safe.
+Do not port that loop literally. Validate both offsets inside [0x3d0,0xf88),
+20-byte alignment relative to 0x3d0, modulo distance and an explicit record
+limit before reading. Treat start==end as no observable records, with full-wrap
+ambiguity, rather than asserting no transitions occurred. A bounded observer
+must reject or report truncation, non-increasing timestamps and overwritten or
+inconsistent snapshots; it must not silently certify freshness from them.
+
+Implementable boundary
+----------------------
+
+A read-only observer can decode a bounded, consistently captured notification
+interval; report the last observed OPP, limits, raw timestamp and separately
+sampled current index; and expose dropped/truncated/invalid intervals. A later
+owned vote implementation can report ``submitted`` and separately
+``target observed/converged`` when a new valid interval and independent stable
+PLL/divider/rail/table checks agree. It cannot call that a sequence-matched
+completion on this AP evidence. Repeated targets, delayed/coalesced callbacks,
+ring overwrite, counter wrap and autonomous PPM/EEM changes defeat that claim.
+Double-reading a ring is not proof against a producer wrapping and replacing
+identical data. No timestamp units, maximum producer delay or rollback protocol
+has been recovered here.
+
+Before active control, a physical producer must transfer exclusive scheduler,
+PPM, EEM, hotplug/suspend, CSRAM and CPU notification ownership; identify the
+active SSPM firmware/ABI and initialized controller; preserve its actual shared
+DRAM and calibrated PVT/EEM state; and establish CPU/CCI/rail constraints and
+a bounded failure response. INIT_PTBL/INIT_STA are not safe handoff probes:
+stock initialization creates tables, clears shared repository data and sends
+initialization commands. PLATFORM liveness proves none of these conditions.
+The mailbox0-only native driver does not own mailbox2's notification path.
+``dvfs_control_ready`` must remain false pending this missing contract. No
+physical producer or native ring/transition controller is supplied by this audit.
+
+Reproduction
+------------
+
+Run with existing Python capstone, pyelftools and unicorn modules::
+
+  python3 audit_feedback.py --image /path/to/Image --elf /path/to/stock.elf \
+    --bsp /path/to/workspace --output /private/output
+
+The script rejects other Image/ELF hashes, checks symbol addresses, hashes
+bounded code spans and BSP files, emits bounded disassembly, and executes six
+cases: all 32 cluster-bit positions plus baseline, three raw current-index
+reads, receive wait with/without coalescing, and successful/dropped notification
+copy. OS scheduling/locking, RAM and copy callbacks are explicitly modeled;
+no SSPM producer, peripheral timing, live memory or hardware is emulated.
+The generated evidence contains hashes, addresses and synthetic vectors, not
+private retained logs or firmware bytes. Complete bounded disassembly stays
+in the requested private output directory.
diff --git a/tools/mt6762/hardware/cpu-power/NATIVE.rst b/tools/mt6762/hardware/cpu-power/NATIVE.rst
new file mode 100644
index 0000000000000000000000000000000000000000..04dd5b944a5ac6ccb8abc9e77b3d59fc726605a2
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/NATIVE.rst
@@ -0,0 +1,94 @@
+Native CPU/CCI observation
+==========================
+
+``bsd/dev/mt6762_cpufreq.c`` is now a native readback module. It has no clock,
+voltage, mailbox, SRAM-vote or governor-write path. The earlier offline OPP
+selector remains useful for planning only. No physical device execution or
+native DVFS transition is claimed.
+
+Admission and reported values
+-----------------------------
+
+The common version-1 native handoff must be accepted first. An additional
+``cpu-clock-verified=1`` authorizes reads of the initialized APMIXED and MCUCFG
+blocks. CPU0-3, CPU4-7 and CCI use their respective PLL CON0/CON1/power and
+CKDIV addresses documented in README.rst. A double matching snapshot, PLL
+enable, power on without isolation, and source mux selecting that PLL are
+required. Reserved divider and postdivider encodings fail. The arithmetic
+retains fractional-PCW precision and uses the documented 26 MHz reference;
+these are configured nominal frequencies, not frequency-counter measurements.
+Bypass sources remain unknown instead of being mistaken for the CPU PLL.
+
+If PWRAP is separately ready, the observer also double-reads VPROC/VSRAM
+selector and enable/stable status. ``vproc_programmed_uv`` and
+``vsram_programmed_uv`` describe DAC settings, not electrical voltmeter
+measurements. VPROC DBG0/DBG1 are 0x14a2/0x14a4; VSRAM_PROC DBG0/DBG1 are
+0x19cc/0x19ce. Both DBG1 registers have enable/stable bits 0/1. All registers
+are read-only in this module.
+
+``sspm-dvfs-verified=1`` plus ``dvfs-bin=4`` permits reading the exact stock
+CSRAM range 0x00110c00..0x00111fff. These properties assert a loader handoff;
+they do not initialize firmware or establish a firmware version. The decoder
+requires a matching pair of complete snapshots, stock guard words, no pending
+EEM flag, valid current indices, and PPM base/limit indices. PVT frequency and
+divider methods must match the exact C62 table. Runtime voltage selectors are
+imported from the shared table, not replaced with nominal boot values.
+Unsupported bins or malformed tables fail without retaining stale validity.
+
+The table starts at CSRAM+0x10. Each domain occupies 36 words: sixteen
+frequency-in-MHz/selector words, sixteen postdiv/clkdiv words, and a sentinel
+at word 32. Exact stock ``cpuhvfs_pvt_tbl_create`` and table-pointer evidence
+are packaged alongside the decoder fixture. Two matching snapshots still do
+not prove EEM completion, firmware liveness, or freshness across an ABA
+update. Therefore ``dvfs_control_ready`` stays zero. Current-index words at
+0x354+4*domain are observations, not sequence acknowledgements. PPM ceilings
+are not complete live thermal/current budgets.
+
+Firmware attachment and missing completion
+------------------------------------------
+
+The next control step requires a real exclusive handoff from the AP DVFS,
+PPM, EEM, scheduler, hotplug and suspend clients. Existing active SSPM firmware
+must remain coherent with the inherited rails and all three domains.
+
+Stock ``sspm_alive_show`` at 0xffffff8008809d64 sends PLATFORM IPI ID 0 with
+command 0xDEAD, three words, and a one-word acknowledgement. Nonzero returned
+acknowledgement is the stock liveness indication. This sysfs *read* actively
+sends a firmware command: it has not been exercised under the passive ADB
+authorization. Remaining payload words are not initialized in stock; a new
+implementation must initialize them explicitly and bound waiting.
+
+Stock ``dvfs_to_spm2_command`` at 0xffffff800867ac10 sends CPU_DVFS IPI ID 1,
+four words, polling option 1, and a one-word signed acknowledgement. Commands
+0/1 initialize the table/state; command 2 changes cluster online state.
+These are state-changing operations, not harmless version queries. They must
+not be replayed against active firmware merely to test it.
+
+The supplied BSP mt6765 SSPM layout places the CPU send pin at mailbox 0,
+word slot 3, length 4. Mailbox 0 data/control are 0x10450000/0x10451000 in the
+actual DT. IN_IRQ is control+0, OUT_IRQ control+4, bit 1 is the CPU pin.
+The mailbox-2 CPU notification uses slot 3 at 0x10470000/control 0x10471000;
+it carries ring-log bounds. Initialization validates mailbox layout tags,
+but ordinary traffic overwrites these tags. Runtime ownership, transport
+state and active image compatibility therefore still require a loader
+contract and an acknowledged liveness test. No mailbox MMIO is mapped or written by the CPU observer. The separate
+SSPM module now performs an explicitly owned, bounded PLATFORM probe; see
+SSPM.rst. That response does not initialize CPU-DVFS.
+
+After attachment, any sequence-tagged scheduler vote must be bounded and
+checked against actual PLL/CKDIV, shared-rail readback, reported current index,
+and the current EEM/thermal/current limits. A stored request word is not a
+completed transition. Failed completion must not trigger direct PLL writes or
+reduce shared rails. Scheduler integration, SMP demand, CCI mapping, frequency
+accounting and firmware-managed idle are additional work before a best
+permitted-performance governor is available.
+
+Validation
+----------
+
+``test.sh`` tests the exact native decoder header using an independently
+extracted stock PVT fixture. It checks runtime voltage import, malformed
+selectors/methods/sentinels, preserved output on failure, fractional dividers,
+power/isolation/source checks and PPM bounds. These host tests establish
+software behavior only. Kernel compilation and emulator evidence are reported
+by the parent integration build; ordinary QEMU has no native clock handoff.
