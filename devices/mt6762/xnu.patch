diff --git a/tools/mt6762/firmware/extract.py b/tools/mt6762/firmware/extract.py
new file mode 100644
index 0000000000000000000000000000000000000000..695476a0288e7e888d1889c7224bda5869f28cbe
--- /dev/null
+++ b/tools/mt6762/firmware/extract.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""Read-only, format-aware extraction of this phone's boot v2 and DT tables.
+
+No dependencies beyond Python. Optional --dtc decompiles extracted FDTs.
+Only boot.bin/dtbo.bin/vendor_boot.bin are read; calibration/user partitions are not.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import zlib
+
+
+def take(data, offset, size):
+    if offset < 0 or size < 0 or offset + size > len(data):
+        raise ValueError(f"invalid range {offset:#x}+{size:#x}/{len(data):#x}")
+    return data[offset:offset + size]
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def dt_table(data):
+    magic, total, header, entry_size, count, entries, page, version = struct.unpack_from('>8I', data)
+    if magic != 0xd7b7ab1e or version != 0 or header < 32 or entry_size < 32:
+        raise ValueError('Unsupported Android DT table')
+    take(data, 0, total)
+    result = []
+    for i in range(count):
+        entry = struct.unpack('>8I', take(data, entries + i * entry_size, 32))
+        size, offset, ident, rev, *custom = entry
+        blob = take(data[:total], offset, size)
+        if struct.unpack_from('>I', blob)[0] != 0xd00dfeed:
+            raise ValueError('DT table member is not an FDT')
+        fdt_size = struct.unpack_from('>I', blob, 4)[0]
+        if fdt_size != size:
+            raise ValueError('DT table and FDT sizes disagree')
+        result.append((blob, dict(index=i, offset=offset, size=size, id=ident,
+                                  rev=rev, custom=custom, sha256=digest(blob))))
+    return result
+
+
+def fdt_properties(blob):
+    """Validate FDT structure and return property bytes keyed by absolute path."""
+    magic, total, off_struct, off_strings, _, version, _, _, strings_size, struct_size = struct.unpack_from('>10I', blob)
+    if magic != 0xd00dfeed or version != 17 or total != len(blob):
+        raise ValueError('Unsupported FDT header')
+    strings = take(blob, off_strings, strings_size)
+    data = take(blob, off_struct, struct_size)
+    pos, stack, nodes = 0, [], {}
+    while pos < len(data):
+        token, = struct.unpack('>I', take(data, pos, 4))
+        pos += 4
+        if token == 1:
+            end = data.index(0, pos)
+            stack.append(data[pos:end].decode())
+            pos = (end + 4) & ~3
+            nodes['/' + '/'.join(stack[1:])] = {}
+        elif token == 2:
+            stack.pop()
+        elif token == 3:
+            size, nameoff = struct.unpack('>II', take(data, pos, 8))
+            pos += 8
+            name = strings[nameoff:strings.index(0, nameoff)].decode()
+            nodes['/' + '/'.join(stack[1:])][name] = take(data, pos, size)
+            pos = (pos + size + 3) & ~3
+        elif token == 4:
+            pass
+        elif token == 9:
+            if stack:
+                raise ValueError('Unclosed FDT node')
+            return nodes
+        else:
+            raise ValueError(f'Invalid FDT token {token}')
+    raise ValueError('Missing FDT end token')
+
+
+def display_property(name, value):
+    if name in ('model', 'compatible', 'device_type', 'enable-method', 'method', 'bootargs', 'clock-names', 'status'):
+        return value.rstrip(b'\0').decode().split('\0')
+    if len(value) % 4 == 0:
+        return list(struct.unpack('>' + 'I' * (len(value) // 4), value))
+    return {'hex': value.hex()}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--dump', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True)
+    parser.add_argument('--dtc', type=Path)
+    args = parser.parse_args()
+    if args.out.resolve() == args.dump.resolve() or args.dump.resolve() in args.out.resolve().parents:
+        raise ValueError('Output must be outside the original dump')
+    args.out.mkdir(parents=True, exist_ok=True)
+    report = {'evidence_type': 'static-format-parsing', 'inputs': {}, 'outputs': {}, 'limitations': [
+        'No hardware execution; bootloader-mutated live DT and actual installed RAM remain unknown.',
+        'DT overlay contains reference display/touch properties inconsistent with compiled kernel config.',
+        'No REA Evidence ID: REA firmware tool unavailable because REA_BINWALK_COMMAND is unset; this is an independent parser.']}
+
+    def read(name):
+        data = (args.dump / name).read_bytes()
+        report['inputs'][name] = {'size': len(data), 'sha256': digest(data)}
+        return data
+
+    def write(name, data):
+        (args.out / name).write_bytes(data)
+        report['outputs'][name] = {'size': len(data), 'sha256': digest(data)}
+
+    data = read('boot.bin')
+    if data[:8] != b'ANDROID!':
+        raise ValueError('Not an Android boot image')
+    keys = ['kernel_size', 'kernel_addr', 'ramdisk_size', 'ramdisk_addr', 'second_size',
+            'second_addr', 'tags_addr', 'page_size', 'header_version', 'os_version_encoded']
+    header = dict(zip(keys, struct.unpack_from('<10I', data, 8)))
+    if header['header_version'] != 2:
+        raise ValueError('Only boot header v2 supported')
+    rec_size, rec_offset, hdr_size, dtb_size, dtb_addr = struct.unpack_from('<IQIIQ', data, 1632)
+    header.update(recovery_dtbo_size=rec_size, recovery_dtbo_offset=rec_offset,
+                  header_size=hdr_size, dtb_size=dtb_size, dtb_addr=dtb_addr)
+    header['cmdline'] = (data[64:576].split(b'\0')[0] + data[608:1632].split(b'\0')[0]).decode()
+    page = header['page_size']
+    if page < hdr_size or page & (page - 1):
+        raise ValueError('Invalid boot image page size')
+    align = lambda size: (size + page - 1) & ~(page - 1)
+    offset = page
+    sections = {}
+    for name in ('kernel', 'ramdisk', 'second'):
+        size = header[name + '_size']
+        sections[name] = {'offset': offset, 'size': size}
+        if size:
+            write(name + '.compressed' if name == 'kernel' else name, take(data, offset, size))
+        offset += align(size)
+    offset += align(rec_size)
+    sections['dtb'] = {'offset': offset, 'size': dtb_size}
+    report['boot_header'] = header
+    report['boot_sections'] = sections
+    compressed = take(data, sections['kernel']['offset'], header['kernel_size'])
+    decoder = zlib.decompressobj(31)
+    kernel = decoder.decompress(compressed) + decoder.flush()
+    if not decoder.eof or decoder.unused_data:
+        raise ValueError('Unexpected kernel gzip layout')
+    if kernel[56:60] != b'ARMd':
+        raise ValueError('Not an AArch64 Image')
+    write('Image', kernel)
+    text_offset, image_size, flags = struct.unpack_from('<3Q', kernel, 8)
+    banner = kernel.index(b'Linux version ')
+    report['linux_image'] = dict(text_offset=text_offset, image_size=image_size, flags=flags,
+                                banner=kernel[banner:kernel.index(0, banner)].decode())
+    config_start = kernel.find(b'IKCFG_ST')
+    if config_start >= 0:
+        config_end = kernel.index(b'IKCFG_ED', config_start)
+        config = zlib.decompress(kernel[config_start + 8:config_end], 31)
+        write('stock.config', config)
+        report['ikconfig'] = dict(start=config_start, end=config_end)
+    for table_name, table in [('boot.bin', take(data, offset, dtb_size)), ('dtbo.bin', read('dtbo.bin'))]:
+        members = dt_table(table)
+        report[table_name + '_dt_table'] = [info for _, info in members]
+        for blob, info in members:
+            suffix = '' if len(members) == 1 else f'.{info["index"]}'
+            name = table_name + suffix + '.dtb'
+            write(name, blob)
+            nodes = fdt_properties(blob)
+            if table_name == 'boot.bin':
+                selected = {path: {key: display_property(key, value) for key, value in props.items()}
+                            for path, props in nodes.items()
+                            if path in ('/', '/chosen', '/memory', '/timer', '/psci')
+                            or path.startswith(('/cpus/cpu@', '/serial@', '/interrupt-controller@'))}
+                report['boot_dt_selected_nodes'] = selected
+            if args.dtc:
+                dts_name = ('boot' if table_name == 'boot.bin' else 'overlay') + suffix + '.dts'
+                result = subprocess.run([str(args.dtc), '-I', 'dtb', '-O', 'dts', '-o', str(args.out / dts_name), str(args.out / name)], capture_output=True, check=True)
+                write(dts_name + '.warnings.log', result.stderr)
+    vendor = read('vendor_boot.bin')
+    report['vendor_boot_all_zero'] = not any(vendor)
+    (args.out / 'evidence.json').write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps({'boot': header, 'linux': report['linux_image'], 'evidence': str(args.out / 'evidence.json')}, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/mt6762/firmware/extract_boot_log_facts.py b/tools/mt6762/firmware/extract_boot_log_facts.py
new file mode 100644
index 0000000000000000000000000000000000000000..c382e82b3e81db312445b7e9a0ac5b2e94091555
--- /dev/null
+++ b/tools/mt6762/firmware/extract_boot_log_facts.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Retain only memory/boot-handoff facts from a supplied expdb image.
+
+These are historical ASCII boot-log observations, not live measurements.
+No general log contents, device identifiers or private partition data are exported.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+
+p = argparse.ArgumentParser(description=__doc__)
+p.add_argument('expdb', type=Path)
+p.add_argument('output', type=Path)
+a = p.parse_args()
+data = a.expdb.read_bytes()
+patterns = (
+    r'^total_dram_size: 0x[0-9a-fA-F]+, max_dram_size: 0x[0-9a-fA-F]+$',
+    r'^.*Memory: [0-9]+K/[0-9]+K available \(.*\)$',
+    r'^.*\[BLOCK_TAG\] DRAM: 0x[0-9a-fA-F]+ - 0x[0-9a-fA-F]+, size: 0x[0-9a-fA-F]+$',
+    r'^.*LK_LOG_STORE:dram pl/lk log buff mapping start addr = 0x[0-9a-fA-F]+, size = 0x[0-9a-fA-F]+$',
+    r'^RAM_CONSOLE mrdump_addr:0x[0-9a-fA-F]+, mrdump_size:0x[0-9a-fA-F]+, dram_addr:0x[0-9a-fA-F]+, dram_size:0x[0-9a-fA-F]+$',
+    r'^RAM_CONSOLE\. boot_arg\(PL2LK\): sram_addr:0x[0-9a-fA-F]+, sram_size:0x[0-9a-fA-F]+, def_type:0x[0-9a-fA-F]+, memory_info_offset:0x[0-9a-fA-F]+$',
+)
+found = []
+for m in re.finditer(rb'[\x20-\x7e]{8,}', data):
+    line = m.group().decode('ascii')
+    if any(re.fullmatch(pattern, line) for pattern in patterns):
+        found.append({'file_offset': m.start(), 'text': line})
+dram_sizes = sorted({int(m.group(1), 16) for row in found
+                     if (m := re.match(r'total_dram_size: (0x[0-9a-fA-F]+)', row['text']))})
+report = {
+    'source': str(a.expdb.resolve()), 'sha256': hashlib.sha256(data).hexdigest(),
+    'evidence_type': 'historical ASCII boot logs with exact image offsets',
+    'observations': found,
+    'reported_total_dram_bytes': dram_sizes,
+    'inference': ('Consistent retained total DRAM reports; compare with the static DTB and live boot map.'
+                  if len(dram_sizes) == 1 else 'No unique total DRAM value established.'),
+    'limitations': ['No live hardware measurement.', 'Bootloader reserved regions must still be reconciled before physical boot.',
+                   'Only the explicit memory and handoff line patterns above were retained.'],
+}
+a.output.write_text(json.dumps(report, indent=2) + '\n')
+print(f'{len(found)} bounded observations saved to {a.output}')
diff --git a/tools/mt6762/hardware/battery-soc/README.rst b/tools/mt6762/hardware/battery-soc/README.rst
new file mode 100644
index 0000000000000000000000000000000000000000..2f903a1ad4c421d2cc8b6b222bc856ffbb3e98c8
--- /dev/null
+++ b/tools/mt6762/hardware/battery-soc/README.rst
@@ -0,0 +1,182 @@
+Conditional approximate SOC model
+================================
+
+This standalone, default-off C core is for an explicitly approximate UI estimate.
+It is not integrated into XNU, the loader, IOKit or any charger control. No phone
+measurement was taken by this work. Do not use its outputs as charging, shutdown,
+thermal, battery protection, learned capacity, or exact Android-daemon policy.
+
+The output is an interval in basis points (10000=100%). There is deliberately no
+single preferred percentage, measured temperature, remaining time or learned
+capacity. Quality flags identify the estimate, unknown temperature, conditional
+resistance model, nonmonotonic vendor data and2200mAh endpoint normalization.
+The interval is conditional model uncertainty, NOT a physical confidence bound.
+Unknown voltage/gauge calibration, relaxation, hysteresis, aging, physical cell
+identity/capacity and resistance error can put the true SOC outside it.
+
+Profile admission
+-----------------
+
+bs_profile_init requires the actual six big-endian888-byte profile payloads;
+it computes SHA256 itself and matches the exact shipped hashes. No caller
+"validated" boolean bypasses this. It additionally requires declared row counts
+100, columns3, temperatures50/25/10/0/-6/-10, and raw DT R_FG_VALUE10,
+CAR_TUNE_VALUE100, FG_METER_RESISTANCE75. Reject absent/changed/duplicate metadata
+in the future FDT integration before calling this API. The core consumes byte
+spans and values, not a whole FDT; validating the surrounding live board/gauge
+node and its ancestors remains that caller's responsibility.
+
+The actual profile contains74 rows; original ARM64 code repeats its last row
+through100. Repeated endpoints do not add curve geometry, so this core stores
+only the74 source rows. T0..2 share SHA256
+ d4d40034e86047a42318bcdceab41e256e903da4f19e7947ecf8bec0837fa5cf
+and T3..5 share
+ b878eecf8515ac02a25b526ccdcf1daf926d9547e8fff875c358e082d02ca58d.
+No proprietary profile payload is embedded in these sources. Validated decoded
+profile objects must remain immutable and come only from bs_profile_init. Their
+marker checks programming misuse, not adversarial in-process memory mutation.
+
+All voltage/resistance columns are identical across the six shipped tables;
+early discharged-charge coordinates differ slightly. A voltage reversal occurs
+at row12 and a charge backstep at row64. No rows are silently sorted, removed or
+repaired. Pure bs_ocv_interval checks all overlapping segments and keeps every
+charge intersection from all six temperature profiles, with outward integer
+rounding. It therefore represents local multi-valued ambiguity rather than
+choosing the stock algorithm's first crossing. Because voltage coordinates match
+across tables, intermediate temperature interpolation is contained in this
+six-table envelope. No25C physical reading is assumed.
+
+Stock provenance and intentional differences
+-------------------------------------------
+
+Original Image SHA256:
+82b1919185a49f268a0f8e145a6714d6264c1f66918a90df0d763266147ead4b.
+Private source-bound evidence is retained in
+hardware/hakios-migration-20261026/battery58/soc-profile/:
+FINDINGS.rst, stock-soc-functions.json/stock-soc.asm, original-replay.json,
+dt-profiles.json and source-hashes.json. The evidence includes execution of the
+original ARM64 header/DT parser, temperature construction and OCV interpolation
+with explicit host mocks and synthetic inputs; it is not a physical battery test.
+
+Exact entry points include fg_custom_init_from_dts ffffff8008a7caec,
+its inlined triple parser a7de04..a7df18, fgr_construct_battery_profile
+ffffff8008a81358, fg_construct_battery_profile_by_qmax ffffff8008a819ac,
+fg_construct_battery_profile_by_vboot ffffff8008a81ab4, fgr_construct_vboot
+ffffff8008a81e18, OCV_to_SOC_c ffffff8008a82cdc. Relevant BSP cross-checks are
+kernel-4.14/drivers/power/supply/mediatek/battery/mtk_battery_core.c850..910,
+1255..1412 andmtk_battery_recovery.c1409..1709,1842..2008.
+
+The discharged-charge endpoint22000 is0.1mAh, hence the explicit project model
+capacity2200000 microamp-hours. It is neither measured capacity nor a claim that
+the stock algorithm always selects this denominator. Stock QMAX_SEL1 derives
+normalization from load/cutoff/PTIM resistance; compiled default Qmax arrays
+also differ. That policy is deliberately not reconstructed here. Original
+first-crossing arithmetic under an explicit3350mV cutoff produces3715mV23.62%
+and3705mV25.83%, demonstrating why voltage must not continually reseed the UI.
+
+Initial estimate
+----------------
+
+bs_begin(state,1) explicitly opts into this conditional model. A zero/default
+state has no estimate. It takes two valid, forward, generation-continuous
+observations before producing the initial seed; the first only establishes a
+baseline. Both observations must carry fresh VBAT, current and signed CAR from
+one coherent observer snapshot. No absent measurement is substituted.
+
+For the second observation, the conditional OCV interval is:
+
+  VBAT - current_uA * R_0.1mOhm / 10000
+
+Positive current means charging, so its terminal voltage is corrected downward;
+negative current corrects upward. R uses the full actual table range740..990 plus
+the stock series terms R_FG100 and FG_METER_RESISTANCE75, i.e.91.5..116.5mOhm.
+This envelope avoids guessing a temperature or a particular resistance row.
+Outward rounding and an extra±1000uV cover integer ADC millivolt flooring only.
+They do not cover physical calibration error. Series compensation is justified
+as a stock software model, not verified electrical accuracy or a rested cell.
+There is no claim that two observations constitute an OCV rest period.
+
+bs_ocv_interval is also independently callable with an explicitly conditional
+OCV interval, without opting into the resistance assumption. Its arithmetic-only
+result has valid=0 and no freshness timestamp. A later integration may prefer
+this lower-level API if physical electrical assumptions cannot be admitted.
+
+Updates and explicit bounds
+---------------------------
+
+After seeding, voltage is never used to reseed or adjust SOC. The core adds the
+observed signed CAR difference relative to the seed, using2200000uAh as the
+model denominator. It retains the inherited counter's arbitrary origin; +8Ah
+and-8Ah origins with equal deltas give the same estimate. Rounding is applied
+from the baseline on every update, avoiding cumulative per-poll truncation.
+A±200uAh arithmetic allowance covers quantized endpoint differences in the
+reported interval. This is not a bound on physical coulomb-counter accuracy.
+The OCV fields retain their separate ocv_acquired_us seed timestamp, even while
+current output acquisition/expiry fields advance.
+
+The following are explicit project admission rules, not claims about hardware
+maximums or stock UI policy:
+
+* All times are monotonic microseconds. Caller converts native absolute ticks
+  with checked arithmetic before calling. Input lease starts BEFORE all I/O:
+  acquired<=now<expires, expires>acquired, expires-acquired<=2000000us.
+* Acquisitions strictly increase; every update/read now must not move backward.
+  Consecutive acquisition gaps are at most5000000us. Caller must call bs_read
+  when acquisition stops so the output expires at its original deadline.
+* Sequence numbers strictly increase; nonzero generation identifies the same
+  admitted continuous gauge/configuration epoch. Changing it invalidates state.
+* The33-bit NTER must advance by a modular delta in[1,2^32). Natural forward
+  wrap is allowed, following the existing native observer. No assumed2Hz-to-wall
+  relation is imposed:2Hz is only the QEMU fixture rate, not recovered physical
+  timing. The native latch/configuration/freshness checks remain prerequisites.
+* Current is signed microamps, quantized100uA by the exact decoder, with allowed
+  magnitude at most2000000uA. Voltage is2500000..5000000uV, quantized1000uV by
+  the exact stock processed conversion. The conditional OCV interval must also
+  stay within2500000..5000000uV or admission fails.
+* CAR is signed microamp-hours, quantized100uAh; magnitude above20000000uAh is
+  rejected as out of the supported decoded-counter envelope. It is not remaining
+  charge. Success requires valid==7 (VBAT/current/CAR), not native BAT_* flags.
+* Each CAR delta must satisfy abs(delta)<=ceil(2000000*gap_us/3600000000)+200
+  microamp-hours. This accommodates quantization but bounds implausible jumps.
+  It does not assume endpoint currents bound all intervening transient loads.
+* When both endpoint currents have the same nonzero sign, a CAR delta of the
+  opposite sign beyond200uAh is rejected. A real intervening direction reversal
+  could produce a conservative false rejection; endpoint current alone cannot
+  prove the complete waveform. Different endpoint signs are allowed.
+* The integrated model interval must remain wholly within0..10000 basis points.
+  Crossing a boundary invalidates it instead of silently pinning0/100. This
+  deliberately means near-full/empty estimates may require future qualified
+  boundary policy; it does not signal hardware full/empty or control charging.
+
+A stale, partial, reversed-time, discontinuous, implausible or out-of-model
+observation clears the output and latches failure. It never silently reseeds.
+Restart requires an explicit new bs_begin after the integration has re-established
+its measurement/continuity prerequisites. The core cannot detect every small
+CAR-only reset that leaves NTER/configuration apparently continuous; an unknown
+reset can resemble a small valid delta. Therefore independent gauge ownership,
+no unaccounted reset writers, and epoch changes on known resets are mandatory
+integration assumptions. Without those, use arithmetic-only lookup and do not
+publish a tracked estimate.
+
+No broadening of permission follows from profile identity or sample valid bits.
+The caller must serialize access; profile/state/sample/output spans must not
+alias. It must keep the admitted profile immutable, pass the actual same-boot
+profile/coefficients and fresh snapshot, remove expired UI properties, and
+avoid translating an interval midpoint into unwarranted precision. This package
+adds no callbacks, driver invocation, hardware action or publication code.
+
+Tests
+-----
+
+  BS_PROFILE_DTB=/private/capture44/runtime.dtb python3 test_battery_soc.py -v
+
+The suite compiles actual C with optimization, -Wall -Wextra -Werror and
+-ffreestanding. It tests SHA256 against hashlib across padding boundaries;
+corrupt/truncated/mismatched profiles and metadata; exact rational segment
+intersections; nonmonotonic ambiguity; signed IR correction; baseline-relative
+CAR integration for1000 updates while voltage alternates; quantization/jump
+boundaries; sign/generation/sequence/NTER/time guards; expiry and model bounds.
+All measurement streams in tests are explicitly synthetic. The optional real
+DTB supplies immutable profile bytes only, not live measurements. Without it,
+three artifact-authentication/default-off tests run and the real-profile class
+is explicitly skipped. No raw private profile bytes are bundled with this code.
diff --git a/tools/mt6762/hardware/battery-soc/battery_soc.c b/tools/mt6762/hardware/battery-soc/battery_soc.c
new file mode 100644
index 0000000000000000000000000000000000000000..802283eff55514ec720fd5115e218ace716fd977
--- /dev/null
+++ b/tools/mt6762/hardware/battery-soc/battery_soc.c
@@ -0,0 +1,148 @@
+#include "battery_soc.h"
+#include "profile_sha256.h"
+#define PROFILE_MARKER 0x42535031U
+#define ALL_QUALITY 63U
+static void zero(void *p,size_t n) {unsigned char *v=p;while(n--)*v++=0;}
+static uint32_t be32(const unsigned char *p) {return (uint32_t)p[0]<<24|(uint32_t)p[1]<<16|(uint32_t)p[2]<<8|p[3];}
+static int digest_equal(const unsigned char *a,const unsigned char *b) {unsigned i,v=0;for(i=0;i<32;i++)v|=a[i]^b[i];return v==0;}
+static int64_t floor_div(int64_t n,int64_t d) {int64_t q=n/d,r=n%d;return q-(r<0);}
+static int64_t ceil_div(int64_t n,int64_t d) {int64_t q=n/d,r=n%d;return q+(r>0);}
+static int64_t magnitude(int64_t n) {return n<0?-n:n;}
+int bs_profile_init(struct bs_profile *p,const struct bs_blob b[6],const uint32_t rows[6],const uint32_t cols[6],const int32_t temps[6],const struct bs_coefficients *coeff) {
+ static const int32_t expected_t[6]={50,25,10,0,-6,-10};
+ static const unsigned char hashes[2][32]={
+ {0xd4,0xd4,0x00,0x34,0xe8,0x60,0x47,0xa4,0x23,0x18,0xbc,0xdc,0xea,0xb4,0x1e,0x25,0x6e,0x90,0x3d,0xa4,0xf1,0x9e,0x79,0x47,0xec,0xf8,0xbe,0xc0,0x83,0x7f,0xa5,0xcf},
+ {0xb8,0x78,0xee,0xcf,0x85,0x15,0xac,0x02,0xa2,0x5b,0x52,0x6c,0xcd,0xcf,0x1d,0xaf,0x92,0x6d,0x95,0x47,0xe8,0xff,0xf8,0x75,0xc3,0x58,0xe0,0x82,0xd0,0x2c,0xa5,0x8d}};
+ unsigned t,i;unsigned char digest[32];
+ if(!p)return BS_ARGUMENT;
+ zero(p,sizeof(*p));
+ if(!b||!rows||!cols||!temps||!coeff)return BS_ARGUMENT;
+ if(coeff->rfg_dt!=10||coeff->car_tune_dt!=100||coeff->meter_resistance_dt!=75)return BS_PROFILE;
+ /* Verify all byte inputs before exposing any decoded profile. */
+ for(t=0;t<6;t++) {
+  if(!b[t].bytes||b[t].length!=BS_PROFILE_BYTES||rows[t]!=100||cols[t]!=3||temps[t]!=expected_t[t])return BS_PROFILE;
+  bs_sha256(b[t].bytes,b[t].length,digest);
+ if(!digest_equal(digest,hashes[t<3?0:1]))return BS_PROFILE;
+ }
+ p->resistance_min_0p1mohm=UINT32_MAX;
+ for(t=0;t<6;t++)for(i=0;i<BS_ROWS;i++) {
+  const unsigned char *v=b[t].bytes+i*12;struct bs_row *r=&p->rows[t][i];
+  r->charge_0p1mah=be32(v);r->voltage_0p1mv=be32(v+4);r->resistance_0p1mohm=be32(v+8);
+  if(r->resistance_0p1mohm<p->resistance_min_0p1mohm)p->resistance_min_0p1mohm=r->resistance_0p1mohm;
+  if(r->resistance_0p1mohm>p->resistance_max_0p1mohm)p->resistance_max_0p1mohm=r->resistance_0p1mohm;
+ }
+ p->initialized=PROFILE_MARKER;return BS_OK;
+}
+static void include_charge(int64_t q_floor,int64_t q_ceil,int64_t *low,int64_t *high) {
+ if(q_floor<*low)*low=q_floor;
+ if(q_ceil>*high)*high=q_ceil;
+}
+int bs_ocv_interval(const struct bs_profile *p,int64_t lo,int64_t hi,struct bs_result *out) {
+ unsigned t,i;int64_t qlo=INT64_MAX,qhi=INT64_MIN;
+ if(!out)return BS_ARGUMENT;
+ zero(out,sizeof(*out));
+ if(!p||p->initialized!=PROFILE_MARKER)return BS_PROFILE;
+ if(lo<2500000||hi>5000000||lo>hi)return BS_RANGE;
+ for(t=0;t<6;t++) {
+  const struct bs_row *r=p->rows[t];int64_t top=(int64_t)r[0].voltage_0p1mv*100,bottom=(int64_t)r[BS_ROWS-1].voltage_0p1mv*100;
+  if(hi>=top)include_charge(0,0,&qlo,&qhi);
+  if(lo<=bottom)include_charge(BS_MODEL_CAPACITY_UAH,BS_MODEL_CAPACITY_UAH,&qlo,&qhi);
+  for(i=1;i<BS_ROWS;i++) {
+   int64_t va=(int64_t)r[i-1].voltage_0p1mv*100,vb=(int64_t)r[i].voltage_0p1mv*100;
+   int64_t qa=(int64_t)r[i-1].charge_0p1mah*100,qb=(int64_t)r[i].charge_0p1mah*100;
+   int64_t minv=va<vb?va:vb,maxv=va>vb?va:vb,x,y;
+   if(hi<minv||lo>maxv)continue;
+   if(va==vb) {include_charge(qa<qb?qa:qb,qa>qb?qa:qb,&qlo,&qhi);continue;}
+   /* Normalize denominator positive; preserve both direction reversals. */
+   if(va>vb) {int64_t z=va;va=vb;vb=z;z=qa;qa=qb;qb=z;}
+   x=lo>va?lo:va;y=hi<vb?hi:vb;
+   include_charge(qa+floor_div((qb-qa)*(x-va),vb-va),qa+ceil_div((qb-qa)*(x-va),vb-va),&qlo,&qhi);
+   include_charge(qa+floor_div((qb-qa)*(y-va),vb-va),qa+ceil_div((qb-qa)*(y-va),vb-va),&qlo,&qhi);
+  }
+ }
+ if(qlo<0||qhi>BS_MODEL_CAPACITY_UAH||qlo>qhi)return BS_RANGE;
+ out->lower_bp=(uint32_t)floor_div((BS_MODEL_CAPACITY_UAH-qhi)*10000,BS_MODEL_CAPACITY_UAH);
+ out->upper_bp=(uint32_t)ceil_div((BS_MODEL_CAPACITY_UAH-qlo)*10000,BS_MODEL_CAPACITY_UAH);
+ out->quality=ALL_QUALITY & ~BS_CONDITIONAL_IR_MODEL;out->conditional_ocv_lower_uv=lo;out->conditional_ocv_upper_uv=hi;
+ /* No valid flag: arithmetic alone is not a fresh observable estimate. */
+ return BS_OK;
+}
+static int fail(struct bs_state *s,int error) {s->phase=BS_FAILED;s->fault=error;
+ zero(&s->last,sizeof(s->last));return error;}
+int bs_begin(struct bs_state *s,unsigned enabled) {
+ if(!s)return BS_ARGUMENT;
+ zero(s,sizeof(*s));
+ if(enabled!=1)return BS_DISABLED;
+ s->phase=BS_WAIT_FIRST;return BS_OK;
+}
+static int sample_ok(const struct bs_sample *v,uint64_t now) {
+ if(!v||v->valid!=7||!v->sequence||!v->generation)return BS_ARGUMENT;
+ if(v->acquired_us>now||v->expires_us<=v->acquired_us||v->expires_us-v->acquired_us>BS_MAX_LEASE_US||now>=v->expires_us)return BS_STALE;
+ if(v->nter_ticks>=(UINT64_C(1)<<33)||v->charge_uah>INT64_C(20000000)||v->charge_uah<INT64_C(-20000000)||v->charge_uah%100)return BS_COUNTER;
+ if(v->voltage_uv<2500000||v->voltage_uv>5000000||v->current_ua>BS_MAX_CURRENT_UA||v->current_ua<-BS_MAX_CURRENT_UA||v->current_ua%100||v->voltage_uv%1000)return BS_RANGE;
+ return BS_OK;
+}
+int bs_update(struct bs_state *s,const struct bs_profile *p,const struct bs_sample *v,uint64_t now,struct bs_result *out) {
+ int e;int64_t delta,limit,span,lo,hi,ir1,ir2;uint64_t dt,ticks;
+ if(!out)return BS_ARGUMENT;
+ zero(out,sizeof(*out));
+ if(!s)return BS_ARGUMENT;
+ if(s->phase==BS_OFF)return BS_DISABLED;
+ if(s->phase==BS_FAILED)return BS_FAULT;
+ if(now<s->last_now_us)return fail(s,BS_TIME);
+ s->last_now_us=now;
+ if(!p||p->initialized!=PROFILE_MARKER)return fail(s,BS_PROFILE);
+ e=sample_ok(v,now);
+ if(e)return fail(s,e);
+ if(s->phase==BS_WAIT_FIRST) {s->previous=*v;s->phase=BS_WAIT_SECOND;return BS_PENDING;}
+ if(v->generation!=s->previous.generation||v->sequence<=s->previous.sequence)return fail(s,BS_COUNTER);
+ if(v->acquired_us<=s->previous.acquired_us)return fail(s,BS_TIME);
+ dt=v->acquired_us-s->previous.acquired_us;
+ if(dt>BS_MAX_GAP_US)return fail(s,BS_TIME);
+ ticks=(v->nter_ticks-s->previous.nter_ticks)&((UINT64_C(1)<<33)-1);
+ if(!ticks||ticks>=(UINT64_C(1)<<32))return fail(s,BS_COUNTER);
+ /* Original decoded charge is0.1mAh-quantized. Bound by global allowed2A
+  * during the whole gap, rather than assuming endpoints bound transient load. */
+ delta=v->charge_uah-s->previous.charge_uah;
+ limit=ceil_div((int64_t)BS_MAX_CURRENT_UA*(int64_t)dt,INT64_C(3600000000))+BS_CAR_TOLERANCE_UAH;
+ if(magnitude(delta)>limit)return fail(s,BS_JUMP);
+ if((s->previous.current_ua>0&&v->current_ua>0&&delta < -BS_CAR_TOLERANCE_UAH)||
+    (s->previous.current_ua<0&&v->current_ua<0&&delta > BS_CAR_TOLERANCE_UAH))return fail(s,BS_DIRECTION);
+ if(s->phase==BS_WAIT_SECOND) {
+  /* Conditional stock resistance model: R_FG100 + FG_METER_RESISTANCE75
+   * (0.1mOhm) plus the full actual table R envelope. Positive current charges,
+   * so terminal voltage is higher than conditional OCV. No measured-temp claim.
+   * Rounding outward and ±1mV account only for arithmetic ADC millivolt flooring.
+   * This is NOT a bound on unknown physical calibration/hysteresis/model error. */
+  ir1=(int64_t)v->current_ua*(p->resistance_min_0p1mohm+175);
+  ir2=(int64_t)v->current_ua*(p->resistance_max_0p1mohm+175);
+  if(ir1>ir2) {int64_t z=ir1;ir1=ir2;ir2=z;}
+  lo=(int64_t)v->voltage_uv-ceil_div(ir2,10000)-1000;
+  hi=(int64_t)v->voltage_uv-floor_div(ir1,10000)+1000;
+  e=bs_ocv_interval(p,lo,hi,out);
+ if(e)return fail(s,e);
+  s->seed_charge_uah=v->charge_uah;s->seed_lower_bp=out->lower_bp;s->seed_upper_bp=out->upper_bp;
+  s->phase=BS_TRACKING;out->quality=ALL_QUALITY;out->ocv_acquired_us=v->acquired_us;
+ } else if(s->phase==BS_TRACKING) {
+  span=v->charge_uah-s->seed_charge_uah;
+  lo=(int64_t)s->seed_lower_bp*BS_MODEL_CAPACITY_UAH+(span-BS_CAR_TOLERANCE_UAH)*10000;
+  hi=(int64_t)s->seed_upper_bp*BS_MODEL_CAPACITY_UAH+(span+BS_CAR_TOLERANCE_UAH)*10000;
+  if(lo<0||hi>10000*BS_MODEL_CAPACITY_UAH)return fail(s,BS_RANGE);
+  *out=s->last;out->lower_bp=(uint32_t)floor_div(lo,BS_MODEL_CAPACITY_UAH);out->upper_bp=(uint32_t)ceil_div(hi,BS_MODEL_CAPACITY_UAH);
+ } else return fail(s,BS_ARGUMENT);
+ out->valid=1;out->acquired_us=v->acquired_us;out->expires_us=v->expires_us;
+ s->previous=*v;s->last=*out;return BS_OK;
+}
+int bs_read(struct bs_state *s,uint64_t now,struct bs_result *out) {
+ if(!out)return BS_ARGUMENT;
+ zero(out,sizeof(*out));
+ if(!s)return BS_ARGUMENT;
+ if(s->phase==BS_FAILED)return BS_FAULT;
+ if(s->phase==BS_OFF)return BS_DISABLED;
+ if(now<s->last_now_us)return fail(s,BS_TIME);
+ s->last_now_us=now;
+ if(s->phase!=BS_TRACKING)return BS_PENDING;
+ if(now<s->last.acquired_us)return fail(s,BS_TIME);
+ if(now>=s->last.expires_us)return fail(s,BS_STALE);
+ *out=s->last;return BS_OK;
+}
diff --git a/tools/mt6762/hardware/battery-soc/battery_soc.h b/tools/mt6762/hardware/battery-soc/battery_soc.h
new file mode 100644
index 0000000000000000000000000000000000000000..6c7e8309084dc798fec05c60a6930931d9178fc3
--- /dev/null
+++ b/tools/mt6762/hardware/battery-soc/battery_soc.h
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: MIT
+ * Conditional UI estimate only. Never use as charger/protection input. */
+#ifndef MT6762_BATTERY_SOC_H
+#define MT6762_BATTERY_SOC_H
+#include <stddef.h>
+#include <stdint.h>
+#define BS_TABLES 6U
+#define BS_ROWS 74U
+#define BS_PROFILE_BYTES (BS_ROWS * 12U)
+#define BS_MODEL_CAPACITY_UAH INT64_C(2200000)
+#define BS_MAX_LEASE_US UINT64_C(2000000)
+#define BS_MAX_GAP_US UINT64_C(5000000)
+#define BS_MAX_CURRENT_UA 2000000
+/* Exact-stock0.1mAh output quantization; two endpoints can differ by one
+ * quantum each. This tolerance is arithmetic, not a physical accuracy bound. */
+#define BS_CAR_TOLERANCE_UAH INT64_C(200)
+enum bs_error { BS_OK=0, BS_PENDING=1, BS_ARGUMENT=-1, BS_PROFILE=-2,
+    BS_DISABLED=-3, BS_STALE=-4, BS_TIME=-5, BS_COUNTER=-6,
+    BS_JUMP=-7, BS_DIRECTION=-8, BS_RANGE=-9, BS_FAULT=-10 };
+enum bs_state_kind { BS_OFF, BS_WAIT_FIRST, BS_WAIT_SECOND, BS_TRACKING, BS_FAILED };
+enum bs_quality { BS_ESTIMATED=1, BS_TEMPERATURE_UNKNOWN=2,
+    BS_CONDITIONAL_IR_MODEL=4, BS_NONMONOTONIC_PROFILE=8,
+    BS_ENDPOINT_CAPACITY_MODEL=16, BS_NOT_PHYSICAL_CONFIDENCE_INTERVAL=32 };
+struct bs_blob { const unsigned char *bytes; size_t length; };
+struct bs_coefficients { uint32_t rfg_dt, car_tune_dt, meter_resistance_dt; };
+struct bs_row { uint32_t charge_0p1mah, voltage_0p1mv, resistance_0p1mohm; };
+/* Only bs_profile_init output may be supplied to other APIs; keep immutable
+ * afterwards. Marker is a programming invariant, NOT an authenticity token. */
+struct bs_profile {
+    uint32_t initialized;
+    struct bs_row rows[BS_TABLES][BS_ROWS];
+    uint32_t resistance_min_0p1mohm, resistance_max_0p1mohm;
+};
+struct bs_sample {
+    /* One immutable coherent observer snapshot: lease starts before any I/O.
+     * Times are monotonic microseconds; no time conversion inside this core. */
+    uint64_t acquired_us, expires_us, sequence, nter_ticks, generation;
+    int64_t charge_uah; /* arbitrary inherited origin; positive charge */
+    int32_t current_ua; /* positive charge */
+    uint32_t voltage_uv;
+    uint32_t valid; /* must equal7: fresh VBAT,current,CAR; no unknown bits */
+};
+struct bs_result {
+    uint32_t valid, quality;
+    uint32_t lower_bp, upper_bp; /* basis points:10000 means100%; no midpoint */
+    int64_t conditional_ocv_lower_uv, conditional_ocv_upper_uv;
+    uint64_t acquired_us, expires_us, ocv_acquired_us;
+};
+struct bs_state {
+    uint32_t phase; int32_t fault;
+    uint64_t last_now_us;
+    struct bs_sample previous;
+    int64_t seed_charge_uah;
+    uint32_t seed_lower_bp, seed_upper_bp;
+    struct bs_result last;
+};
+/* BE triples plus exact observed num=100/col=3 and temperatures. Hashes pin all
+ * six shipped payloads, including their anomalies; no profile data embedded. */
+int bs_profile_init(struct bs_profile *, const struct bs_blob[BS_TABLES],
+    const uint32_t declared_rows[BS_TABLES], const uint32_t columns[BS_TABLES],
+    const int32_t temperatures_c[BS_TABLES], const struct bs_coefficients *);
+/* Input voltage is a CONDITIONAL OCV interval; examines every segment in all
+ * six profiles, retaining ambiguities. No physical freshness/permission claim. */
+int bs_ocv_interval(const struct bs_profile *, int64_t lower_uv, int64_t upper_uv,
+    struct bs_result *);
+/* enabled must be1 and explicitly opts into endpoint/IR assumptions described
+ * in README. No automatic restart or reseeding after invalidation. */
+int bs_begin(struct bs_state *, unsigned enabled);
+int bs_update(struct bs_state *, const struct bs_profile *, const struct bs_sample *,
+    uint64_t now_us, struct bs_result *);
+/* Poll expiry even when acquisition stops. Expiry is terminal until explicit
+ * new bs_begin, so a stale cached percentage cannot quietly persist. */
+int bs_read(struct bs_state *, uint64_t now_us, struct bs_result *);
+#endif
diff --git a/tools/mt6762/hardware/battery-soc/profile_sha256.c b/tools/mt6762/hardware/battery-soc/profile_sha256.c
