diff --git a/tools/mt6762/physical/native_display.h b/tools/mt6762/physical/native_display.h
new file mode 100644
index 0000000000000000000000000000000000000000..066513b76e027c99c32e2cc54bc8d5cc296f8b45
--- /dev/null
+++ b/tools/mt6762/physical/native_display.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: MIT -- admission for the measured physical profile. */
+#ifndef MTK_NATIVE_DISPLAY_H
+#define MTK_NATIVE_DISPLAY_H
+#include "pwm_probe.h"
+
+static inline int native_display_admitted(uint64_t framebuffer,
+    const volatile struct display_probe_record *display,
+    const volatile struct pwm_probe_record *pwm)
+{
+    if (display->state != DISPLAY_ACCEPTED || display->state_inverse != ~(uint32_t)DISPLAY_ACCEPTED ||
+        display->pass != 2 || display->read_mask != 63 || display->sources != 3 ||
+        display->layer != 1 || display->tag_base != UINT64_C(0x7ef90000) ||
+        display->tag_size != 0x470000 || framebuffer != UINT64_C(0x7f0d4000) ||
+        display->datapath != UINT32_C(0x81000001) || display->sbch ||
+        pwm->state != PWM_COMPLETE || pwm->state_inverse != ~(uint32_t)PWM_COMPLETE || pwm->pass != 2)
+        return 0;
+    for (unsigned i = 0; i < 32; ++i)
+        if (display->identity[i] != pwm->identity[i]) return 0;
+    for (unsigned i = 0; i < 2; ++i) {
+        const volatile struct pwm_probe_snapshot *p = &pwm->snapshots[i];
+        struct mt6762_pwm_snapshot s = {p->top, p->infra, p->gpio, p->enable,
+            p->commit, p->con0, p->con1, p->debug};
+        if (p->mask != 23 || !mt6762_display_power(p->power[0],p->power[1],p->power[2]) ||
+            !mt6762_pwm_lk_configured(&s)) return 0;
+        if (i) {
+            const volatile struct pwm_probe_snapshot *first = &pwm->snapshots[0];
+            if (p->top != first->top || p->infra != first->infra || p->gpio != first->gpio ||
+                p->enable != first->enable || p->commit != first->commit || p->con0 != first->con0 ||
+                p->con1 != first->con1 || p->debug != first->debug) return 0;
+        }
+    }
+    return 1;
+}
+#endif
diff --git a/tools/mt6762/physical/native_storage.h b/tools/mt6762/physical/native_storage.h
new file mode 100644
index 0000000000000000000000000000000000000000..780709dbdbb5ac404f52ee6253a501568231992e
--- /dev/null
+++ b/tools/mt6762/physical/native_storage.h
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: MIT
+ * Read-only producer for the exact LK's completed synchronous eMMC handoff.
+ * No card command, controller write, pointer following or guessed tuning.
+ * The kernel must independently check rails and live CMD13/EXT_CSD before
+ * publishing its read-only disk. See audit_lk_msdc.py and capture19 evidence.
+ */
+#ifndef MT6762_NATIVE_STORAGE_H
+#define MT6762_NATIVE_STORAGE_H
+#include <stdint.h>
+#include "../../../bsd/dev/mt6762_msdc_clock.h"
+
+struct mt6762_storage_profile {
+    uint32_t sectors,ocr,rca,cfg,sdc_cfg,pad_drive,hclk_hz,card_clock_hz;
+    uint32_t pll[6],top_tune[12],controller_tune[18];
+};
+_Static_assert(sizeof(struct mt6762_storage_profile)==44*4,"storage profile layout");
+typedef uint32_t (*mt6762_storage_read)(void *,uint32_t);
+
+static inline int mt6762_storage_snapshot(mt6762_storage_read read,void *ctx,
+    struct mt6762_storage_profile *p)
+{
+#define R(a) read(ctx,(a))
+    /* Clock-gated register reads are forbidden until both parents/gates pass. */
+    uint32_t top=R(0x10000070),parent,hclk;
+    if((top&0x8783)!=0x101 || (R(0x10001094)&4) || (R(0x100010c8)&0x200))return 0;
