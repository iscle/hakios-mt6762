+        memory = next(n for n in chosen['children'] if n['name'] == b'memory-map\0')
+        self.assertEqual(memory['RAMDisk'], struct.pack('<QQ', 0x45000000, 0x2000000))
+        self.assertEqual(memory['RAMDisk1'], struct.pack('<QQ', 0x49000000, 0x4000000))
