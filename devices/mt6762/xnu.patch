+    def test_boot_abi(self):
+        self.assertEqual(ctypes.sizeof(BootArgs), 736)
+        args = BootArgs.from_buffer_copy(p.boot_args(0x44000000, 12345, 0x44008000, 'cpus=1'))
+        self.assertEqual(args.deviceTreeP, p.VIRT + 0x4000000)
