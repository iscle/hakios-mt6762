diff --git a/tools/mt6762/hardware/power/power_protocol.c b/tools/mt6762/hardware/power/power_protocol.c
new file mode 100644
index 0000000000000000000000000000000000000000..4a81e0109d459cee933b93983889508ae44eb709
--- /dev/null
+++ b/tools/mt6762/hardware/power/power_protocol.c
@@ -0,0 +1,76 @@
+#include "power_protocol.h"
+#define PSC_ADDRESS 0x6a
+int psc5425e_read(const struct power_i2c *bus, uint8_t reg, uint8_t *out)
+{
+    uint8_t value=0;
+    struct power_i2c_msg msg[2]={{PSC_ADDRESS,0,1,&reg},{PSC_ADDRESS,1,1,&value}};
+    if (!bus || !bus->transfer || !out || reg>6) return POWER_INVALID;
+    if (bus->transfer(bus->ctx,msg,2)!=2) return POWER_IO;
+    *out=value;
+    return POWER_OK;
+}
+int psc5425e_snapshot(const struct power_i2c *bus, struct psc5425e_snapshot *out)
+{
+    struct psc5425e_snapshot s={0};
+    int e;
+    if (!out) return POWER_INVALID;
+    if ((e=psc5425e_read(bus,3,&s.identity))) return e;
+    if (s.identity!=0xf0) return POWER_ID_MISMATCH;
+    if ((e=psc5425e_read(bus,0,&s.status)) ||
+        (e=psc5425e_read(bus,1,&s.control)) ||
+        (e=psc5425e_read(bus,2,&s.voltage)) ||
+        (e=psc5425e_read(bus,4,&s.current))) return e;
+    s.status_code=(s.status>>4)&3;
+    s.done=s.status_code==2;
+    s.charge_disabled=(s.control>>2)&1;
+    *out=s;
+    return POWER_OK;
+}
+int psc5425e_disable_charge(const struct power_i2c *bus)
+{
+    uint8_t id,reg,check,bytes[2];
+    struct power_i2c_msg msg={PSC_ADDRESS,0,2,bytes};
+    int e;
+    if ((e=psc5425e_read(bus,3,&id))) return e;
+    if (id!=0xf0) return POWER_ID_MISMATCH;
+    if ((e=psc5425e_read(bus,1,&reg))) return e;
+    if (!(reg&4)) {
+        bytes[0]=1; bytes[1]=reg|4;
+        if (bus->transfer(bus->ctx,&msg,1)!=1) return POWER_IO;
+    }
+    if ((e=psc5425e_read(bus,1,&check))) return e;
+    return (check&4) ? POWER_OK : POWER_IO;
+}
+static int pwrap_wait(const struct power_mmio *m, unsigned state, unsigned polls, uint32_t *v)
+{
+    while (polls--) {
+        if (m->read32(m->ctx,0xc24,v)) return POWER_IO;
+        if (!(*v&(1u<<21))) return POWER_NOT_READY;
+        if (((*v>>16)&7)==state) return POWER_OK;
+    }
+    return POWER_TIMEOUT;
+}
+int mt6765_pwrap_read16(const struct power_mmio *m, uint16_t address,
+                       uint16_t *out, unsigned max_polls)
+{
+    uint32_t v;
+    int e;
+    if (!m || !m->read32 || !m->write32 || !out || (address&1) || !max_polls)
+        return POWER_INVALID;
+    if ((e=pwrap_wait(m,0,max_polls,&v))) return e;
+    if (m->write32(m->ctx,0xc20,((uint32_t)address>>1)<<16)) return POWER_IO;
+    if ((e=pwrap_wait(m,6,max_polls,&v))) return e;
+    if (m->write32(m->ctx,0xc28,1)) return POWER_IO;
+    *out=(uint16_t)v;
+    return POWER_OK;
+}
+struct mt6357_keys mt6357_decode_topstatus(uint16_t raw)
+{
+    struct mt6357_keys k={!(raw&2),!(raw&8),!!(raw&4)};
+    return k;
+}
+int mt6765_key_pressed(const uint16_t state[5], unsigned index)
+{
+    if (!state || index>=72) return POWER_INVALID;
+    return !(state[index/16]&(1u<<(index%16)));
+}
diff --git a/tools/mt6762/hardware/power/power_protocol.h b/tools/mt6762/hardware/power/power_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..249e037ffe74b00cf95bbbb88e320d407875c0e7
--- /dev/null
+++ b/tools/mt6762/hardware/power/power_protocol.h
@@ -0,0 +1,29 @@
+/* Local research backend. See README.rst for evidence and unimplemented policy. */
+#ifndef MT6762_POWER_PROTOCOL_H
+#define MT6762_POWER_PROTOCOL_H
+#include <stddef.h>
+#include <stdint.h>
+enum { POWER_OK=0, POWER_IO=-1, POWER_INVALID=-2, POWER_TIMEOUT=-3,
+       POWER_NOT_READY=-4, POWER_ID_MISMATCH=-5 };
+struct power_i2c_msg { uint8_t address, read; uint16_t length; uint8_t *data; };
+/* Return exactly nmsgs on success; preserve repeated START between messages.
+ * Caller serializes the whole public operation, including read/modify/write. */
+struct power_i2c { void *ctx; int (*transfer)(void *, struct power_i2c_msg *, size_t); };
+struct psc5425e_snapshot { uint8_t identity, status, control, voltage, current;
+                         uint8_t status_code, charge_disabled, done; };
+int psc5425e_read(const struct power_i2c *, uint8_t reg, uint8_t *out);
+int psc5425e_snapshot(const struct power_i2c *, struct psc5425e_snapshot *out);
+/* Only disable is exposed. No guessed battery limits, enable or OTG writes. */
+int psc5425e_disable_charge(const struct power_i2c *);
+struct power_mmio { void *ctx; int (*read32)(void *, uint32_t, uint32_t *);
+                    int (*write32)(void *, uint32_t, uint32_t); };
+/* Offsets relative to 0x1000d000. Requires bootloader-initialized wrapper,
+ * exclusive WACS2 ownership and ordered MMIO. max_polls is a hard bound. */
+int mt6765_pwrap_read16(const struct power_mmio *, uint16_t address,
+                       uint16_t *out, unsigned max_polls);
+/* PMIC TOPSTATUS 0x24 fields from BSP register definitions, active low keys. */
+struct mt6357_keys { uint8_t power, home, charger_present; };
+struct mt6357_keys mt6357_decode_topstatus(uint16_t raw);
+/* Matrix index, not physical button identity. Reads KP_MEM1..5 as 16-bit. */
+int mt6765_key_pressed(const uint16_t state[5], unsigned index);
+#endif
