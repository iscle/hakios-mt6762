index 0000000000000000000000000000000000000000..fd30272233f3a1c5d7900b4ae93d58d2b7e87bb0
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity-rom/sha256.c
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: MIT
+ * SHA-256, FIPS 180-4 equations. Original freestanding implementation.
+ * Caller limits message length; no allocation, libc, IO or authentication.
+ */
+#include "sha256.h"
+static uint32_t ror(uint32_t x, unsigned n) { return (x>>n)|(x<<(32-n)); }
+static void transform(struct cr_sha256 *s, const uint8_t *b)
+{
+    static const uint32_t k[64]={
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+    uint32_t w[64],a,c,d,e,f,g,h,z,t1,t2; unsigned i;
+    for(i=0;i<16;i++) w[i]=(uint32_t)b[4*i]<<24|(uint32_t)b[4*i+1]<<16|(uint32_t)b[4*i+2]<<8|b[4*i+3];
+    for(i=16;i<64;i++) w[i]=w[i-16]+(ror(w[i-15],7)^ror(w[i-15],18)^(w[i-15]>>3))+
+        w[i-7]+(ror(w[i-2],17)^ror(w[i-2],19)^(w[i-2]>>10));
+    a=s->state[0];z=s->state[1];c=s->state[2];d=s->state[3];
+    e=s->state[4];f=s->state[5];g=s->state[6];h=s->state[7];
+    for(i=0;i<64;i++) {
+        t1=h+(ror(e,6)^ror(e,11)^ror(e,25))+((e&f)^(~e&g))+k[i]+w[i];
+        t2=(ror(a,2)^ror(a,13)^ror(a,22))+((a&z)^(a&c)^(z&c));
+        h=g;g=f;f=e;e=d+t1;d=c;c=z;z=a;a=t1+t2;
+    }
+    s->state[0]+=a;s->state[1]+=z;s->state[2]+=c;s->state[3]+=d;
+    s->state[4]+=e;s->state[5]+=f;s->state[6]+=g;s->state[7]+=h;
+}
+void cr_sha256_init(struct cr_sha256 *s)
+{
+    static const uint32_t initial[8]={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
+    unsigned i;for(i=0;i<8;i++)s->state[i]=initial[i];s->bytes=0;s->used=0;
+}
+void cr_sha256_update(struct cr_sha256 *s,const uint8_t *p,size_t n)
+{
+    size_t i,t;s->bytes+=n;
+    while(n) {
+        t=64-s->used;if(t>n)t=n;
+        for(i=0;i<t;i++)s->block[s->used+i]=p[i];
+        s->used+=t;p+=t;n-=t;
+        if(s->used==64){transform(s,s->block);s->used=0;}
+    }
+}
+void cr_sha256_final(struct cr_sha256 *s,uint8_t digest[32])
+{
+    uint64_t bits=s->bytes*8;unsigned i;
+    s->block[s->used++]=0x80;
+    if(s->used>56){while(s->used<64)s->block[s->used++]=0;transform(s,s->block);s->used=0;}
+    while(s->used<56)s->block[s->used++]=0;
+    for(i=0;i<8;i++)s->block[63-i]=(uint8_t)(bits>>(8*i));
+    transform(s,s->block);
+    for(i=0;i<32;i++)digest[i]=(uint8_t)(s->state[i/4]>>(24-8*(i%4)));
+}
