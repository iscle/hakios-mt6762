diff --git a/tools/mt6762/hardware/cpu-power/test_sspm_observation.py b/tools/mt6762/hardware/cpu-power/test_sspm_observation.py
new file mode 100644
index 0000000000000000000000000000000000000000..e017ba0a1d71f77229299cd37cbb1ddb134b35d9
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/test_sspm_observation.py
@@ -0,0 +1,89 @@
+import copy
+import json
+from pathlib import Path
+import unittest
+from decode_sspm_observation import GROUPS, GUARDS, decode
+
+
+def fixture():
+    sample = {name: [0]*count for name, (count, _) in GROUPS.items()}
+    sample['guards'] = GUARDS[:]
+    rows = json.loads((Path(__file__).parent / 'evidence/stock-c62-pvt.json').read_text())['rows']
+    for domain in range(3):
+        for i, (mhz, selector, post, clk) in enumerate(rows[domain*16:(domain+1)*16]):
+            sample['pvt'][domain*36+i] = mhz | (selector << 16)
+            sample['pvt'][domain*36+16+i] = post | (clk << 16)
+        sample['pvt'][domain*36+32] = 0xffffffff
+    sample['mailbox'][:2] = [0x80000003, 0x40000003]
+    sample['irq'] = [1 << 13, 1 << 13]
+    return sample
+
+
+def record(samples, stable=511, guards=1, c62=1):
+    lines = [f'MT6762_SSPM_OBSERVE version=1 passes=2 words=174 stable_groups={stable:03x} '
+             f'guards={guards} c62_representation={c62} ownership=0 liveness=unknown']
+    for p, sample in enumerate(samples):
+        for name, words in sample.items():
+            for i in range(0, len(words), 4):
+                chunk = words[i:i+4]
+                fields = ' '.join(f'{v:08x}' for v in chunk+[0]*(4-len(chunk)))
+                lines.append(f'MT6762_SSPM_RAW pass={p} group={name} word={i} count={len(chunk)} {fields}')
+    lines.append('MT6762_SSPM_OBSERVE end=1 writes=0')
+    return ('\n'.join(lines)+'\n').encode()
+
+
+class TestObservation(unittest.TestCase):
+    def test_c62_is_not_ready(self):
+        sample = fixture()
+        sample['eem'][0] = 1
+        sample['index'][0] = 0xffffffff
+        result = decode(record([sample]))
+        self.assertTrue(result['c62_representation_match'])
+        self.assertFalse(result['controller_ready'])
+        self.assertFalse(result['ownership_granted'])
+        self.assertFalse(result['interpretation'][0]['eem_flags_clear'])
+        self.assertFalse(result['interpretation'][0]['current_indices_in_range'])
+        self.assertEqual(result['interpretation'][0]['pending_platform_cpu_out'], 3)
+        self.assertTrue(result['interpretation'][0]['mailbox0_irq_active'])
+
+    def test_zero_is_not_initialized(self):
+        zero = {name: [0]*count for name, (count, _) in GROUPS.items()}
+        self.assertFalse(decode(record([zero], guards=0, c62=0))['c62_representation_match'])
+
+    def test_unstable_retained(self):
+        first = fixture()
+        second = copy.deepcopy(first)
+        second['pvt'][17] ^= 1
+        result = decode(record([first, second], stable=511^2, c62=0))
+        self.assertFalse(result['matching_second_raw_pass_omitted'])
+        self.assertEqual(result['samples'][1]['pvt'][17], second['pvt'][17])
+
+    def test_incomplete_and_duplicates(self):
+        lines = record([fixture()]).splitlines(keepends=True)
+        for blob in (b''.join(lines[:-1]), b''.join(lines[:2]+lines[3:]),
+                     b''.join(lines[:2]+lines[1:]), b''.join(lines+lines)):
+            with self.assertRaises(ValueError):
+                decode(blob)
+
+    def test_report_disagrees_with_raw(self):
+        first = fixture()
+        second = copy.deepcopy(first)
+        second['index'][0] = 7
+        with self.assertRaises(ValueError):
+            decode(record([first, second], stable=511^1, guards=0, c62=0))
+        first['pvt'][0] ^= 1
+        with self.assertRaises(ValueError):
+            decode(record([first]))
+
+    def test_bounds_and_padding(self):
+        good = record([fixture()])
+        for old, new in [(b'word=0 count=4', b'word=999 count=4'),
+                         (b'group=eem', b'group=unknown'),
+                         (b'word=4 count=1 55aa55aa 00000000', b'word=4 count=1 55aa55aa 00000001'),
+                         (b'stable_groups=1ff', b'stable_groups=fff')]:
+            with self.assertRaises(ValueError):
+                decode(good.replace(old, new, 1))
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tools/mt6762/hardware/cpu-power/test_sspm_observer.c b/tools/mt6762/hardware/cpu-power/test_sspm_observer.c
new file mode 100644
index 0000000000000000000000000000000000000000..54faee0b4fd3ae8c0e8a48465485dfaea011f361
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/test_sspm_observer.c
@@ -0,0 +1,114 @@
+#include <assert.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include "mt6762_sspm_observer.h"
+#include "pvt_fixture.h"
+
+struct fixture {
+    uint32_t sram[0x500/4],data[7],ctrl[2],gic[0x400/4];
+    unsigned reads,fail_at,change_at,regions[MT6762_OBS_WORDS],offsets[MT6762_OBS_WORDS];
+};
+static int read_word(void *context,unsigned region,uint32_t offset,uint32_t *out)
+{
+    struct fixture *f=context;
+    uint32_t *bank;
+    assert(mt6762_sspm_observer_address(region,offset));
+    unsigned n=++f->reads;
+    if(n<=MT6762_OBS_WORDS) {f->regions[n-1]=region;f->offsets[n-1]=offset;}
+    if(n==f->fail_at)return -1;
+    switch(region) {
+    case MT6762_OBS_CSRAM:bank=f->sram;break;
+    case MT6762_OBS_DATA:bank=f->data;break;
+    case MT6762_OBS_CTRL:bank=f->ctrl;break;
+    case MT6762_OBS_GIC:bank=f->gic;break;
+    default:assert(0);return -1;
+    }
+    *out=bank[offset/4]^(n==f->change_at?1u:0u);return 0;
+}
+static void init(struct fixture *f)
+{
+    memset(f,0,sizeof(*f));
+    f->sram[0]=f->sram[2]=f->sram[0x2a0/4]=0x55aa55aa;
+    f->sram[1]=f->sram[3]=0xaa55aa55;
+    memcpy(f->sram+4,pvt_fixture,sizeof(pvt_fixture));
+    f->sram[0x320/4]=f->sram[0x324/4]=15;
+    f->sram[0x354/4]=10;f->sram[0x358/4]=15;f->sram[0x35c/4]=10;
+    f->sram[0x3a4/4]=0xffa; /* Submitted vote, no inferred ACK. */
+    f->ctrl[0]=0x80000003;f->ctrl[1]=0x40000003; /* Pending traffic retained. */
+    f->gic[0x11c/4]=f->gic[0x31c/4]=1u<<13; /* Enabled/active is observable. */
+    for(unsigned i=0;i<7;i++)f->data[i]=0x12340000+i;
+}
+static unsigned group(unsigned region,unsigned offset)
+{
+    if(region==MT6762_OBS_GIC)return MT6762_OBS_IRQ;
+    if(region!=MT6762_OBS_CSRAM)return MT6762_OBS_MAILBOX;
+    if(offset<16 || offset==0x2a0)return MT6762_OBS_GUARDS;
+    if(offset<0x250)return MT6762_OBS_PVT;
+    if(offset<0x310)return MT6762_OBS_EEM;
+    if(offset<0x32c)return MT6762_OBS_PPM;
+    if(offset<0x354)return MT6762_OBS_VOLT;
+    if(offset<0x3a4)return MT6762_OBS_INDEX;
+    return MT6762_OBS_VOTE;
+}
+int main(void)
+{
+    struct fixture f,original;
+    struct mt6762_sspm_observation_pair p,unchanged;
+    _Static_assert(sizeof(p.sample[0])==MT6762_OBS_WORDS*4,"unexpected snapshot padding");
+    init(&f);original=f;
+    assert(!mt6762_sspm_observe_pair(read_word,&f,&p));
+    assert(f.reads==2*MT6762_OBS_WORDS && p.stable_groups==MT6762_OBS_ALL);
+    assert(mt6762_sspm_observer_guards(&p) && mt6762_sspm_observer_c62(&p));
+    assert(!memcmp(&f,&original,offsetof(struct fixture,reads)));
+    assert(p.sample[0].mailbox[0]==0x80000003 && p.sample[0].mailbox[1]==0x40000003);
+    assert(p.sample[0].irq[0]==(1u<<13) && p.sample[0].irq[1]==(1u<<13));
+    /* Exact whitelist: every permitted word is read once per pass; no status
+     * acknowledgement, reset, command, arbitrary pointer or ring traversal. */
+    unsigned allowed=0;
+    for(unsigned region=0;region<4;region++)for(unsigned offset=0;offset<0x1400;offset++) {
+        if(!mt6762_sspm_observer_address(region,offset))continue;
+        unsigned found=0;allowed++;
+        for(unsigned i=0;i<MT6762_OBS_WORDS;i++)
+            found+=f.regions[i]==region && f.offsets[i]==offset;
+        assert(found==1);
+    }
+    assert(allowed==MT6762_OBS_WORDS);
+    assert(!mt6762_sspm_observer_address(4,0));
+    assert(!mt6762_sspm_observer_address(0,0xfffffffc));
+    /* Every read can fail, including the final read of pass2; no partial or
+     * previous validity may replace the caller's output. */
+    memset(&unchanged,0xa5,sizeof(unchanged));
+    for(unsigned fail=1;fail<=2*MT6762_OBS_WORDS;fail++) {
+        init(&f);f.fail_at=fail;p=unchanged;
+        assert(mt6762_sspm_observe_pair(read_word,&f,&p)==-1);
+        assert(f.reads==fail && !memcmp(&p,&unchanged,sizeof(p)));
+    }
+    /* Change each captured word in pass2: exactly its group loses stability.
+     * This also covers changes confined to a table tail or unrelated IRQ bit. */
+    for(unsigned word=0;word<MT6762_OBS_WORDS;word++) {
+        init(&f);f.change_at=MT6762_OBS_WORDS+word+1;
+        assert(!mt6762_sspm_observe_pair(read_word,&f,&p));
+        unsigned expected=MT6762_OBS_ALL^group(f.regions[word],f.offsets[word]);
+        assert(p.stable_groups==expected && f.reads==2*MT6762_OBS_WORDS);
+    }
+    memset(&f,0,sizeof(f));
+    assert(!mt6762_sspm_observe_pair(read_word,&f,&p));
+    assert(p.stable_groups==MT6762_OBS_ALL);
+    assert(!mt6762_sspm_observer_guards(&p) && !mt6762_sspm_observer_c62(&p));
+    init(&f);f.sram[4]^=1;
+    assert(!mt6762_sspm_observe_pair(read_word,&f,&p));
+    assert(mt6762_sspm_observer_guards(&p) && !mt6762_sspm_observer_c62(&p));
+    /* Valid representation can coexist with pending EEM, invalid indices and
+     * active IRQ/traffic. It must not be presented as firmware readiness. */
+    init(&f);f.sram[0x300/4]=1;f.sram[0x354/4]=0xffffffff;
+    assert(!mt6762_sspm_observe_pair(read_word,&f,&p));
+    assert(mt6762_sspm_observer_c62(&p) && p.sample[0].eem[0]==1);
+    assert(p.sample[0].index[0]==0xffffffff && p.sample[0].mailbox[0]==0x80000003);
+    p=unchanged;f.reads=0;
+    assert(mt6762_sspm_observe_pair(NULL,&f,&p)==-1 && !f.reads);
+    assert(!memcmp(&p,&unchanged,sizeof(p)));
+    assert(mt6762_sspm_observe_pair(read_word,&f,NULL)==-1 && !f.reads);
+    puts("SSPM passive observer: 174-address whitelist, 348 injected read failures, 174 changing-word pairs, no writes: PASS");
+    return 0;
+}
diff --git a/tools/mt6762/hardware/cpu-power/test_thermal_observer.c b/tools/mt6762/hardware/cpu-power/test_thermal_observer.c
new file mode 100644
index 0000000000000000000000000000000000000000..ee48578e52ec1a14736db697b9d0fdd7ca0830c8
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/test_thermal_observer.c
@@ -0,0 +1,92 @@
+/* Compile the native consumer, controlling only its clock and hardware I/O. */
+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define MT6762_THERMAL_HOST_TEST 1
+#define NSEC_PER_MSEC 1000000
+#define LCK_GRP_DECLARE(name,label) int name __attribute__((unused))
+#define LCK_MTX_DECLARE(name,group) int name
+static uint64_t now,read_delay,conversion_delay,lock_wait,interval_delay,duration;
+static unsigned reads,conversions,fail_read,fail_conversion;
+static const uint16_t pmic_words[]={0x137,1588,0,0,1526,1534};
+static const uint32_t cpu_words[]={0x0299546b,0x9d9d514c,0xa5d36940};
+static void lck_mtx_lock(int *lock)
+{assert(!*lock);*lock=1;now+=lock_wait;lock_wait=0;}
+static void lck_mtx_unlock(int *lock){assert(*lock);*lock=0;}
+static void clock_get_uptime(uint64_t *value){*value=now;}
+static void clock_interval_to_absolutetime_interval(unsigned ms,unsigned scale,uint64_t *value)
+{assert(ms==2000 && scale==NSEC_PER_MSEC);now+=interval_delay;*value=duration;}
+static int mt6762_pwrap_read16(uint16_t reg,uint16_t *value)
+{
+    reads++;now+=read_delay;
+    if(reads==fail_read)return -EIO;
+    if(reg==8)*value=0x5730;
+    else {assert(reg>=0x11ae && reg<=0x11b8 && !(reg&1));*value=pmic_words[(reg-0x11ae)/2];}
+    return 0;
+}
+static int mt6762_pmic_thermal_sample(unsigned sensor,uint16_t *value)
+{
+    assert(sensor<3);conversions++;now+=conversion_delay;
+    if(conversions==fail_conversion)return -EIO;
+    *value=pmic_words[sensor? sensor+3:1];return 0;
+}
+static uint32_t reg32(uintptr_t base,unsigned offset)
+{
+    reads++;now+=read_delay;
+    if(base==2){assert(offset<=8 && !(offset&3));return cpu_words[offset/4];}
+    assert(base==1);
+    if(offset==0)return 7;
+    if(offset==0x100)return 3;
+    if(offset==0x3c || offset==0x13c)return 0;
+    assert(offset==0x90 || offset==0x94 || offset==0x98 || offset==0x190 || offset==0x194);
+    return 3682;
+}
+#include "../../../../bsd/dev/mt6762_thermal.c"
+static void reset(void)
+{
+    now=100;read_delay=conversion_delay=lock_wait=interval_delay=0;duration=2000;
+    reads=conversions=fail_read=fail_conversion=0;errors=samples=observed_mask=0;
+    controller=1;efuse=2;
+    memset(acquisitions,0,sizeof(acquisitions));memset(deadlines,0,sizeof(deadlines));
+}
+static void rejected(unsigned sensor)
+{
+    int value=12345;
+    assert(mt6762_pmic_temperature_read(sensor,&value)==-ENXIO && value==12345);
+}
+int main(void)
+{
+    reset();sample_pmic();sample_cpu();assert(valid_mask(now)==255);
+    int value=0;assert(!mt6762_pmic_temperature_read(0,&value) && value==27500);
+    now=2099;assert(valid_mask(now)==255);now=2100;assert(valid_mask(now)==0);rejected(0);
+    /* Calibration latency counts, even if the eventual conversion succeeds. */
+    reset();read_delay=160;sample_pmic();assert(!valid_mask(now) && !samples && errors==3);
+    /* Each later sensor shares the calibration's acquisition start. */
+    reset();conversion_delay=700;sample_pmic();assert(samples==2 && errors==1);
+    assert(deadlines[0]==2100 && deadlines[1]==2100 && !deadlines[2]);
+    assert(!valid_mask(now));rejected(0);rejected(2);
+    /* Preemption during interval conversion cannot renew the lease. */
+    reset();interval_delay=3000;sample_pmic();assert(!samples && errors==3);rejected(0);
+    reset();interval_delay=100;sample_pmic();assert(samples==3 && deadlines[0]==2100);
+    /* Contention after acquisition must be included at publication and read. */
+    reset();lock_wait=2000;sample_pmic();assert(!samples && errors==3);rejected(0);
+    reset();sample_pmic();lock_wait=2000;rejected(0);
+    /* Reject arithmetic overflow/zero duration without touching hardware. */
+    reset();now=UINT64_MAX-10;sample_pmic();assert(!reads && !conversions && !samples);
+    reset();duration=0;sample_cpu();assert(!reads && !samples && errors==5);
+    /* Clock regression cannot resurrect a value predating acquisition. */
+    reset();sample_pmic();now=99;assert(!valid_mask(now));rejected(0);
+    /* A failed replacement invalidates its previous value, independent of age. */
+    reset();sample_pmic();fail_conversion=4;sample_pmic();rejected(0);
+    assert(valid_mask(now)==6);
+    reset();sample_pmic();fail_read=reads+1;sample_pmic();assert(!valid_mask(now));
+    /* CPU observations retain the same bounded cache age, without asserting
+     * that the hardware performed a new sensor conversion. */
+    reset();read_delay=100;sample_cpu();assert(samples==4 && errors==1);
+    assert(!valid_mask(now));
+    assert(mt6762_pmic_temperature_read(3,&value)==-EINVAL);
+    assert(mt6762_pmic_temperature_read(0,NULL)==-EINVAL);
+    puts("native thermal consumer acquisition/expiry/failure tests: PASS");
+}
