diff --git a/tools/mt6762/hardware/display-touch/apple_backlight_core.h b/tools/mt6762/hardware/display-touch/apple_backlight_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..59847bed61ecf2205763b5888d59ee8a2d105afc
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/apple_backlight_core.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: MIT
+ * CoreBrightness20F66 legacy property ABI: integer brightness and signed
+ * nonnegative16.16 seconds FadePeriod. No floating-point operations in kernel.
+ * Float brightness is converted by Apple's code before the registry call.
+ */
+#ifndef MT6762_APPLE_BACKLIGHT_CORE_H
+#define MT6762_APPLE_BACKLIGHT_CORE_H
+#include <stdint.h>
+/* OSNumber reserves sizes31 and63 for floating payloads. Its integer getters
+ * numerically truncate those payloads, so validate the type before conversion.
+ * This is a type predicate, not a test of whether a float happens to be whole. */
+static inline int mt6762_backlight_integer_type(unsigned number_bits)
+{
+    return number_bits > 0 && number_bits <= 64 && number_bits != 31 && number_bits != 63;
+}
+enum { MT6762_BACKLIGHT_ACTIVE, MT6762_BACKLIGHT_BLANKED, MT6762_BACKLIGHT_STOPPED };
+struct mt6762_backlight_lifecycle {
+    unsigned mode, desired;
+    uint64_t fade_us;
+};
+/* A blanked request is deferred, never a confirmed hardware measurement. */
+static inline int mt6762_backlight_desire(struct mt6762_backlight_lifecycle *s,
+    unsigned level, uint64_t fade_us)
+{
+    if (s->mode == MT6762_BACKLIGHT_STOPPED || level > 1023) return -1;
+    s->desired = level;
+    s->fade_us = fade_us;
+    return s->mode == MT6762_BACKLIGHT_BLANKED ? 1 : 0;
+}
+/* Call only after the zero-level PWM write/readback succeeds. Repeated off
+ * must not replace a target that CoreBrightness queued while already blank. */
+static inline void mt6762_backlight_blank_confirmed(struct mt6762_backlight_lifecycle *s,
+    unsigned previous_confirmed)
+{
+    if (s->mode != MT6762_BACKLIGHT_ACTIVE) return;
+    s->desired = previous_confirmed;
+    s->fade_us = 0;
+    s->mode = MT6762_BACKLIGHT_BLANKED;
+}
+static inline int mt6762_backlight_request(uint64_t brightness, uint64_t fade_fixed,
+    uint64_t *duration_us)
+{
+    if (!duration_us || brightness > 1023 || fade_fixed > INT32_MAX) return -1;
+    *duration_us = (fade_fixed * UINT64_C(1000000)) >> 16;
+    return 0;
+}
+static inline unsigned mt6762_backlight_step(unsigned from, unsigned to,
+    uint64_t elapsed_us, uint64_t duration_us)
+{
+    if (!duration_us || elapsed_us >= duration_us) return to;
+    if (to >= from) return from + (unsigned)((to - from) * elapsed_us / duration_us);
+    return from - (unsigned)((from - to) * elapsed_us / duration_us);
+}
+#endif
diff --git a/tools/mt6762/hardware/display-touch/axs15260_panel.h b/tools/mt6762/hardware/display-touch/axs15260_panel.h
new file mode 100644
index 0000000000000000000000000000000000000000..c40bd8aa76db5642f38a55d8ed852b40c97c04ee
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/axs15260_panel.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: MIT
+ * Panel command sequence reconstructed from this phone's stock kernel.
+ * Stock init table VA 0xffffff800983e9f8; push_table 0xffffff8008747b30.
+ * The caller must establish and validate MT6762 DSI, clocks, pins and power.
+ * This file does not itself establish a working scanout path.
+ */
+#ifndef MT6762_AXS15260_PANEL_H
+#define MT6762_AXS15260_PANEL_H
+#include <stddef.h>
+#include <stdint.h>
+struct axs15260_command {
+    uint16_t command; /* 0xffe means millisecond delay */
+    uint8_t count;
+    uint8_t data[11];
+};
+static const struct axs15260_command axs15260_init_commands[] = {
+    {0xbb,8,{0,0,0,0,0,0,0x5a,0xa5}},
+    {0xb2,11,{0x01,0,0,0x06,0,0x0a,0x04,0x21,0x9c,0,0x1e}},
+    {0xb2,1,{0x41}},
+    {0x11,1,{0}}, {0xffe,120,{0}},
+    {0x29,1,{0}}, {0xffe,10,{0}},
+};
+static const struct axs15260_command axs15260_suspend_commands[] = {
+    {0x28,1,{0}}, {0xffe,120,{0}},
+    {0x10,1,{0}}, {0xffe,30,{0}},
+};
+/* Stock selects this branch only after proximity-preserved suspend SKIPPED
+ * the sleep commands and bias shutdown. It is not evidence of a safe wake
+ * after the suspend table alone while retaining bias. Normal resume reinitializes
+ * bias, touch/panel reset and the full vendor table; see panel-lifecycle-audit.json. */
+static const struct axs15260_command axs15260_proximity_resume_commands[] = {
+    {0x11,1,{0}}, {0xffe,150,{0}},
+    {0x29,1,{0}}, {0xffe,20,{0}},
+};
+struct axs15260_transport {
+    void *context;
+    int (*dcs_write)(void *, uint8_t, const uint8_t *, size_t);
+    void (*delay_ms)(void *, unsigned);
+};
+static inline int axs15260_send_sequence(const struct axs15260_transport *io,
+    const struct axs15260_command *commands, size_t count)
+{
+    if (!io || !io->dcs_write || !io->delay_ms || !commands) return -1;
+    for (size_t i = 0; i < count; ++i) {
+        const struct axs15260_command *c = &commands[i];
+        if (c->command == 0xffe) io->delay_ms(io->context, c->count);
+        else {
+            if (c->command > 255 || c->count > sizeof c->data) return -1;
+            int result = io->dcs_write(io->context, (uint8_t)c->command, c->data, c->count);
+            if (result) return result;
+        }
+    }
+    return 0;
+}
+#endif
diff --git a/tools/mt6762/hardware/display-touch/axs_touch.h b/tools/mt6762/hardware/display-touch/axs_touch.h
new file mode 100644
index 0000000000000000000000000000000000000000..5e8070226954c1277d07555cef2c26a2dca3ad5a
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/axs_touch.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: MIT
+ * Independently reconstructed from the supplied stock AXS driver.
+ * Evidence: axs_ts_interrupt 0xffffff8008a26b50, packet decode +0x264.
+ * This is a packet decoder, not a complete device or IOHID driver.
+ */
+#ifndef MT6762_AXS_TOUCH_H
+#define MT6762_AXS_TOUCH_H
+#include <stddef.h>
+#include <stdint.h>
+
+#define AXS_TOUCH_ADDRESS 0x3b
+#define AXS_TOUCH_PACKET_BYTES 32
+#define AXS_TOUCH_MAX_CONTACTS 5
+struct axs_contact {
+    uint16_t x, y;
+    uint8_t id, event, pressure, area;
+};
+struct axs_frame {
+    uint8_t count;
+    uint8_t active_mask;
+    struct axs_contact contacts[AXS_TOUCH_MAX_CONTACTS];
+};
+/* 1 valid touch frame, 0 non-touch/status frame, -1 invalid argument/header.
+ * Zero-contact valid frames release all contacts. For non-touch/errors retain
+ * previous state until the caller's independent timeout/reset policy fires.
+ * Coordinates are raw; caller validates/transforms against the actual panel.
+ */
+static inline int
+axs_touch_decode(const uint8_t *p, size_t n, struct axs_frame *out)
+{
+    struct axs_frame f = {0};
+    if (!p || !out || n != AXS_TOUCH_PACKET_BYTES) return -1;
+    if (p[0] != 0) return 0;
+    if (p[1] & 0xf0) return -1;
+    unsigned count = p[1] & 15;
+    if (count > AXS_TOUCH_MAX_CONTACTS) count = AXS_TOUCH_MAX_CONTACTS;
+    for (unsigned i = 0; i < count; ++i) {
+        const uint8_t *r = p + 2 + 6*i;
+        unsigned id = r[2] >> 4;
+        if (id >= AXS_TOUCH_MAX_CONTACTS) break;
+        struct axs_contact *c = &f.contacts[f.count++];
+        c->x = (uint16_t)(((r[0] & 15) << 8) | r[1]);
+        c->y = (uint16_t)(((r[2] & 15) << 8) | r[3]);
+        c->event = r[0] >> 6;
+        c->id = (uint8_t)id;
+        c->pressure = r[4];
+        c->area = r[5] >> 4;
+        if (c->event == 0 || c->event == 2) {
+            if (!c->pressure) c->pressure = 63;
+            if (!c->area) c->area = 9;
+            f.active_mask |= (uint8_t)(1u << id);
+        }
+    }
+    *out = f;
+    return 1;
+}
+#endif
diff --git a/tools/mt6762/hardware/display-touch/axs_touch_state.h b/tools/mt6762/hardware/display-touch/axs_touch_state.h
new file mode 100644
index 0000000000000000000000000000000000000000..5882663c52b4b127e5503375e15bc8d1f63a4689
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/axs_touch_state.h
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: MIT
+ * Portable AXS state tracking. No hardware access or runtime initialization.
+ * Caller serializes calls and supplies a monotonic microsecond clock. Call
+ * axs_state_expire periodically even when no packets arrive, and release_all
+ * before stopping a device, so transport loss cannot leave fingers held.
+ */
+#ifndef MT6762_AXS_TOUCH_STATE_H
+#define MT6762_AXS_TOUCH_STATE_H
+#include "axs_touch.h"
+/* Values match bsd/sys/hakios.input.h. Sink adapts to hakios_touch_post(). */
+enum { AXS_DOWN = 1, AXS_MOVE = 2, AXS_UP = 3 };
+typedef void (*axs_event_sink)(void *, unsigned type, unsigned id, unsigned x, unsigned y);
+struct axs_state {
+    struct { uint16_t x, y; } point[AXS_TOUCH_MAX_CONTACTS];
+    uint16_t x_max, y_max;
+    uint8_t active, clock_seen;
+    uint64_t last_clock_us, last_valid_us, timeout_us;
+    axs_event_sink emit;
+    void *context;
+};
+static inline int axs_state_init(struct axs_state *s, unsigned xmax, unsigned ymax,
+    uint64_t timeout_us, axs_event_sink emit, void *context)
+{
+    if (!s || !xmax || !ymax || xmax > 4095 || ymax > 4095 || !timeout_us || !emit) return -1;
+    *s = (struct axs_state){0};
+    s->x_max = (uint16_t)xmax; s->y_max = (uint16_t)ymax;
+    s->timeout_us = timeout_us; s->emit = emit; s->context = context;
+    return 0;
+}
+static inline void axs_state_release_all(struct axs_state *s)
+{
+    if (!s || !s->emit) return;
+    uint8_t active = s->active;
+    s->active = 0;
+    for (unsigned i = 0; i < AXS_TOUCH_MAX_CONTACTS; ++i)
+        if (active & (1u << i)) s->emit(s->context, AXS_UP, i, s->point[i].x, s->point[i].y);
+}
+/* Returns -1 for invalid state/backwards clock, 1 if expired, otherwise0. */
+static inline int axs_state_expire(struct axs_state *s, uint64_t now_us)
+{
+    if (!s || !s->emit || !s->timeout_us) return -1;
+    if (s->clock_seen && now_us < s->last_clock_us) {
+        axs_state_release_all(s);
+        return -1;
+    }
+    s->last_clock_us = now_us; s->clock_seen = 1;
+    if (s->active && now_us - s->last_valid_us >= s->timeout_us) {
+        axs_state_release_all(s);
+        return 1;
+    }
+    return 0;
+}
+/* Returns1 for valid touch frame,0 for status frame,-1 for malformed input.
+ * Validation completes before posting any new contact. Malformed frames release
+ * every held contact; status frames preserve state only until the deadline.
+ * axis maxima are inclusive reported ABS maxima (this phone:384 and854).
+ */
+static inline int axs_state_feed(struct axs_state *s, const uint8_t *packet,
+    size_t length, uint64_t now_us)
+{
+    struct axs_frame f;
+    uint8_t seen = 0;
+    if (axs_state_expire(s, now_us) < 0) return -1;
+    int result = axs_touch_decode(packet, length, &f);
+    if (!result) return 0;
+    if (result < 0 || (packet[1] & 15) > AXS_TOUCH_MAX_CONTACTS || f.count != (packet[1] & 15)) goto malformed;
+    for (unsigned i = 0; i < f.count; ++i) {
+        const struct axs_contact *c = &f.contacts[i];
+        if ((seen & (1u << c->id)) || c->event == 3 || c->x > s->x_max || c->y > s->y_max) goto malformed;
+        seen |= (uint8_t)(1u << c->id);
+    }
+    /* Release missing/up contacts before new downs, using their last position. */
+    for (unsigned id = 0; id < AXS_TOUCH_MAX_CONTACTS; ++id) {
+        if ((s->active & ~f.active_mask) & (1u << id))
+            s->emit(s->context, AXS_UP, id, s->point[id].x, s->point[id].y);
+    }
+    for (unsigned i = 0; i < f.count; ++i) {
+        const struct axs_contact *c = &f.contacts[i];
+        if (!(f.active_mask & (1u << c->id))) continue;
+        unsigned x = (unsigned)c->x * 65535u / s->x_max;
+        unsigned y = (unsigned)c->y * 65535u / s->y_max;
+        if (!(s->active & (1u << c->id))) s->emit(s->context, AXS_DOWN, c->id, x, y);
+        else if (x != s->point[c->id].x || y != s->point[c->id].y)
+            s->emit(s->context, AXS_MOVE, c->id, x, y);
+        s->point[c->id].x = (uint16_t)x; s->point[c->id].y = (uint16_t)y;
+    }
+    s->active = f.active_mask; s->last_valid_us = now_us;
+    return 1;
+malformed:
+    axs_state_release_all(s);
+    return -1;
+}
+#endif
diff --git a/tools/mt6762/hardware/display-touch/backlight_probe.c b/tools/mt6762/hardware/display-touch/backlight_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..97d5430fecf5e09dad76c6cb75929f333e1c9922
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/backlight_probe.c
@@ -0,0 +1,74 @@
+/* Read-only iOS registry diagnostic. No brightness/PWM/property writes.
+ * Build against an iOS SDK with CoreFoundation and IOKit. Run only in the
+ * explicitly prepared laboratory userspace; does not connect to a phone. */
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOKit/IOKitLib.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+static void property(io_service_t service, CFStringRef key)
+{
+    CFTypeRef value = IORegistryEntryCreateCFProperty(service, key, NULL, 0);
+    char name[128] = {0}, description[2048] = {0};
+    CFStringGetCString(key, name, sizeof(name), kCFStringEncodingUTF8);
+    if (value) {
+        CFStringRef text = CFCopyDescription(value);
+        if (text) {
+            CFStringGetCString(text, description, sizeof(description), kCFStringEncodingUTF8);
+            CFRelease(text);
+        }
+        CFRelease(value);
+    }
+    printf("MT6762_BL_PROPERTY %s=%s\n", name, value ? description : "<absent>");
+}
+static void enumerate(const char *label, CFMutableDictionaryRef matching)
+{
+    io_iterator_t iterator = 0;
+    kern_return_t result = IOServiceGetMatchingServices(0, matching, &iterator);
+    printf("MT6762_BL_MATCH %s status=%#x\n", label, result);
+    if (result) return;
+    io_service_t service;
+    unsigned count = 0;
+    while (count < 16 && (service = IOIteratorNext(iterator))) {
+        io_name_t name = {0}, class_name = {0};
+        uint64_t registry_id = 0;
+        IORegistryEntryGetName(service, name);
+        IOObjectGetClass(service, class_name);
+        IORegistryEntryGetRegistryEntryID(service, &registry_id);
+        printf("MT6762_BL_SERVICE name=%s class=%s id=%llu conforms=%u\n",
+            name, class_name, (unsigned long long)registry_id,
+            IOObjectConformsTo(service, "AppleARMBacklight"));
+        property(service, CFSTR("backlight-control"));
+        property(service, CFSTR("IODisplayParameters"));
+        property(service, CFSTR("backlight-level"));
+        property(service, CFSTR("MT6762BacklightFault"));
+        property(service, CFSTR("IOClass"));
+        property(service, CFSTR("built-in"));
+        IOObjectRelease(service);
+        count++;
+    }
+    IOObjectRelease(iterator);
+    printf("MT6762_BL_COUNT %s=%u\n", label, count);
+}
+int main(int argc, char **argv)
+{
+    unsigned repeats = argc > 1 ? (unsigned)strtoul(argv[1], NULL, 10) : 1;
+    if (!repeats || repeats > 12) return 2;
+    setvbuf(stdout, NULL, _IONBF, 0);
+    for (unsigned i = 0; i < repeats; i++) {
+        printf("MT6762_BL_PROBE iteration=%u uid=%u readonly=1\n", i, getuid());
+        enumerate("AppleARMBacklight", IOServiceMatching("AppleARMBacklight"));
+        CFMutableDictionaryRef props = CFDictionaryCreateMutable(NULL, 1,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        CFMutableDictionaryRef matching = CFDictionaryCreateMutable(NULL, 1,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        if (!props || !matching) return 3;
+        CFDictionarySetValue(props, CFSTR("backlight-control"), kCFBooleanTrue);
+        CFDictionarySetValue(matching, CFSTR("IOPropertyMatch"), props);
+        CFRelease(props);
+        enumerate("backlight-control=true", matching);
+        if (i + 1 < repeats) sleep(10);
+    }
+    return 0;
+}
diff --git a/tools/mt6762/hardware/display-touch/backlight_request.c b/tools/mt6762/hardware/display-touch/backlight_request.c
new file mode 100644
index 0000000000000000000000000000000000000000..67d0d9b4698dd6782f68fc6a3471070d1c366f1f
--- /dev/null
+++ b/tools/mt6762/hardware/display-touch/backlight_request.c
@@ -0,0 +1,100 @@
+/* QEMU laboratory diagnostic, not a physical-device utility.
+ * Calls ORIGINAL20F66 BackBoardServices exports through its Mach service.
+ * No Apple patching and no IORegistryEntrySetCFProperties/PWM write here.
+ * Requires the explicit synthetic ADT lab-fixture contract and --qemu-lab.
+ */
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOKit/IOKitLib.h>
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static bool flag(io_registry_entry_t entry, CFStringRef key)
+{
+    CFTypeRef value = IORegistryEntryCreateCFProperty(entry, key, NULL, 0);
+    bool valid = value && CFGetTypeID(value) == CFDataGetTypeID() &&
+        CFDataGetLength(value) == 4;
+    if (valid) {
+        const UInt8 *bytes = CFDataGetBytePtr(value);
+        valid = bytes[0] == 1 && !bytes[1] && !bytes[2] && !bytes[3];
+    }
+    if (value) CFRelease(value);
+    return valid;
+}
+static bool is_lab(void)
+{
+    io_registry_entry_t entry = IORegistryEntryFromPath(0,
+        "IODeviceTree:/chosen/mt6762-handoff");
+    if (!entry) return false;
+    bool valid = flag(entry, CFSTR("version")) && flag(entry, CFSTR("native-io")) &&
+        flag(entry, CFSTR("lab-fixture"));
+    IOObjectRelease(entry);
+    return valid;
+}
+static int native_level(void)
+{
+    io_service_t service = IOServiceGetMatchingService(0, IOServiceMatching("AppleARMBacklight"));
+    if (!service) return -1;
+    CFTypeRef parameters = IORegistryEntryCreateCFProperty(service,
+        CFSTR("IODisplayParameters"), NULL, 0);
+    int level = -1;
+    if (parameters && CFGetTypeID(parameters) == CFDictionaryGetTypeID()) {
+        CFTypeRef brightness = CFDictionaryGetValue(parameters, CFSTR("brightness"));
+        if (brightness && CFGetTypeID(brightness) == CFDictionaryGetTypeID()) {
+            CFTypeRef value = CFDictionaryGetValue(brightness, CFSTR("value"));
+            if (value && CFGetTypeID(value) == CFNumberGetTypeID())
+                CFNumberGetValue(value, kCFNumberIntType, &level);
+        }
+    }
+    if (parameters) CFRelease(parameters);
+    IOObjectRelease(service);
+    return level;
+}
+int main(int argc, char **argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (argc < 2 || strcmp(argv[1], "--qemu-lab")) return 2;
+    if (!is_lab()) {
+        puts("MT6762_BKS_ABORT synthetic ADT contract absent");
+        return 3;
+    }
+    unsigned delay = argc > 2 ? (unsigned)strtoul(argv[2], NULL, 10) : 45;
+    unsigned hold = argc > 3 ? (unsigned)strtoul(argv[3], NULL, 10) : 4;
+    if (delay > 600 || hold < 4 || hold > 180) return 2;
+    printf("MT6762_BKS_WAIT seconds=%u hold=%u uid=%u\n", delay, hold, getuid());
+    sleep(delay);
+    void *framework = dlopen("/System/Library/PrivateFrameworks/BackBoardServices.framework/BackBoardServices", RTLD_NOW);
+    if (!framework) {printf("MT6762_BKS_ABORT dlopen=%s\n", dlerror());return 4;}
+    /* Exact20F66 wrappers: s0 float argument/result; setter tail-calls MIG
+     * routine returning int32 status. See apple-brightness-abi.json. */
+    int32_t (*set)(float) = dlsym(framework, "BKSDisplayBrightnessSetWithImplicitTransaction");
+    float (*get)(void) = dlsym(framework, "BKSDisplayBrightnessGetCurrent");
+    bool (*available)(void) = dlsym(framework, "BKSDisplayBrightnessIsBrightnessLevelControlAvailable");
+    if (!set || !get || !available) {puts("MT6762_BKS_ABORT exports missing");return 5;}
+    bool ready = false;
+    for (unsigned i = 0; i < 30; i++) {
+        ready = available();
+        if (ready) break;
+        sleep(2);
+    }
+    printf("MT6762_BKS_READY available=%u native=%d\n", ready, native_level());
+    if (!ready) return 6;
+    float original = get();
+    if (!(original >= 0.0f && original <= 1.0f)) {
+        puts("MT6762_BKS_ABORT initial logical brightness invalid");return 7;
+    }
+    const float targets[3] = {0.25f, 0.75f, original};
+    for (unsigned i = 0; i < 3; i++) {
+        int32_t status = set(targets[i]);
+        printf("MT6762_BKS_REQUEST target=%.6f status=%#x\n", targets[i], status);
+        sleep(i < 2 ? hold : 4);
+        printf("MT6762_BKS_OBSERVE logical=%.6f native=%d\n", get(), native_level());
+        if (status) return 8;
+    }
+    puts("MT6762_BKS_DONE requests complete; require independent native PWM evidence");
+    return 0;
+}
