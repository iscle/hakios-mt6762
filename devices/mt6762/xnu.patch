diff --git a/tools/mt6762/physical/sspm/fixture.ld b/tools/mt6762/physical/sspm/fixture.ld
new file mode 100644
index 0000000000000000000000000000000000000000..26ffd2697c370bef460a773ddfc0f726f19bcef0
--- /dev/null
+++ b/tools/mt6762/physical/sspm/fixture.ld
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: MIT -- test allocation only, no production linker change. */
+OUTPUT_FORMAT("elf64-littleaarch64")
+OUTPUT_ARCH(aarch64)
+ENTRY(fixture_return)
+PHDRS { image PT_LOAD FLAGS(7); }
+SECTIONS {
+  . = 0x40080000;
+  .entry : { *(.text.entry) } :image
+  . = 0x40084000;
+  .trace : { *(.trace) } :image
+  . = 0x40085400;
+  .probe_record : { *(.sspm_fixture_record) } :image
+  .text : ALIGN(2048) { *(.text .text.*) } :image
+  .rodata : ALIGN(16) { *(.rodata .rodata.*) } :image
+  .data : ALIGN(16) { *(.data .data.*) } :image
+  .bss (NOLOAD) : ALIGN(16) {
+    __bss_start = .; *(.bss .bss.* COMMON); . = ALIGN(16); __bss_end = .;
+  } :image
+  .stack : ALIGN(16) { __stack_start = .; *(.stack); __stack_end = .; } :image
+  image_end = .;
+  __image_size = image_end - image_start;
+  /DISCARD/ : { *(.comment .note* .eh_frame*) }
+}
+ASSERT(SIZEOF(.entry) <= 0x4000, "original entry fixture overlaps trace")
+ASSERT(fixture_record == 0x40085400 && SIZEOF(.probe_record) == 1024, "fixture record")
+ASSERT((sspm_probe_vectors & 0x7ff) == 0, "private VBAR alignment")
+ASSERT((physical_vectors & 0x7ff) == 0, "original VBAR alignment")
+ASSERT((__stack_end & 15) == 0, "stack alignment")
+ASSERT(__stack_end - __stack_start == 65536, "original loader stack size")
diff --git a/tools/mt6762/physical/sspm/guard.S b/tools/mt6762/physical/sspm/guard.S
new file mode 100644
index 0000000000000000000000000000000000000000..e3cc984be2f4f7975c52b53cd952a704264a54a9
--- /dev/null
+++ b/tools/mt6762/physical/sspm/guard.S
@@ -0,0 +1,328 @@
+/* SPDX-License-Identifier: MIT
+ * Single boot CPU, EL1h, fixed-x28 loader only. No unrestricted address API.
+ * All unexpected exceptions delegate to the existing physical vector slot.
+ */
+.arch armv8-a
+.text
+.balign 4
+.global sspm_guard_read
+.type sspm_guard_read,%function
+sspm_guard_read:
+    sub sp,sp,#288
+    stp x0,x1,[sp,#0]
+    stp x2,x3,[sp,#16]
+    stp x4,x5,[sp,#32]
+    stp x6,x7,[sp,#48]
+    stp x8,x9,[sp,#64]
+    stp x10,x11,[sp,#80]
+    stp x12,x13,[sp,#96]
+    stp x14,x15,[sp,#112]
+    stp x16,x17,[sp,#128]
+    stp x18,x19,[sp,#144]
+    stp x20,x21,[sp,#160]
+    stp x22,x23,[sp,#176]
+    stp x24,x25,[sp,#192]
+    stp x26,x27,[sp,#208]
+    stp x28,x29,[sp,#224]
+    str x30,[sp,#240]
+    mrs x9,nzcv
+    str x9,[sp,#248]
+    mrs x9,CurrentEL
+    cmp x9,#4
+    b.ne .Lreject
+    mrs x9,SPSel
+    cmp x9,#1
+    b.ne .Lreject
+    cbnz x28,.Lreject
+    mrs x9,daif
+    str x9,[sp,#256]
+    and x10,x9,#0x3c0
+    cmp x10,#0x3c0
+    b.ne .Lreject
+    mrs x9,sctlr_el1
+    tbnz x9,#0,.Lreject
+    tbnz x9,#2,.Lreject
+    tbnz x9,#25,.Lreject
+    mrs x9,mpidr_el1
+    tst x9,#0xffffff
+    b.ne .Lreject
+    ubfx x10,x9,#32,#8
+    cbnz x10,.Lreject
+    mrs x10,vbar_el1
+    adrp x11,physical_vectors
+    add x11,x11,:lo12:physical_vectors
+    cmp x10,x11
+    b.ne .Lreject
+    str x10,[sp,#264]
+    cmp x0,#13
+    b.hs .Lreject
+    adrp x11,image_start
+    add x11,x11,:lo12:image_start
+    adrp x12,image_end
+    add x12,x12,:lo12:image_end
+    tst x1,#3
+    b.ne .Lreject
+    cmp x1,x11
+    b.lo .Lreject
+    sub x13,x12,#4
+    cmp x1,x13
+    b.hi .Lreject
+    tst x2,#7
+    b.ne .Lreject
+    cmp x2,x11
+    b.lo .Lreject
+    sub x13,x12,#32
+    cmp x2,x13
+    b.hi .Lreject
+    /* Failure must leave output unchanged, including aliased destinations. */
+    add x13,x1,#4
+    cmp x13,x2
+    b.ls .Lbuffers_disjoint
+    add x13,x2,#32
+    cmp x1,x13
+    b.lo .Lreject
+.Lbuffers_disjoint:
+    /* Neither destination may overlap this wrapper OR the future exception
+     * frame. A fault destination there would corrupt saved handler GPRs. */
+    sub x13,sp,#256
+    add x14,sp,#288
+    add x15,x1,#4
+    cmp x15,x13
+    b.ls .Lcheck_fault_stack
+    cmp x1,x14
+    b.lo .Lreject
+.Lcheck_fault_stack:
+    add x15,x2,#32
+    cmp x15,x13
+    b.ls .Lcontext
+    cmp x2,x14
+    b.lo .Lreject
+.Lcontext:
+    adrp x10,sspm_guard_context
+    add x10,x10,:lo12:sspm_guard_context
+    add x13,x10,#64
+    add x14,x1,#4
+    cmp x14,x10
+    b.ls .Lfault_not_context
+    cmp x1,x13
+    b.lo .Lreject
+.Lfault_not_context:
+    add x14,x2,#32
+    cmp x14,x10
+    b.ls .Lcontext_available
+    cmp x2,x13
+    b.lo .Lreject
+.Lcontext_available:
+    ldr x11,[x10,#0]
+    cbnz x11,.Lreject
+    ldr x11,[x10,#8]
+    cbnz x11,.Lreject
+    adrp x11,sspm_probe_addresses
+    add x11,x11,:lo12:sspm_probe_addresses
+    ldr w16,[x11,x0,lsl #2]
+    stp x16,x0,[x10,#16]        /* expected address, whitelist index */
+    stp x1,x2,[x10,#32]         /* owned output, owned fault destination */
+    str x9,[x10,#48]           /* exact admitted MPIDR */
+    adrp x11,sspm_probe_vectors
+    add x11,x11,:lo12:sspm_probe_vectors
+    msr vbar_el1,x11
+    isb
+    mov x11,#1
+    str x11,[x10,#0]           /* armed, only once; barriers are NOT recoverable */
+    dsb sy
+.global sspm_guard_load
+sspm_guard_load:
+    ldr w17,[x16]
+.global sspm_guard_after_load
+sspm_guard_after_load:
+    dsb sy
+    str xzr,[x10,#0]
+    str w17,[x1]              /* publish only after completed protected read */
+    mov x0,#0
+    b .Lretire
+.global sspm_guard_failed
+sspm_guard_failed:
+    /* The vector disarms before ERET; it never changes output. */
+    mov x0,#-1
+.Lretire:
+    str xzr,[x10,#8]
+    ldr x9,[sp,#264]
+    msr vbar_el1,x9
+    isb
+    ldr x9,[sp,#256]
+    msr daif,x9
+    b .Lreturn
+.Lreject:
+    mov x0,#-2
+.Lreturn:
+    str x0,[sp,#0]            /* only x0 is an ABI result; all others restored */
+    ldr x9,[sp,#248]
+    msr nzcv,x9
+    ldp x0,x1,[sp,#0]
+    ldp x2,x3,[sp,#16]
+    ldp x4,x5,[sp,#32]
+    ldp x6,x7,[sp,#48]
+    ldp x8,x9,[sp,#64]
+    ldp x10,x11,[sp,#80]
+    ldp x12,x13,[sp,#96]
+    ldp x14,x15,[sp,#112]
+    ldp x16,x17,[sp,#128]
+    ldp x18,x19,[sp,#144]
+    ldp x20,x21,[sp,#160]
+    ldp x22,x23,[sp,#176]
+    ldp x24,x25,[sp,#192]
+    ldp x26,x27,[sp,#208]
+    ldp x28,x29,[sp,#224]
+    ldr x30,[sp,#240]
+    add sp,sp,#288
+    ret
+.size sspm_guard_read,.-sspm_guard_read
+
+.balign 2048
+.global sspm_probe_vectors
+sspm_probe_vectors:
+.set slot,0
+.rept 16
+    .if slot == 4
+        b sspm_guard_sync
+    .else
+        b physical_vectors+(slot*128)
+    .endif
+    .space 124,0
+    .set slot,slot+1
+.endr
+
+.global sspm_guard_sync
+.type sspm_guard_sync,%function
+sspm_guard_sync:
+    /* Existing fatal handler uses x28=1 to stop recursive diagnostics.
+     * Keep it set throughout our handler so a nested fault goes straight to
+     * that same fatal recursion rule. The admitted original x28 was zero. */
+    cbnz x28,.Lfatal_direct
+    mov x28,#1
+    sub sp,sp,#256
+    stp x0,x1,[sp,#0]
+    stp x2,x3,[sp,#16]
+    stp x4,x5,[sp,#32]
+    stp x6,x7,[sp,#48]
+    stp x8,x9,[sp,#64]
+    stp x10,x11,[sp,#80]
+    stp x12,x13,[sp,#96]
+    stp x14,x15,[sp,#112]
+    stp x16,x17,[sp,#128]
+    stp x18,x19,[sp,#144]
+    stp x20,x21,[sp,#160]
+    stp x22,x23,[sp,#176]
+    stp x24,x25,[sp,#192]
+    stp x26,x27,[sp,#208]
+    stp xzr,x29,[sp,#224]
+    str x30,[sp,#240]
+    mrs x9,CurrentEL
+    cmp x9,#4
+    b.ne .Lfatal_restore
+    mrs x9,SPSel
+    cmp x9,#1
+    b.ne .Lfatal_restore
+    adrp x10,sspm_guard_context
+    add x10,x10,:lo12:sspm_guard_context
+    ldr x9,[x10,#0]
+    cmp x9,#1
+    b.ne .Lfatal_restore
+    ldr x9,[x10,#8]
+    cbnz x9,.Lfatal_restore
+    mov x9,#1
+    str x9,[x10,#8]
+    mrs x9,mpidr_el1
+    ldr x11,[x10,#48]
+    cmp x9,x11
+    b.ne .Lfatal_restore
+    mrs x12,spsr_el1
+    and x9,x12,#0x1f
+    cmp x9,#5
+    b.ne .Lfatal_restore
+    and x9,x12,#0x3c0
+    cmp x9,#0x3c0
+    b.ne .Lfatal_restore
+    mrs x13,elr_el1
+    adr x9,sspm_guard_load
+    cmp x13,x9
+    b.ne .Lfatal_restore
+    mrs x14,esr_el1
+    and x9,x14,#0xfe000000
+    mov x11,#0x96000000
+    cmp x9,x11
+    b.ne .Lfatal_restore
+    mov x11,#0x5ff            /* FnV, CM, S1PTW, WnR and DFSC; EA is recorded */
+    and x9,x14,x11
+    cmp x9,#0x10
+    b.ne .Lfatal_restore
+    ldr x11,[x10,#24]
+    cmp x11,#13
+    b.hs .Lfatal_restore
+    adrp x9,sspm_probe_addresses
+    add x9,x9,:lo12:sspm_probe_addresses
+    ldr w9,[x9,x11,lsl #2]
+    ldr x11,[x10,#16]
+    cmp x9,x11
+    b.ne .Lfatal_restore
+    ldr x11,[sp,#128]         /* actual address register at the faulting LDR */
+    cmp x9,x11
+    b.ne .Lfatal_restore
+    mrs x15,far_el1
+    cmp x9,x15
+    b.ne .Lfatal_restore
+    ldr x9,[x10,#40]
+    stp x14,x15,[x9,#0]
+    stp x13,x12,[x9,#16]
+    str xzr,[x10,#0]          /* disarm before ERET */
+    adr x9,sspm_guard_failed
+    msr elr_el1,x9
+    /* SPSR is intentionally unchanged: ERET restores the interrupted flags. */
+    ldp x0,x1,[sp,#0]
+    ldp x2,x3,[sp,#16]
+    ldp x4,x5,[sp,#32]
+    ldp x6,x7,[sp,#48]
+    ldp x8,x9,[sp,#64]
+    ldp x10,x11,[sp,#80]
+    ldp x12,x13,[sp,#96]
+    ldp x14,x15,[sp,#112]
+    ldp x16,x17,[sp,#128]
+    ldp x18,x19,[sp,#144]
+    ldp x20,x21,[sp,#160]
+    ldp x22,x23,[sp,#176]
+    ldp x24,x25,[sp,#192]
+    ldp x26,x27,[sp,#208]
+    ldr x29,[sp,#232]
+    ldr x30,[sp,#240]
+    add sp,sp,#256
+    mov x28,xzr
+    eret
+.Lfatal_restore:
+    ldp x0,x1,[sp,#0]
+    ldp x2,x3,[sp,#16]
+    ldp x4,x5,[sp,#32]
+    ldp x6,x7,[sp,#48]
+    ldp x8,x9,[sp,#64]
+    ldp x10,x11,[sp,#80]
+    ldp x12,x13,[sp,#96]
+    ldp x14,x15,[sp,#112]
+    ldp x16,x17,[sp,#128]
+    ldp x18,x19,[sp,#144]
+    ldp x20,x21,[sp,#160]
+    ldp x22,x23,[sp,#176]
+    ldp x24,x25,[sp,#192]
+    ldp x26,x27,[sp,#208]
+    ldr x29,[sp,#232]
+    ldr x30,[sp,#240]
+    add sp,sp,#256
+    mov x28,xzr
+.Lfatal_direct:
+    b physical_vectors+0x200
+.size sspm_guard_sync,.-sspm_guard_sync
+
+.bss
+.balign 16
+.global sspm_guard_context
+sspm_guard_context:
+    .skip 64                  /* armed,handling,address,index,output,fault,MPIDR */
+.section .note.GNU-stack,"",%progbits
diff --git a/tools/mt6762/physical/sspm/probe.c b/tools/mt6762/physical/sspm/probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..8da1d2f07aa5f6e262fad520b00ad1a9367c68e2
--- /dev/null
+++ b/tools/mt6762/physical/sspm/probe.c
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: MIT -- read-only hardware; writes only owned RAM. */
+#include "probe.h"
+extern unsigned char image_start[],image_end[],physical_vectors[];
+const uint32_t sspm_probe_addresses[SSPM_PROBE_WORDS]={
+    0x00110c00,0x00110c04,0x00110c08,0x00110c0c,0x00110ea0,
+    0x10450000,0x10450004,0x10450008,0x1045000c,0x10450010,0x10450014,0x10450018,
+    0x10451004
+};
+const uint32_t sspm_probe_external_addresses[SSPM_PROBE_EXTERNAL_WORDS]={
+    0x10000040,0x10000090,0x100010c8,0x1000c23c,0x1000c240,0x1000c248,
+    0x10006350,0x10006358,0x1001a010,0x1001a024,0x1001a050,0x1001a054,0x1001a058
+};
+static const uint32_t screen_mask[8]={0x83,0x83,1u<<17,UINT32_MAX,UINT32_MAX,
+    UINT32_MAX,UINT32_MAX,0x10013};
+static const uint32_t screen_value[8]={1,1,0,0xd4800181,0x81150000,0x80000001,
+    0xffff0000,0x12};
+static void barrier(void) { __asm__ volatile("dsb sy" ::: "memory"); }
+static uint64_t ticks(void)
+{uint64_t value;__asm__ volatile("isb; mrs %0, cntpct_el0":"=r"(value)::"memory");return value;}
+static int owned(const volatile void *p,size_t size,size_t alignment)
+{
+    uintptr_t a=(uintptr_t)p,lo=(uintptr_t)image_start,hi=(uintptr_t)image_end;
+    return !(a&(alignment-1)) && a>=lo && a<=hi && size<=hi-a;
+}
+static void commit(volatile struct sspm_probe_record *r,uint32_t state)
+{
+    r->state_inverse=0;r->sequence_inverse=0;barrier();
+    r->state=state;r->sequence++;
+    barrier();r->sequence_inverse=~r->sequence;r->state_inverse=~state;barrier();
+}
+static int entry(volatile struct sspm_probe_record *r)
+{
+    uint64_t el,sp,mpidr,sctlr,vbar,daif,hz,guard;
+    __asm__ volatile("mrs %0, CurrentEL":"=r"(el));
+    if(el!=4)return 0;
+    __asm__ volatile("mrs %0, SPSel":"=r"(sp));
+    __asm__ volatile("mrs %0, mpidr_el1":"=r"(mpidr));
+    __asm__ volatile("mrs %0, sctlr_el1":"=r"(sctlr));
+    __asm__ volatile("mrs %0, vbar_el1":"=r"(vbar));
+    __asm__ volatile("mrs %0, daif":"=r"(daif));
+    __asm__ volatile("mrs %0, cntfrq_el0":"=r"(hz));
+    __asm__ volatile("mov %0, x28":"=r"(guard));
+    r->entry_mpidr=mpidr;r->entry_sctlr=sctlr;r->entry_vbar=vbar;r->entry_daif=daif;
+    r->counter_hz=hz;
+    return sp==1 && !(mpidr&UINT64_C(0xff00ffffff)) &&
+        !(sctlr&((1u<<25)|5u)) && vbar==(uintptr_t)physical_vectors &&
+        (daif&0x3c0)==0x3c0 && hz==SSPM_PROBE_COUNTER_HZ && !guard;
+}
+static int budget(volatile struct sspm_probe_record *r)
+{
+    uint64_t previous=r->ended_ticks,now=ticks();r->ended_ticks=now;
+    if(now<previous || now<r->began_ticks){r->reason=SSPM_PROBE_TIME_REVERSED;return 0;}
+    if(now-r->began_ticks>=r->budget_ticks){r->reason=SSPM_PROBE_DEADLINE;return 0;}
+    return 1;
+}
+static int screen(volatile struct sspm_probe_record *r)
+{
+    r->operation=SSPM_PROBE_SCREEN;r->external_valid=0;r->screen_count++;
+    commit(r,SSPM_PROBE_RUNNING);
+    for(unsigned i=0;i<SSPM_PROBE_EXTERNAL_WORDS;i++) {
+        uint32_t value=*(volatile uint32_t *)(uintptr_t)sspm_probe_external_addresses[i];
+        barrier();r->external[i]=value;r->external_valid|=1u<<i;
+        if(i<8 && (value&screen_mask[i])!=screen_value[i]) {
+            r->bad_screen_word=i;r->reason=SSPM_PROBE_BAD_PROFILE;return 0;
+        }
+    }
+    /* SECURITY_AO readings are recorded, never treated as permissions. */
+    return 1;
+}
+int sspm_probe_run(volatile struct sspm_probe_record *r,const uint8_t identity[32])
+{
+    if(!owned(r,sizeof(*r),64) || !owned(identity,32,1))return SSPM_PROBE_REFUSED;
+    uintptr_t id=(uintptr_t)identity,record=(uintptr_t)r;
+    if(id<record+sizeof(*r) && id+32>record)return SSPM_PROBE_REFUSED;
+    for(size_t i=0;i<sizeof(*r);i++)((volatile uint8_t *)r)[i]=0;
+    const uint8_t magic[8]={'M','T','K','S','S','P','R','1'};
+    for(unsigned i=0;i<8;i++)r->magic[i]=magic[i];
+    for(unsigned i=0;i<32;i++)r->identity[i]=identity[i];
+    r->version=1;r->size=sizeof(*r);r->index=UINT32_MAX;r->pass=UINT32_MAX;
+    r->bad_screen_word=UINT32_MAX;r->budget_ticks=SSPM_PROBE_BUDGET_TICKS;
+    for(unsigned i=0;i<SSPM_PROBE_WORDS;i++)r->words[i].address=sspm_probe_addresses[i];
+    if(!entry(r)) {r->reason=SSPM_PROBE_BAD_ENTRY;commit(r,SSPM_PROBE_REFUSED);return SSPM_PROBE_REFUSED;}
+    r->began_ticks=ticks();r->ended_ticks=r->began_ticks;
+    commit(r,SSPM_PROBE_RUNNING);
+    for(unsigned pass=0;pass<2;pass++)for(unsigned i=0;i<SSPM_PROBE_WORDS;i++) {
+        r->pass=pass;r->index=i;
+        if(!budget(r))goto expired;
+        if(i==0 || i==5 || i==12) {
+            if(!screen(r)){commit(r,SSPM_PROBE_REFUSED);return SSPM_PROBE_REFUSED;}
+            if(!budget(r))goto expired;
+        }
+        uint32_t value=0;
+        r->operation=SSPM_PROBE_LOAD;r->words[i].began_ticks[pass]=ticks();
+        commit(r,SSPM_PROBE_RUNNING);
+        int result=sspm_guard_read(i,&value,&r->fault);
+        r->words[i].ended_ticks[pass]=ticks();r->ended_ticks=r->words[i].ended_ticks[pass];
+        if(result==SSPM_GUARD_ABORT){commit(r,SSPM_PROBE_ABORT);return SSPM_PROBE_ABORT;}
+        if(result!=SSPM_GUARD_OK){r->reason=SSPM_PROBE_GUARD_REJECTED;
+            commit(r,SSPM_PROBE_REFUSED);return SSPM_PROBE_REFUSED;}
+        r->words[i].value[pass]=value;r->words[i].valid|=1u<<pass;r->completed++;
+        if(r->ended_ticks<r->words[i].began_ticks[pass]) {
+            r->reason=SSPM_PROBE_TIME_REVERSED;goto expired;
+        }
+        commit(r,SSPM_PROBE_RUNNING);
+    }
+    r->operation=SSPM_PROBE_IDLE;commit(r,SSPM_PROBE_COMPLETE);return SSPM_PROBE_COMPLETE;
+expired:
+    commit(r,SSPM_PROBE_EXPIRED);return SSPM_PROBE_EXPIRED;
+}
diff --git a/tools/mt6762/physical/sspm/probe.h b/tools/mt6762/physical/sspm/probe.h
new file mode 100644
index 0000000000000000000000000000000000000000..152568366e0aeaf0c8964cb6df2f188e4129712c
--- /dev/null
+++ b/tools/mt6762/physical/sspm/probe.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: MIT -- standalone loader diagnostic, never grants. */
+#ifndef MT6762_SSPM_GUARDED_PROBE_H
+#define MT6762_SSPM_GUARDED_PROBE_H
+#include <stdint.h>
+#include <stddef.h>
+
+#define SSPM_PROBE_WORDS 13u
+#define SSPM_PROBE_EXTERNAL_WORDS 13u
+#define SSPM_PROBE_RECORD_SIZE 1024u
+/* Proposed only: the integrating linker/DA reader must reserve/assert it. */
+#define SSPM_PROBE_PROPOSED_RECORD_ADDRESS UINT64_C(0x40085400)
+#define SSPM_PROBE_COUNTER_HZ UINT64_C(13000000)
+#define SSPM_PROBE_BUDGET_TICKS UINT64_C(130000) /* dispatch checks, not bus timeout */
+enum sspm_probe_state {
+    SSPM_PROBE_EMPTY=0, SSPM_PROBE_RUNNING=1, SSPM_PROBE_COMPLETE=2,
+    SSPM_PROBE_ABORT=3, SSPM_PROBE_REFUSED=4, SSPM_PROBE_EXPIRED=5
+};
+enum sspm_probe_reason {
+    SSPM_PROBE_NO_REASON=0, SSPM_PROBE_BAD_ENTRY=1, SSPM_PROBE_BAD_PROFILE=2,
+    SSPM_PROBE_GUARD_REJECTED=3, SSPM_PROBE_DEADLINE=4, SSPM_PROBE_TIME_REVERSED=5
+};
+enum sspm_probe_operation { SSPM_PROBE_IDLE=0, SSPM_PROBE_SCREEN=1, SSPM_PROBE_LOAD=2 };
+enum sspm_guard_result { SSPM_GUARD_OK=0, SSPM_GUARD_ABORT=-1, SSPM_GUARD_REJECT=-2 };
+struct sspm_probe_fault { uint64_t esr,far,elr,spsr; };
+struct sspm_probe_word {
+    uint32_t address, value[2], valid;
+    uint64_t began_ticks[2], ended_ticks[2];
+};
+struct sspm_probe_record {
+    uint8_t magic[8]; uint32_t version,size; uint8_t identity[32];
+    uint32_t state,state_inverse,sequence,sequence_inverse;
+    uint32_t reason,completed,index,pass,screen_count,bad_screen_word;
+    uint64_t began_ticks,ended_ticks,budget_ticks,counter_hz;
+    struct sspm_probe_fault fault;
+    uint32_t external[SSPM_PROBE_EXTERNAL_WORDS],external_valid;
+    uint64_t entry_mpidr,entry_sctlr,entry_vbar,entry_daif;
+    uint32_t operation,reserved_header[3];
+    struct sspm_probe_word words[SSPM_PROBE_WORDS];
+    uint8_t reserved[144];
+};
+_Static_assert(sizeof(struct sspm_probe_record)==SSPM_PROBE_RECORD_SIZE,"record size");
+_Static_assert(offsetof(struct sspm_probe_record,fault)==120,"fault offset");
+_Static_assert(offsetof(struct sspm_probe_record,words)==256,"word offset");
+_Static_assert(sizeof(struct sspm_probe_word)==48,"word size");
+extern const uint32_t sspm_probe_addresses[SSPM_PROBE_WORDS];
+extern const uint32_t sspm_probe_external_addresses[SSPM_PROBE_EXTERNAL_WORDS];
+
+/* Assembly preserves x1..x30/NZCV, SP, DAIF/VBAR; x0 returns this result.
+ * Caller is admitted EL1h, boot CPU, M/C/EE off, DAIF masked, x28 reserved0.
+ * No general-address read interface; both destinations are owned Image RAM,
+ * disjoint from one another, context, wrapper and future exception frames.
+ * Caller must supply a valid 16-byte-aligned stack with at least 544 bytes.
+ * fault is untouched on success; output is untouched on any failure. */
+int sspm_guard_read(uint32_t index,uint32_t *output,volatile struct sspm_probe_fault *fault);
+/* Runs only the diagnostic. Caller MUST stop afterwards, never enter XNU.
+ * Record and identity must be aligned/owned Image RAM. No allocation here. */
+int sspm_probe_run(volatile struct sspm_probe_record *record,const uint8_t identity[32]);
+#endif
diff --git a/tools/mt6762/physical/sspm/probe_fixture.py b/tools/mt6762/physical/sspm/probe_fixture.py
new file mode 100644
index 0000000000000000000000000000000000000000..48591c3c03f15c390fad0ce7e0742c54423bb7e8
--- /dev/null
+++ b/tools/mt6762/physical/sspm/probe_fixture.py
@@ -0,0 +1,245 @@
+#!/usr/bin/env python3
+"""Execute the real linked probe and original vectors with modeled EL1 entry.
+
+Unicorn executes all ordinary AArch64 instructions. System registers,
+barriers, counter progression and exception entry/ERET are modeled explicitly;
+this is not an interconnect, secure-world, or physical permission emulator.
+"""
+import hashlib
+import os
+from pathlib import Path
+import struct
+import subprocess
+
+from capstone import Cs, CS_ARCH_ARM64, CS_MODE_ARM
+from elftools.elf.elffile import ELFFile
+from unicorn import Uc, UC_ARCH_ARM64, UC_MODE_ARM, UC_HOOK_CODE, UC_HOOK_MEM_READ, UC_HOOK_MEM_WRITE, UC_PROT_READ
+from unicorn import arm64_const as regs
+
+HERE = Path(__file__).resolve().parent
+ADDRESSES = (0x110c00, 0x110c04, 0x110c08, 0x110c0c, 0x110ea0,
+             0x10450000, 0x10450004, 0x10450008, 0x1045000c,
+             0x10450010, 0x10450014, 0x10450018, 0x10451004)
+EXTERNAL = (0x10000040, 0x10000090, 0x100010c8, 0x1000c23c, 0x1000c240,
+            0x1000c248, 0x10006350, 0x10006358, 0x1001a010, 0x1001a024,
+            0x1001a050, 0x1001a054, 0x1001a058)
+EXTERNAL_VALUES = (0x20101, 0x1010201, 0, 0xd4800181, 0x81150000,
+                   0x80000001, 0xffff0000, 0x12, 0, 0, 0, 0, 0)
+IDENTITY = b'SSPM-OFFLINE-FIXTURE-IDENTITY-01'
+MASK64 = (1 << 64) - 1
+
+
+def register(name):
+    return getattr(regs, 'UC_ARM64_REG_' + name.upper())
+
+
+class Program:
+    def __init__(self, directory):
+        directory = Path(directory)
+        clang = os.environ.get('IOS_CC', '/home/iscle/mt6762-ios-port/toolchain/bin/clang')
+        self.command = [clang, '--target=aarch64-none-elf', '-mcpu=cortex-a53',
+            '-mgeneral-regs-only', '-mstrict-align', '-ffixed-x28', '-ffreestanding',
+            '-fno-builtin', '-fno-stack-protector', '-fno-pic', '-O2', '-Wall', '-Wextra',
+            '-Werror', '-nostdlib', '-fuse-ld=lld', '-Wl,--build-id=none',
+            '-Wl,-T,' + str(HERE / 'fixture.ld'), str(HERE.parent / 'start.S'),
+            str(HERE / 'probe.c'), str(HERE / 'guard.S'), str(HERE / 'fixture.S'),
+            '-o', str(directory / 'probe.elf')]
+        subprocess.run(self.command, check=True, capture_output=True)
+        self.elf = directory / 'probe.elf'
+        self.sha256 = hashlib.sha256(self.elf.read_bytes()).hexdigest()
+        self.instructions = {}
+        self.symbols = {}
+        self.segments = []
+        disassembler = Cs(CS_ARCH_ARM64, CS_MODE_ARM)
+        with self.elf.open('rb') as stream:
+            elf = ELFFile(stream)
+            self.symbols = {s.name: s['st_value'] for s in elf.get_section_by_name('.symtab').iter_symbols()}
+            for section in elf.iter_sections():
+                if section['sh_flags'] & 4:
+                    # The real Image header embeds data before vectors; decoding
+                    # the entire section stops at those non-instruction bytes.
+                    data = section.data()
+                    for offset in range(0, len(data), 4):
+                        self.instructions.update((i.address, i) for i in
+                            disassembler.disasm(data[offset:offset+4], section['sh_addr']+offset))
+            self.segments = [(s['p_vaddr'], s.data()) for s in elf.iter_segments() if s['p_type'] == 'PT_LOAD']
+        assert self.symbols['fixture_record'] == 0x40085400
+        assert self.symbols['sspm_probe_vectors'] % 2048 == 0
+        assert self.symbols['physical_vectors'] % 2048 == 0
+
+
+class Machine:
+    def __init__(self, program, *, fault_at=None, fault=None, stall_at=None,
+                 values=None, tick_step=13, mutate=None, nested=False,
+                 external_change=None, direct=False, index=0,
+                 after_load_fault=None, stop_pc=None):
+        self.program, self.symbols = program, program.symbols
+        self.u = Uc(UC_ARCH_ARM64, UC_MODE_ARM)
+        self.base = self.symbols['image_start']
+        self.end = self.symbols['image_end']
+        self.u.mem_map(self.base, (self.end - self.base + 4095) & ~4095)
+        for address, data in program.segments:
+            self.u.mem_write(address, data)
+        for page in sorted({a & ~4095 for a in ADDRESSES + EXTERNAL}):
+            self.u.mem_map(page, 4096, UC_PROT_READ)
+        for address, value in zip(EXTERNAL, EXTERNAL_VALUES):
+            self.u.mem_write(address, struct.pack('<I', value))
+        self.system = {'currentel': 4, 'spsel': 1, 'mpidr_el1': 0x80000000,
+            'sctlr_el1': 0x30d00800, 'vbar_el1': self.symbols['physical_vectors'],
+            'daif': 0x3c0, 'cntfrq_el0': 13000000, 'cntpct_el0': 1000,
+            'esr_el1': 0, 'far_el1': 0, 'elr_el1': 0, 'spsr_el1': 0}
+        for n in range(31):
+            self.u.reg_write(register('x' + str(n)), 0x1100000000000000 + n * 0x10101)
+        self.u.reg_write(regs.UC_ARM64_REG_X28, 0)
+        self.u.reg_write(regs.UC_ARM64_REG_X30, self.symbols['fixture_return'])
+        self.u.reg_write(regs.UC_ARM64_REG_SP, self.symbols['__stack_end'])
+        self.u.reg_write(regs.UC_ARM64_REG_NZCV, 0xa0000000)
+        self.direct = direct
+        if direct:
+            args = (index, self.symbols['fixture_output'], self.symbols['fixture_fault'])
+            self.entry = self.symbols['sspm_guard_read']
+        else:
+            args = (self.symbols['fixture_record'], self.symbols['fixture_identity'])
+            self.entry = self.symbols['sspm_probe_run']
+        for n, value in enumerate(args):
+            self.u.reg_write(register('x' + str(n)), value)
+        self.fault_at, self.fault = fault_at, fault or {}
+        self.stall_at, self.values = stall_at, values
+        self.tick_step, self.mutate, self.nested = tick_step, mutate, nested
+        self.external_change = external_change
+        self.after_load_fault, self.stop_pc = after_load_fault, stop_pc
+        self.attempts, self.device_reads, self.memory_writes = [], [], []
+        self.system_writes, self.exceptions, self.erets, self.fatal = [], [], [], []
+        self.returned = self.stalled = self.nested_injected = False
+        self.instruction_count = 0
+        self.minimum_sp = self.u.reg_read(regs.UC_ARM64_REG_SP)
+        self.u.hook_add(UC_HOOK_CODE, self.code)
+        self.u.hook_add(UC_HOOK_MEM_READ, self.read)
+        self.u.hook_add(UC_HOOK_MEM_WRITE, self.write)
+
+    def gprs(self):
+        return [self.u.reg_read(register('x' + str(n))) for n in range(31)]
+
+    def read(self, cpu, access, address, size, value, unused):
+        if address < self.base or address >= self.end:
+            assert address in ADDRESSES + EXTERNAL, hex(address)
+            assert size == 4, (hex(address), size)
+            self.device_reads.append(address)
+            if address in EXTERNAL and self.external_change:
+                self.external_change(self, address)
+
+    def write(self, cpu, access, address, size, value, unused):
+        assert self.base <= address and address + size <= self.end, ('unexpected hardware store', hex(address), size)
+        self.memory_writes.append((address, size, value))
+
+    def inject(self, address, overrides=None):
+        override = overrides or {}
+        interrupted = self.gprs()
+        self.system['elr_el1'] = override.get('elr', address)
+        self.system['esr_el1'] = override.get('esr', 0x96000010)
+        self.system['far_el1'] = override.get('far', self.u.reg_read(regs.UC_ARM64_REG_X16))
+        self.system['spsr_el1'] = override.get('spsr',
+            self.u.reg_read(regs.UC_ARM64_REG_NZCV) | self.system['daif'] | 5)
+        self.system['currentel'] = override.get('el', 4)
+        self.system['spsel'] = override.get('spsel', 1)
+        self.system['daif'] = 0x3c0
+        if 'mpidr' in override: self.system['mpidr_el1'] = override['mpidr']
+        self.exceptions.append({'gprs': interrupted, 'sp': self.u.reg_read(regs.UC_ARM64_REG_SP),
+                                'elr': self.system['elr_el1']})
+        slot = override.get('vector', 4)
+        self.u.reg_write(regs.UC_ARM64_REG_PC, self.system['vbar_el1'] + slot * 128)
+
+    def code(self, cpu, address, size, unused):
+        self.instruction_count += 1
+        sp = cpu.reg_read(regs.UC_ARM64_REG_SP)
+        self.minimum_sp = min(self.minimum_sp, sp)
+        assert sp % 16 == 0, ('misaligned SP', hex(address), hex(sp))
+        assert self.symbols['__stack_start'] <= sp <= self.symbols['__stack_end']
+        if address == self.symbols['fixture_return']:
+            self.returned = True; cpu.emu_stop(); return
+        if self.symbols['physical_vectors'] <= address < self.symbols['physical_vectors'] + 2048:
+            self.fatal.append({'vector': (address-self.symbols['physical_vectors']) // 128,
+                'gprs': self.gprs(), 'sp': sp, 'x28': cpu.reg_read(regs.UC_ARM64_REG_X28)})
+            # Ordinary unsupported exceptions delegate to the actual old slot.
+            # For nested cases execute its real branch + fatal recursion test.
+            if not self.nested_injected:
+                cpu.emu_stop(); return
+        if address == self.symbols['physical_halt']:
+            self.stalled = True; cpu.emu_stop(); return
+        if address == self.stop_pc:
+            self.stalled = True; cpu.emu_stop(); return
+        if self.nested and not self.nested_injected and address == self.symbols['sspm_guard_sync'] + 8:
+            self.nested_injected = True; self.inject(address); return
+        if address == self.symbols['sspm_guard_load']:
+            number = len(self.attempts)
+            target = cpu.reg_read(regs.UC_ARM64_REG_X16)
+            assert target in ADDRESSES
+            self.attempts.append(target)
+            if self.mutate: self.mutate(self, number)
+            if number == self.stall_at:
+                self.stalled = True; cpu.emu_stop(); return
+            if number == self.fault_at:
+                self.inject(address, self.fault); return
+            value = self.values(number, target) if self.values else 0
+            cpu.mem_write(target, struct.pack('<I', value))
+        if address == self.symbols['sspm_guard_after_load'] and self.after_load_fault is not None:
+            fault, self.after_load_fault = self.after_load_fault, None
+            self.inject(address, fault); return
+        instruction = self.program.instructions[address]
+        operands = [p.strip() for p in instruction.op_str.split(',')]
+        if instruction.mnemonic == 'mrs':
+            name = operands[1].lower()
+            if name == 'nzcv': value = cpu.reg_read(regs.UC_ARM64_REG_NZCV)
+            else:
+                value = self.system[name]
+                if name == 'cntpct_el0': self.system[name] += self.tick_step
+            cpu.reg_write(register(operands[0]), value)
+            cpu.reg_write(regs.UC_ARM64_REG_PC, address+4)
+        elif instruction.mnemonic == 'msr':
+            name = operands[0].lower()
+            if name == 'daifset':
+                value = self.system['daif'] | (int(operands[1].lstrip('#'), 0) << 6)
+                name = 'daif'
+            else:
+                value = 0 if operands[1] == 'xzr' else cpu.reg_read(register(operands[1]))
+            if name == 'nzcv': cpu.reg_write(regs.UC_ARM64_REG_NZCV, value)
+            else: self.system[name] = value
+            self.system_writes.append((name, value))
+            cpu.reg_write(regs.UC_ARM64_REG_PC, address+4)
+        elif instruction.mnemonic == 'eret':
+            context = struct.unpack('<8Q', cpu.mem_read(self.symbols['sspm_guard_context'], 64))
+            assert context[0] == 0 and context[1] == 1, 'recovery must disarm before ERET'
+            assert self.gprs() == self.exceptions[-1]['gprs'], 'handler GPR restoration'
+            assert sp == self.exceptions[-1]['sp'], 'handler SP restoration'
+            self.erets.append(self.system['elr_el1'])
+            self.system['daif'] = self.system['spsr_el1'] & 0x3c0
+            cpu.reg_write(regs.UC_ARM64_REG_NZCV, self.system['spsr_el1'] & 0xf0000000)
+            cpu.reg_write(regs.UC_ARM64_REG_PC, self.system['elr_el1'])
+        elif instruction.mnemonic in ('dsb', 'isb'):
+            cpu.reg_write(regs.UC_ARM64_REG_PC, address+4)
+
+    def run(self):
+        self.initial_gprs = self.gprs()
+        self.initial_sp = self.u.reg_read(regs.UC_ARM64_REG_SP)
+        self.initial_nzcv = self.u.reg_read(regs.UC_ARM64_REG_NZCV)
+        self.initial_daif = self.system['daif']
+        self.initial_vbar = self.system['vbar_el1']
+        self.u.emu_start(self.entry, self.end, count=100000)
+        assert self.returned or self.stalled or self.fatal, 'fixture instruction budget exhausted'
+        if self.returned:
+            assert self.u.reg_read(regs.UC_ARM64_REG_SP) == self.initial_sp
+            assert self.system['vbar_el1'] == self.initial_vbar
+            assert self.system['daif'] == self.initial_daif
+            if self.direct:
+                assert self.gprs()[1:] == self.initial_gprs[1:]
+                assert self.u.reg_read(regs.UC_ARM64_REG_NZCV) == self.initial_nzcv
+        return self
+
+    def record(self):
+        return bytes(self.u.mem_read(self.symbols['fixture_record'], 1024))
+
+    def output(self):
+        return bytes(self.u.mem_read(self.symbols['fixture_output'], 4))
+
+    def result(self):
+        return self.u.reg_read(regs.UC_ARM64_REG_X0) & 0xffffffff
diff --git a/tools/mt6762/physical/sspm/test_probe.py b/tools/mt6762/physical/sspm/test_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..d88392707ecba98775a5f4a0acf00cb769d1e8d8
--- /dev/null
+++ b/tools/mt6762/physical/sspm/test_probe.py
@@ -0,0 +1,313 @@
+#!/usr/bin/env python3
+"""Real AArch64 C/assembly execution, exception predicates and record validation."""
+import json
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+import unittest
+
+from unicorn import UcError
+from unicorn import arm64_const as regs
+from probe_fixture import Program, Machine, ADDRESSES, EXTERNAL, IDENTITY, register
+from decode import decode
+
+
+class ProbeTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.directory = tempfile.TemporaryDirectory(prefix='sspm-guard-tests-')
+        cls.program = Program(cls.directory.name)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.directory.cleanup()
+
+    def decoded(self, machine):
+        return decode(machine.record(), IDENTITY, self.program.symbols['sspm_guard_load'],
+                      self.program.symbols['physical_vectors'])
+
+    def test_link_layout_and_actual_vector_instructions(self):
+        p = self.program
