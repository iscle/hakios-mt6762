+/* SPDX-License-Identifier: MIT
+ * Tiny original 5x7 diagnostic font. Call only after framebuffer admission.
+ */
+#ifndef MTK_DIAGNOSTIC_CONSOLE_H
+#define MTK_DIAGNOSTIC_CONSOLE_H
+#include <stdint.h>
+static const uint8_t diagnostic_font[36][7] = {
+ {14,17,19,21,25,17,14},{4,12,4,4,4,4,14},{14,17,1,2,4,8,31},
+ {30,1,1,14,1,1,30},{2,6,10,18,31,2,2},{31,16,16,30,1,1,30},
+ {14,16,16,30,17,17,14},{31,1,2,4,8,8,8},{14,17,17,14,17,17,14},
+ {14,17,17,15,1,1,14},
+ {14,17,17,31,17,17,17},{30,17,17,30,17,17,30},{14,17,16,16,16,17,14},
+ {30,17,17,17,17,17,30},{31,16,16,30,16,16,31},{31,16,16,30,16,16,16},
+ {14,17,16,23,17,17,15},{17,17,17,31,17,17,17},{14,4,4,4,4,4,14},
+ {7,2,2,2,2,18,12},{17,18,20,24,20,18,17},{16,16,16,16,16,16,31},
+ {17,27,21,21,17,17,17},{17,25,21,19,17,17,17},{14,17,17,17,17,17,14},
+ {30,17,17,30,16,16,16},{14,17,17,17,21,18,13},{30,17,17,30,20,18,17},
+ {15,16,16,14,1,1,30},{31,4,4,4,4,4,4},{17,17,17,17,17,17,14},
+ {17,17,17,17,17,10,4},{17,17,17,21,21,21,10},{17,17,10,4,10,17,17},
+ {17,17,10,4,4,4,4},{31,1,2,4,8,16,31}
+};
+struct diagnostic_console { volatile uint32_t *pixels; unsigned column, row; };
+static void diagnostic_clear(struct diagnostic_console *c)
+{
+    if (!c->pixels) return;
+    for (unsigned n = 0; n < 384u * 854u; ++n) c->pixels[n] = 0xff000000u;
+    c->column = c->row = 0;
+}
+static void diagnostic_character(struct diagnostic_console *c, char ch)
+{
+    if (!c->pixels) return;
+    /* Keep additions bounded even after repeated linefeeds or a bad cursor. */
+    if (c->column > 384) c->column = 0;
+    if (c->row > 838) c->row = 0;
+    if (ch == '\r') {c->column = 0; return;}
+    if (ch == '\n') {c->column = 0; c->row = c->row > 822 ? 0 : c->row + 16; return;}
+    if (c->column + 12 > 384) {c->column = 0; c->row += 16;}
+    if (c->row + 16 > 854) c->row = 0;
+    if (ch >= 'a' && ch <= 'z') ch -= 'a'-'A';
+    int index = ch >= '0' && ch <= '9' ? ch-'0' : ch >= 'A' && ch <= 'Z' ? ch-'A'+10 : -1;
+    for (unsigned y=0; y<16; ++y) for (unsigned x=0; x<12; ++x) {
+        unsigned bits = index >= 0 && y < 14 ? diagnostic_font[index][y/2] : 0;
+        if (index < 0 && ch != ' ' && ch != '\t' && (y == 6 || y == 7)) bits = 4;
+        c->pixels[(c->row+y)*384+c->column+x] = x<10 && (bits & (16u>>(x/2))) ? 0xffffffffu : 0xff000000u;
+    }
+    c->column += 12;
+}
+#endif
diff --git a/tools/mt6762/physical/display_probe.h b/tools/mt6762/physical/display_probe.h
new file mode 100644
index 0000000000000000000000000000000000000000..93af42e5cd07b3401382a9cae54a5d7bb903dde7
--- /dev/null
+++ b/tools/mt6762/physical/display_probe.h
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: MIT -- read-only inherited scanout diagnostic. */
+#ifndef MTK_DISPLAY_PROBE_H
+#define MTK_DISPLAY_PROBE_H
+#include <stdint.h>
+#include <stddef.h>
+#include "fdt_handoff.h"
+#include "../hardware/display-touch/mt6762_display_core.h"
+
+enum display_probe_state {
+    DISPLAY_UNTOUCHED, DISPLAY_TAG, DISPLAY_BOUNDS, DISPLAY_RESERVATION,
+    DISPLAY_POWER, DISPLAY_GATES, DISPLAY_SOURCES, DISPLAY_SCANOUT,
+    DISPLAY_ACCEPTED, DISPLAY_READING, DISPLAY_DATAPATH
+};
+/* Only fields selected by read_mask were observed. Pass is one-based for MMIO.
+ * The immutable build identity matches the separate loader phase record.
+ * A completed record is evidence of validation, never native ownership. */
+struct display_probe_record {
+    uint8_t magic[8]; uint32_t version, size; uint8_t identity[32];
+    uint32_t state, pass, read_mask, state_inverse;
+    uint64_t tag_base, tag_size;
+    uint32_t tag_present, tag_found;
+    uint32_t power[3], gates, sources, layer;
+    struct mt6762_ovl_snapshot scanout[4];
+    uint32_t datapath, sbch, reserved[18];
+};
+_Static_assert(sizeof(struct display_probe_record) == 512, "display record size");
+_Static_assert(offsetof(struct display_probe_record, state) == 48, "display state offset");
+_Static_assert(offsetof(struct display_probe_record, scanout) == 112, "display snapshot offset");
+extern volatile struct display_probe_record physical_display;
+struct display_probe_io {
+    void *context;
+    uint32_t (*read)(void *, uint64_t);
+    void (*barrier)(void *);
+};
+static inline void display_probe_commit(volatile struct display_probe_record *r,
+    const struct display_probe_io *io, uint32_t state)
+{
+    r->state_inverse = ~state;
+    io->barrier(io->context);
+    r->state = state;
+    io->barrier(io->context);
+}
+static inline uint64_t display_probe_console(const struct mtk_fdt_framebuffer *tag,
+    int reserved, const struct display_probe_io *io, volatile struct display_probe_record *r)
+{
+    display_probe_commit(r, io, DISPLAY_READING);
+    r->tag_base = tag->base; r->tag_size = tag->size;
+    r->tag_present = tag->present; r->tag_found = tag->found;
+    r->pass = 0; r->read_mask = 1;
+    uint32_t failure = DISPLAY_TAG;
+    if (!(tag->present & 16) || tag->found != 1) goto refuse;
+    struct mt6762_fb_layout fb = {tag->base, 0x144000, tag->base, tag->size,
+        384, 854, 1536, 1, 0};
+    failure = DISPLAY_BOUNDS;
+    if (!mt6762_fb_bounds(&fb)) goto refuse;
+    failure = DISPLAY_RESERVATION;
+    if (!reserved) goto refuse;
+    uint64_t selected = 0;
+    for (unsigned pass = 1; pass <= 2; ++pass) {
+        r->pass = pass; r->read_mask = 1;
+        for (unsigned n = 0; n < 3; ++n)
+            r->power[n] = io->read(io->context, n == 0 ? 0x10006180 : n == 1 ? 0x10006184 : 0x1000630c);
+        r->read_mask |= 2;
+        failure = DISPLAY_POWER;
+        if (!mt6762_display_power(r->power[0], r->power[1], r->power[2])) goto refuse;
+        r->gates = io->read(io->context, 0x14000100); r->read_mask |= 4;
+        failure = DISPLAY_GATES;
+        if (r->gates & ((1u<<7)|(1u<<10)|(1u<<17)|(1u<<19)|(1u<<20)|(1u<<28))) goto refuse;
+        uint32_t sources = io->read(io->context, 0x1400b02c);
+        r->sources = sources; r->read_mask |= 8;
+        failure = DISPLAY_SOURCES;
+        if (!sources || (sources & ~15u)) goto refuse;
+        fb.layer = sources == 1 ? 0 : sources == 2 ? 1 : sources == 4 ? 2 : 3;
+        r->layer = fb.layer;
+        /* Record every enabled hardware layer, including rejected multi-layer
+         * states. Bounds/power/gates still precede every display-block read.
+         * Admission allows either the single layer or the measured LK menu
+         * profile, after validating global controls below. */
+        for (unsigned index = 0; index < 4; ++index) {
+            if (!(sources & (1u << index))) continue;
+            uint64_t layer = index * 0x20;
+#define R(address) io->read(io->context, (address))
+            struct mt6762_ovl_snapshot s = {
+                R(0x1400b00c), sources, R(0x1400b324), R(0x1400b020),
+                R(0x1400b030+layer), R(0x1400bf40+layer), R(0x1400b044+layer),
+                R(0x1400b038+layer), R(0x1400b03c+layer), R(0x1400b04c+layer),
+                R(0x1400b0c0+layer), R(0x1400d010), R(0x14014000),
+                R(0x14014014), R(0x14014018), R(0x1401402c),
+                R(0x1401401c), R(0x14014020), R(0x14014024), R(0x14014028)
+            };
+#undef R
+            r->scanout[index] = s;
+        }
+        r->read_mask |= 16;
+        r->datapath = io->read(io->context, 0x1400b024);
+        r->sbch = io->read(io->context, 0x1400b3a0);
+        r->read_mask |= 32;
+        failure = DISPLAY_DATAPATH;
+        /* Allow only SMI IDs, output rounding disable, GCLAST and clamp.
+         * Reject GPU/PQ/bypass/interlace/background routing and all SBCH
+         * caching. Also admit capture10's exact wide-gamut profile: both LK
+         * and stock Linux preserve bit31 with the same BGRA fetch layout.
+         * Preserve it; its precise color transfer function remains unknown. */
+        if (!mt6762_display_datapath(r->datapath, r->sbch)) goto refuse;
+        uint64_t candidate = 0;
+        if (sources == 3) {
+            struct mt6762_ovl_snapshot layers[2] = {r->scanout[0], r->scanout[1]};
+            candidate = mt6762_boot_menu_buffer(tag->base, tag->size, layers);
+            r->layer = 1;
+        } else if (!(sources & (sources-1))) {
+            struct mt6762_ovl_snapshot s = r->scanout[fb.layer];
+            if (mt6762_ovl_matches(&fb, &s)) candidate = tag->base;
+        } else {
+            failure = DISPLAY_SOURCES; goto refuse;
+        }
+        failure = DISPLAY_SCANOUT;
+        if (!candidate || (pass == 2 && selected != candidate)) goto refuse;
+        selected = candidate;
+    }
+    display_probe_commit(r, io, DISPLAY_ACCEPTED);
+    return selected;
+refuse:
+    display_probe_commit(r, io, failure);
+    return 0;
+}
+#endif
diff --git a/tools/mt6762/physical/display_record.py b/tools/mt6762/physical/display_record.py
new file mode 100644
index 0000000000000000000000000000000000000000..7d97039dde57abaa4e272551c8e30c3636ba7a4a
--- /dev/null
+++ b/tools/mt6762/physical/display_record.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""Decode the loader's build-bound display validation; never assert ownership."""
+import argparse
+import json
+from pathlib import Path
+import struct
+
+OFFSET, ADDRESS, SIZE = 0x4100, 0x40084100, 512
+MAGIC = b'MTKDSP01'
+STATES = ('untouched', 'tag', 'bounds', 'reservation', 'power', 'gates',
+          'sources', 'scanout', 'accepted', 'reading-incomplete', 'datapath')
+SNAPSHOT = ('en', 'sources', 'ext_sources', 'roi', 'con', 'address', 'pitch',
+            'size', 'offset', 'clip', 'rdma', 'downstream_rdma', 'dsi_start',
+            'dsi_mode', 'dsi_lanes', 'dsi_active', 'dsi_ps', 'dsi_vsa',
+            'dsi_vbp', 'dsi_vfp')
+
+
+def initialized(identity, version=2):
+    if len(identity) != 32:
+        raise ValueError('32-byte build identity required')
+    return (MAGIC + struct.pack('<II', version, SIZE) + identity +
+            struct.pack('<4I', 0, 0, 0, 0xffffffff) + bytes(SIZE - 64))
+
+
+def decode(data, identity):
+    if len(data) != SIZE or len(identity) != 32:
+        raise ValueError('exact512-byte display record and32-byte identity required')
+    version, size = struct.unpack_from('<II', data, 8)
+    if data[:8] != MAGIC or version not in (1,2) or size != SIZE:
+        raise ValueError('malformed display magic/version/size')
+    if data[16:48] != identity:
+        raise ValueError('stale or different-build display record')
+    state, pass_number, mask, inverse = struct.unpack_from('<4I', data, 48)
+    reserved_offset = 432 if version == 1 else 440
+    if (state >= len(STATES) or (version == 1 and state == 10) or
+        state ^ inverse != 0xffffffff or any(data[reserved_offset:])):
+        raise ValueError('malformed or torn display commit')
+    expected_masks = {0:(0,), 1:(1,), 2:(1,), 3:(1,), 4:(3,), 5:(7,), 6:(15,31), 7:(31,), 8:(31,)}
+    if version == 2:
+        expected_masks.update({6:(15,63),7:(63,),8:(63,),10:(63,)})
+    if mask & ~(31 if version == 1 else 63) or (state != 9 and mask not in expected_masks[state]):
+        raise ValueError('invalid display read mask')
+    if ((state == 0 and data != initialized(identity,version)) or
+        (state in (1,2,3) and pass_number != 0) or
+        (state in (4,5,6,7,10) and pass_number not in (1,2)) or
+        (state == 8 and pass_number != 2) or pass_number > 2):
+        raise ValueError('invalid display pass')
+    result = dict(version=version,state=state, state_name=STATES[state], pass_number=pass_number,
+                  read_mask=mask, identity=identity.hex(), accepted=state == 8,
+                  native_ownership=False, physical_retention_proven=False)
+    if mask & 1:
+        base, size, present, found = struct.unpack_from('<2Q2I', data, 64)
+        result['tag'] = dict(base=base, size=size, present=present, found=found)
+    if mask & 2:
+        result['power'] = list(struct.unpack_from('<3I', data, 88))
+    if mask & 4:
+        result['gates'], = struct.unpack_from('<I', data, 100)
+    if mask & 8:
+        result['sources'], = struct.unpack_from('<I', data, 104)
+    if mask & 16:
+        if state == 8 or not (result['sources'] & (result['sources'] - 1)):
+            result['layer'], = struct.unpack_from('<I', data, 108)
+        if not 0 < result['sources'] <= 15:
+            raise ValueError('invalid observed display sources')
+        result['scanout'] = {str(i):dict(zip(SNAPSHOT, struct.unpack_from('<20I', data, 112+i*80)))
+                             for i in range(4) if result['sources'] & (1 << i)}
+    if mask & 32:
+        result['datapath'], result['sbch'] = struct.unpack_from('<2I', data, 432)
+    return result
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('record', type=Path)
+    parser.add_argument('--manifest', type=Path, required=True)
+    args = parser.parse_args()
+    identity = bytes.fromhex(json.loads(args.manifest.read_text())['trace']['identity'])
+    print(json.dumps(decode(args.record.read_bytes(), identity), indent=2))
