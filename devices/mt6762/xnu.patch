@@ -0,0 +1,44 @@
+"""Run the actual short-poll wrapper with a deterministic13MHz clock."""
+from pathlib import Path
+import subprocess,tempfile
+HERE=Path(__file__).resolve().parent
+source=(HERE.parents[3]/'bsd/dev/mt6762_power.c').read_text()
+start=source.index('static void pwrap_wacs_delay('); opening=source.index('{',start)
+end=opening+1;depth=1
+while depth:
+    depth+=(source[end]=='{')-(source[end]=='}');end+=1
+function=source[start:end]
+assert function.count('__asm__ volatile("yield" ::: "memory");')==1
+function=function.replace('__asm__ volatile("yield" ::: "memory");','hints++;')
+header=r'''
+#include <stdint.h>
+#include <assert.h>
+#include <stdio.h>
+#define NSEC_PER_USEC 1000
+static uint64_t ticks;
+static unsigned hints,sleeps,last_sleep,clock_reads;
+static void delay(unsigned us){sleeps++;last_sleep=us;}
+static uint64_t mach_absolute_time(void){clock_reads++;return ticks++;}
+static void clock_interval_to_absolutetime_interval(unsigned us,unsigned scale,uint64_t *result){
+ assert(scale==1000);*result=(uint64_t)us*13;
+}
+'''
+cases=r'''
+int main(void){
+ pwrap_wacs_delay(0,0);assert(!clock_reads && !sleeps && !hints);
+ for(unsigned us=1;us<=10;us++){
+  uint64_t initial=ticks;unsigned previous=hints;
+  pwrap_wacs_delay(0,us);
+  assert(!sleeps && ticks-initial>=us*13 && hints-previous==us*13-1);
+ }
+ ticks=UINT64_MAX-4;unsigned previous=hints;
+ pwrap_wacs_delay(0,10);assert(ticks==126 && hints-previous==129);
+ unsigned reads=clock_reads;pwrap_wacs_delay(0,11);
+ assert(sleeps==1 && last_sleep==11 && reads==clock_reads);
+ puts("PASS: actual WACS short-poll wrapper,13MHz elapsed timing/wrap/zero/long-delay fallback");
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+ p=Path(tmp);(p/'test.c').write_text(header+function+cases)
+ subprocess.run(['cc','-std=c11','-O2','-Wall','-Wextra','-Werror',str(p/'test.c'),'-o',str(p/'test')],check=True)
+ subprocess.run([str(p/'test')],check=True,timeout=5)
diff --git a/tools/mt6762/hardware/power/thermistor.c b/tools/mt6762/hardware/power/thermistor.c
new file mode 100644
index 0000000000000000000000000000000000000000..b1eea196ee0353b34192f484e6746333b4bfd9aa
--- /dev/null
+++ b/tools/mt6762/hardware/power/thermistor.c
@@ -0,0 +1,47 @@
+#include "thermistor.h"
+/* Recovered Fg_Temperature_Table at stock VA 0xffffff800987b7d8.
+ * Nominal degrees C = -40 + 5*index; resistance in ohms. */
+static const uint32_t resistance[]={195652,148171,113347,87559,68237,
+ 53650,42506,33892,27219,22021,17926,14674,12081,10000,8315,6948,
+ 5834,4917,4161,3535,3014};
+int mt6357_ntc_temperature(uint32_t adc_mv,uint32_t pullup_mv,
+                          uint32_t pullup_ohms,int *out_deci_c)
+{
+    uint64_t r;
+    unsigned i;
+    if (!out_deci_c || !adc_mv || adc_mv>=pullup_mv || !pullup_ohms)
+        return -1;
+    r=(uint64_t)adc_mv*pullup_ohms/(pullup_mv-adc_mv);
+    if (r>resistance[0] || r<resistance[20]) return -1;
+    for(i=1;i<21;i++) {
+        if(r>=resistance[i]) {
+            int cold=-400+50*(int)(i-1),warm=cold+50;
+            int64_t numerator=(int64_t)(r-resistance[i])*cold+
+                (int64_t)(resistance[i-1]-r)*warm;
+            *out_deci_c=(int)(numerator/(resistance[i-1]-resistance[i]));
+            return 0;
+        }
+    }
+    return -1;
+}
+
+int mt6357_ntc_compensated_temperature(uint32_t adc_mv,uint32_t bif_mv,
+    uint32_t pullup_ohms,int32_t current_ua,uint32_t com_fg,
+    uint32_t com_rfg,unsigned no_comp,int *out_deci_c)
+{
+    int64_t current=current_ua;
+    int64_t delta,corrected,bif;
+    uint64_t resistance;
+    if(no_comp>1 || !out_deci_c) return -1;
+    if(current<0) current=-current;
+    resistance=(no_comp?0:(uint64_t)com_fg)+com_rfg;
+    /* Original current is in 0.1 mA and truncates to whole mA first. */
+    delta=(int64_t)(((uint64_t)(current/1000)*resistance)/10000);
+    if(current_ua>0) delta=-delta;
+    corrected=(int64_t)adc_mv+delta;
+    bif=(int64_t)bif_mv+delta;
+    if(corrected<=0 || corrected>UINT32_MAX || bif<=0 || bif>UINT32_MAX)
+        return -1;
+    return mt6357_ntc_temperature((uint32_t)corrected,(uint32_t)bif,
+                                  pullup_ohms,out_deci_c);
+}
diff --git a/tools/mt6762/hardware/power/thermistor.h b/tools/mt6762/hardware/power/thermistor.h
