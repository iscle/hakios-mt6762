@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: MIT */
+#include "trial_deadline.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+struct clean_test {uintptr_t first,last;size_t count;};
+static void cleaned(uintptr_t p,void *opaque)
+{
+    struct clean_test *c=opaque;
+    assert(!(p&63));
+    if(!c->count)c->first=p;else assert(p==c->last+64);
+    c->last=p;++c->count;
+}
+int main(void)
+{
+    static const char *bad[]={"","59","1801","-60","+60","0x3c","60x",
+        " 60","60 ","4294967356","18446744073709551676"};
+    unsigned seconds;
+    for(size_t i=0;i<sizeof(bad)/sizeof(bad[0]);i++) {
+        seconds=123;assert(!mtk_trial_parse(bad[i],strlen(bad[i])+1,&seconds));
+        assert(!seconds);
+    }
+    const char unterminated[2]={'6','0'};
+    assert(!mtk_trial_parse(unterminated,sizeof(unterminated),&seconds));
+    assert(mtk_trial_parse("0",2,&seconds)&&!seconds);
+    assert(mtk_trial_parse("60",3,&seconds)&&seconds==60);
+    assert(mtk_trial_parse("1800",5,&seconds)&&seconds==1800);
+    struct mtk_trial_deadline t={.seconds=60};
+    assert(!mtk_trial_expired(&t,UINT64_MAX)); /* No feed: not armed. */
+    mtk_trial_fed(&t,UINT64_C(90000000000));
+    mtk_trial_fed(&t,UINT64_C(120000000000)); /* Cannot extend deadline. */
+    assert(t.first_ns==UINT64_C(90000000000));
+    assert(!mtk_trial_expired(&t,UINT64_C(149999999999)));
+    assert(mtk_trial_expired(&t,UINT64_C(150000000000)));
+    assert(mtk_trial_expired(&t,0)); /* Latched even with a backwards clock. */
+    t=(struct mtk_trial_deadline){.seconds=0};
+    mtk_trial_fed(&t,0);assert(!mtk_trial_expired(&t,UINT64_MAX));
+    t=(struct mtk_trial_deadline){.seconds=1800};
+    mtk_trial_fed(&t,UINT64_MAX-UINT64_C(1800000000000));
+    assert(!mtk_trial_expired(&t,UINT64_MAX-1));
+    assert(mtk_trial_expired(&t,UINT64_MAX));
+    t=(struct mtk_trial_deadline){.seconds=60};
+    mtk_trial_fed(&t,100);assert(!mtk_trial_expired(&t,99));
+    struct clean_test c={0};
+    assert(!mtk_trial_clean_range(0x100000,1536*1024,cleaned,&c));
+    assert(c.count==24576&&c.first==0x100000&&c.last==0x27ffc0);
+    c=(struct clean_test){0};
+    assert(!mtk_trial_clean_range(0x103f,2,cleaned,&c));
+    assert(c.count==2&&c.first==0x1000&&c.last==0x1040);
+    c=(struct clean_test){0};
+    assert(mtk_trial_clean_range(UINTPTR_MAX,2,cleaned,&c)==-1&&!c.count);
+    assert(!mtk_trial_clean_range(UINTPTR_MAX,1,cleaned,&c)&&c.count==1);
+    assert(!mtk_trial_clean_range(0,0,NULL,NULL));
+    puts("PASS: deadline admission/bounds/anchor/latch and fixed-range cache maintenance");
+}
diff --git a/tools/mt6762/hardware/watchdog/test_worker.py b/tools/mt6762/hardware/watchdog/test_worker.py
new file mode 100644
index 0000000000000000000000000000000000000000..533ec3e23d502c9d87feab706616a49912523a1d
--- /dev/null
+++ b/tools/mt6762/hardware/watchdog/test_worker.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Execute the actual worker/init C against deterministic clocks and MMIO.
+
+Only ARM cache/barrier instructions are removed for this host-only harness.
+It does not model watchdog acceptance, IRQ/reset timing or RAM retention.
+"""
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+here = Path(__file__).resolve().parent
+root = here.parents[3]
+source = (root / 'bsd/dev/mt6762_platform.c').read_text()
+worker = source[source.index('static uintptr_t watchdog;'):source.index('\n#else\nvoid mt6762_platform_init')]
+worker, removed = re.subn(r'__asm__ volatile\([^;]+;', '(void)0;', worker)
+assert removed == 4, 'review changed ARM cache/barrier sites before updating this harness'
+preamble = r'''
+#include "trial_deadline.h"
+#include <assert.h>
+#include <setjmp.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+typedef void *thread_t;
+typedef int wait_result_t;
+typedef void *event_t;
+#define NSEC_PER_MSEC 1000000
+#define THREAD_UNINT 0
+#define THREAD_CONTINUE_NULL NULL
+#define KERN_SUCCESS 0
+static int ready=1;
+static uint64_t fake_ns;
+static unsigned writes,flushes,blocks,change_after,gap_after;
+static const char *arg;
+static jmp_buf stop;
+static uint32_t r32(uintptr_t base,unsigned offset) {
+    assert(base==0x10007000);
+    switch(offset) {
+    case 0:return change_after&&writes>=change_after ? 0x7c:0x7d;
+    case 4:return 0xf000;
+    case 0x30:return 0x3f0036;
+    case 0x34:return 0x3b0034;
+    case 0xc:case 0x20:case 0x24:return 0;
+    default:assert(0);return 0;
+    }
+}
+static void w32(uintptr_t base,unsigned offset,uint32_t value) {
+    assert(base==0x10007000&&offset==8&&value==0x1971);++writes;
+}
+static void kprintf(const char *format,...) {(void)format;}
+static void clock_get_uptime(uint64_t *now) {*now=fake_ns;}
+static void absolutetime_to_nanoseconds(uint64_t ticks,uint64_t *ns) {*ns=ticks;}
+static void clock_interval_to_deadline(unsigned n,unsigned unit,uint64_t *out) {
+    assert(n==1000&&unit==NSEC_PER_MSEC);*out=fake_ns+1000000000;
+}
+static void assert_wait_deadline(event_t e,int mode,uint64_t deadline) {
+    (void)e;assert(mode==0&&deadline==fake_ns+1000000000);
+}
+static void thread_block(void *continuation) {
+    assert(!continuation);++blocks;
+    if(blocks==2000)longjmp(stop,2);
+    fake_ns+=gap_after&&writes==gap_after ? UINT64_C(11000000000):UINT64_C(1000000000);
+}
+static thread_t current_thread(void) {return NULL;}
+static void thread_terminate(thread_t t) {(void)t;longjmp(stop,1);}
+static int flag(const char *name) {assert(!strcmp(name,"watchdog-refresh-owned"));return 1;}
+static void *mt6762_map_mmio(uint64_t base,size_t bytes) {
+    assert(base==0x10007000&&bytes==4096);return (void *)(uintptr_t)base;
+}
+static int PE_parse_boot_arg_str(const char *name,char *out,int capacity) {
+    assert(!strcmp(name,"mt6762_trial_seconds"));
+    if(!arg)return 0;
+    snprintf(out,(size_t)capacity,"%s",arg);return 1;
+}
+static int kernel_thread_start(void (*fn)(void *,wait_result_t),void *p,thread_t *out) {
+    (void)fn;assert(!p);*out=NULL;return 0;
+}
+static void thread_deallocate(thread_t t) {(void)t;}
+static unsigned mt6762_trial_flush_log(uint32_t *before,uint32_t *after) {
+    ++flushes;*before=128;*after=129;return MTK_TRIAL_CONCURRENT_LOG;
+}
+'''
+tests = r'''
+static void run(const char *argument,unsigned changes,unsigned gap,unsigned expected_writes,int expiry) {
+    fake_ns=UINT64_C(7000000000);writes=flushes=blocks=0;
+    change_after=changes;gap_after=gap;arg=argument;
+    watchdog=0;watchdog_trial_seconds=0;
+    memset(&mt6762_trial_record,0,sizeof(mt6762_trial_record));
+    mt6762_watchdog_init();
+    int stopped=setjmp(stop);
+    if(!stopped)watchdog_worker(NULL,0);
+    assert(writes==expected_writes);
+    assert(flushes==(unsigned)expiry);
+    if(expiry) {
+        assert(stopped==1&&mt6762_trial_record.state==3);
+        assert(mt6762_trial_record.first_feed_ns==UINT64_C(7000000000));
+        assert(mt6762_trial_record.last_feed_ns==fake_ns-UINT64_C(1000000000));
+        assert(mt6762_trial_record.expired_ns==fake_ns);
+        assert(mt6762_trial_record.attempts==expected_writes);
+        assert(mt6762_trial_record.mode==0x7d&&mt6762_trial_record.length==0xf000);
+        assert(mt6762_trial_record.flags==MTK_TRIAL_CONCURRENT_LOG);
+    }
+}
+int main(void) {
+    run(NULL,0,0,2000,0);run("0",0,0,2000,0);
+    run("60",0,0,60,1);run("1800",0,0,1800,1);
+    run("59",0,0,2000,0);run("1801",0,0,2000,0);
+    run("4294967356",0,0,2000,0);run("-60",0,0,2000,0);
+    run(NULL,10,0,10,0);run("60",10,0,10,0);
+    run(NULL,0,20,20,0);run("60",0,20,20,0);
+    puts("PASS:12 actual worker/init executions; exact RESTART-only stores, deadline cessation, unchanged default/failure paths");
+}
+'''
+with tempfile.TemporaryDirectory(prefix='mt6762-trial-') as directory:
+    path = Path(directory)
+    (path / 'test.c').write_text(preamble + worker + tests)
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=c11', '-Wall', '-Wextra',
+                    '-Werror', '-Wno-unused-parameter', '-I', str(here),
+                    str(path / 'test.c'), '-o', str(path / 'test')], check=True)
+    subprocess.run([str(path / 'test')], check=True)
diff --git a/tools/mt6762/hardware/watchdog/trial_deadline.h b/tools/mt6762/hardware/watchdog/trial_deadline.h
new file mode 100644
index 0000000000000000000000000000000000000000..d2aec69149f56d49f3382ec4e5d5777028a0e65f
--- /dev/null
+++ b/tools/mt6762/hardware/watchdog/trial_deadline.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef MT6762_TRIAL_DEADLINE_H
+#define MT6762_TRIAL_DEADLINE_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* Decimal-only boot argument. Missing/invalid input leaves the trial disabled;
+ * never accept truncation/wrapping of a large number as a short deadline. */
+static inline int mtk_trial_parse(const char *s, size_t capacity, unsigned *seconds)
+{
+    unsigned n=0;
+    *seconds=0;
+    if (!s || !capacity || !s[0]) return 0;
+    for (size_t i=0;i<capacity;i++) {
+        unsigned char c=(unsigned char)s[i];
+        if (!c) {
+            if (n && (n<60 || n>1800)) return 0;
+            *seconds=n;return 1;
+        }
+        if (c<'0' || c>'9' || n>1800) return 0;
+        n=n*10+(c-'0');
+    }
+    return 0;
+}
+
+struct mtk_trial_deadline {
+    uint64_t first_ns;
+    unsigned seconds,started,expired;
+};
+/* Host retrieval must bind this symbol to the selected kernel/trial manifest.
+ * This is an ordinary diagnostic record, not a unique boot attestation.
+ * state:0 disabled,1 armed,2 expired,3 cache-clean operations completed. */
+struct mtk_trial_record {
+    uint64_t magic;
+    uint32_t version,state,seconds,attempts,flags,reserved0;
+    uint64_t first_feed_ns,last_feed_ns,expired_ns;
+    uint32_t log_length_before,log_length_after;
+    uint32_t mode,length,status,nonrst,nonrst2,req_mode,req_irq;
+    uint32_t reserved[9];
+};
+_Static_assert(sizeof(struct mtk_trial_record)==128,"trial record ABI");
+enum { MTK_TRIAL_CONCURRENT_LOG=1, MTK_TRIAL_LOG_LENGTH_INVALID=2 };
+static inline void mtk_trial_fed(struct mtk_trial_deadline *t,uint64_t now_ns)
+{
+    if (!t->started) {t->first_ns=now_ns;t->started=1;}
+}
+/* Called after the existing profile/scheduling checks and before a refresh.
+ * Subtraction avoids overflow near UINT64_MAX. Backwards clocks remain the
+ * existing worker's scheduling-failure case, not fabricated deadline expiry. */
+static inline int mtk_trial_expired(struct mtk_trial_deadline *t,uint64_t now_ns)
+{
+    if (t->expired) return 1;
+    if (t->seconds && t->started && now_ns>=t->first_ns &&
+        now_ns-t->first_ns>=(uint64_t)t->seconds*UINT64_C(1000000000))
+        t->expired=1;
+    return (int)t->expired;
+}
+
+/* Fixed-allocation cache maintenance, independent of any mutable log length.
+ * clean receives aligned cache-line addresses, not byte loads/stores. */
+static inline int mtk_trial_clean_range(uintptr_t base,size_t bytes,
+    void (*clean)(uintptr_t,void *),void *context)
+{
+    if (!bytes) return 0;
+    if (!clean || bytes-1>UINTPTR_MAX-base) return -1;
+    uintptr_t last=(base+bytes-1)&~(uintptr_t)63;
+    for (uintptr_t p=base&~(uintptr_t)63;;p+=64) {
+        clean(p,context);
+        if (p==last) break;
+    }
+    return 0;
+}
+#endif
diff --git a/tools/mt6762/iig/LEGACY-CANDIDATE.rst b/tools/mt6762/iig/LEGACY-CANDIDATE.rst
new file mode 100644
index 0000000000000000000000000000000000000000..2dd633f824f4ed4651c885ccfd08b0f11bfe060c
--- /dev/null
+++ b/tools/mt6762/iig/LEGACY-CANDIDATE.rst
@@ -0,0 +1,134 @@
+DriverKit440 legacy IORPC transform candidate
+===========================================
+
+legacy_transform.py is a separate source transformation experiment. It does
+not change genuine generator output, current kernel sources, or replay.py's
+Xcode15 admission policy. Its result is labelled
+``legacy-transform-candidate-not-compatible`` with ``replay_eligible: false``.
+No compatibility or working-RPC claim follows from a successful transform.
+
+The reviewed profile pins every byte of all17 genuine headers and17 generated
+implementations. Unknown hashes, missing files, changed pattern counts, or
+unhandled kernelContent/parser shapes are rejected before creating output.
+The command requires a pinned successful diagnostic generation manifest and
+its matching input manifest. Earlier failed diagnostic manifests are preserved
+and are not rewritten into successful ones.
+
+The transformed candidate keeps the original24-byte IORPC and adds a compile
+time size assertion. Invocation unions use packed Msg_With_Content pointers,
+remove their extra kernelContent slot, and access content as a member of that
+packed struct. No naturally aligned Content-pointer cast is introduced.
+All94 request-bearing Invoke entries call the bounded request helper before
+any generated variable-length count reads or content access. All86 methods
+whose generator assumed a nonnull reply instead check its pointer and capacity
+before continuing. The remaining oneway methods still permit absent replies.
+All36 dispatch parsers use the bounded legacy-message helper.
+All85 ordinary generated reply producers explicitly set the190615 reply
+protocol version; their outgoing caller validation now checks that version.
+CheckForWork's request-shaped asynchronous reply is excluded from that check.
+
+Two special paths require additional handling. InterruptOccurred builds a
+message directly in a supplied reply buffer, so it checks that buffer before
+memset or field writes. CheckForWork returns a request-shaped asynchronous
+message in its reply buffer. Both its reply parsers use checked bounds, and
+forwarding explicitly assigns the reply buffer to rpc.message before clearing
+rpc.reply. The helper's reply argument chooses the buffer; it must not blindly
+require the normal reply-version ID for this asynchronous request-shaped path.
+Candidate26c-2 also requires at least one logical object reference in both
+CheckForWork paths before the outgoing wrapper reads objects[0]. The general
+bounded parser accepts an otherwise valid header with zero references; a Mach
+descriptor alone does not prove that the content carries an object slot.
+Candidate26c-1 remains preserved and cannot pass the updated transform-hash
+replay check.
+
+The separately reviewed MTKIIGLegacy.h must provide:
+
+::
+
+    IORPCMessage *mtk_iig_legacy_message(const IORPC &, bool reply = false);
+    bool mtk_iig_legacy_request(const IORPC &, uint32_t full_size,
+        uint32_t content_offset, uint64_t expected_refs, uint64_t expected_id);
+
+The request helper must validate the actual message bounds and descriptor
+traversal, expected content offset, reference count and method ID before typed
+member access. A C++ pointer/capacity pair is still an internal trusted-memory
+contract; this does not make arbitrary unmapped pointers safe to dereference.
+The transform records the supplied helper hash, but does not certify its
+implementation. A separate output directory is mandatory and the helper is
+copied there as source only.
+
+Host validation exercises all actual17 generated implementations, ordering of
+the early checks, special reply paths, unexpected source shapes and manifest
+hash rejection. Actual command-line negatives additionally reject changed
+pristine source, changed manifest, helper symlink and an existing output
+directory, preserving existing contents. If genuine artifacts are absent, those artifact tests are
+explicitly skipped; no fabricated RPC implementation substitutes for them.
+Method IDs, full packed wire-layout comparison, target compilation, exports,
+malformed-message/runtime tests and explicit import review remain independent
+acceptance requirements.
+
+An opt-in DEVELOPMENT/DEBUG MT6762 kernel test is registered separately in
+iokit/Kernel/MTKIIGLegacySelfTest.cpp. With ``mt6762_iig_selftest=1``, its first
+read of ``kern.redwood.mt6762_iig_test_result`` or ``mt6762_iig_test_cases``
+runs a mutex-serialized test once. The actual generated public
+IOMemoryMap::_CopyState_Invoke and OSAction::Aborted_Invoke methods receive
+independently described raw wire buffers and controlled counting handlers.
+The205 cases cover separate/overlapping/four-byte-aligned buffers, every short
+request/reply capacity, null buffers, invalid descriptor/header/reference/ID
+metadata, untouched reply canaries on failure, and a valid oneway call without
+a reply. Twelve additional cases call the real
+IODispatchSource::CheckForWork_Invoke with a controlled handler that writes
+request-shaped replies, including header-only zero-reference, truncated
+one-reference, wrong protocol/flags/descriptors, oversize and valid one-reference
+messages. No sentinel object pointer is invoked. Expected result is1 with205
+cases; a negative result identifies the
+first failed case. Without the explicit argument, both reads return ENOTSUP.
+The test creates no IOKit objects and accesses no devices. Its source being
+present is not evidence of a successful build or runtime test. Build22 passed
+the earlier193-case suite on one and eight emulated CPUs; that suite lacked
+the zero-reference regression. The new205-case result requires its own run.
+
+Example after independently reviewing the successful diagnostic manifests:
+
+::
+
+    python3 legacy_transform.py \
+      --generated /path/to/pristine-diagnostic-output \
+      --generation-sha256 <reviewed-hash> \
+      --inputs /path/to/input-bundle --input-sha256 <reviewed-hash> \
+      --helper /path/to/MTKIIGLegacy.h --output /path/to/new-candidate
+
+The profile contains hashes and structural counts, not redistributed SDK files
+or generated kernel implementation bodies. Candidate output stays outside the
+repository and current kernel build.
+
+Observed build22 validation
+---------------------------
+
+All17 adapted genuine implementations compiled in a fresh kernel build. The
+94 previously missing DriverKit exports are now present;35 unrelated Apple
+hardware-private exports remain missing. build22.json and exports-build22.json
+under ../build-audit record exact source/kernel/tool identities. No original
+Apple executable was compiled.
+
+The bounded helper passes host guard-page tests with actual XNU standalone ABI
+declarations. Host ASan/UBSan execution was unavailable because libasan was
+missing; no sanitizer pass is claimed. The opt-in kernel selftest executes
+actual generated IOMemoryMap::_CopyState_Invoke and OSAction::Aborted_Invoke
+handlers in193 cases, with PASS on one and eight emulated A53 cores. Disabled
+mode returns ENOTSUP. These are representative method tests; all-method wire
+compatibility and physical hardware operation remain unproved.
+
+To select the experimental build consumer, use the normal replay environment
+plus MTK_IIG_CANDIDATE=/path/to/candidate and MTK_IIG_CANDIDATE_SHA256 containing
+the reviewed transform.json digest. Set IIG to experimental_legacy_replay.py,
+then run its verify command before building. The build records selected inputs
+and rejects a changed generator or bundle in an existing BUILD tree. Preserve
+and replace BUILD with an empty directory for a deliberate mode transition.
+SDK/tool binaries and generated bundles remain outside the source repository.
+
+Build23 compiled candidate26c-2 successfully. All205 representative actual
+Invoke cases passed on both one and eight emulated cores, including the new
+CheckForWork reply checks. The disabled path returned ENOTSUP; the eight-core
+MSDC regression passed. These results are recorded under ../build-audit/.
+The GUI run is tracked separately; full physical acceptance remains outstanding.
diff --git a/tools/mt6762/iig/MTKIIGLegacy.h b/tools/mt6762/iig/MTKIIGLegacy.h
new file mode 100644
index 0000000000000000000000000000000000000000..cd626ce22c629e6ff834cde372c5864db683bcee
--- /dev/null
+++ b/tools/mt6762/iig/MTKIIGLegacy.h
@@ -0,0 +1,72 @@
+/* Bounded contiguous-message adapter for the 24-byte xnu-8796 IORPC ABI.
+ * Candidate only: the generator's separate kernelContent ABI is not imported.
+ * The caller must own accessible sendSize/replySize bytes for the duration of
+ * dispatch. This checks message structure; it cannot validate arbitrary kernel
+ * pointers or prevent concurrent mutation by a caller violating that contract.
+ */
+#ifndef MTK_IIG_LEGACY_H
+#define MTK_IIG_LEGACY_H
+
+#include <DriverKit/IORPC.h>
+
+static_assert(sizeof(IORPC) == 24, "requires legacy arm64 IORPC ABI");
+static_assert(sizeof(IORPCMessage) == 24, "unexpected content header");
+
+/* reply_buffer selects storage only. CheckForWork returns a request in its
+ * reply buffer, so both routes require the request protocol version. */
+static inline IORPCMessage *
+mtk_iig_legacy_message(const IORPC& rpc, bool reply_buffer = false)
+{
+	IORPCMessageMach *base = reply_buffer ? rpc.reply : rpc.message;
+	const uint32_t capacity = reply_buffer ? rpc.replySize : rpc.sendSize;
+	const uint32_t start = __builtin_offsetof(IORPCMessageMach, objects);
+	const uintptr_t address = reinterpret_cast<uintptr_t>(base);
+	if (!base || (address & 3) || capacity < start ||
+	    address > UINTPTR_MAX - capacity) return nullptr;
+
+	mach_msg_header_t header;
+	mach_msg_body_t body;
+	const unsigned char *bytes = reinterpret_cast<const unsigned char *>(base);
+	__builtin_memcpy(&header, bytes, sizeof(header));
+	__builtin_memcpy(&body, bytes + __builtin_offsetof(IORPCMessageMach, msgh_body), sizeof(body));
+	if (header.msgh_id != kIORPCVersion190615 || header.msgh_size > capacity ||
+	    header.msgh_size < start) return nullptr;
+	uint32_t offset = start;
+	for (uint32_t i = 0; i < body.msgh_descriptor_count; ++i) {
+		/* The common type byte lives in the first 12 bytes of both supported
+		 * descriptors. Copy into the declared port type to avoid bitfield
+		 * offsets and unaligned typed reads. Kernel port descriptors are 16B. */
+		mach_msg_port_descriptor_t prefix = {};
+		static_assert(sizeof(prefix) >= 12, "unexpected descriptor layout");
+		if (header.msgh_size - offset < 12) return nullptr;
+		__builtin_memcpy(&prefix, bytes + offset, 12);
+		uint32_t length;
+		if (prefix.type == MACH_MSG_PORT_DESCRIPTOR) length = sizeof(mach_msg_port_descriptor_t);
+		else if (prefix.type == MACH_MSG_OOL_DESCRIPTOR) length = sizeof(mach_msg_ool_descriptor_t);
+		else return nullptr;
+		if (length > header.msgh_size - offset) return nullptr;
+		offset += length;
+	}
+	if (header.msgh_size - offset < sizeof(IORPCMessage)) return nullptr;
+	IORPCMessage content;
+	__builtin_memcpy(&content, bytes + offset, sizeof(content));
+	if (content.objectRefs > (header.msgh_size - offset - sizeof(content)) / sizeof(OSObjectRef))
+		return nullptr;
+	return reinterpret_cast<IORPCMessage *>(address + offset);
+}
+
+static inline bool
+mtk_iig_legacy_request(const IORPC& rpc, uint32_t full_size,
+    uint32_t content_offset, uint64_t expected_refs, uint64_t expected_id)
+{
+	IORPCMessage *content = mtk_iig_legacy_message(rpc);
+	if (!content || full_size > rpc.sendSize || content_offset > full_size ||
+	    full_size - content_offset < sizeof(IORPCMessage) ||
+	    reinterpret_cast<uintptr_t>(content) - reinterpret_cast<uintptr_t>(rpc.message) != content_offset)
+		return false;
+	/* The parser above proved alignment and bounds for these packed headers. */
+	return rpc.message->msgh.msgh_size >= full_size &&
+	       rpc.message->msgh_body.msgh_descriptor_count == expected_refs &&
+	       content->objectRefs == expected_refs && content->msgid == expected_id;
+}
+#endif
diff --git a/tools/mt6762/iig/README.rst b/tools/mt6762/iig/README.rst
