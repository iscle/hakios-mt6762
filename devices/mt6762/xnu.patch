diff --git a/tools/mt6762/hardware/btif/test.py b/tools/mt6762/hardware/btif/test.py
new file mode 100644
index 0000000000000000000000000000000000000000..80145e814c42f22266cbe15bc8774bd5994c19d4
--- /dev/null
+++ b/tools/mt6762/hardware/btif/test.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""Compile and run the bounded PIO and actual WMT composition fixtures."""
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+
+
+def main():
+    compiler = shlex.split(os.environ.get('CC', 'cc'))
+    with tempfile.TemporaryDirectory(prefix='mt6762-btif-') as directory:
+        for name, sources in (
+            ('pio', ['btif_pio.c', 'test_btif.c']),
+            ('wmt', ['btif_pio.c', 'btif_wmt.c',
+                     '../connectivity/wmt_protocol.c', 'test_wmt_transport.c']),
+        ):
+            binary = Path(directory) / name
+            subprocess.run(compiler + ['-std=c99', '-O2', '-Wall', '-Wextra', '-Werror'] +
+                           [str(HERE / s) for s in sources] + ['-o', str(binary)], check=True)
+            subprocess.run([str(binary)], check=True, timeout=30)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/mt6762/hardware/btif/test_btif.c b/tools/mt6762/hardware/btif/test_btif.c
new file mode 100644
index 0000000000000000000000000000000000000000..4407198ecddc3cfd5fd6eabde1a116a9f509ea63
--- /dev/null
+++ b/tools/mt6762/hardware/btif/test_btif.c
@@ -0,0 +1,178 @@
+#include "btif_pio.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+struct peripheral {
+    uint32_t regs[32];
+    uint8_t rx[4096],tx[4096];
+    size_t rx_read,rx_length,tx_length,tx_fifo;
+    unsigned accesses,writes,reads8,writes8,ready_calls,accessible,stuck;
+};
+static int ready(void *v)
+{ struct peripheral *p=v; p->ready_calls++; return p->accessible; }
+static uint32_t read32(void *v,unsigned r)
+{
+    struct peripheral *p=v; assert(p->accessible);p->accesses++;
+    assert(r && !(r&3) && r<128); /* RBR/THR must never be32-bit. */
+    if(r==8) return p->rx_read<p->rx_length?0x44:1;
+    if(r==20) return (p->rx_read<p->rx_length?1u:0)|
+        (!p->tx_fifo?0x40u:0)|(p->tx_fifo<=8?0x20u:0);
+    return p->regs[r/4];
+}
+static void write32(void *v,unsigned r,uint32_t value)
+{
+    struct peripheral *p=v;assert(p->accessible);p->accesses++;p->writes++;
+    assert(r==4 || r==12 || r==0x4c || r==0x60 || r==0x6c);
+    /* FIFO clear, wake, DMA enable, sleep and clock writes are excluded. */
+    if(r==0x4c) assert(!(value&3));
+    if(r==4) assert(!(value&2));
+    if(r==0x60) assert(!(value&0x80));
+    if(r!=p->stuck) p->regs[r/4]=value;
+}
+static uint8_t read8(void *v,unsigned r)
+{
+    struct peripheral *p=v;assert(p->accessible && r==0);
+    p->accesses++;p->reads8++;assert(p->rx_read<p->rx_length);
+    return p->rx[p->rx_read++];
+}
+static void write8(void *v,unsigned r,uint8_t value)
+{
+    struct peripheral *p=v;assert(p->accessible && r==0);
+    p->accesses++;p->writes8++;
+    assert(p->tx_fifo<16 && p->tx_length<sizeof(p->tx));
+    p->tx[p->tx_length++]=value;p->tx_fifo++;
+}
+static struct btif_pio_io io(struct peripheral *p)
+{ return (struct btif_pio_io){p,ready,read32,write32,read8,write8}; }
+static const struct btif_pio_grant grant={1,1,1,1};
+static void start(struct btif_pio *s,struct peripheral *p)
+{
+    memset(s,0,sizeof(*s));memset(p,0,sizeof(*p));p->accessible=1;
+    struct btif_pio_io ops=io(p);assert(btif_pio_init(s,&ops,&grant)==0);
+    assert(s->initialized && p->regs[1]==1 && p->regs[0x4c/4]==4);
+    assert(p->regs[0x60/4]==0x18 && p->regs[0x6c/4]==1);
+}
+static void admission(void)
+{
+    for(unsigned i=0;i<4;i++) {
+        struct btif_pio s={0};struct peripheral p={.accessible=1};
+        struct btif_pio_io ops=io(&p);struct btif_pio_grant g=grant;
+        if(i==0)g.enabled=0;
+        if(i==1)g.exclusive=0;
+        if(i==2)g.irq_masked=0;
+        if(i==3)g.apdma_idle=0;
+        assert(btif_pio_init(&s,&ops,&g)<0 && !p.accesses && !p.ready_calls);
+    }
+    for(unsigned i=0;i<5;i++) {
+        struct btif_pio s={0};struct peripheral p={.accessible=1};
+        struct btif_pio_io ops=io(&p);
+        if(i==0)p.accessible=0;
+        if(i==1)p.regs[0x4c/4]=3;
+        if(i==2)p.rx_length=1;
+        if(i==3)p.tx_fifo=1;
+        if(i==4)p.regs[1]=2;
+        assert(btif_pio_init(&s,&ops,&grant)<0 && !p.writes && !p.reads8);
+        if(i==0)assert(!p.accesses);
+    }
+    for(unsigned i=0;i<3;i++) {
+        struct btif_pio s={0};struct peripheral p={.accessible=1};
+        struct btif_pio_io ops=io(&p);
+        p.stuck=i==0?0x4c:i==1?0x60:0x6c;
+        assert(btif_pio_init(&s,&ops,&grant)==BTIF_CONFIG && !s.initialized);
+        unsigned a=p.accesses;
+        assert(btif_pio_init(&s,&ops,&grant)==BTIF_STATE && p.accesses==a);
+    }
+}
+static void fifo_progress(void)
+{
+    struct btif_pio s;struct peripheral p;uint8_t tx[45],rx[64];size_t n;
+    start(&s,&p);for(size_t i=0;i<sizeof(tx);i++)tx[i]=(uint8_t)(i*7+3);
+    assert(btif_pio_begin(&s,tx,sizeof(tx),100,10000)==0);
+    assert(btif_pio_step(&s,rx,sizeof(rx),&n,101)==0 && !n);
+    assert(s.tx_written==16 && !s.tx_complete);
+    assert(btif_pio_finish(&s,101)==BTIF_STATE);
+    /* Full FIFO permits no write; exactly eight slots available below THRE. */
+    assert(btif_pio_step(&s,rx,sizeof(rx),&n,102)==0 && s.tx_written==16);
+    p.tx_fifo=8;assert(btif_pio_step(&s,rx,sizeof(rx),&n,103)==0);
+    assert(s.tx_written==24 && p.tx_fifo==16);
+    p.tx_fifo=0;assert(btif_pio_step(&s,rx,sizeof(rx),&n,104)==0);
+    assert(s.tx_written==40 && !s.tx_complete);
+    p.tx_fifo=0;assert(btif_pio_step(&s,rx,sizeof(rx),&n,105)==0);
+    assert(s.tx_written==45 && !s.tx_complete);
+    p.tx_fifo=0;assert(btif_pio_step(&s,rx,sizeof(rx),&n,106)==0 && s.tx_complete);
+    assert(!memcmp(tx,p.tx,sizeof(tx)) && p.writes8==sizeof(tx));
+    assert(btif_pio_finish(&s,107)==0 && !s.active);
+}
+static void receive_and_stream(void)
+{
+    struct btif_pio s;struct peripheral p;uint8_t tx[2054],rx[64];size_t n;
+    start(&s,&p);for(size_t i=0;i<sizeof(tx);i++)tx[i]=(uint8_t)(i+19);
+    assert(btif_pio_begin(&s,tx,sizeof(tx),0,100000)==0);
+    for(size_t i=0;i<sizeof(p.rx);i++)p.rx[i]=(uint8_t)(i+7);
+    unsigned now=1,total=0;
+    while(!s.tx_complete || p.rx_read<p.rx_length) {
+        memset(rx,0xcc,sizeof(rx));p.tx_fifo=0;
+        /* No event belongs to this command before the final byte is sent. */
+        if(s.tx_written==s.tx_length)p.rx_length=sizeof(p.rx);
+        assert(btif_pio_step(&s,rx,sizeof(rx),&n,now++)==0 && n<=32);
+        for(size_t i=0;i<n;i++)assert(rx[i]==(uint8_t)(total+i+7));
+        for(size_t i=n;i<sizeof(rx);i++)assert(rx[i]==0xcc);
+        total+=(unsigned)n;assert(now<1000);
+    }
+    assert(total==sizeof(p.rx) && s.rx_total==total);
+    assert(p.tx_length==sizeof(tx) && !memcmp(tx,p.tx,sizeof(tx)));
+    assert(btif_pio_finish(&s,now)==0);
+    assert(btif_pio_begin(&s,NULL,0,now,1000)==0);
+    p.rx_read=0;p.rx_length=5;
+    assert(btif_pio_step(&s,rx,2,&n,now+1)==0 && n==2 && p.rx_read==2);
+    assert(btif_pio_step(&s,rx,2,&n,now+2)==0 && n==2 && p.rx_read==4);
+    assert(btif_pio_step(&s,rx,2,&n,now+3)==0 && n==1 && p.rx_read==5);
+    assert(btif_pio_finish(&s,now+4)==0);
+}
+static void errors(void)
+{
+    struct btif_pio s;struct peripheral p;uint8_t tx[20]={0},rx[4];size_t n;
+    for(unsigned i=0;i<7;i++) {
+        start(&s,&p);assert(btif_pio_begin(&s,tx,sizeof(tx),100,1000)==0);
+        unsigned a=p.accesses,w=p.writes8;
+        if(i==0)p.accessible=0;
+        if(i==1)p.regs[0x4c/4]|=1;
+        if(i==2)p.regs[1]|=2;
+        if(i==3)p.regs[0x60/4]|=0x80;
+        uint64_t now=i==4?99:i==5?1100:101;
+        if(i==6)s.polls=1000000;
+        n=99;assert(btif_pio_step(&s,rx,sizeof(rx),&n,now)<0 && !n);
+        assert(p.writes8==w && !s.active && !s.tx_complete);
+        if(i==0 || i>=4)assert(p.accesses==a);
+        a=p.accesses;
+        assert(btif_pio_step(&s,rx,sizeof(rx),&n,now)<0 && p.accesses==a);
+    }
+    start(&s,&p);unsigned a=p.accesses;
+    assert(btif_pio_begin(&s,NULL,1,0,1000)==BTIF_ARGUMENT);
+    assert(btif_pio_begin(&s,tx,2055,0,1000)==BTIF_ARGUMENT);
+    assert(btif_pio_begin(&s,tx,1,UINT64_MAX-9,1000)==BTIF_ARGUMENT);
+    assert(btif_pio_begin(&s,tx,1,0,999)==BTIF_ARGUMENT && p.accesses==a);
+    /* A nonadvancing clock cannot spin forever even when hardware stays idle. */
+    assert(btif_pio_begin(&s,NULL,0,0,1000)==0);
+    for(unsigned i=0;i<1000000;i++)assert(btif_pio_step(&s,rx,1,&n,0)==0);
+    assert(btif_pio_step(&s,rx,1,&n,0)==BTIF_BUDGET);
+    /* Old pending replies must not satisfy a new command, even when they
+     * arrive in the gap between begin() and the first pump. */
+    start(&s,&p);p.rx_length=1;
+    assert(btif_pio_begin(&s,tx,1,0,1000)==BTIF_BUSY && !p.writes8 && !p.reads8);
+    start(&s,&p);assert(btif_pio_begin(&s,tx,1,0,1000)==0);p.rx_length=1;
+    assert(btif_pio_step(&s,rx,1,&n,1)==BTIF_BUSY && !p.writes8 && !p.reads8);
+    start(&s,&p);assert(btif_pio_begin(&s,NULL,0,100,1000)==0);
+    assert(btif_pio_step(&s,rx,1,&n,101)==0 && s.tx_complete);
+    a=p.accesses;assert(btif_pio_finish(&s,1100)==BTIF_TIMEOUT && p.accesses==a);
+    start(&s,&p);assert(btif_pio_begin(&s,NULL,0,100,1000)==0);
+    assert(btif_pio_step(&s,rx,1,&n,101)==0 && s.tx_complete);
+    a=p.accesses;assert(btif_pio_finish(&s,99)==BTIF_CLOCK && p.accesses==a);
+}
+int main(void)
+{
+    admission();fifo_progress();receive_and_stream();errors();
+    puts("BTIF PIO: ownership, access widths, FIFO capacity, streaming, deadlines and sticky failures passed");
+    return 0;
+}
diff --git a/tools/mt6762/hardware/btif/test_wmt_transport.c b/tools/mt6762/hardware/btif/test_wmt_transport.c
new file mode 100644
index 0000000000000000000000000000000000000000..fa68ec029dfde0cf7274b3aa1a59cc774eeda4a1
--- /dev/null
+++ b/tools/mt6762/hardware/btif/test_wmt_transport.c
@@ -0,0 +1,109 @@
+#include "btif_wmt.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+/* An eight-byte RX FIFO and a peer that stops when handshake deasserts.
+ * This tests the software contract, not physical CONSYS flow control. */
+static const uint8_t query[]={0x80,0x40,5,0,1,4,1,0,4,0,0};
+static const uint8_t event[]={0x80,0x40,10,0,2,4,6,0,0,4,0x11,0,0,0,0,0};
+struct peripheral {
+    uint32_t regs[32];
+    uint8_t fifo[8],reply[sizeof(event)],tx[sizeof(query)];
+    size_t count,head,produced,tx_length;
+    unsigned accesses,writes8,backpressure,tx_empty,ready;
+};
+static int accessible(void *v) {return ((struct peripheral *)v)->ready;}
+static uint32_t read32(void *v,unsigned r)
+{
+    struct peripheral *p=v;assert(p->ready);p->accesses++;assert(r && r<128);
+    if(r==20)return (p->tx_empty?0x40u:0)|(p->count?1u:0);
+    if(r==8)return p->count?0x44:1;
+    return p->regs[r/4];
+}
+static void write32(void *v,unsigned r,uint32_t value)
+{
+    struct peripheral *p=v;assert(p->ready);p->accesses++;
+    assert(r==4 || r==12 || r==0x4c || r==0x60 || r==0x6c);
+    p->regs[r/4]=value;
+}
+static uint8_t read8(void *v,unsigned r)
+{
+    struct peripheral *p=v;assert(p->ready && !r && p->count);
+    p->accesses++;uint8_t value=p->fifo[p->head];
+    p->head=(p->head+1)%8;p->count--;return value;
+}
+static void write8(void *v,unsigned r,uint8_t value)
+{
+    struct peripheral *p=v;assert(p->ready && !r && p->tx_length<sizeof(p->tx));
+    p->accesses++;p->writes8++;p->tx[p->tx_length++]=value;p->tx_empty=0;
+}
+static void produce(struct peripheral *p)
+{
+    if(p->tx_length!=sizeof(query))return;
+    assert(!memcmp(query,p->tx,sizeof(query)) && (p->regs[0x6c/4]&1));
+    while(p->produced<sizeof(event)) {
+        if(p->count==8){p->backpressure++;break;}
+        p->fifo[(p->head+p->count)%8]=p->reply[p->produced++];p->count++;
+    }
+}
+static void start(struct btif_wmt_query *s,struct peripheral *p)
+{
+    memset(s,0,sizeof(*s));memset(p,0,sizeof(*p));
+    p->tx_empty=1;p->ready=1;memcpy(p->reply,event,sizeof(event));
+    const struct btif_pio_io io={p,accessible,read32,write32,read8,write8};
+    const struct btif_pio_grant grant={1,1,1,1};
+    assert(btif_wmt_start(s,&io,&grant,0,100000)==0);
+}
+static void successful(void)
+{
+    struct btif_wmt_query s;struct peripheral p;start(&s,&p);
+    assert(btif_wmt_step(&s,1)==0 && p.tx_length==sizeof(query));
+    p.tx_empty=1;produce(&p);assert(p.count==8 && p.backpressure==1);
+    assert(btif_wmt_step(&s,5000)==0 && s.phase==BTIF_WMT_QUERY && !p.count);
+    produce(&p);assert(p.count==8);
+    assert(btif_wmt_step(&s,10000)==0 && s.phase==BTIF_WMT_DEFAULT_OPTIONS);
+    assert(s.protocol.events==1 && s.transport.tx_written==sizeof(query));
+    assert(p.produced==sizeof(event) && !p.count && !s.protocol.pda_ready);
+    unsigned a=p.accesses;assert(btif_wmt_step(&s,10001)<0 && a==p.accesses);
+}
+static void failures(void)
+{
+    for(unsigned variant=0;variant<5;variant++) {
+        struct btif_wmt_query s;struct peripheral p;start(&s,&p);
+        if(variant==0){p.fifo[0]=0x80;p.count=1;}
+        int r=btif_wmt_step(&s,1);
+        if(variant==0){assert(r<0 && !p.tx_length);continue;}
+        assert(r==0);p.tx_empty=variant!=1;
+        if(variant==2)p.reply[8]=1; /* Firmware status failure. */
+        produce(&p);
+        if(variant==3)p.ready=0;
+        r=btif_wmt_step(&s,variant==4?100000:5);
+        if(variant==3 || variant==4){assert(r<0);continue;}
+        assert(r==0);produce(&p);r=btif_wmt_step(&s,10);
+        if(variant==2)assert(r<0 && s.protocol_error==CW_STATUS);
+        if(variant==1){
+            assert(r==0 && s.phase==BTIF_WMT_QUERY && !s.transport.tx_complete);
+            assert(btif_wmt_step(&s,100000)<0 && s.phase==BTIF_WMT_FAILED);
+        }
+        assert(s.phase!=BTIF_WMT_DEFAULT_OPTIONS);
+    }
+}
+static void small_capacity(void)
+{
+    struct btif_wmt_query s;struct peripheral p;start(&s,&p);
+    assert(btif_wmt_step(&s,1)==0);p.tx_empty=1;
+    /* Exercise the same FIFO with a caller buffer smaller than its capacity. */
+    uint8_t bytes[2],all[sizeof(event)];size_t n,total=0;
+    for(unsigned i=0;total<sizeof(event);i++){
+        produce(&p);assert(p.count<=8);
+        assert(btif_pio_step(&s.transport,bytes,sizeof(bytes),&n,2+i*1000)==0);
+        assert(n && n<=2);memcpy(all+total,bytes,n);total+=n;assert(i<20);
+    }
+    assert(!memcmp(all,event,sizeof(event)) && p.backpressure>=4);
+}
+int main(void)
+{
+    successful();failures();small_capacity();
+    puts("BTIF/WMT: eight-byte FIFO, backpressure, exact default query and failed exchanges passed");
+    return 0;
+}
diff --git a/tools/mt6762/hardware/build-probes.sh b/tools/mt6762/hardware/build-probes.sh
new file mode 100755
index 0000000000000000000000000000000000000000..d6b1f84f30ccbd3f6f483f32616c039487d5bf3f
--- /dev/null
+++ b/tools/mt6762/hardware/build-probes.sh
@@ -0,0 +1,20 @@
+#!/bin/sh
+# Explicit iOS cross compiler, SDK, signer and fresh output directory required.
+# Never edits Apple executables or images.
+set -eu
+if [ "$#" -ne 1 ]; then echo "usage: IOS_CC=... IOS_SDK=... LDID=... $0 NEW_OUTPUT_DIRECTORY" >&2; exit 2; fi
+: "${IOS_CC:?set IOS_CC to the iOS clang driver}"
+: "${IOS_SDK:?set IOS_SDK to the iPhoneOS SDK directory}"
+: "${LDID:?set LDID to the project signing tool}"
+source_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+output_dir=$1
+mkdir -- "$output_dir"
+for helper in backlight_probe backlight_request display_power_probe battery_probe; do
+    case "$helper" in battery_probe) source_file="$source_dir/power/$helper.c";;
+        *) source_file="$source_dir/display-touch/$helper.c";; esac
+    "$IOS_CC" -arch arm64 -mcpu=cortex-a53 -isysroot "$IOS_SDK" -O1 -Wall -Wextra -Werror \
+        -framework CoreFoundation -framework IOKit -o "$output_dir/$helper" "$source_file"
+    case "$helper" in backlight_request|display_power_probe)
+        "$LDID" "-S$source_dir/display-touch/backlight_request.entitlements" "$output_dir/$helper";;
+        *) "$LDID" -S "$output_dir/$helper";; esac
+done
