+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def decode_adt(data, offset=0, path=''):
+    props, children = struct.unpack_from('<II', data, offset)
+    offset += 8
+    values, positions = {}, {}
+    for _ in range(props):
+        name = data[offset:offset+32].split(b'\0')[0].decode('ascii')
+        size, = struct.unpack_from('<I', data, offset+32)
+        offset += 36
+        if name in values or size > len(data)-offset:
+            raise ValueError('invalid generated ADT')
+        values[name] = data[offset:offset+size]
+        positions[name] = offset
+        offset += (size+3)&~3
+    name = values.pop('name').rstrip(b'\0').decode('ascii')
+    path += '/' + name
+    all_positions = {path+'/'+k:v for k,v in positions.items()}
+    descendants = []
+    for _ in range(children):
+        child, offset, child_positions = decode_adt(data, offset, path)
+        descendants.append(child)
+        all_positions.update(child_positions)
+    return dict(name=name, props=values, children=descendants), offset, all_positions
+
+
+def encode_adt(tree):
+    return prepare.node(tree['name'], list(tree['props'].items()),
+                        [encode_adt(child) for child in tree['children']])
+
+
+def physical_identity(chosen, wifi_mac=None):
+    """Discard lab identities; optionally publish this phone's raw factory MAC.
+
+    MobileGestalt's WifiAddressData reads this OSData before falling back to
+    waiting for IONetworkController. This property grants no network hardware
+    ownership and does not imply that a Wi-Fi driver exists.
+    """
+    if wifi_mac is not None and (len(wifi_mac) != 6 or wifi_mac == bytes(6)
+                                 or wifi_mac[0] & 1):
+        raise ValueError('Wi-Fi identity must be six raw, nonzero unicast MAC bytes')
+    for key in ('unique-chip-id', 'mac-address-wifi0', 'mac-address-bluetooth0'):
+        chosen.pop(key, None)
+    if wifi_mac is not None:
+        chosen['mac-address-wifi0'] = wifi_mac
+
+
+CHARGER_SETUP_FLAGS = ('dma-direct','i2c-pads-verified','i2c5-verified',
+                       'charger-inherited-probe','charger-setup-only')
+CHARGER_READONLY_FLAGS = CHARGER_SETUP_FLAGS[:-1] + ('charger-readonly-probe',)
+BATTERY_OBSERVER_FLAGS = CHARGER_SETUP_FLAGS[:-1] + ('battery-inherited-observer',)
+GAUGE_OBSERVER_VALUES = ('fgauge-baseline-version','fgauge-rfg','fgauge-car-tune',
+    'fgauge-con0','fgauge-efuse-gain','fgauge-efuse-offset','fgauge-adjust-offset','fgauge-gain')
+VBAT_OBSERVER_VALUES = ('vbat-adc-profile-version','vbat-adc-clock0',
+    'vbat-adc-clock1','vbat-adc-reset','vbat-adc-test','vbat-adc-reuse')
+VBAT_OBSERVER_DIAGNOSTICS = ('vbat-observation-status','vbat-observation-reads',
+    'vbat-observed-reuse','vbat-observed-reuse-passes')
