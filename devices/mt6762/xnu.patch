diff --git a/tools/mt6762/physical/peripheral_probe.h b/tools/mt6762/physical/peripheral_probe.h
new file mode 100644
index 0000000000000000000000000000000000000000..40e60f069b9cf325418e1c19dfc60f7ea83a31f2
--- /dev/null
+++ b/tools/mt6762/physical/peripheral_probe.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: MIT -- passive, width-specific native entry record. */
+#ifndef MT6762_PERIPHERAL_PROBE_H
+#define MT6762_PERIPHERAL_PROBE_H
+#include <stdint.h>
+#include <stddef.h>
+struct peripheral_entry {
+    uint32_t address; uint8_t width,group; uint16_t valid;
+    uint32_t value[2];
+};
+struct peripheral_record {
+    uint8_t magic[8]; uint32_t version,size; uint8_t identity[32];
+    uint32_t state,state_inverse,pass,index;
+    uint64_t began[2],ended[2];
+    struct peripheral_entry entries[250];
+};
+_Static_assert(sizeof(struct peripheral_record)==4096,"peripheral trace size");
+_Static_assert(offsetof(struct peripheral_record,entries)==96,"peripheral entries offset");
+struct peripheral_io {
+    void *context;
+    uint32_t (*read)(void *,uint32_t,unsigned);
+    void (*barrier)(void *);
+    uint64_t (*ticks)(void *);
+};
+extern volatile struct peripheral_record physical_peripherals;
+
+static inline int peripheral_value(volatile struct peripheral_record *r,unsigned pass,
+    uint32_t address,uint32_t *value)
+{
+    for(unsigned n=0;n<250;n++) {
+        volatile struct peripheral_entry *e=&r->entries[n];
+        if(e->address==address && (e->valid&(1u<<pass))) {*value=e->value[pass];return 1;}
+    }
+    return 0;
+}
+static inline int peripheral_group_ready(volatile struct peripheral_record *r,unsigned pass,unsigned group)
+{
+    uint32_t top,infra,con0,con1,power,other;
+#define V(a,v) peripheral_value(r,pass,(a),&(v))
+    /* Group5 is a bounded snapshot of ordinary LK text/static RAM. It has no
+     * peripheral clock prerequisite and never follows a captured pointer. */
+    if(!group || group==5)return 1;
+    if(group==1)return V(0x10001090,infra) && !(infra&2);
+    if(group==2 || group==3) {
+        if(!V(0x100000a0,top) || !V(0x10001090,infra) ||
+           (top&0x80) || (infra&(1u<<11)) || (top&7)>4)return 0;
+        unsigned parent=top&7;
+        if(parent) {
+            uint32_t a=parent<=2?0x1000c26c:0x1000c23c;
+            if(!V(a,con0) || !V(a+4,con1) || !V(a+12,power) ||
+               !(con0&1) || !(con0&(1u<<23)) || !(con1&0x3fffff) || (power&3)!=1)return 0;
+        }
+        return group==2 || (V(0x10001094,infra) && !(infra&(1u<<18)));
+    }
+    if(group==4) {
+        if(!V(0x10000070,top) || (top&0x8783)!=0x101 ||
+           !V(0x10001094,infra) || (infra&4) || !V(0x100010c8,other) || (other&(1u<<9)))return 0;
+        for(unsigned n=0;n<2;n++) {
+            uint32_t a=n?0x1000c23c:0x1000c27c;
+            if(!V(a,con0) || !V(a+4,con1) || !V(a+12,power) ||
+               !(con0&1) || (n && !(con0&(1u<<23))) || !(con1&0x3fffff) || (power&3)!=1)return 0;
+        }
+        return 1;
+    }
+    return 0;
+#undef V
+}
+static inline void peripheral_commit(const struct peripheral_io *io,
+    volatile struct peripheral_record *r,uint32_t state)
+{
+    r->state_inverse=~state;io->barrier(io->context);
+    r->state=state;io->barrier(io->context);
+}
+static inline void peripheral_capture(const struct peripheral_io *io,
+    volatile struct peripheral_record *r)
+{
+    peripheral_commit(io,r,1);
+    for(unsigned pass=0;pass<2;pass++) {
+        r->pass=pass+1;r->began[pass]=io->ticks(io->context);
+        for(unsigned n=0;n<250;n++) {
+            volatile struct peripheral_entry *e=&r->entries[n];
+            if(!e->address)break;
+            r->index=n;io->barrier(io->context);
+            if(!peripheral_group_ready(r,pass,e->group))continue;
+            e->value[pass]=io->read(io->context,e->address,e->width);
+            io->barrier(io->context);e->valid|=1u<<pass;
+        }
+        r->ended[pass]=io->ticks(io->context);
+    }
+    peripheral_commit(io,r,2);
+}
+#endif
diff --git a/tools/mt6762/physical/peripheral_record.py b/tools/mt6762/physical/peripheral_record.py
new file mode 100644
index 0000000000000000000000000000000000000000..160ff564b79618c8190ac224f17cfb4375a45790
--- /dev/null
+++ b/tools/mt6762/physical/peripheral_record.py
@@ -0,0 +1,80 @@
+"""Versioned passive register record, bound to one physical Image identity."""
+import json
+from pathlib import Path
+import struct
+
+HERE=Path(__file__).resolve().parent
+SIZE=4096
+OFFSET=0x4400
+ADDRESS=0x40080000+OFFSET
+MAGIC=b'MTKPER01'
+VERSION=2
+
+def registers():
+    table=json.loads((HERE/'peripheral-registers.json').read_text())['registers']
+    assert 0<len(table)<=250
+    seen=set();last=0
+    for e in table:
+        a=int(e['address'],0);w=e['width'];g=e['group']
+        assert a not in seen and 0<a<2**32 and w in (2,4) and a%w==0 and last<=g<=5
+        seen.add(a);last=g
+    return table
+
+def initialized(identity):
+    if len(identity)!=32:raise ValueError('Require Image identity')
+    raw=bytearray(SIZE)
+    struct.pack_into('<8sII32s4I4Q',raw,0,MAGIC,VERSION,SIZE,identity,0,0xffffffff,0,0,0,0,0,0)
+    for n,e in enumerate(registers()):
+        struct.pack_into('<IBBHII',raw,96+n*16,int(e['address'],0),e['width'],e['group'],0,0,0)
+    return bytes(raw)
+
+def decode(raw,identity):
+    if len(raw)!=SIZE or raw[:16]!=struct.pack('<8sII',MAGIC,VERSION,SIZE) or raw[16:48]!=identity:
+        raise ValueError('Peripheral record format or Image identity mismatch')
+    state,inverse,passes,index=struct.unpack_from('<4I',raw,48)
+    if state not in (0,1,2) or inverse!=state^0xffffffff or passes>2 or index>=250:
+        raise ValueError('Incomplete/corrupt peripheral state')
+    table=registers()
+    if state==0 and raw!=initialized(identity):raise ValueError('Changed unexecuted peripheral record')
+    if state==2 and (passes!=2 or index!=len(table)-1):raise ValueError('Incomplete completed peripheral record')
+    times=struct.unpack_from('<4Q',raw,64);result=[]
+    if state==2 and any(times[n+2]<times[n] for n in (0,1)):
+        raise ValueError('Invalid peripheral timestamps')
+    for n,e in enumerate(table):
+        address,width,group,valid,first,second=struct.unpack_from('<IBBHII',raw,96+n*16)
+        if (address,width,group)!=(int(e['address'],0),e['width'],e['group']) or valid>3:
+            raise ValueError('Register allowlist/layout mismatch')
+        if (not valid&1 and first) or (not valid&2 and second) or (width==2 and (first>65535 or second>65535)):
+            raise ValueError('Invalid unread or narrow register value')
+        result.append(dict(e,valid=valid,first=first if valid&1 else None,
+                           second=second if valid&2 else None,stable=valid==3 and first==second))
+    if any(raw[96+len(result)*16:]):raise ValueError('Unexpected extra register entries')
+    return dict(state=state,pass_number=passes,last_index=index,began_ticks=times[:2],
+        ended_ticks=times[2:],counter_hz=13000000,registers=result,
+        lk_card_metadata=lk_card_metadata(result),
+        ownership_granted=False,mmio_writes=False)
+
+def lk_card_metadata(entries):
+    """Interpret only the pinned LK's stable, pointer-linked static objects.
+
+    This is a corroborating software snapshot, never card/queue ownership or
+    live EXT_CSD evidence. In particular, no captured pointer is dereferenced.
+    """
+    values={int(e['address'],0):e['first'] for e in entries if e['stable']}
+    words=(0x4a0301c3,0x00c0eb03,0x4410447a,0xbf004770,0x000fb12c,
+           0x4a030203,0x2080ebc3,0x4410447a,0xbf004770,0x000fb228)
+    if any(values.get(0x4804bb18+4*n)!=v for n,v in enumerate(words)):
+        return dict(valid=False,reason='LK getter code absent, unstable or mismatched')
+    host,card=0x48146c50,0x48146d60
+    required={host:card,host+0x28:0x11230000,host+0x44:512,
+              card:host,card+8:512,card+0x1c:1}
+    if any(values.get(a)!=v for a,v in required.items()):
+        return dict(valid=False,reason='LK host/card linkage, type or geometry mismatch')
+    fields={name:values.get(card+offset) for name,offset in
+            (('sectors',4),('ocr',12),('rca',24),('state_ready',32))}
+    if (any(v is None for v in fields.values()) or not 0<fields['sectors']<2**31 or
+        not 0<fields['rca']<=65535 or fields['ocr']&0xc0000000!=0xc0000000 or
+        not fields['state_ready']&0x10 or fields['state_ready']>>16!=1):
+        return dict(valid=False,reason='LK card addressing/readiness metadata incomplete')
+    return dict(valid=True,**fields,ownership_granted=False,
+                authority='stable exact-LK software metadata; requires live CMD13 and EXT_CSD')
