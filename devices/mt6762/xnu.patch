+int mt6762_c62_select(enum mt6762_domain d,uint32_t request,uint32_t floor,
+                     uint32_t cap,uint32_t thermal,struct mt6762_nominal_opp *out)
+{
+    unsigned i;
+    uint32_t limit=request;
+    if ((unsigned)d>=3 || !out || !request || !floor || !cap || !thermal) return -1;
+    if (cap<limit) limit=cap;
+    if (thermal<limit) limit=thermal;
+    if (floor>limit) return -1;
+    for(i=0;i<16;i++) {
+        if(opps[d][i].khz<=limit && opps[d][i].khz>=floor) {
+            *out=opps[d][i]; return 0;
+        }
+    }
+    return -1;
+}
+int mt6762_c62_shared_voltage(const uint8_t idx[3],uint32_t *out)
+{
+    uint32_t v=0;
+    unsigned d;
+    if(!idx || !out) return -1;
+    for(d=0;d<3;d++) {
+        if(idx[d]>=16) return -1;
+        if(opps[d][idx[d]].nominal_uv>v) v=opps[d][idx[d]].nominal_uv;
+    }
+    *out=v;return 0;
+}
+int mt6357_selector_for_window(uint32_t min,uint32_t max,uint8_t *sel,uint32_t *actual)
+{
+    uint32_t s,v;
+    if(!sel || !actual || min<518750 || min>max || max>1312500) return -1;
+    s=(min-518750+6249)/6250;
+    if(s>127) return -1;
+    v=518750+s*6250;
+    if(v>max) return -1;
+    *sel=(uint8_t)s;*actual=v;return 0;
+}
+int mt6762_sspm_vote(enum mt6762_domain d,unsigned index,unsigned counter,
+                    uint32_t *offset,uint32_t *word)
+{
+    if((unsigned)d>=3 || index>=16 || !counter || counter>255 || !offset || !word)
+        return -1;
+    *offset=0x3a4+4*(unsigned)d;
+    *word=(counter<<4)|index;return 0;
+}
diff --git a/tools/mt6762/hardware/cpu-power/opp_policy.h b/tools/mt6762/hardware/cpu-power/opp_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..bddb3bf4079771c21a1107c2a3f8b11c34afa7bc
--- /dev/null
+++ b/tools/mt6762/hardware/cpu-power/opp_policy.h
@@ -0,0 +1,22 @@
+#ifndef MT6762_OPP_POLICY_H
+#define MT6762_OPP_POLICY_H
+#include <stdint.h>
+enum mt6762_domain { MT6762_CPU0=0, MT6762_CPU4=1, MT6762_CCI=2 };
+struct mt6762_nominal_opp { uint32_t khz, nominal_uv; uint8_t postdiv, clkdiv, index; };
+/* Pure planning for stock level4 (C62). Does not authorize/program an OPP.
+ * All limits must be known, nonzero; thermal_cap includes current protection.
+ * Runtime EEM voltages and SSPM readiness must be resolved by integration. */
+int mt6762_c62_select(enum mt6762_domain, uint32_t request_khz,
+                     uint32_t policy_floor_khz, uint32_t policy_cap_khz,
+                     uint32_t thermal_cap_khz, struct mt6762_nominal_opp *out);
+/* Maximum shared VPROC nominal demand across both clusters and CCI. Caller
+ * must supply all three indices; never lower a rail using only one domain. */
+int mt6762_c62_shared_voltage(const uint8_t indices[3], uint32_t *nominal_uv);
+/* PMIC linear-selector arithmetic only. Caller supplies allowed voltage window.
+ * Upward rounding may not exceed maximum; output unchanged on error. */
+int mt6357_selector_for_window(uint32_t minimum_uv, uint32_t maximum_uv,
+                              uint8_t *selector, uint32_t *actual_uv);
+/* Pure stock scheduler request encoding: no MMIO. counter must be1..255. */
+int mt6762_sspm_vote(enum mt6762_domain, unsigned index, unsigned counter,
+                    uint32_t *csram_offset, uint32_t *word);
+#endif
