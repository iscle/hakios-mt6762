+    if complete[:len(packed)] != packed:
+        raise ValueError('Diagnostic payload changed')
+    offset, size = footer['vbmeta_offset'], footer['vbmeta_size']
+    if size < 256 or offset % 4096:
+        raise ValueError('Invalid vbmeta extent/alignment')
