diff --git a/tools/mt6762/qemu/test_lab_display.py b/tools/mt6762/qemu/test_lab_display.py
new file mode 100644
index 0000000000000000000000000000000000000000..476f416b3aca61954635cee4257656daa78b9332
--- /dev/null
+++ b/tools/mt6762/qemu/test_lab_display.py
@@ -0,0 +1,264 @@
+#!/usr/bin/env python3
+"""QEMU-only register/PWM fixture tests. Never connects to a physical device.
+
+Requires the local MT6762 QEMU patch series and an explicit research DTB.
+The CPU remains paused; qtest accesses synthetic MMIO and QMP injects faults.
+This does not establish DSI scanout, actual brightness or panel behaviour.
+"""
+import argparse
+import json
+from pathlib import Path
+import socket
+import subprocess
+import tempfile
+import time
+
+
+class Lab:
+    def __init__(self, qemu, dtb, directory, enabled=True, accel='tcg', two_layer=False):
+        directory = Path(directory)
+        self.log = (directory / "qemu.log").open("w+")
+        self.qmp_path = directory / "qmp.sock"
+        self.test_path = directory / "qtest.sock"
+        machine = "mt6762,lab-i2c=on"
+        self.two_layer = two_layer
+        if enabled:
+            machine += ",lab-display=on,lab-display-fb=" + (
+                "0x7ef90000,lab-display-two-layer=on" if two_layer else "0x41000000")
+        self.process = subprocess.Popen([
+            str(qemu), "-M", machine, "-accel", accel, "-cpu", "cortex-a53",
+            "-m", "1024M" if two_layer else "512M", "-smp", "1", "-dtb", str(dtb),
+            *([] if accel == 'qtest' else ['-S']),
+            "-display", "none", "-serial", "null", "-monitor", "none",
+            "-qmp", f"unix:{self.qmp_path},server=on,wait=off",
+            "-qtest", f"unix:{self.test_path},server=on,wait=off",
+        ], stdout=self.log, stderr=self.log)
+        self.sockets = []
+        try:
+            self.qmp = self.connect(self.qmp_path)
+            self.test = self.connect(self.test_path)
+            assert "QMP" in json.loads(self.qmp.readline())
+            self.command("qmp_capabilities")
+        except BaseException:
+            self.close()
+            raise
+
+    def connect(self, path):
+        deadline = time.monotonic() + 10
+        while time.monotonic() < deadline:
+            if self.process.poll() is not None:
+                self.log.seek(0)
+                raise RuntimeError(self.log.read())
+            sock = socket.socket(socket.AF_UNIX)
+            sock.settimeout(5)
+            try:
+                sock.connect(str(path))
+            except (FileNotFoundError, ConnectionRefusedError):
+                sock.close()
+                time.sleep(0.02)
+                continue
+            self.sockets.append(sock)
+            return sock.makefile("rwb", buffering=0)
+        raise TimeoutError(f"QEMU socket {path.name} did not appear")
+
+    def command(self, command, **arguments):
+        self.qmp.write((json.dumps({"execute": command, "arguments": arguments}) + "\n").encode())
+        while True:
+            answer = json.loads(self.qmp.readline())
+            if "event" in answer:
+                continue
+            if "error" in answer:
+                raise RuntimeError(answer["error"])
+            return answer.get("return")
+
+    def state(self):
+        return json.loads(self.command("qom-get", path="/machine", property="lab-display-state"))
+
+    def fault(self, name):
+        self.command("qom-set", path="/machine", property="lab-display-fault", value=name)
+
+    def access(self, text):
+        self.test.write((text + "\n").encode())
+        reply = self.test.readline().decode().strip()
+        if not reply.startswith("OK"):
+            raise RuntimeError(reply)
+        return reply[2:].strip()
+
+    def read(self, address):
+        return int(self.access(f"readl {address:#x}"), 0)
+
+    def write(self, address, value):
+        self.access(f"writel {address:#x} {value:#x}")
+
+    def close(self):
+        if self.process.poll() is None:
+            self.process.terminate()
+            try:
+                self.process.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                self.process.kill()
+                self.process.wait(timeout=5)
+        for name in ["qmp", "test"]:
+            stream = getattr(self, name, None)
+            if stream:
+                stream.close()
+        for sock in self.sockets:
+            sock.close()
+        self.log.close()
+
+
+def exercise(lab):
+    base=0x7ef90000 if lab.two_layer else 0x41000000
+    initial=1023 if lab.two_layer else 512
+    assert lab.state()["applied_level"] == initial
+    assert lab.read(0x1400bf40) == base
+    assert lab.read(0x10006180) == lab.read(0x10006184) == 8
+    assert lab.read(0x10000080) == (0x30101 if lab.two_layer else 0x03000000)
+    if lab.two_layer:
+        assert lab.read(0x10005350) == 0x11111441
+        assert lab.read(0x1400bf60) == base+0x144000
+        assert lab.read(0x1400b02c) == 3
+        assert lab.read(0x1400b024) == 0x81000001
+    assert not lab.read(0x100010ac) & 4
+    assert lab.read(0x1401401c) == (0x2c030480 if lab.two_layer else (3 << 16) | 1152)
+    if not lab.two_layer:
+        assert not lab.state()["two_layer"]
+        assert lab.read(0x1400b02c) == 1 and lab.read(0x1400b030) == 0x20ff
+        assert lab.read(0x1400bf60) == lab.read(0x1400b050) == 0
+        before = lab.state()['reads']['ovl']
+        assert lab.read(0x1400b024) == lab.read(0x1400b3a0) == 0
+        assert lab.state()['reads']['ovl'] == before + 2
+        before = lab.state()['rejected_writes']
+        lab.write(0x1400b024, 0xffffffff)
+        lab.write(0x1400b3a0, 0xffffffff)
+        assert lab.read(0x1400b024) == lab.read(0x1400b3a0) == 0
+        assert lab.state()['rejected_writes'] == before + 2
+    pwm = 0x1100e000
+    assert lab.read(pwm + 0x18) == (0 if lab.two_layer else 3 << 16)
+    assert lab.read(pwm + 0x1c) == (initial << 16) | 1023
+    lab.write(pwm + 0x1c, (700 << 16) | 1023)
+    lab.write(pwm, 1)
+    assert lab.state()["applied_level"] == initial
+    lab.write(pwm + 0xc, 1)
+    assert lab.state()["applied_level"] == initial
+    lab.write(pwm + 0xc, 0)
+    assert lab.state()["applied_level"] == 700 and lab.state()["commits"] == 1
+    lab.write(pwm + 0xc, 0)  # No rising edge: no new latch.
+    assert lab.state()["commits"] == 1
+    lab.write(pwm + 0x1c, (1 << 16) | 1023)
+    lab.write(pwm, 0)
+    lab.write(pwm + 0xc, 1)
+    lab.write(pwm + 0xc, 0)
+    assert lab.state()["applied_level"] == 0 and lab.state()["commits"] == 2
+    lab.fault("pwm-drop")
+    lab.write(pwm + 0x1c, (900 << 16) | 1023)
+    lab.write(pwm, 1)
+    lab.write(pwm + 0xc, 1)
+    lab.write(pwm + 0xc, 0)
+    assert lab.read(pwm + 0x1c) == (1 << 16) | 1023
+    assert lab.state()["applied_level"] == 0 and lab.state()["commits"] == 2
+    lab.fault("power-off")
+    assert lab.read(0x10006180) == 0 and lab.read(0x10006184) == 0
+    lab.fault("scanout-mismatch")
+    assert lab.read(0x1400bf40) != base
+    lab.fault("none")
+    lab.write(0x1400bf40, 0x43000000)  # Pipeline is inherited, not programmable.
+    assert lab.read(0x1400bf40) == base
+    before = lab.state()["rejected_writes"]
+    lab.write(pwm + 0x1c, (1024 << 16) | 1023)
+    lab.write(pwm + 0xc, 1)
+    lab.write(pwm + 0xc, 0)
+    assert lab.state()["rejected_writes"] == before + 1
+    assert lab.state()["commits"] == 2
+    return lab.state()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--qemu", required=True, type=Path)
+    parser.add_argument("--dtb", required=True, type=Path)
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory(prefix="mt6762-display-qtest-") as temporary:
+        lab = Lab(args.qemu.resolve(), args.dtb.resolve(), temporary)
+        try:
+            result = exercise(lab)
+        finally:
+            lab.close()
+        lab = Lab(args.qemu.resolve(), args.dtb.resolve(), temporary, two_layer=True)
+        try:
+            assert lab.state()["two_layer"]
+            registers = {
+                0x1400b00c: 1, 0x1400b02c: 3, 0x1400b020: 384 | (854 << 16),
+                0x1400b030: 0x21ff, 0x1400b050: 0x21ff,
+                0x1400b038: 384 | (854 << 16), 0x1400b058: 384 | (854 << 16),
+                0x1400b044: 1536, 0x1400b064: 1536,
+                0x1400bf40: 0x7ef90000, 0x1400bf60: 0x7f0d4000,
+                0x1400b03c: 0, 0x1400b05c: 0, 0x1400b04c: 0, 0x1400b06c: 0,
+                0x1400b324: 0, 0x1400b024: 0x81000001, 0x1400b3a0: 0,
+                0x1400b0c0: 0x520001, 0x1400b0e0: 0x480001,
+                0x1400d010: 0x101, 0x14014000: 1, 0x14014014: 2,
+                0x14014018: 0x1001c, 0x1401401c: 0x2c030480,
+                0x14014020: 2, 0x14014024: 20, 0x14014028: 170, 0x1401402c: 854,
+            }
+            before = lab.state()['reads']['ovl']
+            assert {a: lab.read(a) for a in registers} == registers
+            assert lab.state()['reads']['ovl'] == before + sum(
+                0x1400b000 <= a < 0x1400c000 for a in registers)
+            before = lab.state()["rejected_writes"]
+            for address, value in registers.items():
+                lab.write(address, value ^ 0xffffffff)
+            assert {a: lab.read(a) for a in registers} == registers
+            assert lab.state()["rejected_writes"] == before + len(registers)
+            try:
+                lab.command('qom-set', path='/machine', property='lab-display-two-layer', value=False)
+                raise AssertionError('fixture mode must be immutable')
+            except RuntimeError as error:
+                assert 'before initialization' in str(error)
+            lab.fault('scanout-mismatch')
+            assert lab.read(0x1400bf40) == 0x7ef94000
+            assert lab.read(0x1400bf60) == 0x7f0d8000
+            lab.fault('none')
+            assert {a: lab.read(a) for a in registers} == registers
+            lk_result = exercise(lab)
+        finally:
+            lab.close()
+        lab = Lab(args.qemu.resolve(), args.dtb.resolve(), temporary, enabled=False)
+        try:
+            assert lab.state() == {"enabled": False}
+            assert lab.read(0x1100e018) == 0
+        finally:
+            lab.close()
+    # Board must reject invalid physical-range assertions before mapping any
+    # display registers. The4GiB case uses RAM spanning that boundary so it
+    # exercises the narrower32-bit scanout limit, not merely the RAM bound.
+    for options, memory in [
+        ("lab-display=on,lab-display-fb=0x41000000", "512M"),
+        ("lab-i2c=on,lab-display=on,lab-display-fb=0x41000001", "512M"),
+        ("lab-i2c=on,lab-display=on,lab-display-fb=0x3fff0000", "512M"),
+        ("lab-i2c=on,lab-display=on,lab-display-fb=0x5fff0000", "512M"),
+        ("lab-i2c=on,lab-display=on,lab-display-fb=0xffffc000", "4096M"),
+    ]:
+        failed = subprocess.run([
+            str(args.qemu.resolve()), "-M", "mt6762," + options, "-m", memory,
+            "-accel", "tcg", "-smp", "1", "-dtb", str(args.dtb.resolve()),
+            "-S", "-display", "none", "-serial", "null", "-monitor", "none",
+        ], capture_output=True, timeout=10)
+        assert failed.returncode != 0 and b"lab-display requires" in failed.stderr, failed.stderr
+    for options, memory in [
+        ('lab-display-two-layer=on', '1024M'),
+        ('lab-i2c=on,lab-display=on,lab-display-two-layer=on,lab-display-fb=0x41000000', '1024M'),
+        ('lab-i2c=on,lab-display=on,lab-display-two-layer=on,lab-display-fb=0x7ef90000', '512M'),
+        ('lab-i2c=on,lab-display=on,lab-display-two-layer=on,lab-display-fb=0x7ef90000', '1010M'),
+    ]:
+        failed = subprocess.run([
+            str(args.qemu.resolve()), '-M', 'mt6762,' + options, '-m', memory,
+            '-accel', 'tcg', '-smp', '1', '-dtb', str(args.dtb.resolve()),
+            '-S', '-display', 'none', '-serial', 'null', '-monitor', 'none',
+        ], capture_output=True, timeout=10)
+        assert failed.returncode != 0 and b'lab-display-two-layer requires' in failed.stderr
+    print(json.dumps({"synthetic_only": True, "passed": True, "final_fixture_state": result,
+                      "lk_fixture_state": lk_result}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/mt6762/qemu/test_lab_power.py b/tools/mt6762/qemu/test_lab_power.py
new file mode 100644
index 0000000000000000000000000000000000000000..968cfeee4de8538e69d22f8147169c7f377d4137
--- /dev/null
+++ b/tools/mt6762/qemu/test_lab_power.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Test only opt-in synthetic PWRAP/ADC/keypad MMIO; no phone access.
+
+The qtest accelerator executes no guest instructions. Virtual-time stepping tests WACS2 busy/read-valid/clear,
+conversion-ready delays, faults, command restrictions and active-low keys.
+Native-worker integration is a separate full-kernel acceptance run.
+"""
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+from test_lab_display import Lab
+
+
+class PowerLab(Lab):
+    def __init__(self, qemu, dtb, directory, enabled=True, thermal=False):
+        directory = Path(directory)
+        self.log = (directory / 'qemu.log').open('w+')
+        self.qmp_path = directory / 'qmp.sock'
+        self.test_path = directory / 'qtest.sock'
+        self.process = subprocess.Popen([
+            str(qemu), '-M', 'mt6762' + (',lab-power=on' if enabled else '') +
+            (',lab-pmic-thermal=on' if thermal else ''),
+            '-accel', 'qtest', '-cpu', 'cortex-a53', '-m', '512M', '-smp', '1',
+            '-dtb', str(dtb), '-display', 'none', '-serial', 'null',
+            '-monitor', 'none', '-qmp', f'unix:{self.qmp_path},server=on,wait=off',
+            '-qtest', f'unix:{self.test_path},server=on,wait=off',
+        ], stdout=self.log, stderr=self.log)
+        self.sockets = []
+        try:
+            self.qmp = self.connect(self.qmp_path)
+            self.test = self.connect(self.test_path)
+            assert 'QMP' in json.loads(self.qmp.readline())
+            self.command('qmp_capabilities')
+        except BaseException:
+            self.close()
+            raise
+
+    def state(self):
+        return json.loads(self.command('qom-get', path='/machine', property='lab-power-state'))
+
+    def fault(self, name):
+        self.command('qom-set', path='/machine', property='lab-power-fault', value=name)
+
+    def keys(self, mask):
+        self.command('qom-set', path='/machine', property='lab-key-mask', value=mask)
+
+    def step(self, ns):
+        self.access(f'clock_step {ns}')
+
+    def status(self):
+        return self.read(0x1000dc24)
+
+    def pmic(self, address, value=None):
+        assert address % 2 == 0
+        assert (self.status() >> 16) & 7 == 0
+        command = (address >> 1) << 16
+        if value is not None:
+            command |= 0x80000000 | value
+        self.write(0x1000dc20, command)
+        assert (self.status() >> 16) & 7 == 2
+        self.step(10000)
+        if value is not None:
+            assert (self.status() >> 16) & 7 == 0
+            return
+        assert (self.status() >> 16) & 7 == 6
+        result = self.status() & 0xffff
+        self.write(0x1000dc28, 1)
+        assert (self.status() >> 16) & 7 == 0
+        return result
+
+    def keymem(self):
+        return int(self.access('readw 0x10010004'), 0)
+
+
+def exercise(lab):
+    assert lab.status() == 1 << 21
+    assert lab.pmic(8) == 0x5730
+    assert lab.pmic(0x24) == 6 and lab.pmic(0xe08) == 1
+    assert lab.keymem() == 0xffff
+    for mask in range(8):
+        lab.keys(mask)
+        assert bool(lab.pmic(0x24) & 2) == (not bool(mask & 1))
+        mem = lab.keymem()
+        assert bool(mem & 2) == (not bool(mask & 2))
+        assert bool(mem & 1) == (not bool(mask & 4))
+    lab.keys(0)
+    # Ready must remain clear before the conversion delay.
+    lab.pmic(0x110e, 2)
+    assert lab.pmic(0x108a) == 0
+    lab.step(1280000)
+    raw = lab.pmic(0x108a)
+    assert raw == 0x8000 | 26700
+    assert ((raw & 0x7fff) * 3 * 1800) >> 15 == 4400
+    lab.pmic(0x110e, 8)
+    assert lab.pmic(0x108e) == 0
+    lab.step(80000)
+    raw = lab.pmic(0x108e)
+    assert raw == 0x8000 | 1400
+    assert ((raw & 0xfff) * 1800) >> 12 == 615
+    # No fabricated PMIC programming beyond the two conversion requests.
+    before = lab.state()['rejected']
+    lab.pmic(0x110e, 4)
+    lab.pmic(0x24, 0)
+    assert lab.state()['rejected'] == before + 2
+    assert lab.pmic(0x24) == 6
+    lab.fault('bad-id')
+    assert lab.pmic(8) == 0x1234
+    lab.fault('adc-timeout')
+    lab.pmic(0x110e, 2)
+    lab.step(40000000)
+    assert lab.pmic(0x108a) == 0
+    lab.fault('adc-rail')
+    lab.pmic(0x110e, 8)
+    lab.step(80000)
+    assert lab.pmic(0x108e) == 0x8000
+    lab.fault('keypad-disabled')
+    assert int(lab.access('readw 0x10010024'), 0) == 0
+    lab.fault('init-loss')
+    assert not lab.status() & (1 << 21)
+    lab.fault('none')
+    assert lab.status() == 1 << 21
+    # No automatic recovery from a timed-out in-flight command.
+    lab.fault('stall')
+    lab.write(0x1000dc20, (8 >> 1) << 16)
+    lab.step(20000000)
+    assert (lab.status() >> 16) & 7 == 2
+    lab.fault('none')
+    lab.step(20000000)
+    assert (lab.status() >> 16) & 7 == 2
+    before = lab.state()['rejected']
+    lab.write(0x1000dc20, (8 >> 1) << 16)
+    lab.write(0x1000dc28, 1)
+    assert lab.state()['rejected'] == before + 2
+    return lab.state()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--qemu', type=Path, required=True)
+    parser.add_argument('--dtb', type=Path, required=True)
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory(prefix='mt6762-power-qtest-') as temporary:
+        lab = PowerLab(args.qemu.resolve(), args.dtb.resolve(), temporary)
+        try:
+            result = exercise(lab)
+        finally:
+            lab.close()
+        lab = PowerLab(args.qemu.resolve(), args.dtb.resolve(), temporary, enabled=False)
+        try:
+            assert lab.state() == {'enabled': False}
+            assert lab.status() == 0
+            assert lab.keymem() == 0
+        finally:
+            lab.close()
+    print(json.dumps({'passed': True, 'synthetic_only': True, 'final_state': result}, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/mt6762/qemu/test_lab_thermal.py b/tools/mt6762/qemu/test_lab_thermal.py
new file mode 100644
index 0000000000000000000000000000000000000000..3d2ab3885af5d058e1b4747654eb573cf6dd3124
--- /dev/null
+++ b/tools/mt6762/qemu/test_lab_thermal.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Opt-in synthetic PMIC thermal protocol tests; never physical temperatures.
+
+No guest CPU executes. This independently checks timer/ready/fault fixtures;
+real native conversion/freshness acceptance is a separate kernel run.
+"""
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+from test_lab_power import PowerLab
+
+
+CALIBRATION = (0x137, 1588, 0, 0, 1526, 1534)
+CHANNELS = ((0x110e, 16, 0x1090, 1588),
+            (0x1114, 32, 0x10d8, 1526),
+            (0x1114, 64, 0x10da, 1534))
+
+
+def sample(lab, channel, rail=False):
+    request, bit, output, raw = CHANNELS[channel]
+    lab.pmic(request, bit)
+    assert lab.pmic(output) == 0  # Mandatory observed READY low.
+    lab.step(80000)
+    assert lab.pmic(output) == (0x8000 | (0 if rail else raw))
+
+
+def exercise(lab):
+    state = lab.state()
+    assert state['thermal_enabled'] and state['thermal_calibration_synthetic']
+    for _ in range(2):
+        assert tuple(lab.pmic(0x11ae + 2 * i) for i in range(6)) == CALIBRATION
+    assert lab.pmic(0x1216) == 0
+    for channel in range(3):
+        sample(lab, channel)
+        sample(lab, channel)  # A new request clears previous READY.
+    assert lab.state()['thermal_requests'] == [2, 2, 2]
+    assert lab.state()['thermal_completions'] == [2, 2, 2]
+    # Thermal faults leave baseline battery/NTC ADC operational.
+    lab.fault('thermal-timeout')
+    lab.pmic(0x110e, 16)
+    lab.step(40000000)
+    assert lab.pmic(0x1090) == 0
+    lab.pmic(0x110e, 2)
+    lab.step(1280000)
+    assert lab.pmic(0x108a) == 0x8000 | 26700
+    lab.fault('thermal-stale')
+    lab.pmic(0x1114, 32)
+    assert lab.pmic(0x10d8) & 0x8000  # Guest must reject preexisting READY.
+    lab.fault('thermal-uncalibrated')
+    assert not lab.pmic(0x11ae) & 256
+    lab.fault('thermal-bad-degc')
+    assert lab.pmic(0x11ae) & 63 == 1
+    lab.fault('thermal-mux')
+    assert lab.pmic(0x1216) & 16  # Shared die channel belongs to DCXO.
+    lab.fault('thermal-rail')
+    for channel in range(3):
+        sample(lab, channel, rail=True)
+    lab.fault('none')
+    before = lab.state()['rejected']
+    lab.pmic(0x1216, 16)  # Mux/rail programming remains unsupported.
+    lab.pmic(0x1114, 96)  # No combined-channel request contract.
+    assert lab.state()['rejected'] == before + 2
+    assert lab.pmic(0x1216) == 0
+    return lab.state()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--qemu', required=True, type=Path)
+    parser.add_argument('--dtb', required=True, type=Path)
+    args = parser.parse_args()
+    qemu, dtb = args.qemu.resolve(), args.dtb.resolve()
+    with tempfile.TemporaryDirectory(prefix='mt6762-thermal-qtest-') as temporary:
+        lab = PowerLab(qemu, dtb, temporary, thermal=True)
+        try:
+            result = exercise(lab)
+        finally:
+            lab.close()
+        lab = PowerLab(qemu, dtb, temporary)
+        try:
+            assert not lab.state()['thermal_enabled']
+            before = lab.state()['rejected']
+            assert lab.pmic(0x11ae) == 0xffff
+            lab.pmic(0x110e, 16)
+            assert lab.state()['rejected'] == before + 2
+            assert lab.state()['thermal_requests'] == [0, 0, 0]
+        finally:
+            lab.close()
+    bad = subprocess.run([str(qemu), '-M', 'mt6762,lab-pmic-thermal=on',
+        '-accel', 'qtest', '-m', '512M', '-dtb', str(dtb), '-display', 'none',
+        '-serial', 'null', '-monitor', 'none'], capture_output=True, timeout=10)
+    assert bad.returncode != 0 and b'lab-power' in bad.stderr
+    print(json.dumps({'passed': True, 'synthetic_only': True,
+        'physical_calibration_claimed': False, 'final_state': result}, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/mt6762/qemu/test_lab_touch.py b/tools/mt6762/qemu/test_lab_touch.py
new file mode 100644
index 0000000000000000000000000000000000000000..b7893911a54eb6a6a017629fa769ec42288ee241
--- /dev/null
+++ b/tools/mt6762/qemu/test_lab_touch.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Validate runtime raw AXS packets through the synthetic APDMA model."""
+import argparse
+import importlib.util
+from pathlib import Path
+import tempfile
+from test_lab_display import Lab
+
+spec = importlib.util.spec_from_file_location('touch_lab', Path(__file__).resolve().parents[1] / 'boot/touch_lab.py')
+touch = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(touch)
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--qemu', type=Path, required=True)
+    p.add_argument('--dtb', type=Path, required=True)
+    a = p.parse_args()
+    with tempfile.TemporaryDirectory(prefix='mtk-touch-') as directory:
+        lab = Lab(a.qemu.resolve(), a.dtb.resolve(), directory, enabled=False, accel='qtest')
+        try:
+            def get():
+                return lab.command('qom-get', path='/machine', property='lab-touch-frame')
+            def put(value):
+                lab.command('qom-set', path='/machine', property='lab-touch-frame', value=value)
+            assert get() == ''
+            packet = touch.frame([(0, 384, 854), (1, 0, 0), (2, 120, 200), (3, 300, 800), (4, 1, 853)])
+            put(packet)
+            assert get() == packet
+            for bad in ('0', '00' * 31, '00' * 33, 'gg' * 32):
+                try:
+                    put(bad)
+                except RuntimeError:
+                    pass
+                else:
+                    raise AssertionError('Malformed packet accepted')
+                assert get() == packet, 'Invalid setter changed previous state'
+            lab.write(0x10001084, 1 << 11)
+            lab.write(0x1000108c, 1 << 18)
+            def receive():
+                base, dma, target = 0x11007000, 0x11000080, 0x41000000
+                for offset, value in ((4, 0x77), (12, 0xffff), (16, 4), (20, 32), (24, 1)):
+                    lab.access(f'writew {base + offset:#x} {value:#x}')
+                for offset, value in ((24, 1), (32, target), (36, 0), (40, 32), (84, 0), (88, 0), (8, 1)):
+                    lab.write(dma + offset, value)
+                lab.access(f'writew {base + 36:#x} 1')
+                lab.access('clock_step 1000000')
+                assert int(lab.access(f'readw {base + 12:#x}'), 0) == 1
+                assert lab.read(dma + 8) == 0
+                return lab.access(f'read {target:#x} 32').removeprefix('0x').lower()
+            assert receive() == packet
+            put(touch.frame([])); assert receive() == '00' * 32
+            put(''); assert get() == '' and receive() == '00' * 32
+            for points in ([(0, -1, 0)], [(5, 1, 1)], [(0, 385, 0)], [(0, 0, 855)], [(0, 1, 1)] * 2):
+                try:
+                    touch.frame(points)
+                except ValueError:
+                    pass
+                else:
+                    raise AssertionError('Invalid contacts accepted')
+            print('Synthetic raw AXS: five contacts, DMA bytes, invalid setter preservation and release passed')
+        finally:
+            lab.close()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/mt6762/run-ios.sh b/tools/mt6762/run-ios.sh
