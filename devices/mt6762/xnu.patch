+from unicorn.arm_const import *
+from capstone import Cs,CS_ARCH_ARM,CS_MODE_THUMB
+LK_SHA='5badc0dc942b0babdca3da13c7e07f3b5f1e57b66d503414b7f80effe8ce891a'
