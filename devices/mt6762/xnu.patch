+def trampoline(ba_pa, entry_pa, split_eoi=False):
+    eoi_setup = '''    /* Explicit synthetic inherited CPU-interface mode. */
+    mrs x4, ICC_SRE_EL1
+    orr x4, x4, #1
+    msr ICC_SRE_EL1, x4
+    isb
+    mrs x4, ICC_CTLR_EL1
+    orr x4, x4, #2
+    msr ICC_CTLR_EL1, x4
+    isb
+    mrs x4, ICC_CTLR_EL1
+99: tbz x4, #1, 99b
+''' if split_eoi else ''
+    return f'''/* QEMU-only AArch64 Linux Image handoff; no stack or relocation. */
+.section .text,"ax"
+.global _start
+_start:
+    b start
+    .long 0
+    .quad 0x80000
+    .quad image_end - _start
+    .quad 0xa
+    .quad 0, 0, 0
+    .long 0x644d5241
+    .long 0
+start:
+    msr daifset, #15
+{eoi_setup}\
+    ldr x1, =0x11002000
+    adr x2, message
+1:  ldrb w3, [x2], #1
+    cbz w3, 3f
+2:  ldr w4, [x1, #0x14]
+    tbz w4, #5, 2b
+    str w3, [x1]
+    b 1b
+3:  dsb sy
+    ic iallu
+    dsb sy
+    isb
+    ldr x0, ={ba_pa:#x}
+    ldr x9, ={entry_pa:#x}
+    mov x1, xzr
+    mov x2, xzr
+    mov x3, xzr
+    br x9
+message:
+    .asciz "mt6762 loader: entering XNU at {entry_pa:#x} boot_args={ba_pa:#x}{' synthetic-split-eoi=1' if split_eoi else ''}\\r\\n"
+    .balign 8
+    .ltorg
+image_end:
+'''
