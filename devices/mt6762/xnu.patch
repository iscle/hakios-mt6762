+/* SPDX-License-Identifier: MIT
+ * Executes the actual core against a modeled cache/RAM consumer, never MMIO.
+ */
+#include "conn_rom.h"
+#include "sha256.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+enum fault { F_NONE,F_WRITE,F_SHORT_WRITE,F_READ,F_SHORT_READ,F_MISMATCH,
+    F_PUBLISH,F_INVALIDATE,F_ADMIT,F_STATE,F_LATE,F_SOURCE,F_BACKWARDS };
+struct fixture {
+    uint8_t *dram,*cache,*file[3];
+    struct cr_request request;struct cr_io io;
+    struct cr_workspace workspace;struct cr_report report;
+    uint64_t tick,step;unsigned tick_calls;
+    enum fault fault;enum cr_phase fault_phase;unsigned target,state_field,fired;
+    unsigned observations,writes,reads,publishes,invalidates,sequence;
+    uint64_t pending;size_t pending_n;
+    unsigned expected_image;size_t expected_at;
+    struct cr_live live;
+};
+static uint64_t ticks(void *v)
+{
+    struct fixture *f=v;f->tick_calls++;
+    if(f->fault==F_BACKWARDS && f->tick_calls==10){f->tick-=1000;f->fired++;}
+    f->tick+=f->step;return f->tick;
+}
+static int observe(void *v,enum cr_phase phase,struct cr_live *s)
+{
+    struct fixture *f=v;f->observations++;*s=f->live;
+    assert(!f->fired || f->fault==F_SOURCE);
+    if(f->fault==F_SOURCE && phase==CR_COPY && !f->fired) {
+        f->file[0][2000]^=1;f->fired++;return 0;
+    }
+    if((f->fault==F_ADMIT || f->fault==F_STATE || f->fault==F_LATE) &&
+       phase==f->fault_phase && !f->fired) {
+        f->fired++;
+        if(f->fault==F_ADMIT)return -91;
+        if(f->fault==F_LATE){f->tick+=UINT64_C(13000000)*6;return 0;}
+        switch(f->state_field) {
+        case 0:s->lease_epoch++;break;
+        case 1:s->owned_base+=0x1000000;break;
+        case 2:s->owned_bytes--;break;
+        case 3:s->rgu_reset&=~0x1000U;break;
+        case 4:s->spm_control|=0x10;break;
+        case 5:s->power_status&=~2U;break;
+        case 6:s->power_status2&=~2U;break;
+        case 7:s->ip_id^=1;break;
+        case 8:s->fw_version|=1;break;
+        case 9:s->emi_remap^=1;break;
+        case 10:s->hw_version^=1;break;
+        case 11:s->fw_version^=0x100;break;
+        default:assert(0);
+        }
+    }
+    return 0;
+}
+static size_t offset(struct fixture *f,uint64_t pa,size_t n)
+{
+    assert(pa>=f->request.consys_base && n && n<=CR_CHUNK);
+    assert(pa-f->request.consys_base<=CR_CONSYS_BYTES-n);
+    return (size_t)(pa-f->request.consys_base);
+}
+static int write_ram(void *v,uint64_t pa,const uint8_t *data,size_t n,size_t *done)
+{
+    struct fixture *f=v;const struct cr_profile *p;size_t at=offset(f,pa,n),expected_n;
+    assert(!f->fired || f->fault==F_SOURCE);
+    assert(f->sequence==0 && f->expected_image<3);p=cr_profile_at(f->expected_image);
+    if(f->expected_at==p->file_bytes-48) {
+        assert(at==p->buildtime_offset && n==16);
+        assert(!memcmp(data,f->file[f->expected_image],15) && data[15]==0);
+        f->expected_image++;f->expected_at=0;
+    } else {
+        expected_n=p->file_bytes-48-f->expected_at;if(expected_n>CR_CHUNK)expected_n=CR_CHUNK;
+        assert(at==p->offset+f->expected_at && n==expected_n);
+        assert(!memcmp(data,f->file[f->expected_image]+48+f->expected_at,n));
+        f->expected_at+=n;
+    }
+    f->writes++;f->pending=pa;f->pending_n=n;f->sequence=1;
+    *done=n;
+    if(f->writes==f->target && f->fault==F_SHORT_WRITE){*done=n-1;f->fired++;}
+    memcpy(f->cache+at,data,*done);
+    if(f->writes==f->target && f->fault==F_WRITE){f->fired++;return -92;}
+    return 0;
+}
+static int sync_ram(void *v,uint64_t pa,size_t n,enum cr_cache_action action)
+{
+    struct fixture *f=v;size_t at=offset(f,pa,n);
+    assert(!f->fired || f->fault==F_SOURCE);
+    assert(pa==f->pending && n==f->pending_n);
+    if(action==CR_CACHE_PUBLISH) {
+        assert(f->sequence==1);f->publishes++;
+        if(f->fault==F_PUBLISH && f->publishes==f->target){f->fired++;return -93;}
+        memcpy(f->dram+at,f->cache+at,n);f->sequence=2;
+    } else {
+        assert(action==CR_CACHE_PREPARE_READ && f->sequence==2);f->invalidates++;
+        if(f->fault==F_INVALIDATE && f->invalidates==f->target){f->fired++;return -94;}
+        memset(f->cache+at,0,n); /* A read of stale/write cache cannot pass. */
+        f->sequence=3;
+    }
+    return 0;
+}
+static int read_ram(void *v,uint64_t pa,uint8_t *data,size_t n,size_t *done)
+{
+    struct fixture *f=v;size_t at=offset(f,pa,n);
+    assert(!f->fired || f->fault==F_SOURCE);
+    assert(f->sequence==3 && pa==f->pending && n==f->pending_n);
+    f->reads++;*done=n;
+    if(f->fault==F_SHORT_READ && f->reads==f->target){*done=n-1;f->fired++;}
+    memcpy(data,f->dram+at,*done);
+    if(f->fault==F_MISMATCH && f->reads==f->target){data[n/2]^=1;f->fired++;}
+    if(f->fault==F_READ && f->reads==f->target){f->fired++;return -95;}
+    f->sequence=0;return 0;
+}
+static void setup(struct fixture *f)
+{
+    unsigned i;uint8_t *dram=f->dram,*cache=f->cache,*files[3];
+    for(i=0;i<3;i++)files[i]=f->file[i];
+    memset(f,0,sizeof(*f));f->dram=dram;f->cache=cache;
+    memset(f->dram,0xa5,CR_CONSYS_BYTES);memset(f->cache,0xcc,CR_CONSYS_BYTES);
+    f->request=(struct cr_request){.enabled=1,.counter_hz=CR_COUNTER_HZ,
+        .timeout_us=5000000,.operation_limit=20000,.lease_epoch=7,
+        .consys_base=0xa0000000,.consys_bytes=CR_CONSYS_BYTES};
+    for(i=0;i<3;i++) {
+        f->file[i]=files[i];f->request.image[i]=(struct cr_source){files[i],cr_profile_at(i)->file_bytes,UINT64_C(0x120000000)+i*0x100000};
+    }
+    f->live=(struct cr_live){.lease_epoch=7,.owned_base=0xa0000000,.owned_bytes=CR_CONSYS_BYTES,
+        .rgu_reset=0x5000,.spm_control=0xd,.power_status=0x434e,.power_status2=0x434e,
+        .ip_id=0x10020300,.hw_version=0x8a10,.fw_version=0x8a00,.emi_remap=0xa0};
+    f->io=(struct cr_io){f,ticks,observe,write_ram,read_ram,sync_ram};
+    f->step=1;f->target=1;
+}
+static int run(struct fixture *f) { return cr_stage(&f->request,&f->io,&f->workspace,&f->report); }
+static void hash_test(const char *text,const char *expected)
+{
+    struct cr_sha256 s;uint8_t out[32];char hex[65];size_t i;
+    cr_sha256_init(&s);
+    for(i=0;text[i];i++)cr_sha256_update(&s,(const uint8_t *)text+i,1);
+    cr_sha256_final(&s,out);
+    for(i=0;i<32;i++)sprintf(hex+2*i,"%02x",out[i]);
+    assert(!strcmp(hex,expected));
+}
+static void primitive_tests(void)
+{
+    struct cr_request q={0};struct cr_io io={0};struct cr_workspace w;struct cr_report r;
+    hash_test("","e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
+    hash_test("abc","ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+    hash_test("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq","248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
+    assert(cr_stage(&q,&io,&w,&r)==CR_DISABLED && r.operations==0);
+    assert(cr_stage(0,&io,&w,&r)==CR_ARGUMENT);
+    assert(cr_stage(&q,&io,&w,(void *)&q)==CR_ARGUMENT);
+    assert(!cr_profile_at(3));
+    puts("SHA-256 known vectors, disabled/no-callback and bad-argument tests PASS");
+}
+static void check_destination(struct fixture *f)
+{
+    size_t at,i,n;unsigned ranges=0;
+    for(at=0;at<CR_CONSYS_BYTES;at++) {
+        int found=0;
+        for(i=0;i<3;i++) {
+            const struct cr_profile *p=cr_profile_at(i);n=p->file_bytes-48;
+            if(at>=p->offset && at<p->offset+n){assert(f->dram[at]==f->file[i][48+at-p->offset]);found=1;break;}
+            if(at>=p->buildtime_offset && at<p->buildtime_offset+16){
+                assert(f->dram[at]==(at==p->buildtime_offset+15?0:f->file[i][at-p->buildtime_offset]));found=1;break;
+            }
+        }
+        if(!found)assert(f->dram[at]==0xa5);else ranges++;
+    }
+    assert(ranges==571037+196160+105892+48);
+}
+int main(int argc,char **argv)
+{
+    struct fixture *f;unsigned i,j,total_writes,tests=0;
+    static const enum cr_phase phases[]={CR_VALIDATE,CR_HASH,CR_COPY,CR_PUBLISH,CR_INVALIDATE,CR_READBACK_PHASE,CR_BUILD_TIME,CR_FINISH};
+    primitive_tests();
+    if(argc==1){puts("SKIP exact-firmware staging tests: pass BT, Wi-Fi and MCU private original paths");return 0;}
+    assert(argc==4);f=calloc(1,sizeof(*f));assert(f);
+    f->dram=malloc(CR_CONSYS_BYTES);f->cache=malloc(CR_CONSYS_BYTES);assert(f->dram && f->cache);
+    for(i=0;i<3;i++) {
+        FILE *in=fopen(argv[i+1],"rb");size_t n=cr_profile_at(i)->file_bytes;assert(in);
+        f->file[i]=malloc(n);assert(f->file[i]);assert(fread(f->file[i],1,n,in)==n);
+        assert(fgetc(in)==EOF);fclose(in);
+    }
+    setup(f);assert(run(f)==CR_OK);total_writes=f->writes;tests++;
+    assert(f->report.validated_images==3 && f->report.completed_images==3 && f->expected_image==3);
+    assert(f->report.bytes_written==873137 && f->report.bytes_verified==873137);
+    assert(f->report.source_bytes_hashed==873233 && f->report.writes==total_writes);
+    check_destination(f);
+    printf("Exact firmware success: %u transfers, %u observations, %llu verified bytes\n",total_writes,f->observations,(unsigned long long)f->report.bytes_verified);
+    /* Each later image must also authenticate before ANY destination writes. */
+    for(i=0;i<3;i++) {
+        setup(f);f->file[i][100]^=1;assert(run(f)==CR_SOURCE_HASH && !f->writes);f->file[i][100]^=1;tests++;
+        setup(f);f->file[i][0]^=1;assert(run(f)==CR_SOURCE_HASH && !f->writes);f->file[i][0]^=1;tests++;
+        setup(f);f->file[i][40]^=1;assert(run(f)==CR_SOURCE_HASH && !f->writes);f->file[i][40]^=1;tests++;
+        setup(f);f->file[i][24]^=1;assert(run(f)==CR_HEADER && !f->writes);f->file[i][24]^=1;tests++;
+    }
+    /* Callback faults/short operations at early, middle and final transfers. */
+    for(i=F_WRITE;i<=F_INVALIDATE;i++)for(j=0;j<3;j++) {
+        int expected=(i==F_SHORT_WRITE || i==F_SHORT_READ)?CR_SHORT:(i==F_MISMATCH?CR_READBACK:CR_IO);
+        setup(f);f->fault=(enum fault)i;f->target=j==0?1:(j==1?total_writes/2:total_writes);
+        assert(run(f)==expected && f->fired==1);assert(f->writes==f->target);tests++;
+    }
+    for(i=0;i<sizeof(phases)/sizeof(phases[0]);i++) {
+        setup(f);f->fault=F_ADMIT;f->fault_phase=phases[i];assert(run(f)==CR_ADMISSION && f->fired==1);tests++;
+        setup(f);f->fault=F_LATE;f->fault_phase=phases[i];assert(run(f)==CR_TIMEOUT && f->fired==1);tests++;
+    }
+    for(i=0;i<12;i++) {
+        setup(f);f->fault=F_STATE;f->fault_phase=CR_COPY;f->state_field=i;
+        assert(run(f)==CR_STATE && !f->writes);tests++;
+        setup(f);f->fault=F_STATE;f->fault_phase=CR_INVALIDATE;f->state_field=i;
+        assert(run(f)==CR_STATE && f->writes==1 && !f->reads);tests++;
+    }
+    setup(f);f->step=0;f->request.operation_limit=10;assert(run(f)==CR_LIMIT && f->observations==10 && !f->writes);tests++;
+    setup(f);f->tick=UINT64_MAX-100;assert(run(f)==CR_OK);tests++;
+    setup(f);f->fault=F_BACKWARDS;assert(run(f)==CR_TIMEOUT && !f->writes);tests++;
+    setup(f);f->fault=F_SOURCE;assert(run(f)==CR_SOURCE_CHANGED && f->report.completed_images==0);
+    assert(f->report.bytes_written==571037);f->file[0][2000]^=1;tests++;
+    /* Invalid ownership/address/size/virtual-alias layouts call no callbacks. */
+    for(i=0;i<11;i++) {
+        int expected=CR_RANGE;setup(f);
+        switch(i) {
+        case 0:f->request.consys_base++;break;
+        case 1:f->request.consys_base=UINT64_C(0x100000000);break;
+        case 2:f->request.consys_bytes--;break;
+        case 3:f->request.image[0].physical_address=f->request.consys_base;expected=CR_OVERLAP;break;
+        case 4:f->request.image[1].physical_address=f->request.image[0].physical_address+1;expected=CR_OVERLAP;break;
+        case 5:f->request.image[0].physical_address=UINT64_MAX-1;break;
+        case 6:f->request.image[0].length--;break;
+        case 7:f->request.image[0].bytes=(void *)&f->report;expected=CR_ARGUMENT;break;
+        case 8:f->request.image[1].bytes=f->file[0];expected=CR_ARGUMENT;break;
+        case 9:f->request.counter_hz=24000000;expected=CR_ARGUMENT;break;
+        case 10:f->request.enabled=2;expected=CR_ARGUMENT;break;
+        }
+        assert(run(f)==expected && !f->observations && !f->writes);tests++;
+    }
+    printf("Actual core/stateful cache+RAM consumer: %u exact-image scenarios PASS\n",tests);
+    printf("Host ABI: workspace %zu bytes, report %zu bytes\n",sizeof(f->workspace),sizeof(f->report));
+    for(i=0;i<3;i++)free(f->file[i]);
+    free(f->dram);free(f->cache);free(f);
+    return 0;
+}
diff --git a/tools/mt6762/hardware/connectivity/README.rst b/tools/mt6762/hardware/connectivity/README.rst
new file mode 100644
index 0000000000000000000000000000000000000000..0ac49f8f13d698a407e4ad0d69afd19754b0e77d
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity/README.rst
@@ -0,0 +1,110 @@
+MT6762 connectivity: offline parsers and passive observations
+===========================================================
+
+This package does not start Wi-Fi. It validates retained stock artifacts and
+parses bounded observations before a future native backend. No function performs
+MMIO, allocation, firmware download, DMA, radio commands, or phone access.
+There is no kernel/init integration. Original firmware and calibration remain
+private local inputs, never repository payloads.
+
+``conn_decode.c/.h`` is freestanding C99, with no libc dependencies. All reads use
+bounded byte decoding, avoiding alignment and host endian assumptions. Failed
+calls leave the caller's output unchanged. The core supports:
+
+* Actual CONNAC common tail (36 bytes), up to 16 region tails (40 bytes), payload
+  bounds, device-address overflow/overlap, the observed uncompressed feature
+  shapes, and bounded release-info TLVs. Device addresses are firmware address
+  space, never permissions or destinations for host writes.
+* WMT 28-byte patch and 48-byte ROM/RAM metadata headers, exact ALPS signature
+  and timestamp shape. HW/SW fields are reported big endian, address/type fields
+  retain their raw little-endian representation. CRC fields remain opaque.
+* The exact phone's 2050-byte WIFI calibration file envelope: 2048-byte BSP
+  structure, versions 1/8 and a structurally valid unicast nonzero address,
+  plus two uninterpreted trailer bytes. No address/calibration bytes are returned.
+* Project passive-record version 1, specified in ``conn_decode.h``. It rejects
+  malformed sizes, versions, reserved fields, duplicate/unknown addresses,
+  invalid widths, backward time and unbounded snapshot intervals. Only valid
+  stable paired observations contribute. Classification is default-off.
+
+Structural acceptance is separate from authenticity. ``validate.py`` first
+checks exact size and SHA-256 against ``stock-profile.json`` and then calls the
+compiled C core. The profile pins the dumped vendor modules, configuration and
+four WLAN/common firmware files, plus this phone's complete calibration hash.
+There is no CLI override allowing a different hash profile. This does not prove
+an image matches a live ADIE/ECO, authenticate its vendor signature, implement
+firmware CRC algorithms, or establish radio/regulatory calibration semantics.
+It also does not claim the manifest is an exhaustive future cold-start bundle.
+
+Usage (all paths are explicit local inputs)::
+
+    python3 validate.py --artifacts /private/stock-artifacts \
+      --calibration /private/WIFI
+    python3 validate.py --peripherals /private/peripherals-result.json --survey
+    python3 validate.py --record /private/conn-record.bin --survey
+    python3 validate.py --display /private/display.bin \
+      --display-identity EXPECTED_64_HEX_LOADER_IDENTITY
+    python3 -m unittest discover -s . -p 'test_*.py' -v
+
+A host C compiler builds the shared parser into a temporary directory; nothing is
+installed. ``CC`` can choose a host compiler. A future kernel can compile the C
+core directly and separately require cryptographic artifact verification before
+using any parsed payload. The Python command does not dump input bytes, addresses,
+SSID or credentials; its firmware target addresses are not the private WLAN MAC.
+
+State evidence and limits
+-------------------------
+
+The passive format has no hardware grant flags. ``POWER_BITS_READY`` means only
+that the modeled SPM power/reset/isolation and infra protection bits matched in
+a stable pair. It is not authorization to read powered CONN registers or perform
+DMA. Even that result leaves rail state, clock accessibility, ADIE/ECO, reset
+ownership, EMI/MPU, DMA routing/cache maintenance and firmware matching unresolved.
+Default ``survey_enabled=0`` decodes observations but returns unknown power state.
+
+The candidate address list is a decoder vocabulary, NOT a physical read allowlist.
+An acquisition implementation must review each new read against the shipped
+module and current power state. It contains no 0x180xxxxx connectivity registers.
+The stock function ``consys_check_reg_readable`` is actively mutating: it writes
+0x30000, barriers/delays, then tests clock bits. It must not be called a passive
+probe or used here.
+
+Captured display records are decoded by the existing strict display ABI decoder
+with a separately supplied expected loader identity. Only the final pass remains
+in that record: this package does not duplicate it into an invented stable pair,
+merge asynchronous display/peripheral samples, or treat display's SPM control
+0x1000630c as connectivity's different control at 0x1000632c. External identity
+must be verified against the frozen loader manifest; matching a caller-provided
+identity is not independent proof of provenance or freshness.
+
+Capture40's display power statuses are both 0x434c. CONN bit1 is clear in each,
+so connectivity was off at that recorded sample. This says nothing about later
+power state. The peripheral record contributes only GPIO 0x100053f0 from the
+connectivity vocabulary; the required control/protection/clock/rail state remains
+missing. See ``validation-evidence.json``. No further device action was taken.
+
+Source basis
+------------
+
+Private exact firmware audit:
+``hardware/hakios-migration-20261026/wifi-native/evidence.json`` in the workspace.
+Its stock modules are 4.19.191; their AXI symbols, MT6765 operations table and
+bounded relocation-annotated disassembly corroborate this platform. The supplied
+BSP is a reference, not an assertion of full source equivalence:
+
+* ``vendor/mediatek/kernel_modules/connectivity/wlan/core/gen4m/include/chips/fw_dl.h``
+  lines 121-142 and ``chips/common/fw_dl.c`` lines 1602-1664, 1993-2048:
+  CONNAC tail/release formats and download interpretation.
+* ``common/common_main/core/include/wmt_core.h`` lines 427-443 and
+  ``core/wmt_ic_soc.c`` lines 3260-3305, 3550-3650: WMT 28/48-byte formats.
+* ``wlan/core/gen4m/include/CFG_Wifi_File.h`` line 479 onward: calibration envelope.
+* ``common/common_main/platform/include/mt6765.h`` lines 45-100, 130-142:
+  pinmux, SPM/infra offsets and CONN ack bit1. Shipped ``wmt_drv.ko`` separately
+  confirms the selected platform and the active readability-test behavior.
+* ``tools/mt6762/physical/display_probe.h`` records SPM 0x10006180/184/30c;
+  ``display_record.py`` validates the existing build-bound format.
+
+Next integration should retain the existing Qualcomm exclusion. A MediaTek
+backend must own the cold-start power/WMT/STP flow and separate CONNAC AXI DMA
+interface, then attach ``hakios_sta_ops`` and ``hakios_net_link``. The Qualcomm
+ath11k bus/QRTR/SMMU implementation is not this radio's transport. Actual firmware
+selection still requires live ADIE/ECO and per-phone calibration validation.
diff --git a/tools/mt6762/hardware/connectivity/WMT-PROTOCOL.rst b/tools/mt6762/hardware/connectivity/WMT-PROTOCOL.rst
new file mode 100644
index 0000000000000000000000000000000000000000..2f5cbf1f53bf731b5a57ee06c39d1619b046e544
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity/WMT-PROTOCOL.rst
@@ -0,0 +1,123 @@
+Bounded SoC WMT / BTIF management protocol
+=========================================
+
+``wmt_protocol.c`` is original, freestanding C99 source. It performs no register
+access, firmware transfer, allocation, thread creation or transport operation.
+``cw_init(s, 0)`` is disabled. The implemented result is **STP options verified**,
+not Wi-Fi readiness, successful firmware boot, scan capability or hardware
+ownership. Its only commands are the exact shipped SoC query / set-STP options.
+
+Evidence and ordering
+---------------------
+
+``protocol-evidence.json`` binds the dumped ``wmt_drv.ko`` hash, section-relative
+symbols and relocations, and the supplied BSP source hashes. The ELF contains
+multiple similarly named tables for different chips. The SoC function
+``_wmt_soc_mode_ctrl`` selects .data+0x2dc8 (SET) and .data+0x2df0 (QUERY), whose
+relocations select .data+0x2e27 and .data+0x2e36 respectively. This establishes
+the DB option byte, rather than DF used in several other tables.
+
+The supplied BSP paths below are relative to
+``vendor/mediatek/kernel_modules/connectivity/common/common_main``:
+
+* ``core/wmt_core.c:840-873``: reset STP state; choose BTIF mandatory mode,
+  enable it. This is a host software framing choice, not a BTIF power sequence.
+* ``core/wmt_ic_soc.c:1130-1175``: query default options, SET, reinitialize host
+  full framing, wait 10 ms, then query and match configured options. The exact
+  dumped function confirms this table chain and ``osal_sleep_ms(10)``.
+* ``platform/mt6765.c:162-173`` and ``include/wmt_plat.h:261-278``: PDA patch
+  profile. The shipped ``mtk_wcn_emi_addr_info`` .data+0x448 has u32 +0x24 = 1.
+* ``core/wmt_ic_soc.c:1224-1230,1351-1358``: non-PDA chips switch before patch
+  download; this PDA profile switches **after** patch download/reset. A cold
+  transport probe may query the default options, but must not jump directly to
+  full framing as a substitute for the missing PDA download implementation.
+* ``core/stp_core.c:1126-1224,1746-1911,2035-2230,2350-2387``: mandatory and
+  full headers, streaming receive, checksum, CRC, transport selection.
+* ``linux/osal.c:59-92,323-336``: reflected CRC16 polynomial 0xa001, initial
+  zero, no final XOR. The shipped 512-byte table agrees; ASCII ``123456789``
+  gives 0xbb3d, query bytes ``01 04 01 00 04`` give 0xf36c (wire ``6c f3``).
+
+Wire subset
+-----------
+
+WMT is type/opcode/u16-LE body length followed by body. Commands use type 1;
+events type 2; the first event body byte is status, which must be zero here.
+Exact complete event bytes are matched, including options and subopcode.
+No variable-length placeholder or generic success event is accepted.
+
+BTIF mandatory framing is ``80 / channel+length-high / length-low / 00``,
+payload, two zero trailer bytes. It has no CRC protection; strict zero checks
+cannot substitute for a CRC. BTIF has no SDIO four-byte aggregation padding.
+This management subset accepts channel 4 only and rejects diagnostic/coredump
+channels rather than pretending those messages are WMT events.
+
+Full framing is ``80|seq<<3|ack / channel+length-high / length-low / sum8``;
+payload is followed by little-endian CRC16. Zero-length ACK packets are four
+bytes with channel zero and no CRC. Sequence and ACK are modulo eight;
+initial receive sequence is zero and initial transmitted ACK is seven.
+The core has one outstanding command and accepts its prior ACK or current ACK;
+regression after acknowledgement, wrong sequence, NAK and resynchronization
+requests are terminal. Up to two optional 0x55 delimiter bytes are accepted
+before each full packet. There are no automatic retries or recovery guesses.
+This is deliberately narrower than stock's seven-packet retry window.
+
+Integration contract
+--------------------
+
+State belongs to one serialized caller. Do not alias output/input buffers with
+its internal state. The adapter must independently establish power, clocks,
+BTIF ownership/configuration and a monotonic microsecond clock. APIs are:
+
+1. ``cw_init(s, 1)``, then ``cw_command(...CW_QUERY_DEFAULT...)``. Send exactly
+   the returned bytes and require the transport's entire write to succeed.
+2. Feed bounded received spans through ``cw_feed``; call ``cw_poll`` while
+   waiting. A matched default event produces ``CW_DEFAULT_VERIFIED``.
+3. Before SET, explicitly call ``cw_attest_pda_patch_reset``. This call records
+   a caller attestation, **not independently verified evidence**. It qualifies
+   only after the separate, correctly admitted PDA transfer completed every
+   required segment, matched firmware acceptance responses, and matched the
+   firmware reset response. Validating files, seeing default options, or
+   returning success from an unimplemented downloader does not qualify.
+4. ``CW_SET_FULL`` must match its exact event. Reconfigure/reset the host STP
+   framing state, then call ``cw_enter_full`` at least 10 ms after the event.
+   No hardware configuration is performed by that call.
+5. Send ``CW_QUERY_FULL``. The result becomes ``CW_OPTIONS_VERIFIED`` only after
+   exact event matching and ACK of the outstanding command. Drain
+   ``cw_take_ack`` and require the returned four bytes to be fully transmitted.
+   Taking bytes from this API does **not** prove they reached the device.
+
+Every command has an explicit 1 ms..10 s deadline anchored at output generation
+(before transmission, so a slow write cannot extend it). Backwards clocks,
+expiry and one million pending polling/feed calls are terminal; this also bounds
+frozen-clock loops. The SET deadline includes mode switching. A timeout below
+10 ms cannot accommodate that switch. No deadline can be extended by partial
+packets, ACKs or bytes arriving continuously. Clock must keep running while
+waiting. Calls process at most 65536 input bytes; STP payload is at most 2048
+(less than 2000 in mandatory mode) and WMT message at most 64. An error is sticky
+and all further I/O must stop. Transport failures likewise require discarding
+the session; do not interpret an earlier matched event as overall success.
+
+The transport adapter is responsible for scheduling ACK transmission promptly,
+logging exact terminal errors, and discarding the session on partial writes or
+hardware errors. No callback or state in this file authorizes CONN MMIO/DMA.
+
+Tests and current boundary
+--------------------------
+
+Run ``python3 -m unittest discover -s tools/mt6762/hardware/connectivity -p
+ 'test_*.py'`` from the kernel tree. The 26 protocol tests compile with C99,
+``-Wall -Wextra -Werror`` and cover exact commands, every mandatory split,
+bytewise full input, split WMT across STP packets, coalesced ACK/event, delayed
+ACK, checksum/CRC/status/options/channel/sequence rejection, PDA prerequisite,
+mode delay, capacity/truncation and clock/deadline/poll-budget bounds.
+The additional 20 artifact/passive-state tests remain passing. The initial test
+fixture had an incorrect handwritten query CRC; extracting the shipped table
+confirmed 0xf36c, and the fixture was corrected. No hardware test occurred.
+
+Still missing before firmware boot or scan: physical power/rail/clock admission,
+BTIF adapter integration, exact PDA destination/remap/EMI ownership and complete
+transfer/reset implementation, live chip/ECO/ADIE validation, calibrated WMT
+setup, CONNAC firmware download and command/event/data rings, DMA/cache handling,
+regulatory/calibration admission, and HakiOS station/network integration.
+The current commands do not enable a radio, issue scan requests or invent
+calibration, ADIE identity, or a region.
diff --git a/tools/mt6762/hardware/connectivity/conn_decode.c b/tools/mt6762/hardware/connectivity/conn_decode.c
new file mode 100644
index 0000000000000000000000000000000000000000..085f6ef1f607b4608b7d8da1195f044e9d0622e8
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity/conn_decode.c
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: MIT */
+#include "conn_decode.h"
+static uint16_t le16(const uint8_t *p) { return (uint16_t)(p[0] | ((uint16_t)p[1]<<8)); }
+static uint32_t le32(const uint8_t *p) { return (uint32_t)le16(p) | ((uint32_t)le16(p+2)<<16); }
+static uint64_t le64(const uint8_t *p) { return (uint64_t)le32(p) | ((uint64_t)le32(p+4)<<32); }
+static int equal(const uint8_t *p, const char *q, size_t n) { size_t i; for(i=0;i<n;i++) if(p[i]!=(uint8_t)q[i]) return 0; return 1; }
+static int zero(const uint8_t *p, size_t n) { size_t i; for(i=0;i<n;i++) if(p[i]) return 0; return 1; }
+static int digits(const uint8_t *p, size_t n) { size_t i; for(i=0;i<n;i++) if(p[i]<'0'||p[i]>'9') return 0; return 1; }
+static int release_info(const uint8_t *p, size_t n) {
+ size_t end, at;
+ if(n<36 || !equal(p,"################",16) || !equal(p+n-16,"################",16)) return CONN_FORMAT;
+ if(p[18] || p[19] || le16(p+16)!=(n-36)) return CONN_FORMAT;
+ end=n-16; at=20;
+ while(at<end) {
+  size_t len;
+  if(end-at<4) return CONN_SIZE;
+  len=(size_t)le16(p+at)+p[at+2];
+  if((p[at+3]!=1 && p[at+3]!=2)||len>end-at-4) return CONN_RANGE;
+  at+=4+len;
+ }
+ return at==end?CONN_OK:CONN_RANGE;
+}
+int conn_image_parse(const uint8_t *b,size_t n,unsigned kind,struct conn_image *out) {
+ struct conn_image r={0}; size_t i,tail,used=0; const uint8_t *p;
+ if(!b || !out || n>16*1024*1024) return CONN_SIZE;
+ r.kind=kind;
+ if(kind==CONN_WLAN) {
+  if(n<76) return CONN_SIZE;
+  p=b+n-36; r.chip=p[0];r.eco=p[1];r.region_count=p[2];r.format=p[3];r.flags=p[4];
+  /* Exact supported format family; ECO is reported, never claimed measured. */
+  if(r.chip!=7 || r.format!=2 || r.flags>1 || !zero(p+5,2) || !digits(p+17,14) || p[31]) return CONN_FORMAT;
+  if(!r.region_count || r.region_count>16 || r.region_count>(n-36)/40) return CONN_RANGE;
+  tail=n-36-r.region_count*40;
+  for(i=0;i<r.region_count;i++) {
+   const uint8_t *s=b+tail+i*40; uint32_t addr=le32(s+16),len=le32(s+20);size_t j;
+   if(!len || len>tail-used || (uint64_t)addr+len>UINT64_C(0x100000000)) return CONN_RANGE;
+   /* This package supports the actual uncompressed CONNAC tailers only. */
+   if(!zero(s,16)||!zero(s+25,15)||(s[24]!=7 && s[24]!=128)) return CONN_FORMAT;
+   for(j=0;j<i;j++) if((uint64_t)addr< (uint64_t)r.regions[j].device_address+r.regions[j].length &&
+    (uint64_t)r.regions[j].device_address<(uint64_t)addr+len) return CONN_RANGE;
+   r.regions[i].offset=(uint32_t)used;r.regions[i].length=len;r.regions[i].device_address=addr;r.regions[i].feature=s[24];used+=len;
+  }
+  if(used<tail) { int e; if(!r.flags) return CONN_FORMAT;e=release_info(b+used,tail-used);if(e) return e; }
+  r.payload_bytes=(uint32_t)used;
+ } else if(kind==CONN_WMT_PATCH || kind==CONN_WMT_RAM) {
+  size_t header=kind==CONN_WMT_RAM?48:28;
+  if(n<=header) return CONN_SIZE;
+  if(!digits(b,16)||!equal(b+16,"ALPS",4)) return CONN_FORMAT;
+  r.hw_version=((uint32_t)b[20]<<8)|b[21];r.sw_version=((uint32_t)b[22]<<8)|b[23];
+  r.target=le32(b+24);r.payload_bytes=(uint32_t)(n-header);
+  if(kind==CONN_WMT_RAM) {
+   r.image_type=le32(b+28);
+   /* u4CRC[4] at32 is retained opaque; this is not a CRC verifier. */
+   if(r.image_type!=0x03000000 && r.image_type!=0x04000000) return CONN_FORMAT;
+   if((uint64_t)r.target+r.payload_bytes>UINT64_C(0x100000000)) return CONN_RANGE;
+  }
+ } else if(kind==CONN_CALIBRATION) {
+  /* 2048-byte WIFI_CFG_PARAM_STRUCT + two uninterpreted stock trailer bytes.
+   * Never log or return the MAC/calibration bytes. SHA pins the complete file.
+   */
+  if(n!=2050) return CONN_SIZE;
+  r.own_version=le16(b);r.peer_version=le16(b+2);
+  if(r.own_version!=1||r.peer_version!=8 || (b[4]&1) || zero(b+4,6)) return CONN_FORMAT;
+  r.payload_bytes=2048;
+ } else return CONN_FORMAT;
+ *out=r;return CONN_OK;
+}
+/* Candidate passive observation set only. This code DOES NOT read addresses.
+ * BSP platform/include/mt6765.h and shipped WMT module identify these fields.
+ * Physical acquisition needs a separately reviewed allowlist/identity binding.
+ */
+static const uint64_t addresses[]={0x10006180,0x10006184,0x1000632c,0x10001220,0x10001228,0x10001258,0x10007018,0x100053e0,0x100053f0};
+size_t conn_register_count(void) { return sizeof(addresses)/sizeof(addresses[0]); }
+uint64_t conn_register_address(size_t i) { return i<conn_register_count()?addresses[i]:0; }
+int conn_state_parse(const uint8_t *b,size_t n,unsigned enabled,struct conn_state *out) {
+ struct conn_state r={0}; uint32_t value[9]={0};size_t count,i,j;
+ if(!b||!out||n<48||enabled>1) return CONN_SIZE;
+ if(!equal(b,"MTKCONN1",8)||le16(b+8)!=1||le16(b+10)!=48||le16(b+14)!=24||le32(b+20)) return CONN_FORMAT;
+ count=le16(b+12);if(count>9||n!=48+count*24||le32(b+16)!=n) return CONN_SIZE;
+ r.begin=le64(b+24);r.end=le64(b+32);r.hz=le64(b+40);r.survey_enabled=enabled;
+ if(!r.hz||r.hz>UINT64_C(10000000000)||r.end<r.begin||r.end-r.begin>r.hz*10) return CONN_RANGE;
+ for(i=0;i<count;i++) {
+  const uint8_t *s=b+48+i*24;uint64_t a=le64(s);uint32_t bit;
+  for(j=0;j<conn_register_count()&&a!=addresses[j];j++) {}
+  if(j==conn_register_count()||s[16]!=4||s[17]>3||!zero(s+18,6)) return CONN_FORMAT;
+  bit=1u<<j;if(r.seen&bit) return CONN_DUPLICATE;r.seen|=bit;
+  if(s[17]==3 && le32(s+8)==le32(s+12)) {r.stable|=bit;value[j]=le32(s+8);}
+ }
+ r.missing=0x1ffu&~r.stable;
+ if(enabled && (r.stable&7)==7) {
+  unsigned a=(value[0]>>1)&1,c=(value[1]>>1)&1;
+  if(a!=c) r.power=CONN_TRANSITION;
+  else if(!a) r.power=CONN_OFF;
+  else if((value[2]&0x1f)!=0x0d || (value[2]&0x100)) r.power=CONN_ISOLATED;
+  else if((r.stable&0x38)==0x38) {
+   r.power=((value[3]|value[4])&0x6000)||(value[5]&0x40000)?CONN_ISOLATED:CONN_POWER_BITS_READY;
+  }
+ }
+ *out=r;return CONN_OK;
+}
diff --git a/tools/mt6762/hardware/connectivity/conn_decode.h b/tools/mt6762/hardware/connectivity/conn_decode.h
new file mode 100644
index 0000000000000000000000000000000000000000..620e520bed58baa24c8c683caf74df9456e07262
--- /dev/null
+++ b/tools/mt6762/hardware/connectivity/conn_decode.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: MIT
+ * Pure bounded byte parsers. No IO, allocations, credentials, or ownership grants.
+ * Structural success is NOT artifact authenticity or live firmware compatibility.
+ */
+#ifndef MT6762_CONN_DECODE_H
+#define MT6762_CONN_DECODE_H
+#include <stddef.h>
+#include <stdint.h>
+enum conn_error { CONN_OK, CONN_SIZE, CONN_FORMAT, CONN_RANGE, CONN_DUPLICATE };
+enum conn_kind { CONN_WLAN = 1, CONN_WMT_PATCH, CONN_WMT_RAM, CONN_CALIBRATION };
+struct conn_region { uint32_t offset, length, device_address, feature; };
+struct conn_image {
+ uint32_t kind, payload_bytes, region_count, chip, eco, format, flags;
+ uint32_t hw_version, sw_version, target, image_type, own_version, peer_version;
+ struct conn_region regions[16];
+};
+int conn_image_parse(const uint8_t *, size_t, unsigned, struct conn_image *);
+/* Version 1 is a project observation format, NOT a shipped firmware format.
+ * Header48: magic8 "MTKCONN1", version/u16, header_bytes/u16, count/u16,
+ * entry_bytes/u16, total/u32, flags/u32=0, begin/end/hz u64.
+ * Entry24: PA/u64, first/second u32, width/u8=4, valid/u8 (bits0,1),
+ * reserved/u16=0, reserved/u32=0. LE. No implied identity or recency binding.
+ */
+enum conn_power { CONN_UNKNOWN, CONN_OFF, CONN_TRANSITION, CONN_ISOLATED, CONN_POWER_BITS_READY };
+struct conn_state { uint32_t seen, stable, missing, power, survey_enabled; uint64_t begin, end, hz; };
+/* survey_enabled must be explicit 1; default 0 only decodes, no classification.
+ * Even POWER_BITS_READY is only a passive observation; clocks, rails, ADIE,
+ * EMI/MPU ownership, firmware and DMA accessibility remain unproved.
+ */
+int conn_state_parse(const uint8_t *, size_t, unsigned survey_enabled, struct conn_state *);
+size_t conn_register_count(void);
+uint64_t conn_register_address(size_t);
+#endif
