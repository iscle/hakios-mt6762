index 0000000000000000000000000000000000000000..b46c22d7a946e5db8dd43dd4be0e12d3f70f4b8a
--- /dev/null
+++ b/tools/mt6762/hardware/battery-soc/profile_sha256.c
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: MIT -- bounded SHA256 for immutable profile bytes. */
+#include "profile_sha256.h"
+static uint32_t rotr(uint32_t x, unsigned n) {return (x>>n)|(x<<(32-n));}
+static uint32_t get32(const unsigned char *p) {return (uint32_t)p[0]<<24|(uint32_t)p[1]<<16|(uint32_t)p[2]<<8|p[3];}
+static void put32(unsigned char *p,uint32_t x) {p[0]=(unsigned char)(x>>24);p[1]=(unsigned char)(x>>16);p[2]=(unsigned char)(x>>8);p[3]=(unsigned char)x;}
+static void block(uint32_t h[8],const unsigned char p[64]) {
+ static const uint32_t k[64]={
+ 0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+ 0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+ 0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+ 0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+ 0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+ 0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+ 0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+ 0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+ uint32_t w[64],a=h[0],b=h[1],c=h[2],d=h[3],e=h[4],f=h[5],g=h[6],z=h[7];unsigned i;
+ for(i=0;i<16;i++)w[i]=get32(p+4*i);
+ for(;i<64;i++) {uint32_t x=w[i-15],y=w[i-2];w[i]=w[i-16]+(rotr(x,7)^rotr(x,18)^(x>>3))+w[i-7]+(rotr(y,17)^rotr(y,19)^(y>>10));}
+ for(i=0;i<64;i++) {uint32_t t=z+(rotr(e,6)^rotr(e,11)^rotr(e,25))+((e&f)^(~e&g))+k[i]+w[i];uint32_t u=(rotr(a,2)^rotr(a,13)^rotr(a,22))+((a&b)^(a&c)^(b&c));z=g;g=f;f=e;e=d+t;d=c;c=b;b=a;a=t+u;}
+ h[0]+=a;h[1]+=b;h[2]+=c;h[3]+=d;h[4]+=e;h[5]+=f;h[6]+=g;h[7]+=z;
+}
+void bs_sha256(const unsigned char *p,size_t n,unsigned char out[32]) {
+ uint32_t h[8]={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
+ unsigned char last[128];uint64_t bits=(uint64_t)n*8;size_t i,left=n,used;
+ while(left>=64) {block(h,p);p+=64;left-=64;}
+ for(i=0;i<sizeof(last);i++)last[i]=0;
+ for(i=0;i<left;i++)last[i]=p[i];
+ last[left]=0x80;used=left<56?64:128;
+ for(i=0;i<8;i++)last[used-1-i]=(unsigned char)(bits>>(i*8));
+ block(h,last);if(used==128)block(h,last+64);
+ for(i=0;i<8;i++)put32(out+4*i,h[i]);
+}
