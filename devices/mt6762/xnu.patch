+static int verified(const char *name)
+{
+    uint32_t value=0;
+    return !mt6762_handoff_u32(name,&value) && value==1;
+}
+static uint32_t pwrap_rd(void *unused,uint32_t offset)
+{
+    uint32_t v;
+    (void)unused;
+    v=*(volatile uint32_t *)(pwrap+offset);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return v;
+}
+static void pwrap_wr(void *unused,uint32_t offset,uint32_t value)
+{
+    (void)unused;
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *(volatile uint32_t *)(pwrap+offset)=value;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+static void pwrap_delay(void *unused,unsigned us) {(void)unused;delay(us);}
+static void pwrap_wacs_delay(void *unused,unsigned us)
+{
+    uint64_t interval,start;
+    (void)unused;
+    if(!us)return;
+    /* WACS polls request10us. GenericARMCPU has no idle-latency estimate,
+     * so delay() otherwise schedules away on every not-ready poll while
+     * holding pwrap_mutex. Keep these short polls synchronous, with IRQs and
+     * preemption unchanged. YIELD is a CPU hint, not a scheduler operation;
+     * WFE would depend on another event to wake this single-core trial. */
+    if(us>10) {delay(us);return;}
+    clock_interval_to_absolutetime_interval(us,NSEC_PER_USEC,&interval);
+    start=mach_absolute_time();
+    while(mach_absolute_time()-start<interval)
+        __asm__ volatile("yield" ::: "memory");
+}
+static const struct mt6762_wacs_io pwrap_io={NULL,pwrap_rd,pwrap_wr,pwrap_wacs_delay};
+static uint32_t pwrap_entry_read(void *unused,uint32_t address)
+{
+    (void)unused;
+    if(address==0x10001090) {
+        uint32_t value=*(volatile uint32_t *)(pwrap_infra+0x90);
+        __asm__ volatile("dsb oshld":::"memory");return value;
+    }
+    return pwrap_rd(NULL,address-0x1000d000);
+}
+
+static int pwrap_transfer(int write,uint16_t address,uint16_t *value)
+{
+    int e;
+    if(!value || (address&1))return -EINVAL;
+    if(write && pwrap_read_only)return -EPERM;
+    lck_mtx_lock(&pwrap_mutex);
+    if(!pwrap_ready || pwrap_fault) {lck_mtx_unlock(&pwrap_mutex);return -ENXIO;}
+    e=mt6762_wacs_transfer_profile(&pwrap_io,pwrap_profile,write,address,value);
+    /* A timed out or uninitialized wrapper needs ownership-aware recovery.
+     * Do not blindly clear a transaction belonging to another processor. */
+    if(e)pwrap_fault=1;
+    lck_mtx_unlock(&pwrap_mutex);
+    return e ? (e==-3 ? -ETIMEDOUT : -EIO) : 0;
+}
+int mt6762_pwrap_read16(uint16_t address,uint16_t *value)
+{
+    return pwrap_transfer(0,address,value);
+}
+int mt6762_pwrap_write16(uint16_t address,uint16_t value)
+{
+    return pwrap_transfer(1,address,&value);
+}
+
+static int pmic_entry_read(void *unused,uint16_t address,uint16_t *value)
+{(void)unused;return mt6762_pwrap_read16(address,value);}
+static void pmic_adc_entry_probe(void)
+{
+    /* Configuration evidence only. This API cannot request a conversion,
+     * change TDET/trim, or confer ADC calibration/channel ownership. */
+    if(!pwrap_ready || !pwrap_read_only || pwrap_fault)return;
+    kprintf("MT6762_ADC_ENTRY_BEGIN version=1 passes=2 registers=%u conversion_requested=0 gauge_commands=0\n",
+        MT6762_PMIC_ADC_ENTRY_COUNT);
+    for(unsigned pass=0;pass<2;pass++) {
+        struct mt6762_pmic_adc_entry_observation value;
+        struct mt6762_pmic_entry_failure failure;
+        int error=mt6762_pmic_adc_entry_observe(pmic_entry_read,NULL,&value,&failure);
+        if(error) {
+            kprintf("MT6762_ADC_ENTRY_FAILED pass=%u index=%u address=%04x error=%d transport=%d value=%04x\n",
+                pass,failure.index,failure.address,error,failure.error,failure.value);
+            return;
+        }
+        for(unsigned i=0;i<MT6762_PMIC_ADC_ENTRY_COUNT;i++)
+            kprintf("MT6762_ADC_ENTRY pass=%u index=%u address=%04x value=%04x\n",
+                pass,i,mt6762_pmic_adc_entry_regs[i],value.value[i]);
+        kprintf("MT6762_ADC_ENTRY_COMPLETE pass=%u measurement_valid=0 ownership_grant=0 calibration_grant=0\n",pass);
+    }
+}
+static void pmic_entry_probe(void)
+{
+    /* Only extend the inherited read-only observation path. No ADC/gauge
+     * ownership or calibration grant is inferred from matching raw words. */
+    if(!pwrap_ready || !pwrap_read_only || pwrap_fault)return;
+    kprintf("MT6762_PMIC_ENTRY_BEGIN version=1 passes=2 registers=%u conversion_requested=0 gauge_commands=0\n",
+        MT6762_PMIC_ENTRY_COUNT);
+    for(unsigned pass=0;pass<2;pass++) {
+        struct mt6762_pmic_entry_observation value;
+        struct mt6762_pmic_entry_failure failure;
+        int error=mt6762_pmic_entry_observe(pmic_entry_read,NULL,&value,&failure);
+        if(error) {
+            kprintf("MT6762_PMIC_ENTRY_FAILED pass=%u index=%u address=%04x error=%d transport=%d value=%04x\n",
+                pass,failure.index,failure.address,error,failure.error,failure.value);
+            return;
+        }
+        for(unsigned i=0;i<MT6762_PMIC_ENTRY_COUNT;i++)
+            kprintf("MT6762_PMIC_ENTRY pass=%u index=%u address=%04x value=%04x\n",
+                pass,i,mt6762_pmic_entry_regs[i],value.value[i]);
+        kprintf("MT6762_PMIC_ENTRY_COMPLETE pass=%u measurement_valid=0 ownership_grant=0\n",pass);
+    }
+    /* Preserve every version1 PMIC record. A failed earlier pass returns
+     * before this separate record and never starts additional reads. */
+    pmic_adc_entry_probe();
+}
+
+#include "mt6762_gauge_latch_probe.c"
+
+/* The handoff grants exclusive AP ownership of initialized ADC channels.
+ * BIF additionally requires an already-clear TDET bit. Native code has no
+ * independent fallback capable of restoring TDET after losing PWRAP. */
+static int adc_rd(void *unused,uint16_t address,uint16_t *v)
+{(void)unused;return mt6762_pwrap_read16(address,v);}
+static int adc_wr(void *unused,uint16_t address,uint16_t v)
+{
+    int e;
+    (void)unused;e=mt6762_pwrap_write16(address,v);
+    if(!e && address==0x110e) {
+        if(v==2)adc_voltage_requests++;
+        if(v==8)adc_ntc_requests++;
+    }
+    return e;
+}
+static const struct mt6762_adc_io adc_io={NULL,adc_rd,adc_wr,pwrap_delay};
+/* Shares this driver's ADC mutex and PWRAP ownership. */
+#include "mt6762_bif_observer.c"
+int mt6762_pmic_thermal_sample(unsigned sensor,uint16_t *raw)
+{
+    static const struct mt6762_thermal_adc_io io={NULL,adc_rd,adc_wr,pwrap_delay};
+    int e;
+    if(!adc_ready || !verified("pmic-thermal-adc-owned"))return -ENXIO;
+    lck_mtx_lock(&adc_mutex);
+    e=mt6762_thermal_adc(&io,sensor,raw);
+    lck_mtx_unlock(&adc_mutex);
+    return e;
+}
+static int adc_read(unsigned channel,int *mv)
+{
+    int e;
+    if(!adc_ready)return -ENXIO;
+    lck_mtx_lock(&adc_mutex);
+    e=mt6762_adc_sample(&adc_io,channel,mv);
+    lck_mtx_unlock(&adc_mutex);
+    return e;
+}
+static int nominal_ntc(int adc_mv)
+{
+    static const uint32_t r[]={195652,148171,113347,87559,68237,53650,
+        42506,33892,27219,22021,17926,14674,12081,10000,8315,6948,5834,
+        4917,4161,3535,3014};
+    uint64_t resistance;
+    if(adc_mv<=0 || adc_mv>=1800)return -2730;
+    resistance=(uint64_t)(unsigned)adc_mv*16900/(1800-(unsigned)adc_mv);
+    if(resistance>r[0] || resistance<r[20])return -2730;
+    for(unsigned i=1;i<21;i++)if(resistance>=r[i]) {
+        int cold=-400+50*((int)i-1),warm=cold+50;
+        return (int)(((int64_t)(resistance-r[i])*cold+
+            (int64_t)(r[i-1]-resistance)*warm)/(r[i-1]-r[i]));
+    }
+    return -2730;
+}
+static int charger_read(uint8_t address,uint8_t *value)
+{
+    return mt6762_i2c_transfer(5,0x6a,&address,1,value,1);
+}
+static int psc_rd(void *unused,uint8_t address,uint8_t *value)
+{(void)unused;return charger_read(address,value);}
+static int psc_wr(void *unused,uint8_t address,uint8_t value)
+{
+    uint8_t bytes[]={address,value};
+    (void)unused;
+    return mt6762_i2c_transfer(5,0x6a,bytes,2,NULL,0);
+}
+static const struct mt6762_psc_io psc_io={NULL,psc_rd,psc_wr};
+static void adc_observed(int value,int *count,int *minimum,int *maximum)
+{
+    (*count)++;
+    if(*minimum<0 || value<*minimum)*minimum=value;
+    if(*maximum<0 || value>*maximum)*maximum=value;
+}
+static void button_sample(unsigned which,int valid,unsigned pressed)
+{
+    static const uint32_t ids[]={HAKIOS_BUTTON_LOCK,HAKIOS_BUTTON_VOLUME_UP,
+                                HAKIOS_BUTTON_VOLUME_DOWN};
+    int change=mt6762_key_update(&key_filter[which],valid,pressed);
+    if(change && keys_only)
+        kprintf("MT6762_KEY button=%u direction=%d valid=%d\n",ids[which],change,valid);
+    if(change)hakios_touch_post(change>0?HAKIOS_BUTTON_DOWN:HAKIOS_BUTTON_UP,
+                               ids[which],0,0);
+}
+static uint32_t keys_entry_read(void *unused,uint32_t address,unsigned width)
+{
+    (void)unused;
+    volatile uint8_t *base=address>=0x10010000?keypad:
+        address>=0x10005000?keys_gpio:keys_gic;
+    unsigned offset=address&0xfff;
+    uint32_t value=width==2?*(volatile uint16_t *)(base+offset):
+        *(volatile uint32_t *)(base+offset);
+    __asm__ volatile("dsb oshld":::"memory");return value;
+}
+static void poll_buttons(void)
+{
+    if(keys_only && (keys_fault || !mt6762_keys_entry_ok(keys_entry_read,NULL))) {
+        if(!keys_fault)kprintf("MT6762_KEYS fault: inherited keypad state changed\n");
+        keys_fault=1;
+        for(unsigned i=0;i<3;i++)button_sample(i,0,0);
+        return;
+    }
+    uint16_t status=0;
+    int valid=pwrap_ready && !mt6762_pwrap_read16(0x24,&status);
+    button_sample(0,valid,!(status&2));
+    if(keypad) {
+        uint16_t enabled=*(volatile uint16_t *)(keypad+0x24);
+        uint16_t matrix=*(volatile uint16_t *)(keypad+4);
+        __asm__ volatile("dmb oshld" ::: "memory");
+        button_sample(1,!!(enabled&1),!(matrix&2));
+        button_sample(2,!!(enabled&1),!(matrix&1));
+    }
+}
+#include "mt6762_battery_observer.c"
+
+static void poll_battery(void)
+{
+    struct mt6762_battery_sample s={.size=sizeof(s)};
+    uint64_t duration,gauge_expires,now;
+    uint16_t v;
+    uint8_t id,state;
+    static uint32_t last_valid=~0u;
+    static int last_charger=-2,last_safe=-2;
+    clock_get_uptime(&s.acquired_abs);
+    clock_interval_to_absolutetime_interval(2000,NSEC_PER_MSEC,&duration);
+    s.expires_abs=s.acquired_abs+duration;
+    if(s.expires_abs<=s.acquired_abs)s.expires_abs=0;
+    battery_adc_mv=ntc_adc_mv=-1;
+    ntc_nominal_deci_c=-2730;
+    charger_state=-1;
+    if(pwrap_ready && !mt6762_pwrap_read16(0x24,&v)) {
+        s.external=!!(v&4);s.valid|=MT6762_BAT_EXTERNAL;
+    }else if(pwrap_ready)power_errors++;
+    if(pwrap_ready && !mt6762_pwrap_read16(0xe08,&v) && (v&1)) {
+        s.present=!(v&2);s.valid|=MT6762_BAT_PRESENT;
+    }
+    if(adc_ready) {
+        if(!adc_read(1,&battery_adc_mv)) {
+            adc_observed(battery_adc_mv,&adc_voltage_samples,&adc_voltage_min,&adc_voltage_max);
+            s.voltage_uv=battery_adc_mv*1000;s.valid|=MT6762_BAT_VOLTAGE;
+        }else power_errors++;
+        if(!(bif_ready?bif_read(&ntc_adc_mv):adc_read(3,&ntc_adc_mv))) {
+            adc_observed(ntc_adc_mv,&adc_ntc_samples,&adc_ntc_min,&adc_ntc_max);
+            ntc_nominal_deci_c=nominal_ntc(ntc_adc_mv);
+        }
+        else power_errors++;
+    }
+    if(charger_ready) {
+        uint8_t control;
+        int safe=charger_owned ? !mt6762_psc_disable_owned(&psc_io,1,&control) : 0;
+        charger_control_safe=charger_owned ? (safe?1:-1) : -1;
+        charger_control=safe?control:-1;
+        if((safe || (charger_lab && !charger_owned)) &&
+           !charger_read(3,&id) && id==0xf0 && !charger_read(0,&state)) {
+            static const int status_map[]={3,1,4};
+            charger_state=(state>>4)&3;
+            /* Datasheet reserves state 3; stock maps it to not-charging.
+             * Treat it as unknown, and reject a disabled/charging conflict. */
+            if(charger_state<3 && !(safe && charger_state==1)) {
+                s.status=status_map[charger_state];s.valid|=MT6762_BAT_STATUS;
+            }
+            if(safe && charger_state==1)charger_control_safe=-1;
+        }else {power_errors++;if(charger_owned)charger_control_safe=-1;}
+    }
+    if(!mt6762_gauge_current_snapshot(&s.current_ua,&gauge_expires)) {
+        s.valid|=MT6762_BAT_CURRENT;
+        if(gauge_expires<s.expires_abs)s.expires_abs=gauge_expires;
+    }
+    /* Learned SOC and compensated battery NTC are not established. Their
+     * validity bits remain clear; no fake percentage or25C value. */
+    clock_get_uptime(&now);
+    if(!s.expires_abs || now>=s.expires_abs)s.valid=0;
+    power_valid=(int)s.valid;
+    if(s.valid!=last_valid || charger_state!=last_charger || charger_control_safe!=last_safe) {
+        printf("MT6762 power: observed valid=%#x PSC state=%d CE-safe=%d control=%d battery ADC=%d mV\n",
+            s.valid,charger_state,charger_control_safe,charger_control,battery_adc_mv);
+        last_valid=s.valid;last_charger=charger_state;last_safe=charger_control_safe;
+    }
+    /* Explicit lab test suppresses delivery only. Acquisition and button work
+     * continue so BSD getters and the IOKit timer must expire independently. */
+    if(report_gap_ms) {
+        clock_get_uptime(&now);
+        if(!report_gap_start) {
+            clock_interval_to_absolutetime_interval(report_gap_start_ms,NSEC_PER_MSEC,&duration);
+            report_gap_start=now+duration;
+            clock_interval_to_absolutetime_interval(report_gap_ms,NSEC_PER_MSEC,&duration);
+            report_gap_end=report_gap_start+duration;
+        }
+        if(now>=report_gap_start && now<report_gap_end) {
+            if(report_gap_state!=1)printf("MT6762 power: synthetic publication gap begins; acquisition continues\n");
+            report_gap_state=1;reports_suppressed++;return;
+        }
+        if(now>=report_gap_end && report_gap_state!=2) {
+            report_gap_state=2;
+            printf("MT6762 power: synthetic publication gap ends\n");
+        }
+    }
+    mt6762_battery_report(&s);
+}
+static void power_thread(__unused void *parameter,__unused wait_result_t result)
+{
+    for(unsigned tick=0;;tick++) {
+        poll_buttons();
+        if(!keys_only && tick%60==0)poll_battery();
+        delay_for_interval(16,NSEC_PER_MSEC);
+    }
+}
+void mt6762_power_init(void)
+{
+    uint16_t id;
+    thread_t thread;
+    if(started || !mt6762_platform_ready())return;
+    if(verified("pwrap-verified")) {
+        if(mt6762_handoff_u32("pwrap-profile",&pwrap_profile))
+            pwrap_profile=verified("lab-fixture")?MT6762_WACS_LEGACY21:0;
+        if(pwrap_profile!=MT6762_WACS_LK22 &&
+           !(pwrap_profile==MT6762_WACS_LEGACY21 && verified("lab-fixture"))) {
+            kprintf("MT6762_PWRAP refused missing/unsupported profile\n");return;
+        }
+        pwrap_read_only=pwrap_profile==MT6762_WACS_LK22 && !verified("pwrap-write-owned");
+        pwrap=mt6762_map_mmio(0x1000d000,0x1000);
+        if(pwrap && pwrap_profile==MT6762_WACS_LK22) {
+            pwrap_infra=mt6762_map_mmio(0x10001000,0x1000);
+            if(!pwrap_infra || !mt6762_pwrap_entry_ok(pwrap_entry_read,NULL)) {
+                kprintf("MT6762_PWRAP refused live inherited wrapper state\n");return;
+            }
+        }
+        if(pwrap) {
+            pwrap_ready=1;
+            if(mt6762_pwrap_read16(8,&id) || (id>>8)!=0x57) {
+                pwrap_ready=0;
+                printf("MT6762 power: PMIC identification failed; PWRAP observations disabled\n");
+            }else {
+                pmic_id=id;
+                kprintf("MT6762_PWRAP_READY profile=%u id=%04x read_only=%d\n",pwrap_profile,id,pwrap_read_only);
+            }
+        }
+    }
+    if(verified("pwrap-inherited-probe")) {
+        /* PMIC ordinary readable words only: keys/reset policy and eMMC/CPU rails.
+         * No ADC/gauge commands, rail writes or charger control. The separate
+         * inherited-key grant below permits only filtered key observations. */
+        static const uint16_t regs[]={0x24,0x14c,0x1988,0x1958,0x1c20,0x1996,0x1966,
+            0x14a2,0x14a4,0x19cc,0x19ce};
+        for(unsigned pass=0;pwrap_ready && pass<2;pass++)for(unsigned i=0;i<sizeof(regs)/sizeof(regs[0]);i++) {
+            uint16_t value=0;int error=mt6762_pwrap_read16(regs[i],&value);
+            kprintf("MT6762_PWRAP_SAMPLE pass=%u address=%04x error=%d value=%04x\n",pass,regs[i],error,value);
+            if(error)return;
+        }
+        pmic_entry_probe();
+        if(!verified("battery-inherited-observer"))gauge_latch_probe();
+        /* Separate observation grant; bus5 still needs its own validated
+         * handoff and setup. Do not enter normal ADC/charger policy below. */
+        if(verified("charger-readonly-probe") && !verified("battery-inherited-observer")) {
+            for(unsigned pass=0;pass<2;pass++) {
+                struct mt6762_psc_observation value;
+                int error=mt6762_i2c_ready(5)?mt6762_psc_observe(&psc_io,&value):-ENXIO;
+                if(error) {
+                    kprintf("MT6762_PSC_PROBE pass=%u error=%d\n",pass,error);
+                    break;
+                }
+                kprintf("MT6762_PSC_PROBE pass=%u error=0 id=%02x control=%02x status=%02x\n",
+                    pass,value.id,value.control,value.status);
+            }
+        }
+        if(verified("battery-inherited-observer"))battery_inherited_start();
+        if(pwrap_ready && pwrap_read_only && verified("keys-inherited-probe") && verified("keypad-verified")) {
+            keypad=mt6762_map_mmio(0x10010000,0x1000);
+            keys_gpio=mt6762_map_mmio(0x10005000,0x1000);
+            keys_gic=mt6762_map_mmio(0x0c000000,0x1000);
+            if(!keypad || !keys_gpio || !keys_gic || !mt6762_keys_entry_ok(keys_entry_read,NULL)) {
+                kprintf("MT6762_KEYS refused inherited keypad state\n");return;
+            }
+            keys_only=1;
+            if(kernel_thread_start(power_thread,NULL,&thread)==KERN_SUCCESS) {
+                started=1;thread_deallocate(thread);
+                kprintf("MT6762_KEYS_READY readonly=1 boot_held_suppressed=1\n");
+            }
+        }
+        return;
+    }
+    adc_ready=pwrap_ready && verified("adc-verified");
+    bif_init();
+    if(verified("lab-fixture")) {
+        uint32_t start_ms,gap_ms;
+        if(!mt6762_handoff_u32("battery-report-gap-start-ms",&start_ms) &&
+           !mt6762_handoff_u32("battery-report-gap-ms",&gap_ms) &&
+           start_ms>=1000 && start_ms<=300000 && gap_ms>=2000 && gap_ms<=10000) {
+            report_gap_start_ms=start_ms;report_gap_ms=gap_ms;
+        }
+    }
+    charger_owned=verified("charger-control-owned");
+    charger_lab=verified("lab-fixture");
+    charger_ready=verified("charger-verified") && mt6762_i2c_ready(5);
+    if(charger_ready && !charger_owned && !charger_lab) {
+        charger_ready=0;charger_control_safe=0;
+        printf("MT6762 power: rejected charger handoff without control ownership\n");
+    }
+    if(charger_ready && charger_owned) {
+        uint8_t control;
+        charger_control_safe=mt6762_psc_disable_owned(&psc_io,1,&control)?-1:1;
+        charger_control=charger_control_safe==1?control:-1;
+        if(charger_control_safe!=1)
+            printf("MT6762 power: charger disable/readback failed; safety unknown\n");
+    }
+    if(verified("keypad-verified"))keypad=mt6762_map_mmio(0x10010000,0x1000);
+    if(!pwrap_ready && !charger_ready && !keypad)return;
+    if(kernel_thread_start(power_thread,NULL,&thread)==KERN_SUCCESS) {
+        started=1;thread_deallocate(thread);
+        printf("MT6762 power: PMIC %#x; buttons/power observation, ADC=%d charger=%d; charging policy unavailable\n",pmic_id,adc_ready,charger_ready);
+    }
+}
diff --git a/bsd/dev/mt6762_power_protocol.h b/bsd/dev/mt6762_power_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..84ffcfe89208c7f6601ac5fc7611c5eadb6760ae
--- /dev/null
+++ b/bsd/dev/mt6762_power_protocol.h
@@ -0,0 +1,95 @@
+/* Bounded protocol shared with host fixtures. No board initialization. */
+#ifndef MT6762_POWER_PROTOCOL_NATIVE_H
+#define MT6762_POWER_PROTOCOL_NATIVE_H
+#include <stdint.h>
+#include "mt6762_bif_protocol.h"
+struct mt6762_wacs_io {
+    void *context;
+    uint32_t (*read)(void *, uint32_t);
+    void (*write)(void *, uint32_t, uint32_t);
+    void (*delay_us)(void *, unsigned);
+};
+enum { MT6762_WACS_LEGACY21=1, MT6762_WACS_LK22=2 };
+static inline int
+mt6762_wacs_wait(const struct mt6762_wacs_io *io,unsigned profile,unsigned state,uint32_t *value)
+{
+    if(profile!=MT6762_WACS_LEGACY21 && profile!=MT6762_WACS_LK22)return -1;
+    uint32_t initialized=1u<<(profile==MT6762_WACS_LK22?22:21);
+    unsigned n;
+    for(n=0;n<1000;n++) {
+        *value=io->read(io->context,0xc24);
+        if(!(*value&initialized)) return -2;
+        if(((*value>>16)&7)==state) return 0;
+        io->delay_us(io->context,10);
+    }
+    return -3;
+}
+static inline int
+mt6762_wacs_transfer_profile(const struct mt6762_wacs_io *io,unsigned profile,int write,
+                     uint16_t address,uint16_t *value)
+{
+    uint32_t status,command;
+    uint16_t result;
+    int e;
+    if(!io || !io->read || !io->write || !io->delay_us || !value || (address&1) || (write!=0 && write!=1))return -1;
+    if((e=mt6762_wacs_wait(io,profile,0,&status)))return e;
+    command=((uint32_t)address>>1)<<16;
+    if(write)command|=0x80000000u|*value;
+    io->write(io->context,0xc20,command);
+    if(write)return mt6762_wacs_wait(io,profile,0,&status);
+    if((e=mt6762_wacs_wait(io,profile,6,&status)))return e;
+    result=(uint16_t)status;
+    io->write(io->context,0xc28,1);
+    if((e=mt6762_wacs_wait(io,profile,0,&status)))return e;
+    *value=result;return 0;
+}
+/* Retain the explicitly synthetic legacy contract for existing fixtures. */
+static inline int
+mt6762_wacs_transfer(const struct mt6762_wacs_io *io,int write,uint16_t address,uint16_t *value)
+{return mt6762_wacs_transfer_profile(io,MT6762_WACS_LEGACY21,write,address,value);}
+/* Recovered MT6357 ADC request/ready protocol. Outputs are committed only
+ * after a non-rail, ready conversion. Caller owns channel serialization. */
+struct mt6762_adc_io {
+    void *context;
+    int (*read)(void *, uint16_t, uint16_t *);
+    int (*write)(void *, uint16_t, uint16_t);
+    void (*delay_us)(void *, unsigned);
+};
+static int
+mt6762_adc_sample(const struct mt6762_adc_io *io,unsigned channel,int *mv)
+{
+    uint16_t raw;
+    unsigned bits,ratio;
+    int e;
+    if(!io || !io->read || !io->write || !io->delay_us || !mv)return -1;
+    if(channel==1) {bits=15;ratio=3;}
+    else if(channel==3) {bits=12;ratio=1;}
+    else return -1;
+    const struct mt6762_battery_adc_io fresh={io->context,io->read,io->write,io->delay_us};
+    e=mt6762_battery_adc_fresh(&fresh,channel,&raw);
+    if(e)return e;
+    *mv=(int)(((uint32_t)raw*ratio*1800)>>bits);
+    return 0;
+}
+/* A key must first be observed released; two equal samples debounce changes.
+ * Invalid readings reset debounce and release a previously emitted key. */
+struct mt6762_key_filter { unsigned armed, previous, count, down; };
+static int
+mt6762_key_update(struct mt6762_key_filter *k,int valid,unsigned pressed)
+{
+    if(!valid) {
+        unsigned was=k->down;
+        k->armed=k->previous=k->count=k->down=0;
+        return was ? -1 : 0;
+    }
+    pressed=!!pressed;
+    if(!k->armed) {
+        if(!pressed)k->armed=1;
+        return 0;
+    }
+    if(k->previous!=pressed) {k->previous=pressed;k->count=1;return 0;}
+    if(k->count<2)k->count++;
+    if(k->count==2 && k->down!=pressed) {k->down=pressed;return pressed?1:-1;}
+    return 0;
+}
+#endif
diff --git a/bsd/dev/mt6762_sspm.c b/bsd/dev/mt6762_sspm.c
new file mode 100644
index 0000000000000000000000000000000000000000..9f9b159dd1d68b5c509eff507f4149cfe6fa75d3
--- /dev/null
+++ b/bsd/dev/mt6762_sspm.c
@@ -0,0 +1,187 @@
+/* Bounded native SSPM attachment. Only PLATFORM liveness is sent automatically.
+ * No CPU-DVFS initialization, vote, rail write, firmware reset or image load. */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/mt6762_platform.h>
+#include <sys/mt6762_sspm.h>
+#include <sys/sysctl.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+#include "mt6762_sspm_protocol.h"
+#include "../../tools/mt6762/hardware/cpu-power/mt6762_sspm_observer.h"
+
+static uintptr_t data,ctrl,gic;
+static int initialized,attached,sspm_alive=-1,sspm_errors,sspm_probes,sspm_transport_fault;
+static uint64_t alive_deadline;
+static LCK_GRP_DECLARE(sspm_group,"mt6762-sspm");
+static LCK_MTX_DECLARE(sspm_mutex,&sspm_group);
+static struct mt6762_sspm_transport transport;
+SYSCTL_DECL(_kern_hakios);
+SYSCTL_INT(_kern_hakios,OID_AUTO,mt6762_sspm_alive,CTLFLAG_RD|CTLFLAG_LOCKED,&sspm_alive,0,"Last PLATFORM alive response: -1 unknown; not CPU-DVFS readiness");
+SYSCTL_INT(_kern_hakios,OID_AUTO,mt6762_sspm_probes,CTLFLAG_RD|CTLFLAG_LOCKED,&sspm_probes,0,"Attempted active PLATFORM liveness transactions");
+SYSCTL_INT(_kern_hakios,OID_AUTO,mt6762_sspm_errors,CTLFLAG_RD|CTLFLAG_LOCKED,&sspm_errors,0,"SSPM attachment or protocol failures");
+SYSCTL_INT(_kern_hakios,OID_AUTO,mt6762_sspm_fault,CTLFLAG_RD|CTLFLAG_LOCKED,&sspm_transport_fault,0,"Latched ownership/transport fault; no automatic reset or stale-ACK clear");
+
+static int flag(const char *name)
+{uint32_t v;return !mt6762_handoff_u32(name,&v) && v==1;}
+struct passive_mapping {uintptr_t base[4];};
+static int passive_read(void *context,unsigned region,uint32_t offset,uint32_t *value)
+{
+    const struct passive_mapping *m=context;
+    if(!value || !mt6762_sspm_observer_address(region,offset))return -1;
+    *value=*(volatile uint32_t *)(m->base[region]+offset);
+    __asm__ volatile("dmb oshld":::"memory");return 0;
+}
+static void passive_words(unsigned pass,const char *group,const uint32_t *words,unsigned count)
+{
+    for(unsigned i=0;i<count;i+=4) {
+        unsigned n=count-i<4?count-i:4;
+        kprintf("MT6762_SSPM_RAW pass=%u group=%s word=%u count=%u %08x %08x %08x %08x\n",
+            pass,group,i,n,words[i],n>1?words[i+1]:0,n>2?words[i+2]:0,n>3?words[i+3]:0);
+    }
+}
+static void passive_probe(void)
+{
+    struct passive_mapping m;
+    struct mt6762_sspm_observation_pair p;
+    m.base[MT6762_OBS_CSRAM]=(uintptr_t)mt6762_map_mmio(0x00110c00,0x1400);
+    m.base[MT6762_OBS_DATA]=(uintptr_t)mt6762_map_mmio(0x10450000,0x100);
+    m.base[MT6762_OBS_CTRL]=(uintptr_t)mt6762_map_mmio(0x10451000,8);
+    m.base[MT6762_OBS_GIC]=(uintptr_t)mt6762_map_mmio(0x0c000000,0x1000);
+    for(unsigned i=0;i<4;i++)if(!m.base[i]) {
+        kprintf("MT6762_SSPM_OBSERVE error=mapping region=%u\n",i);return;
+    }
+    if(mt6762_sspm_observe_pair(passive_read,&m,&p)) {
+        kprintf("MT6762_SSPM_OBSERVE error=read\n");return;
+    }
+    kprintf("MT6762_SSPM_OBSERVE version=1 passes=2 words=174 stable_groups=%03x guards=%d c62_representation=%d ownership=0 liveness=unknown\n",
+        p.stable_groups,mt6762_sspm_observer_guards(&p),mt6762_sspm_observer_c62(&p));
+    /* Equal groups need one raw copy; a changing pair retains both complete
+     * passes. No word is interpreted as an initialized-controller grant. */
+    for(unsigned pass=0;pass<(p.stable_groups==MT6762_OBS_ALL?1u:2u);pass++) {
+        const struct mt6762_sspm_observation *s=&p.sample[pass];
+        passive_words(pass,"guards",s->guards,5);passive_words(pass,"pvt",s->pvt,144);
+        passive_words(pass,"eem",s->eem,3);passive_words(pass,"ppm",s->ppm,2);
+        passive_words(pass,"voltage",s->voltage,3);passive_words(pass,"index",s->index,3);
+        passive_words(pass,"vote",s->vote,3);passive_words(pass,"mailbox",s->mailbox,9);
+        passive_words(pass,"irq",s->irq,2);
+    }
+    kprintf("MT6762_SSPM_OBSERVE end=1 writes=0\n");
+}
+static int read_word(void *unused,unsigned region,uint32_t offset,uint32_t *out)
+{
+    uintptr_t base=region==MT6762_SSPM_DATA?data:ctrl;
+    (void)unused;
+    if(!out || (offset&3) || offset>=(region==MT6762_SSPM_DATA?0x100u:8u))return -1;
+    *out=*(volatile uint32_t *)(base+offset);
+    __asm__ volatile("dmb oshld":::"memory");return 0;
+}
+static int write_word(void *unused,unsigned region,uint32_t offset,uint32_t value)
+{
+    uintptr_t base=region==MT6762_SSPM_DATA?data:ctrl;
+    (void)unused;
+    if((offset&3) || offset>=(region==MT6762_SSPM_DATA?0x100u:8u))return -1;
+    __asm__ volatile("dmb oshst":::"memory");
+    *(volatile uint32_t *)(base+offset)=value;
+    return 0;
+}
+static void barrier(void *unused) {(void)unused;__asm__ volatile("dsb sy":::"memory");}
+static void wait_us(void *unused,unsigned us) {(void)unused;delay(us);}
+/* The former IRQ consumer must be quiesced, otherwise it can steal our ACK. */
+static int irq_quiesced(void)
+{
+    const unsigned intid=237; /* Actual DT mailbox0: SPI205 + 32. */
+    uint32_t enabled=*(volatile uint32_t *)(gic+0x100+(intid/32)*4);
+    uint32_t active=*(volatile uint32_t *)(gic+0x300+(intid/32)*4);
+    __asm__ volatile("dmb oshld":::"memory");
+    return !((enabled|active)&(1u<<(intid%32)));
+}
+int mt6762_sspm_probe_alive(void)
+{
+    const uint32_t command[3]={0xdead,0,0};
+    uint32_t acknowledgement=0;
+    int e;
+    lck_mtx_lock(&sspm_mutex);
+    if(!attached || transport.fault) {lck_mtx_unlock(&sspm_mutex);return -ENXIO;}
+    sspm_alive=-1;alive_deadline=0;
+    if(!irq_quiesced()) {transport.fault=1;e=MT6762_SSPM_BUSY;}
+    else {
+        sspm_probes++;
+        e=mt6762_sspm_exchange(&transport,0,command,3,&acknowledgement,10000);
+    }
+    sspm_transport_fault=transport.fault;
+    if(e)sspm_errors++;
+    else {
+        sspm_alive=acknowledgement!=0;
+        if(sspm_alive)clock_interval_to_deadline(10000,NSEC_PER_MSEC,&alive_deadline);
+    }
+    lck_mtx_unlock(&sspm_mutex);
+    return e ? (e==MT6762_SSPM_TIMEOUT?-ETIMEDOUT:-EIO) : (acknowledgement?0:-ENXIO);
+}
+int mt6762_sspm_alive_recent(void)
+{
+    uint64_t now;
+    int alive;
+    lck_mtx_lock(&sspm_mutex);
+    clock_get_uptime(&now);
+    alive=attached && !transport.fault && sspm_alive==1 && now<alive_deadline;
+    lck_mtx_unlock(&sspm_mutex);
+    return alive;
+}
+static void worker(__unused void *parameter,__unused wait_result_t result)
+{
+    for(;;) {
+        delay_for_interval(5000,NSEC_PER_MSEC);
+        (void)mt6762_sspm_probe_alive();
+    }
+}
+void mt6762_sspm_init(void)
+{
+    static int observed;
+    thread_t thread;
+    int e;
+    uint32_t pending_in,pending_out;
+    if(!mt6762_platform_ready())return;
+    /* Separate diagnostic admission breaks the circular dependency on an
+     * ownership assertion merely to inspect inherited state. This mode never
+     * enters the active transport, even if both properties were supplied. */
+    if(flag("sspm-inherited-probe")) {
+        if(!observed && !initialized) {observed=1;passive_probe();}
+        return;
+    }
+    if(initialized || !flag("sspm-mailbox-owned"))return;
+    initialized=1;
+    /* Mailbox ownership does not preserve firmware or its dynamic shared
+     * DRAM allocation. A physical loader must reserve both from XNU's page
+     * allocator and retain the active image's EMI access before any command.
+     * The explicitly synthetic fixture has no resident firmware/DRAM image. */
+    if(!flag("lab-fixture") && !flag("sspm-firmware-preserved")) {
+        sspm_errors++;
+        printf("MT6762 SSPM: firmware/shared-memory preservation not established\n");
+        return;
+    }
+    data=(uintptr_t)mt6762_map_mmio(0x10450000,0x100);
+    ctrl=(uintptr_t)mt6762_map_mmio(0x10451000,8);
+    gic=(uintptr_t)mt6762_map_mmio(0x0c000000,0x1000);
+    if(!data || !ctrl || !gic || !irq_quiesced()) {
+        sspm_errors++;printf("MT6762 SSPM: mailbox mapping/IRQ ownership rejected\n");return;
+    }
+    if(read_word(NULL,MT6762_SSPM_CTRL,0,&pending_in) ||
+       read_word(NULL,MT6762_SSPM_CTRL,4,&pending_out) ||
+       ((pending_in|pending_out)&3)) {
+        sspm_errors++;sspm_transport_fault=1;
+        printf("MT6762 SSPM: inherited PLATFORM/CPU traffic rejected, no stale status cleared\n");return;
+    }
+    transport.io=(struct mt6762_sspm_io){NULL,read_word,write_word,barrier,wait_us};
+    transport.owned_pins=3; /* PLATFORM and CPU-DVFS AP pins, as handoff requires. */
+    attached=1;
+    e=mt6762_sspm_probe_alive();
+    printf("MT6762 SSPM: PLATFORM probe result=%d alive=%d fault=%d; CPU-DVFS control remains disabled\n",
+        e,sspm_alive,sspm_transport_fault);
+    if(!transport.fault && kernel_thread_start(worker,NULL,&thread)==KERN_SUCCESS)
+        thread_deallocate(thread);
+}
diff --git a/bsd/dev/mt6762_sspm_protocol.h b/bsd/dev/mt6762_sspm_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..4d0989ce5be3eed403919a60eef38469435bcecd
--- /dev/null
+++ b/bsd/dev/mt6762_sspm_protocol.h
@@ -0,0 +1,66 @@
+/* Exact stock MT6765 SSPM mailbox-0 PLATFORM/CPU pin layout. No resets. */
+#ifndef MT6762_SSPM_PROTOCOL_H
+#define MT6762_SSPM_PROTOCOL_H
+#include <stdint.h>
+enum { MT6762_SSPM_DATA=0, MT6762_SSPM_CTRL=1 };
+enum { MT6762_SSPM_INVALID=-1, MT6762_SSPM_BUSY=-2,
+       MT6762_SSPM_IO=-3, MT6762_SSPM_TIMEOUT=-4, MT6762_SSPM_FAULT=-5 };
+struct mt6762_sspm_io {
+    void *context;
+    int (*read)(void *,unsigned,uint32_t,uint32_t *);
+    int (*write)(void *,unsigned,uint32_t,uint32_t);
+    void (*barrier)(void *);
+    void (*delay_us)(void *,unsigned);
+};
+struct mt6762_sspm_transport {
+    struct mt6762_sspm_io io;
+    unsigned owned_pins,fault;
+};
+/* Caller serializes all transactions and owns the selected AP pin, data
+ * slots, and acknowledgement consumption. max_polls is a hard bound, each
+ * failed poll delays 10 us. Errors never publish an acknowledgement. */
+static inline int
+mt6762_sspm_exchange(struct mt6762_sspm_transport *t,unsigned pin,
+                    const uint32_t *words,unsigned count,uint32_t *ack,
+                    unsigned max_polls)
+{
+    uint32_t in,out,value,bit;
+    unsigned slot;
+    const struct mt6762_sspm_io *io;
+    if(!t || !words || !ack || pin>1 || !max_polls || max_polls>200000 ||
+       count!=(pin?4u:3u) || !(t->owned_pins&(1u<<pin)))return MT6762_SSPM_INVALID;
+    io=&t->io;
+    if(!io->read || !io->write || !io->barrier || !io->delay_us)return MT6762_SSPM_INVALID;
+    if(t->fault)return MT6762_SSPM_FAULT;
+    bit=1u<<pin;slot=pin?3:0;
+    if(io->read(io->context,MT6762_SSPM_CTRL,0,&in) ||
+       io->read(io->context,MT6762_SSPM_CTRL,4,&out))goto io_error;
+    /* Pending traffic belongs to a previous/other owner. Do not erase it. */
+    if((in|out)&bit) {t->fault=1;return MT6762_SSPM_BUSY;}
+    for(unsigned i=0;i<count;i++)
+        if(io->write(io->context,MT6762_SSPM_DATA,(slot+i)*4,words[i]))goto io_error;
+    io->barrier(io->context);
+    if(io->write(io->context,MT6762_SSPM_CTRL,0,bit))goto io_error;
+    io->barrier(io->context);
+    for(unsigned i=0;i<max_polls;i++) {
+        if(io->read(io->context,MT6762_SSPM_CTRL,4,&out))goto io_error;
+        if(out&bit) {
+            /* Capture response before freeing its acknowledgement. Clear only
+             * our W1C bit, preserving unrelated mailbox channels. */
+            io->barrier(io->context);
+            if(io->read(io->context,MT6762_SSPM_DATA,slot*4,&value))goto io_error;
+            /* A reply alone must not hide an unconsumed input doorbell. */
+            if(io->read(io->context,MT6762_SSPM_CTRL,0,&in) || (in&bit))goto io_error;
+            if(io->write(io->context,MT6762_SSPM_CTRL,4,bit))goto io_error;
+            io->barrier(io->context);
+            if(io->read(io->context,MT6762_SSPM_CTRL,4,&out))goto io_error;
+            if(out&bit)goto io_error;
+            *ack=value;return 0;
+        }
+        io->delay_us(io->context,10);
+    }
+    t->fault=1;return MT6762_SSPM_TIMEOUT;
+io_error:
+    t->fault=1;return MT6762_SSPM_IO;
+}
+#endif
diff --git a/bsd/dev/mt6762_thermal.c b/bsd/dev/mt6762_thermal.c
new file mode 100644
index 0000000000000000000000000000000000000000..8a1cd115bc63425cfe0057b70b765e4a70664945
--- /dev/null
+++ b/bsd/dev/mt6762_thermal.c
@@ -0,0 +1,168 @@
+/* Calibrated temperature observation; no frequency/rail/thermal control.
+ * CPU snapshots explicitly lack conversion freshness proof. PMIC conversion
+ * completion requires READY low->high under exclusive ADC ownership. */
+#ifndef MT6762_THERMAL_HOST_TEST
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <sys/errno.h>
+#include <sys/mt6762_platform.h>
+#include <sys/mt6762_power.h>
+#include <sys/mt6762_thermal.h>
+#include <sys/sysctl.h>
+#include <sys/systm.h>
+#endif
+#include "mt6762_thermal_protocol.h"
+
+static LCK_GRP_DECLARE(thermal_group,"mt6762-thermal");
+static LCK_MTX_DECLARE(thermal_lock,&thermal_group);
+static uintptr_t controller,efuse;
+static int errors,samples;
+static int temperatures[8],observed_mask;
+static uint64_t acquisitions[8],deadlines[8];
+static unsigned valid_mask(uint64_t now)
+{
+    unsigned mask=mt6762_thermal_unexpired((unsigned)observed_mask,deadlines,now);
+    for(unsigned i=0;i<8;i++)if(now<acquisitions[i])mask&=~(1u<<i);
+    return mask;
+}
+#ifndef MT6762_THERMAL_HOST_TEST
+static int started,pmic_enabled,cpu_enabled;
+SYSCTL_DECL(_kern_hakios);
+/* Every read checks expiry; a stopped worker cannot keep stale validity. */
+static int thermal_sysctl SYSCTL_HANDLER_ARGS
+{
+    uint64_t now;
+    int value=-273000;
+    (void)oidp;(void)arg1;
+    lck_mtx_lock(&thermal_lock);
+    clock_get_uptime(&now);
+    if(arg2<8) {
+        if(valid_mask(now)&(1u<<arg2))value=temperatures[arg2];
+    }else {
+        value=(int)valid_mask(now);
+        if(arg2==9)value&=7; /* Only PMIC0..2 have measured conversion freshness. */
+    }
+    lck_mtx_unlock(&thermal_lock);
+    return sysctl_handle_int(oidp,&value,0,req);
+}
+#define THERM_SYSCTL(name,index,description) SYSCTL_PROC(_kern_hakios,OID_AUTO,name,CTLTYPE_INT|CTLFLAG_RD|CTLFLAG_LOCKED,NULL,index,thermal_sysctl,"I",description)
+THERM_SYSCTL(mt6762_pmic_die_mc,0,"Calibrated PMIC die mC; -273000 invalid/stale");
+THERM_SYSCTL(mt6762_pmic_buck1_mc,1,"Calibrated PMIC VCORE sensor mC; -273000 invalid/stale");
+THERM_SYSCTL(mt6762_pmic_buck2_mc,2,"Calibrated PMIC VPROC sensor mC; -273000 invalid/stale");
+THERM_SYSCTL(mt6762_cpu_ts1_mc,3,"Calibrated CPU TS1 cached observation; freshness unknown");
+THERM_SYSCTL(mt6762_cpu_ts2_mc,4,"Calibrated CPU TS2 cached observation; freshness unknown");
+THERM_SYSCTL(mt6762_cpu_ts3_mc,5,"Calibrated CPU TS3 cached observation; freshness unknown");
+THERM_SYSCTL(mt6762_cpu_ts4_mc,6,"Calibrated CPU TS4 cached observation; freshness unknown");
+THERM_SYSCTL(mt6762_cpu_ts5_mc,7,"Calibrated CPU TS5 cached observation; freshness unknown");
+THERM_SYSCTL(mt6762_thermal_observed,8,"Unexpired observation bits: PMIC0..2 CPU3..7; not control readiness");
+THERM_SYSCTL(mt6762_thermal_fresh,9,"Fresh calibrated conversions; CPU bits remain clear");
+SYSCTL_INT(_kern_hakios,OID_AUTO,mt6762_thermal_errors,CTLFLAG_RD|CTLFLAG_LOCKED,&errors,0,"Rejected calibration/sensor observations");
+SYSCTL_INT(_kern_hakios,OID_AUTO,mt6762_thermal_samples,CTLFLAG_RD|CTLFLAG_LOCKED,&samples,0,"Successful sensor observations");
+#endif
+int mt6762_pmic_temperature_read(unsigned sensor,int *mc)
+{
+    int e=-ENXIO;
+    uint64_t now;
+    if(sensor>=3 || !mc)return -EINVAL;
+    lck_mtx_lock(&thermal_lock);
+    clock_get_uptime(&now);
+    if(valid_mask(now)&(1u<<sensor)) {*mc=temperatures[sensor];e=0;}
+    lck_mtx_unlock(&thermal_lock);
+    return e;
+}
+#ifndef MT6762_THERMAL_HOST_TEST
+static int flag(const char *name)
+{uint32_t v;return !mt6762_handoff_u32(name,&v) && v==1;}
+static uint32_t reg32(uintptr_t base,unsigned off)
+{
+    uint32_t v=*(volatile uint32_t *)(base+off);
+    __asm__ volatile("dmb oshld":::"memory");return v;
+}
+#endif
+static int sample_window(uint64_t *acquired,uint64_t *expires)
+{
+    uint64_t duration;
+    clock_get_uptime(acquired);
+    clock_interval_to_absolutetime_interval(2000,NSEC_PER_MSEC,&duration);
+    *expires=0;
+    if(!duration || UINT64_MAX-*acquired<duration)return 0;
+    *expires=*acquired+duration;
+    return 1;
+}
+static void publish(unsigned sensor,int valid,int mc,uint64_t acquired,uint64_t expires)
+{
+    uint64_t now;
+    lck_mtx_lock(&thermal_lock);
+    clock_get_uptime(&now);
+    observed_mask&=~(1u<<sensor);deadlines[sensor]=0;
+    if(valid && now>=acquired && now<expires) {
+        temperatures[sensor]=mc;
+        acquisitions[sensor]=acquired;deadlines[sensor]=expires;
+        observed_mask|=1u<<sensor;samples++;
+    }else errors++;
+    lck_mtx_unlock(&thermal_lock);
+}
+static void sample_pmic(void)
+{
+    struct mt6762_pmic_cal cal;
+    uint16_t a[6],b[6],id,raw;
+    uint64_t acquired,expires;
+    /* Calibration, conversion and publication delays all consume this lease. */
+    int valid=sample_window(&acquired,&expires),mc=0;
+    if(valid && (mt6762_pwrap_read16(8,&id) || (id>>8)!=0x57))valid=0;
+    for(unsigned i=0;valid && i<6;i++)if(mt6762_pwrap_read16((uint16_t)(0x11ae + 2*i),&a[i]))valid=0;
+    for(unsigned i=0;valid && i<6;i++)if(mt6762_pwrap_read16((uint16_t)(0x11ae + 2*i),&b[i]) || a[i]!=b[i])valid=0;
+    if(valid && mt6762_pmic_cal_decode(a,&cal))valid=0;
+    for(unsigned i=0;i<3;i++) {
+        int ok=valid && !mt6762_pmic_thermal_sample(i,&raw) && !mt6762_pmic_temperature(&cal,i,raw,&mc);
+        publish(i,ok,mc,acquired,expires);
+    }
+}
+static void sample_cpu(void)
+{
+    const unsigned offsets[5]={0x90,0x94,0x98,0x190,0x194};
+    struct mt6762_cpu_cal cal;
+    uint32_t a[3],b[3];
+    uint64_t acquired,expires;
+    int valid=sample_window(&acquired,&expires),mc=0;
+    for(unsigned i=0;valid && i<3;i++)a[i]=reg32(efuse,i*4);
+    for(unsigned i=0;valid && i<3;i++) {b[i]=reg32(efuse,i*4);if(a[i]!=b[i])valid=0;}
+    if(valid && mt6762_cpu_cal_decode(a,&cal))valid=0;
+    /* Admission additionally promises initialized sensor routing/clocking.
+     * Runtime checks reject disabled/paused banks; no register is changed. */
+    for(unsigned i=0;i<5;i++) {
+        unsigned bank=i<3?0:0x100,mask=i<3?7:3;
+        int enabled=valid && (reg32(controller,bank)&mask)==mask && !(reg32(controller,bank+0x3c)&0x10e);
+        unsigned raw=enabled ? reg32(controller,offsets[i])&4095 : 0;
+        int ok=valid && enabled && !mt6762_cpu_temperature(&cal,i,raw,&mc);
+        publish(i+3,ok,mc,acquired,expires);
+    }
+}
+#ifndef MT6762_THERMAL_HOST_TEST
+static void worker(__unused void *parameter,__unused wait_result_t result)
+{
+    for(;;) {
+        if(pmic_enabled)sample_pmic();
+        if(cpu_enabled)sample_cpu();
+        delay_for_interval(500,NSEC_PER_MSEC);
+    }
+}
+void mt6762_thermal_init(void)
+{
+    thread_t thread;
+    if(started || !mt6762_platform_ready())return;
+    started=1;
+    pmic_enabled=flag("pmic-thermal-adc-owned");
+    if(flag("cpu-thermal-observe-verified")) {
+        controller=(uintptr_t)mt6762_map_mmio(0x1100b000,0x1000);
+        efuse=(uintptr_t)mt6762_map_mmio(0x11c50190,12);
+        cpu_enabled=controller && efuse;
+    }
+    if(!pmic_enabled && !cpu_enabled)return;
+    printf("MT6762 thermal: observation enabled PMIC=%d CPU=%d; CPU freshness and DVFS policy unavailable\n",pmic_enabled,cpu_enabled);
+    if(kernel_thread_start(worker,NULL,&thread)==KERN_SUCCESS)thread_deallocate(thread);
+}
+#endif
diff --git a/bsd/dev/mt6762_thermal_protocol.h b/bsd/dev/mt6762_thermal_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..f02f22e7b40d4a08154d20f192a424f478461322
--- /dev/null
+++ b/bsd/dev/mt6762_thermal_protocol.h
@@ -0,0 +1,104 @@
+/* Independent implementation of recovered MT6765/MT6357 calibration and
+ * measurement contracts. Source/stock evidence is in tools/mt6762/hardware/
+ * cpu-power/THERMAL.rst. No fabricated calibration or control policy. */
+#ifndef MT6762_THERMAL_PROTOCOL_H
+#define MT6762_THERMAL_PROTOCOL_H
+#include <stdint.h>
+struct mt6762_cpu_cal { int gain, offset, half_degrees, slope_den, room[5]; };
+struct mt6762_pmic_cal { int intercept[3], slope_den[3]; };
+static inline unsigned mt6762_thermal_unexpired(unsigned mask,const uint64_t deadlines[8],uint64_t now)
+{
+    unsigned result=0;
+    for(unsigned i=0;i<8;i++)if((mask&(1u<<i)) && now<deadlines[i])result|=1u<<i;
+    return result;
+}
+static inline int mt6762_cpu_cal_decode(const uint32_t words[3],struct mt6762_cpu_cal *out)
+{
+    if(!words || !out)return -1;
+    struct mt6762_cpu_cal c;
+    unsigned a=words[1],b=words[0],d=words[2]; /* NVMEM190: temp1,temp0,temp2. */
+    int gain=(int)(a>>22),offset=(a>>12)&1023,deg=(b>>1)&63;
+    int slope=(a&512)?(int)(b>>26):0;
+    unsigned vts[5]={(b>>17)&511,(b>>8)&511,a&511,d>>23,(d>>5)&511};
+    if(!out || !(b&1) || gain<265 || gain>758 || offset<265 || offset>758 || !deg)return -1;
+    c.gain=10000+(gain-512)*10000/4096;c.offset=offset-512;c.half_degrees=deg;
+    c.slope_den=1534+((b&128)?-10:10)*slope;
+    for(unsigned i=0;i<5;i++) {
+        if(vts[i]>484)return -1;
+        c.room[i]=(((int)vts[i]+3350-c.offset)*10000/4096)*10000/c.gain;
+    }
+    *out=c;return 0;
+}
+static inline int mt6762_cpu_temperature(const struct mt6762_cpu_cal *c,unsigned sensor,unsigned raw,int *mc)
+{
+    int64_t x,t;
+    if(!c || !mc || sensor>=5 || raw==0 || raw>=4095 || c->gain<=0 || c->slope_den<=0)return -1;
+    x=((int64_t)raw-c->offset)*10000;
+    /* AArch64 arithmetic shift is floor division, including negative inputs. */
+    x=x>=0?x/4096:-((-x+4095)/4096);
+    x=(x*10000/c->gain-c->room[sensor])*15/18;
+    t=((c->half_degrees*10)/2-x*1000/c->slope_den)*100;
+    if(t < -50000 || t > 150000)return -1;
+    *mc=(int)t;return 0;
+}
+/* Words are PMIC11ae,11b0,11b2,11b4,11b6,11b8. */
+static inline int mt6762_pmic_cal_decode(const uint16_t words[6],struct mt6762_pmic_cal *out)
+{
+    if(!words || !out)return -1;
+    struct mt6762_pmic_cal c;
+    unsigned deg=words[0]&63,slope=(words[3]&16)?words[2]&63:0;
+    unsigned vts[3]={words[1]&8191,words[4]&8191,words[5]&8191};
+    int sign=(words[2]&256)?-1:1;
+    if(!out || !(words[0]&256) || deg<38 || deg>60)return -1;
+    for(unsigned i=0;i<3;i++) {
+        int factor=i?1863:1681;
+        if(!vts[i] || vts[i]>=4095)return -1;
+        c.slope_den[i]=-(factor+sign*(int)slope);
+        c.intercept[i]=(int)((int64_t)(vts[i]*1800/4096)*1000000/
+            (factor+sign*(int)slope*10))+deg*500;
+    }
+    *out=c;return 0;
+}
+static inline int mt6762_pmic_temperature(const struct mt6762_pmic_cal *c,unsigned sensor,unsigned raw,int *mc)
+{
+    int64_t value;
+    if(!c || !mc || sensor>=3 || !raw || raw>=4095 || c->slope_den[sensor]>=0)return -1;
+    unsigned mv=raw*1800/4096;
+    value=c->intercept[sensor]+(int64_t)mv*1000000/c->slope_den[sensor];
+    if(value < -50000 || value > 150000)return -1;
+    *mc=(int)value;return 0;
+}
+struct mt6762_thermal_adc_io {
+    void *context;
+    int (*read)(void *,uint16_t,uint16_t *);
+    int (*write)(void *,uint16_t,uint16_t);
+    void (*delay_us)(void *,unsigned);
+};
+/* Only measurement requests are written. Caller owns ADC/MUX serialization.
+ * A READY low->high transition is mandatory: cached READY is not freshness. */
+static inline int mt6762_thermal_adc(const struct mt6762_thermal_adc_io *io,unsigned sensor,uint16_t *out)
+{
+    static const uint16_t output[3]={0x1090,0x10d8,0x10da};
+    uint16_t word,mux,raw;
+    int e;
+    if(!io || !io->read || !io->write || !io->delay_us || !out || sensor>=3)return -1;
+    if((e=io->read(io->context,0x1216,&mux)))return e;
+    if(sensor==0 && (mux&16))return -2; /* DCXO owns shared CH4 mux. */
+    if((e=io->write(io->context,sensor?0x1114:0x110e,(uint16_t)(1u<<(sensor?4+sensor:4)))))return e;
+    if((e=io->read(io->context,output[sensor],&word)))return e;
+    if(word&0x8000)return -5; /* No observed conversion transition. */
+    io->delay_us(io->context,80); /* Default DT8 averages,10us each. */
+    for(unsigned n=0;n<160;n++) {
+        if((e=io->read(io->context,output[sensor],&word)))return e;
+        if(word&0x8000) {
+            raw=word&4095;
+            if(!raw || raw==4095)return -4;
+            if((e=io->read(io->context,0x1216,&word)))return e;
+            if(sensor==0 && ((word^mux)&16))return -2;
+            *out=raw;return 0;
+        }
+        io->delay_us(io->context,200);
+    }
+    return -3;
+}
+#endif
diff --git a/bsd/dev/mt6762_vbat_observer.c b/bsd/dev/mt6762_vbat_observer.c
new file mode 100644
index 0000000000000000000000000000000000000000..4a3f88c0a94632de3c04d8912e6ce670d24db011
--- /dev/null
+++ b/bsd/dev/mt6762_vbat_observer.c
@@ -0,0 +1,111 @@
+/* Included by mt6762_battery_observer.c. One exact channel1 conversion, no
+ * generic ADC grant, NTC/BIF/TDET, clock/reset, trim or charger writes. */
+struct vbat_observer_context {
+    struct battery_observer_lease lease;
+    unsigned phase,attempted,completed,reads,fault;
+};
+static int vbat_observer_transfer(struct vbat_observer_context *ctx,int write,uint16_t reg,uint16_t *value)
+{
+    uint64_t now;
+    int error=-EPERM;
+    if(!ctx || !value)return -EINVAL;
+    lck_mtx_lock(&pwrap_mutex);
+    if(!battery_observer.active || !battery_observer.vbat || battery_observer.fault ||
+       battery_observer.vbat_fault || ctx!=battery_observer.vbat_context || ctx->fault ||
+       !gauge_latch_wrapper_ok())goto rejected;
+    clock_get_uptime(&now);
+    if(!mt6762_gauge_probe_in_lease(ctx->lease.start,ctx->lease.end,now)) {error=-ETIMEDOUT;goto rejected;}
+    if(write) {
+        if(ctx->phase!=2 || ctx->attempted || reg!=0x110e || *value!=2)goto rejected;
+        ctx->attempted++; /* Includes an ambiguous WACS completion. No retry. */
+    }else if(ctx->phase==1 || ctx->phase==3) {
+        unsigned index;
+        for(index=0;index<MT6762_VBAT_ENTRY_COUNT;index++)if(reg==mt6762_vbat_entry_regs[index])break;
+        if(index==MT6762_VBAT_ENTRY_COUNT)goto rejected;
+    }else if(ctx->phase!=2 || !ctx->completed || reg!=0x108a)goto rejected;
+    error=mt6762_wacs_transfer_profile(&pwrap_io,pwrap_profile,write,reg,value);
+    if(error) {pwrap_fault=1;error=error==-3?-ETIMEDOUT:-EIO;goto rejected;}
+    if(write) {ctx->completed++;adc_voltage_requests++;}
+    else ctx->reads++;
+    clock_get_uptime(&now);
+    if(!mt6762_gauge_probe_in_lease(ctx->lease.start,ctx->lease.end,now)) {error=-ETIMEDOUT;goto rejected;}
+    lck_mtx_unlock(&pwrap_mutex);
+    return 0;
+rejected:
+    ctx->fault=1;
+    lck_mtx_unlock(&pwrap_mutex);
+    kprintf("MT6762_VBAT_IO write=%d address=%04x error=%d attempted=%u completed=%u\n",
+        write,reg,error,ctx->attempted,ctx->completed);
+    return error;
+}
+static int vbat_observer_read(void *context,uint16_t reg,uint16_t *value)
+{return vbat_observer_transfer(context,0,reg,value);}
+static int vbat_observer_write(void *context,uint16_t reg,uint16_t value)
+{return vbat_observer_transfer(context,1,reg,&value);}
+static void vbat_observer_delay(void *context,unsigned us)
+{
+    struct vbat_observer_context *ctx=context;
+    if(!battery_observer_lease_ok(&ctx->lease) || (us!=1280 && us!=200)) {ctx->fault=1;return;}
+    pwrap_delay(NULL,us);
+    if(!battery_observer_lease_ok(&ctx->lease))ctx->fault=1;
+}
+static int vbat_observer_config(struct vbat_observer_context *ctx,const char *phase)
+{
+    for(unsigned i=0;i<MT6762_VBAT_ENTRY_COUNT;i++) {
+        uint16_t value=0;
+        int error=vbat_observer_read(ctx,mt6762_vbat_entry_regs[i],&value);
+        if(error || value!=battery_observer.vbat_entry[i]) {
+            kprintf("MT6762_VBAT_CONFIG phase=%s address=%04x value=%04x expected=%04x error=%d\n",
+                phase,mt6762_vbat_entry_regs[i],value,battery_observer.vbat_entry[i],error);
+            ctx->fault=1;return error?error:-EINVAL;
+        }
+    }
+    return 0;
+}
+static int vbat_observer_sample(const struct battery_observer_lease *lease,struct mt6762_battery_sample *sample)
+{
+    struct vbat_observer_context ctx={.lease=*lease,.phase=1};
+    struct mt6762_battery_adc_io io={&ctx,vbat_observer_read,vbat_observer_write,vbat_observer_delay};
+    uint16_t raw=0;
+    int error,mv;
+    lck_mtx_lock(&adc_mutex);
+    battery_adc_mv=-1;battery_observer.vbat_context=&ctx;
+    error=vbat_observer_config(&ctx,"before");if(error)goto done;
+    ctx.phase=2;
+    /* The unchanged protocol requires post-request READY low then high;
+     * stale high, missed generation, rails and timeout never publish. */
+    error=mt6762_battery_adc_fresh(&io,1,&raw);if(error)goto done;
+    ctx.phase=3;
+    error=vbat_observer_config(&ctx,"after");if(error)goto done;
+    error=-ETIMEDOUT;
+    if(ctx.fault || ctx.attempted!=1 || ctx.completed!=1 || !battery_observer_lease_ok(lease))goto done;
+    mv=(int)(((uint32_t)raw*3u*1800u)>>15);
+    sample->voltage_uv=mv*1000;sample->valid|=MT6762_BAT_VOLTAGE;
+    battery_adc_mv=mv;battery_observer.vbat_samples++;
+    adc_observed(mv,&adc_voltage_samples,&adc_voltage_min,&adc_voltage_max);
+    kprintf("MT6762_VBAT_OBSERVER sample=%u raw=%04x voltage_uv=%d requests=1 acquired=%llx expires=%llx soc_valid=0 absolute_calibration=0\n",
+        battery_observer.vbat_samples,raw,sample->voltage_uv,
+        (unsigned long long)lease->start,(unsigned long long)lease->end);
+    error=0;
+done:
+    battery_observer.vbat_context=NULL;ctx.phase=0;
+    if(error) {
+        battery_observer.vbat_fault=1;ctx.fault=1;
+        kprintf("MT6762_VBAT_OBSERVER_STOP error=%d requests_attempted=%u requests_completed=%u reads=%u cleanup_writes=0\n",
+            error,ctx.attempted,ctx.completed,ctx.reads);
+    }
+    lck_mtx_unlock(&adc_mutex);
+    return error;
+}
+static int vbat_observer_handoff(void)
+{
+    static const char *names[]={"vbat-adc-clock0","vbat-adc-clock1","vbat-adc-reset","vbat-adc-test","vbat-adc-reuse"};
+    uint32_t value=0;
+    if(mt6762_handoff_u32("vbat-adc-profile-version",&value) || value!=MT6762_VBAT_PROFILE_V1)return 0;
+    for(unsigned i=0;i<MT6762_VBAT_FIXED_COUNT;i++)battery_observer.vbat_entry[i]=mt6762_vbat_fixed_values[i];
+    for(unsigned i=0;i<sizeof(names)/sizeof(names[0]);i++) {
+        if(mt6762_handoff_u32(names[i],&value) || value>0xffff)return 0;
+        battery_observer.vbat_entry[MT6762_VBAT_FIXED_COUNT+i]=(uint16_t)value;
+    }
+    return mt6762_vbat_entry_ok(battery_observer.vbat_entry);
+}
